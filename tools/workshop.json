{
  "item": "3829070317",
  "package": {
    "id": "gmod-rtx-remix",
    "name": "RTX Remix for Garry's Mod",
    "title": "RTX Remix for Garry's Mod (native loader package)",
    "type": "effects",
    "tags": [
      "realism"
    ],
    "description": "Native package for the GMod native loader: the RTX Remix runtime, the RTX fixes and ReShade for RTX sessions. This shipment needs loader 0.9.0 or later (bin\\win64\\winmm.dll) and a native-loader\\config.json that allowlists this item. It supports verified RTX client scripts on multiplayer servers with sv_allowcslua 0 and automatic backup and migration of supported previous RTXLauncher installations. GMod does not mount this item itself; the loader deploys it."
  },
  "parts": [
    {
      "name": "runtime",
      "build": "package_runtime",
      "args": [
        "--runtime",
        "out/inputs/runtime/files",
        "--dxvk-conf",
        "out/inputs/runtime/layers/classic_remix_defaults.conf",
        "--dxvk-conf",
        "out/inputs/runtime/layers/compiler_threads.conf",
        "--env",
        "DXVK_FORCE_WINDOWED=1"
      ]
    },
    {
      "name": "reshade",
      "build": "package_reshade",
      "args": [
        "--setup",
        "out/inputs/reshade/ReShade_Setup_6.8.0.exe"
      ]
    },
    {
      "name": "fixes",
      "build": "package_fixes",
      "args": [
        "--repo",
        "out/inputs/fixes",
        "--modules-from",
        "out/inputs/fixes/modules",
        "--with-debug-module",
        "--client-bootstrap",
        "out/inputs/fixes/modules/gmsv_nlrtxclient_win64.dll",
        "--add-to-addon",
        "remixbinary/LICENSE",
        "packages/fixes/LICENSE",
        "--add-to-addon",
        "rtx_debug/source",
        "packages/fixes/licenses/rtxdebug"
      ]
    },
    {
      "name": "emissives",
      "package": "out/inputs/emissives/emissives.gma"
    },
    {
      "name": "remove-halo",
      "build": "package_content",
      "args": [
        "--id",
        "remove-halo",
        "--requires-remix",
        "--addon",
        "out/inputs/remove-halo/Remove_halo"
      ]
    },
    {
      "name": "model-hotloader",
      "build": "package_content",
      "args": [
        "--id",
        "model-hotloader",
        "--name",
        "Model Hotloader",
        "--requires-remix",
        "--addon",
        "out/inputs/model-hotloader/mmd_hotloader",
        "--addon-file",
        "mmd_hotloader/lua/mmdhl/installation.lua",
        "out/inputs/model-hotloader/overrides/installation.lua",
        "--add-to-addon",
        "mmd_hotloader/LICENSE",
        "packages/model-hotloader/LICENSE",
        "--add-to-addon",
        "mmd_hotloader/licenses",
        "packages/model-hotloader/licenses",
        "--lua-bin",
        "out/inputs/model-hotloader/bin/gmcl_mmdhl_win64.dll",
        "--lua-bin",
        "out/inputs/model-hotloader/bin/gmsv_mmdhl_win64.dll",
        "--lua-bin",
        "out/inputs/model-hotloader/bin/mmdhl_runtime_win64.dll",
        "--lua-bin",
        "out/inputs/model-hotloader/bin/lib_coacd.dll",
        "--lua-bin",
        "out/inputs/model-hotloader/bin/mmdhl_worker.exe",
        "--lua-bin",
        "out/inputs/model-hotloader/bin/mmdhl-native-release.json",
        "--load-first",
        "gmcl_mmdhl_win64.dll=mmdhl_runtime_win64.dll",
        "--load-first",
        "gmsv_mmdhl_win64.dll=mmdhl_runtime_win64.dll"
      ]
    },
    {
      "name": "advanced-material-editor",
      "build": "package_content",
      "args": [
        "--id",
        "advanced-material-editor",
        "--requires-remix",
        "--addon",
        "out/inputs/advanced-material-editor/!advanced_material_editor",
        "--ignore",
        "materials/models/*",
        "--lua-bin",
        "out/inputs/advanced-material-editor/bin/gmcl_advmat_rtx_bridge_win64.dll"
      ]
    },
    {
      "name": "advanced-bodygroup-tool",
      "build": "package_content",
      "args": [
        "--id",
        "advanced-bodygroup-tool",
        "--requires-remix",
        "--addon-as",
        "advanced_bodygroup_tool",
        "out/inputs/advanced-bodygroup-tool/!advanced_bodygroup_tool"
      ]
    },
    {
      "name": "procedural-bodygroup-destruction",
      "build": "package_content",
      "args": [
        "--id",
        "procedural-bodygroup-destruction",
        "--requires-remix",
        "--addon",
        "out/inputs/procedural-bodygroup-destruction/!gmod_bullet_break_simulator"
      ]
    },
    {
      "name": "character-motion-importer",
      "build": "package_content",
      "args": [
        "--id",
        "character-motion-importer",
        "--requires-remix",
        "--addon",
        "out/inputs/character-motion-importer/mmd_vmd_npc",
        "--add-to-addon",
        "mmd_vmd_npc/LICENSE",
        "packages/character-motion-importer/LICENSE"
      ]
    }
  ],
  "gmpublish": "H:\\SteamLibrary\\steamapps\\common\\GarrysMod_PoC\\bin\\win64\\gmpublish.exe"
}
