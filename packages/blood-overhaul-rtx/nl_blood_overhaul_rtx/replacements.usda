        over "mat_006B732830704716"
        {
            # decals/bloodoverhaul/tex/heavy_splash (natural)
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                bool inputs:preload_textures = 0
                asset inputs:diffuse_texture = @./textures/heavy_splash.a.rtex.dds@ (
                    colorSpace = "auto"
                )
                asset inputs:normalmap_texture = @./textures/heavy_splash.n.rtex.dds@ (
                    colorSpace = "raw"
                )
                int inputs:encoding = 0
                asset inputs:reflectionroughness_texture = @./textures/heavy_splash.r.rtex.dds@ (
                    colorSpace = "raw"
                )
                float inputs:metallic_constant = 0
                bool inputs:enable_emission = 0
                float inputs:opacity_constant = 1
                bool inputs:use_legacy_alpha_state = 0
                bool inputs:blend_enabled = 1
                int inputs:blend_type = 0
                bool inputs:inverted_blend = 0
                int inputs:alpha_test_type = 7
            }
        }
