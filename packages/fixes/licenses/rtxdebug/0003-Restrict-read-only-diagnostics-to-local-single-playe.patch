 Pure client-rendering configuration boundary. Local renderer changes require the module's client
 realm, the game thread, an open module and Remix API availability. Only syntactically valid rtx.*
 keys are accepted without the existing full single-player developer mutation gate. No cvar,
-server, Lua execution, memory or detour authority is granted. Tested by render_policy_test.cpp.
+server, Lua execution, memory or detour authority is granted. `IsRenderingConVar` is the short
+allowlist of convar name prefixes (`rtx`, `r_`, `mat_`, `cl_draw`) that `Engine.GetConVar` may read
+outside local single-player; every other convar name is refused there. Tested by
+render_policy_test.cpp.
diff --git a/tests/render_policy_test.cpp b/tests/render_policy_test.cpp
index ca20274..ac909c8 100644
--- a/tests/render_policy_test.cpp
+++ b/tests/render_policy_test.cpp
@@ -12,6 +12,13 @@ int main() {
         if (CanSetConfig(false, true, key)) return 1;
     if (CanSetConfig(false, false, "rtx.pathMaxBounces")) return 1;
     if (!CanSetConfig(true, false, "existing_single_player_option")) return 1;
+    // The rendering-convar allowlist for Engine.GetConVar outside local single-player.
+    for (const auto name : {"r_drawworld", "mat_queue_mode", "rtx_conf", "rtxSomething",
+                            "cl_drawhud", "cl_drawviewmodel", "R_SHADOWS", "Mat_Fullbright"})
+        if (!IsRenderingConVar(name)) return 1;
+    for (const auto name : {"sv_cheats", "sv_allowcslua", "rcon_password", "cl_name", "net_graph",
+                            "", "mat_x;quit", "mat x", "server_rtx", "notrtx"})
+        if (IsRenderingConVar(name)) return 1;
     std::cout << "Rendering policy tests passed\n";
     return 0;
 }
