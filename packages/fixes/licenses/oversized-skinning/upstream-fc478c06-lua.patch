+-- Materials of a model, read from the .mdl header: its texture names and $cdmaterials
+-- folders. NikNaks.ModelMaterials builds every mesh of the model (util.GetModelMeshes) to
+-- find them; called once per static prop, that froze maps with thousands of props
+-- (gm_br_pitfalls: 3250 props, several minutes) until Windows closed the game.
+local modelMaterialCache = {}
+
+local function ReadCString(f, offset)
+    f:Seek(offset)
+    local s = f:Read(256) or ""
+    local z = string.find(s, "\0", 1, true)
+    return z and string.sub(s, 1, z - 1) or s
+end
+
+local function GetModelMaterialNames(modelPath)
+    local key = string.lower(modelPath or "")
+    if key == "" then return {} end
+    local cached = modelMaterialCache[key]
+    if cached then return cached end
+
+    local names = {}
+    modelMaterialCache[key] = names
+    local f = file.Open(key, "rb", "GAME")
+    if not f then return names end
+    if f:Read(4) ~= "IDST" then
+        f:Close()
+        return names
+    end
+    f:Seek(204)
+    local numTex, texIndex, numCd, cdIndex = f:ReadLong(), f:ReadLong(), f:ReadLong(), f:ReadLong()
+    if numTex < 0 or numTex > 1024 or numCd < 0 or numCd > 64 then
+        f:Close()
+        return names
+    end
+
+    local folders = {}
+    for i = 0, numCd - 1 do
+        f:Seek(cdIndex + i * 4)
+        local folder = string.lower(string.gsub(ReadCString(f, f:ReadLong()), "\\", "/"))
+        if folder ~= "" and string.sub(folder, -1) ~= "/" then folder = folder .. "/" end
+        folders[#folders + 1] = folder
+    end
+    if #folders == 0 then folders[1] = "" end
+
+    for i = 0, numTex - 1 do
+        local base = texIndex + i * 64
+        f:Seek(base)
+        local texture = string.lower(string.gsub(ReadCString(f, base + f:ReadLong()), "\\", "/"))
+        -- the engine takes the first folder that has the material
+        for _, folder in ipairs(folders) do
+            local name = folder .. texture
+            if not Material(name):IsError() then
+                names[#names + 1] = name
+                break
             end
         end
     end
+    f:Close()
+    return names
 end
 
