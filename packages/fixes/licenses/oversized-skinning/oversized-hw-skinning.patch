 // Hook: R_StudioCreateSingleMesh
 // Forces MESHGROUP_IS_HWSKINNED flag on mesh groups during creation
 // ============================================================================
+struct AutomaticLargeMeshCertificate {
+    studiomeshgroup_t* group;
+    studiohdr_t* header;
+    IMesh* mesh;
+    OptimizedModel::StripHeader_t* strips;
+    int checksum;
+    unsigned long long fingerprint;
+    bool complete;
+};
+static AutomaticLargeMeshCertificate g_largeMeshCertificates[4096] = {};
+
+static AutomaticLargeMeshCertificate* LargeMeshCertificateSlot(studiomeshgroup_t* group, bool insert) {
+    const size_t first = (reinterpret_cast<uintptr_t>(group) >> 4) % 4096;
+    for (size_t i = 0; i < 4096; ++i) {
+        AutomaticLargeMeshCertificate& entry = g_largeMeshCertificates[(first + i) % 4096];
+        if (entry.group == group) return &entry;
+        if (!entry.group) return insert ? &entry : nullptr;
+    }
+    // A full table may forget an old certificate, never approve unknown data.
+    return insert ? &g_largeMeshCertificates[first] : nullptr;
+}
+
+static unsigned long long LargeMeshStripFingerprint(studiomeshgroup_t* group) {
+    unsigned long long hash = 1469598103934665603ULL;
+    const auto add = [&hash](int value) {
+        hash ^= static_cast<unsigned int>(value);
+        hash *= 1099511628211ULL;
+    };
+    add(group->m_NumVertices);
+    add(group->m_NumStrips);
+    for (int i = 0; i < group->m_NumStrips; ++i) {
+        OptimizedModel::StripHeader_t* strip = &group->m_pStripData[i];
+        add(strip->numVerts); add(strip->vertOffset);
+        add(strip->numBoneStateChanges);
+        if (strip->numBoneStateChanges < 0 || strip->numBoneStateChanges > MAX_D3D9_BONES) return 0;
+        for (int k = 0; k < strip->numBoneStateChanges; ++k) {
+            OptimizedModel::BoneStateChangeHeader_t* change = strip->pBoneStateChange(k);
+            add(change->hardwareID); add(change->newBoneID);
+        }
+    }
+    return hash;
+}
+
+static bool VtxStripPalettesAreComplete(
+    studiohdr_t* header, OptimizedModel::StripGroupHeader_t* source, studiomeshgroup_t* runtime)
+{
+    if (source->numVerts != runtime->m_NumVertices || source->numVerts <= 0 || source->numVerts > 65536 ||
+        source->numStrips != runtime->m_NumStrips || source->numStrips <= 0 || source->numStrips > 1024 ||
+        !runtime->m_pStripData) return false;
+    for (int i = 0; i < source->numStrips; ++i) {
+        OptimizedModel::StripHeader_t* strip = source->pStrip(i);
+        OptimizedModel::StripHeader_t* built = &runtime->m_pStripData[i];
+        if (strip->vertOffset < 0 || strip->numVerts <= 0 || strip->vertOffset > source->numVerts ||
+            strip->numVerts > source->numVerts - strip->vertOffset ||
+            strip->numBoneStateChanges < 0 || strip->numBoneStateChanges > MAX_D3D9_BONES ||
+            strip->numVerts != built->numVerts || strip->vertOffset != built->vertOffset ||
+            strip->numBoneStateChanges != built->numBoneStateChanges) return false;
+        OversizedSkinning::BoneSlotMask used, provided;
+        for (int v = 0; v < strip->numVerts; ++v) {
+            OptimizedModel::Vertex_t* vertex = source->pVertex(strip->vertOffset + v);
+            if (vertex->numBones == 0 || vertex->numBones > 3) return false;
+            for (int b = 0; b < vertex->numBones; ++b) {
+                if (!used.Add(static_cast<unsigned char>(vertex->boneID[b]))) return false;
+            }
+        }
+        for (int k = 0; k < strip->numBoneStateChanges; ++k) {
+            OptimizedModel::BoneStateChangeHeader_t* change = strip->pBoneStateChange(k);
+            OptimizedModel::BoneStateChangeHeader_t* builtChange = built->pBoneStateChange(k);
+            if (change->hardwareID != builtChange->hardwareID || change->newBoneID != builtChange->newBoneID)
+                return false;
+            if (change->newBoneID < 0) break;
+            if (change->newBoneID >= header->numbones || !provided.Add(change->hardwareID)) return false;
+        }
+        if (!OversizedSkinning::StripProvidesUsedSlots(used, provided)) return false;
+    }
+    return true;
+}
+
+static void CertifyAutomaticLargeMeshes(
+    studiohdr_t* header, mstudiomesh_t* mesh, int* vtxMesh, __int64 meshData)
+{
+    __try {
+        if (!header || !meshData) return;
+        const int groupCount = *reinterpret_cast<int*>(meshData);
+        studiomeshgroup_t* groups = *reinterpret_cast<studiomeshgroup_t**>(meshData + 8);
+        if (!groups || groupCount <= 0 || groupCount > MAX_VTX_STRIP_GROUPS) return;
+        for (int i = 0; i < groupCount; ++i) {
+            AutomaticLargeMeshCertificate* entry = LargeMeshCertificateSlot(&groups[i], false);
+            if (entry) entry->complete = false;
+        }
+        OptimizedModel::MeshHeader_t* vtx = reinterpret_cast<OptimizedModel::MeshHeader_t*>(vtxMesh);
+        if (!mesh || !vtx || vtx->numStripGroups != groupCount) return;
+        for (int i = 0; i < groupCount; ++i) {
+            OptimizedModel::StripGroupHeader_t* source = GetVtxStripGroup(vtx, header, i);
+            if (!source || !OversizedSkinning::NeedsHardwareProtection(source->numVerts, source->flags, mesh->numflexes))
+                continue;
+            AutomaticLargeMeshCertificate* entry = LargeMeshCertificateSlot(&groups[i], true);
+            *entry = {};
+            entry->group = &groups[i];
+            entry->header = header;
+            entry->mesh = groups[i].m_pMesh;
+            entry->strips = groups[i].m_pStripData;
+            entry->checksum = header->checksum;
+            entry->complete = VtxStripPalettesAreComplete(header, source, &groups[i]);
+            if (entry->complete) entry->fingerprint = LargeMeshStripFingerprint(&groups[i]);
+            if (HardwareSkinningDebugEnabled()) {
+                HWSKIN_DBG("[HWSkin] Oversized strip palette certificate: vertices=%d strips=%d complete=%d\n",
+                    source->numVerts, source->numStrips, entry->complete);
+            }
+        }
+    } __except(EXCEPTION_EXECUTE_HANDLER) {
+        ReportUnsafeAutomaticLargeMesh("exception certifying compiled strip palettes");
+    }
+}
