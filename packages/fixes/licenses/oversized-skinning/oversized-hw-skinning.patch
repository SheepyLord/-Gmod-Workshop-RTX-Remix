diff --git a/source/oversized_skinning_policy.h b/source/oversized_skinning_policy.h
new file mode 100644
index 0000000..25f223e
--- /dev/null
+++ b/source/oversized_skinning_policy.h
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <cstdint>
+
+namespace OversizedSkinning {
+
+// studiorender.dll's dynamic software path rejects this count inclusively.
+constexpr int SoftwareVertexLimit = 32768;
+constexpr unsigned int Flexed = 0x1;
+constexpr unsigned int HardwareSkinned = 0x2;
+constexpr unsigned int DeltaFlexed = 0x4;
+
+constexpr bool IsNonFlexHardwareGroup(unsigned int flags, int flexes) {
+    return (flags & HardwareSkinned) != 0 &&
+        (flags & (Flexed | DeltaFlexed)) == 0 && flexes == 0;
+}
+
+constexpr bool NeedsHardwareProtection(int vertices, unsigned int flags, int flexes) {
+    return vertices >= SoftwareVertexLimit && IsNonFlexHardwareGroup(flags, flexes);
+}
+
+constexpr bool NeedsHardwareScope(
+    int vertices, unsigned int flags, int flexes, bool userForcedEligible, bool alreadyScoped)
+{
+    return !alreadyScoped && vertices > 0 && IsNonFlexHardwareGroup(flags, flexes) &&
+        (userForcedEligible || vertices >= SoftwareVertexLimit);
+}
+
+constexpr bool HasUnsafeStaticFallback(unsigned char config38, bool oversized) {
+    return oversized && (config38 & 0x08) != 0;
+}
+
+constexpr bool UserForcedUploadSelected(int bones, int mode) {
+    return bones > 1 && bones <= 512 && (mode == 1 || mode == bones);
+}
+
+struct BoneSlotMask {
+    std::uint64_t words[4] = {};
+
+    bool Add(int slot) {
+        if (slot < 0 || slot >= 256) return false;
+        words[slot / 64] |= std::uint64_t(1) << (slot % 64);
+        return true;
+    }
+};
+
+// Only the strip's own assignments prove completeness. A mapping cached from
+// an earlier mesh can be stale when the user has hardware skinning disabled.
+inline bool StripProvidesUsedSlots(const BoneSlotMask& used, const BoneSlotMask& provided) {
+    for (int i = 0; i < 4; ++i) {
+        if ((used.words[i] & ~provided.words[i]) != 0) return false;
+    }
+    return true;
+}
+
+// Only the palette slots and blend states borrowed by the automatic draw are
+// restored. A full D3D state block would also roll back Source's material state.
+template<typename Matrix, int MaxMatrices>
+struct BonePaletteSnapshot {
+    Matrix matrices[MaxMatrices];
+    unsigned int vertexBlend;
+    unsigned int indexedBlend;
+    int count;
+    bool ready;
+
+    template<typename Access>
+    bool Capture(Access& access, int matrixCount) {
+        ready = false;
+        if (matrixCount <= 0 || matrixCount > MaxMatrices ||
+            !access.ReadBlend(vertexBlend, indexedBlend)) return false;
+        for (int i = 0; i < matrixCount; ++i) {
+            if (!access.ReadMatrix(i, matrices[i])) return false;
+        }
+        count = matrixCount;
+        ready = true;
+        return true;
+    }
+
+    template<typename Access>
+    bool Restore(Access& access) const {
+        if (!ready) return true;
+        bool restored = true;
+        for (int i = 0; i < count; ++i) {
+            if (!access.WriteMatrix(i, matrices[i])) restored = false;
+        }
+        if (!access.WriteBlend(vertexBlend, indexedBlend)) restored = false;
+        return restored;
+    }
+};
+
+} // namespace OversizedSkinning
diff --git a/tests/oversized_skinning_test.cpp b/tests/oversized_skinning_test.cpp
new file mode 100644
index 0000000..2df5377
--- /dev/null
+++ b/tests/oversized_skinning_test.cpp
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "../source/oversized_skinning_policy.h"
+#include <cassert>
+#include <iostream>
+
+struct FakePalette {
+    int matrices[8] = {10, 11, 12, 13, 14, 15, 16, 17};
+    unsigned int blend = 2;
+    unsigned int indexed = 1;
+    int failRead = -1;
+    int writes = 0;
+    bool ReadBlend(unsigned int& b, unsigned int& i) { b = blend; i = indexed; return true; }
+    bool WriteBlend(unsigned int b, unsigned int i) { blend = b; indexed = i; ++writes; return true; }
+    bool ReadMatrix(int i, int& value) { value = matrices[i]; return i != failRead; }
+    bool WriteMatrix(int i, int value) { matrices[i] = value; ++writes; return true; }
+};
+
+int main() {
+    using OversizedSkinning::NeedsHardwareProtection;
+    for (int count : {-1, 0, 1, 32767}) assert(!NeedsHardwareProtection(count, 2, 0));
+    for (int count : {32768, 40509, 62049}) assert(NeedsHardwareProtection(count, 2, 0));
+    assert(!NeedsHardwareProtection(40509, 0, 0));
+    assert(!NeedsHardwareProtection(40509, 1, 0));
+    assert(!NeedsHardwareProtection(40509, 3, 0));
+    assert(!NeedsHardwareProtection(40509, 6, 0));
+    assert(!NeedsHardwareProtection(40509, 2, 1));
+    assert(!NeedsHardwareProtection(40509, 2, -1));
+
+    using OversizedSkinning::NeedsHardwareScope;
+    assert(!NeedsHardwareScope(7015, 2, 0, false, false));
+    assert(NeedsHardwareScope(7015, 2, 0, true, false));
+    assert(NeedsHardwareScope(40509, 2, 0, false, false));
+    assert(!NeedsHardwareScope(40509, 2, 0, true, true));
+    assert(!NeedsHardwareScope(7015, 0, 0, true, false));
+    assert(!NeedsHardwareScope(7015, 3, 1, true, false));
+    assert(!NeedsHardwareScope(0, 2, 0, true, false));
+    assert(OversizedSkinning::HasUnsafeStaticFallback(0x08, true));
+    assert(!OversizedSkinning::HasUnsafeStaticFallback(0x08, false));
+    assert(!OversizedSkinning::HasUnsafeStaticFallback(0x00, true));
+    assert(OversizedSkinning::UserForcedUploadSelected(233, 1));
+    assert(OversizedSkinning::UserForcedUploadSelected(43, 43));
+    assert(!OversizedSkinning::UserForcedUploadSelected(233, 0));
+    assert(!OversizedSkinning::UserForcedUploadSelected(233, -1));
+    assert(!OversizedSkinning::UserForcedUploadSelected(233, 43));
+    assert(!OversizedSkinning::UserForcedUploadSelected(1, 1));
+    assert(!OversizedSkinning::UserForcedUploadSelected(513, 1));
+
+    OversizedSkinning::BoneSlotMask used, provided, staleCache;
+    assert(used.Add(0) && used.Add(52) && used.Add(255));
+    assert(provided.Add(0) && provided.Add(52));
+    assert(staleCache.Add(255));
+    assert(!OversizedSkinning::StripProvidesUsedSlots(used, provided));
+    // A stale cache containing the missing slot cannot approve this strip.
+    assert(staleCache.words[3] != 0 &&
+        !OversizedSkinning::StripProvidesUsedSlots(used, provided));
+    assert(provided.Add(255));
+    assert(OversizedSkinning::StripProvidesUsedSlots(used, provided));
+    assert(!provided.Add(-1) && !provided.Add(256));
+
+    FakePalette device;
+    OversizedSkinning::BonePaletteSnapshot<int, 8> snapshot = {};
+    assert(snapshot.Capture(device, 4));
+    for (int i = 0; i < 4; ++i) device.matrices[i] = 100 + i;
+    device.blend = 0; device.indexed = 0;
+    assert(snapshot.Restore(device));
+    for (int i = 0; i < 8; ++i) assert(device.matrices[i] == 10 + i);
+    assert(device.blend == 2 && device.indexed == 1);
+    assert(snapshot.Capture(device, 4));
+    try {
+        device.matrices[0] = 900;
+        device.blend = 7;
+        throw 1;
+    } catch (...) {
+        assert(snapshot.Restore(device));
+    }
+    assert(device.matrices[0] == 10 && device.blend == 2);
+    const int priorWrites = device.writes;
+    device.failRead = 2;
+    assert(!snapshot.Capture(device, 4));
+    assert(snapshot.Restore(device) && device.writes == priorWrites);
+    assert(!snapshot.Capture(device, -1));
+    assert(!snapshot.Capture(device, 9));
+    std::cout << "PASS: oversized HW policy, complete per-strip palettes and borrowed state restoration\n";
+}
diff --git a/tests/oversized_skinning_test.md b/tests/oversized_skinning_test.md
new file mode 100644
index 0000000..4a1dee2
--- /dev/null
+++ b/tests/oversized_skinning_test.md
@@ -0,0 +1,17 @@
+# Oversized skinning regression
+
+Compile oversized_skinning_test.cpp as a standalone C++17 executable. It loads
+the production policy and borrowed-palette snapshot helper without a game, GPU
+or Windows SDK. Assertions cover 32,767/32,768/40,509 vertices, invalid counts,
+hardware versus software groups, flex exclusion, palette/blend restoration,
+complete strip-local slot coverage (a stale cache cannot fill missing slots),
+user-forced small groups versus unchanged default/diagnostic-filter behavior, same-group nesting,
+the unsupported static-fallback guard, exception cleanup and incomplete-capture failure. Exit zero and a PASS line
+indicate success. Keep the executable and compiler outputs under the aggregate
+repository's ignored out directory.
+
+Runtime acceptance must exercise the same large non-flex HW group with
+r_forcehwskin both zero and one, then render ordinary models and arms to catch
+blend/palette leakage. The automatic path must not change the convar, must skip
+an eligible draw if its required state cannot be captured, and must leave all
+noneligible model groups and existing forced-flex behavior alone.
