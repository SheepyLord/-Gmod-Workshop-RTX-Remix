+struct AutomaticBonePaletteAccess {
+    IDirect3DDevice9* device;
+
+    bool ReadBlend(unsigned int& blend, unsigned int& indexed) {
+        DWORD oldBlend, oldIndexed;
+        if (FAILED(device->GetRenderState(D3DRS_VERTEXBLEND, &oldBlend)) ||
+            FAILED(device->GetRenderState(D3DRS_INDEXEDVERTEXBLENDENABLE, &oldIndexed))) return false;
+        blend = oldBlend;
+        indexed = oldIndexed;
+        return true;
+    }
+    bool WriteBlend(unsigned int blend, unsigned int indexed) {
+        const HRESULT first = device->SetRenderState(D3DRS_VERTEXBLEND, blend);
+        const HRESULT second = device->SetRenderState(D3DRS_INDEXEDVERTEXBLENDENABLE, indexed);
+        return SUCCEEDED(first) && SUCCEEDED(second);
+    }
+    bool ReadMatrix(int index, D3DMATRIX& matrix) {
+        return SUCCEEDED(device->GetTransform(D3DTS_WORLDMATRIX(index), &matrix));
+    }
+    bool WriteMatrix(int index, const D3DMATRIX& matrix) {
+        return SUCCEEDED(device->SetTransform(D3DTS_WORLDMATRIX(index), &matrix));
+    }
+};
