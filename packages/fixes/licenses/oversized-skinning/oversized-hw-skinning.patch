+static int* DrawAutomaticLargeHardwareMesh(
+    void* studioRender, void* renderContext, void* mesh, studiomeshgroup_t* group,
+    float blend, IMaterial* material, int lod, HWSkinDrawDynamicMeshFn original)
+{
+    if (!g_bInRenderFinal || !g_pD3DDevice || !g_OriginalDIP || !renderContext || !material) {
+        ReportUnsafeAutomaticLargeMesh("missing render context, device or bone-draw hook");
+        return nullptr;
+    }
+
+    AutomaticBonePaletteAccess access = {g_pD3DDevice};
+    OversizedSkinning::BonePaletteSnapshot<D3DMATRIX, MAX_D3D9_BONES> palette = {};
+    const PerStripDrawState previousStripState = g_PerStripState;
+    studiomeshgroup_t* previousAutomaticGroup = g_automaticLargeMeshGroup;
+    studiomeshgroup_t* previousFlexGroup = g_pCurrentDynamicFlexGroup;
+    const int previousBoneCount = g_BONEDATA.bone_count;
+    const bool previousBoneActive = g_BONEDATA.active;
+    unsigned char* config = nullptr;
+    unsigned char oldConfig24 = 0, oldConfig25 = 0;
+    unsigned int oldGroupFlags = 0;
+    int* oldUniqueTriangles = nullptr;
+    bool configChanged = false, materialChanged = false, groupCaptured = false;
+    int* result = nullptr;
+
+    __try {
+        __try {
+            studiohdr_t* header = *(studiohdr_t**)((uintptr_t)studioRender + 0x108);
+            matrix3x4_t* poses = *(matrix3x4_t**)((uintptr_t)studioRender + 0xE8);
+            config = *(unsigned char**)((uintptr_t)studioRender + 0x08);
+            int paletteCount = 0;
+            const bool oversized = group->m_NumVertices >= OversizedSkinning::SoftwareVertexLimit;
+            if (config && OversizedSkinning::HasUnsafeStaticFallback(config[0x38], oversized)) {
+                ReportUnsafeAutomaticLargeMesh("unsupported static renderer fallback mode");
+                __leave;
+            }
+            if (!config || !GetAutomaticLargeMeshPaletteCount(header, poses, group, paletteCount) ||
+                !palette.Capture(access, paletteCount)) {
+                ReportUnsafeAutomaticLargeMesh("unavailable model, palette, strip data or D3D snapshot");
+                __leave;
+            }
+            oldGroupFlags = group->m_Flags;
+            oldUniqueTriangles = group->m_pUniqueTris;
+            groupCaptured = true;
+            oldConfig24 = config[0x24];
+            oldConfig25 = config[0x25];
+            configChanged = true;
+            config[0x24] &= static_cast<unsigned char>(~0x02);
+            config[0x25] &= static_cast<unsigned char>(~0x0B);
+            materialChanged = material->NeedsSoftwareSkinning();
+            if (materialChanged) material->SetMaterialVarFlag(MATERIAL_VAR_NEEDS_SOFTWARE_SKINNING, false);
+            g_automaticLargeMeshGroup = group;
+
+            static int automaticDrawReports = 0;
+            if (HardwareSkinningDebugEnabled() && automaticDrawReports++ < 32) {
+                HWSKIN_DBG("[HWSkin] Scoped HW safety draw: vertices=%d bones=%d "
+                    "flags=0x%X config24=0x%02X config25=0x%02X materialSW=%d\n",
+                    group->m_NumVertices, header->numbones, oldGroupFlags,
+                    oldConfig24, oldConfig25, materialChanged);
+            }
+            // Known non-flex HW data goes directly through the original HW
+            // branch; its inner hook uploads bones even if r_forcehwskin is 0.
+            result = original(studioRender, renderContext, mesh, group, 0, blend, material, lod);
+        }
+        __finally {
+            g_automaticLargeMeshGroup = previousAutomaticGroup;
+            g_pCurrentDynamicFlexGroup = previousFlexGroup;
+            g_PerStripState = previousStripState;
+            g_BONEDATA.bone_count = previousBoneCount;
+            g_BONEDATA.active = previousBoneActive;
+            __try {
+                if (groupCaptured) {
+                    group->m_Flags = oldGroupFlags;
+                    group->m_pUniqueTris = oldUniqueTriangles;
+                }
+                if (configChanged) {
+                    config[0x24] = oldConfig24;
+                    config[0x25] = oldConfig25;
+                }
+            } __except(EXCEPTION_EXECUTE_HANDLER) {
+                ReportUnsafeAutomaticLargeMesh("exception restoring renderer state");
+            }
+            __try {
+                if (materialChanged) material->SetMaterialVarFlag(MATERIAL_VAR_NEEDS_SOFTWARE_SKINNING, true);
+            } __except(EXCEPTION_EXECUTE_HANDLER) {
+                ReportUnsafeAutomaticLargeMesh("exception restoring material state");
+            }
+            __try {
+                if (!palette.Restore(access)) ReportUnsafeAutomaticLargeMesh("D3D state restoration failed");
+            } __except(EXCEPTION_EXECUTE_HANDLER) {
+                ReportUnsafeAutomaticLargeMesh("exception restoring D3D state");
+            }
+        }
+    } __except(EXCEPTION_EXECUTE_HANDLER) {
+        ReportUnsafeAutomaticLargeMesh("exception preparing or drawing model");
+    }
+    return result;
+}
