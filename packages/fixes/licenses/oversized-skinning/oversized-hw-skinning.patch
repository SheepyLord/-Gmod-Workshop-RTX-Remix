+static void ReportUnsafeAutomaticLargeMesh(const char* reason) {
+    static int reports = 0;
+    if (reports++ < 8) {
+        HWSKIN_ERROR("[HWSkin] Skipping oversized HW mesh without safe draw state: %s\n", reason);
+    }
+}
+
+// Determine every palette slot our existing upload/remap helpers can modify.
+// The engine's software guard must remain intact; unreadable/transient groups
+// are skipped rather than sent back through that unsafe fallback.
+static bool GetAutomaticLargeMeshPaletteCount(
+    studiohdr_t* header, matrix3x4_t* poses, studiomeshgroup_t* group, int& count)
+{
+    const bool oversized = group->m_NumVertices >= OversizedSkinning::SoftwareVertexLimit;
+    if (!header || !poses || !group->m_pMesh || !group->m_pStripData ||
+        header->numbones <= 0 || header->numbones > (oversized ? MAX_D3D9_BONES : 512) ||
+        group->m_NumVertices > 65536 || group->m_NumStrips <= 0 || group->m_NumStrips > 1024) return false;
+    if (oversized) {
+        AutomaticLargeMeshCertificate* certificate = LargeMeshCertificateSlot(group, false);
+        if (!certificate || !certificate->complete || certificate->header != header ||
+            certificate->mesh != group->m_pMesh || certificate->strips != group->m_pStripData ||
+            certificate->checksum != header->checksum ||
+            certificate->fingerprint != LargeMeshStripFingerprint(group)) return false;
+    }
+    count = header->numbones < MAX_D3D9_BONES ? header->numbones : MAX_D3D9_BONES;
+    ModelBoneRemapCache* cache = GetOrCreateBoneRemapCache(header);
+    if (!cache || cache->maxHwID < 0 || cache->maxHwID > MAX_D3D9_BONES) return false;
+    if (cache->maxHwID > count) count = cache->maxHwID;
+    bool haveFirstStripMapping = header->numbones == 1;
+    for (int i = 0; i < cache->maxHwID; ++i) {
+        if (cache->remapTable[i] >= 0 && cache->remapTable[i] < header->numbones)
+            haveFirstStripMapping = true;
+    }
+    for (int stripIndex = 0; stripIndex < group->m_NumStrips; ++stripIndex) {
+        OptimizedModel::StripHeader_t* strip = &group->m_pStripData[stripIndex];
+        if (strip->numBoneStateChanges < 0 || strip->numBoneStateChanges > MAX_D3D9_BONES) return false;
+        for (int i = 0; i < strip->numBoneStateChanges; ++i) {
+            OptimizedModel::BoneStateChangeHeader_t* change = strip->pBoneStateChange(i);
+            if (change->newBoneID < 0) break;
+            if (change->hardwareID < 0 || change->hardwareID >= MAX_D3D9_BONES ||
+                change->newBoneID >= header->numbones) return false;
+            if (change->hardwareID + 1 > count) count = change->hardwareID + 1;
+            if (stripIndex == 0) haveFirstStripMapping = true;
+        }
+    }
+    for (int bone = 0; bone < header->numbones; ++bone) {
+        for (int row = 0; row < 3; ++row) {
+            for (int column = 0; column < 4; ++column) {
+                if (!std::isfinite(poses[bone][row][column])) return false;
+            }
+        }
+    }
+    // Large automatic draws require a certified complete palette. Smaller
+    // user-forced draws retain the existing cache/skeleton-index fallback.
+    return !oversized || haveFirstStripMapping;
+}
+
+static bool UserForcedScopeHasSkinnedPose(void* studioRender) {
+    if (!g_bInRenderFinal) return false;
+    __try {
+        studiohdr_t* header = *(studiohdr_t**)((uintptr_t)studioRender + 0x108);
+        matrix3x4_t* poses = *(matrix3x4_t**)((uintptr_t)studioRender + 0xE8);
+        const int mode = GlobalConvars::r_hwskin_setbones ? GlobalConvars::r_hwskin_setbones->GetInt() : 0;
+        return header && poses && OversizedSkinning::UserForcedUploadSelected(header->numbones, mode);
+    } __except(EXCEPTION_EXECUTE_HANDLER) {
+        return false;
+    }
+}
