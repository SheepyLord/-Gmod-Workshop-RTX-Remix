+static HRESULT DrawAutomaticLargeMeshDIP(
+    IDirect3DDevice9* device, D3DPRIMITIVETYPE type, INT baseVertex,
+    UINT minVertex, UINT vertices, UINT startIndex, UINT primitives)
+{
+    IDirect3DVertexDeclaration9* originalDeclaration = nullptr;
+    IDirect3DVertexDeclaration9* convertedDeclaration = nullptr;
+    bool declarationChanged = false;
+    HRESULT result = D3DERR_INVALIDCALL;
+    __try {
+        __try {
+            if (FAILED(device->GetVertexDeclaration(&originalDeclaration)) || !originalDeclaration) {
+                ReportUnsafeAutomaticLargeMesh("unavailable hardware vertex declaration");
+                __leave;
+            }
+            D3DVERTEXELEMENT9 elements[MAXD3DDECLLENGTH + 1];
+            UINT count = MAXD3DDECLLENGTH + 1;
+            if (FAILED(originalDeclaration->GetDeclaration(elements, &count)) ||
+                count > MAXD3DDECLLENGTH + 1) {
+                ReportUnsafeAutomaticLargeMesh("unreadable hardware vertex declaration");
+                __leave;
+            }
+            bool convert = false, haveIndices = false, unsupported = false;
+            for (UINT i = 0; i < count && elements[i].Type != D3DDECLTYPE_UNUSED; ++i) {
+                if (elements[i].Usage != D3DDECLUSAGE_BLENDINDICES) continue;
+                haveIndices = true;
+                if (elements[i].Type == D3DDECLTYPE_D3DCOLOR) {
+                    elements[i].Type = D3DDECLTYPE_UBYTE4;
+                    convert = true;
+                } else if (elements[i].Type != D3DDECLTYPE_UBYTE4) {
+                    unsupported = true;
+                }
+            }
+            if (unsupported || (!haveIndices && g_PerStripState.numBones > 1)) {
+                ReportUnsafeAutomaticLargeMesh("unsupported hardware blend-index layout");
+                __leave;
+            }
+            if (convert) {
+                convertedDeclaration = AutomaticBlendDeclarationFor(device, originalDeclaration, elements);
+                if (!convertedDeclaration) {
+                    ReportUnsafeAutomaticLargeMesh("could not create unswizzled blend-index declaration");
+                    __leave;
+                }
+                declarationChanged = true;
+                if (FAILED(device->SetVertexDeclaration(convertedDeclaration))) {
+                    ReportUnsafeAutomaticLargeMesh("could not bind unswizzled blend-index declaration");
+                    __leave;
+                }
+            }
+            // Already-UBYTE4 declarations pass through without a replacement.
+            result = g_OriginalDIP(device, type, baseVertex, minVertex, vertices, startIndex, primitives);
+        }
+        __finally {
+            if (declarationChanged) device->SetVertexDeclaration(originalDeclaration);
+            if (convertedDeclaration) convertedDeclaration->Release();
+            if (originalDeclaration) originalDeclaration->Release();
+        }
+    } __except(EXCEPTION_EXECUTE_HANDLER) {
+        ReportUnsafeAutomaticLargeMesh("exception drawing/restoring blend-index declaration");
+    }
+    return result;
+}
