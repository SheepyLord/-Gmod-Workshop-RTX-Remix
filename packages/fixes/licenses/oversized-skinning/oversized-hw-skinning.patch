+struct AutomaticBlendDeclaration {
+    IDirect3DVertexDeclaration9* original;
+    IDirect3DVertexDeclaration9* converted;
+};
+static AutomaticBlendDeclaration g_automaticBlendDeclarations[16] = {};
+static unsigned int g_automaticBlendDeclarationCursor = 0;
+
+static void ReleaseAutomaticBlendDeclarations() {
+    for (AutomaticBlendDeclaration& entry : g_automaticBlendDeclarations) {
+        if (entry.converted) entry.converted->Release();
+        if (entry.original) entry.original->Release();
+        entry = {};
+    }
+    g_automaticBlendDeclarationCursor = 0;
+}
+
+static IDirect3DVertexDeclaration9* AutomaticBlendDeclarationFor(
+    IDirect3DDevice9* device, IDirect3DVertexDeclaration9* original,
+    const D3DVERTEXELEMENT9* elements)
+{
+    for (AutomaticBlendDeclaration& entry : g_automaticBlendDeclarations) {
+        if (entry.original == original) {
+            entry.converted->AddRef();
+            return entry.converted;
+        }
+    }
+    IDirect3DVertexDeclaration9* converted = nullptr;
+    if (FAILED(device->CreateVertexDeclaration(elements, &converted)) || !converted) return nullptr;
+    AutomaticBlendDeclaration& entry = g_automaticBlendDeclarations[
+        g_automaticBlendDeclarationCursor++ % 16];
+    if (entry.converted) entry.converted->Release();
+    if (entry.original) entry.original->Release();
+    // Retain the original too: its address cannot be recycled into a false hit.
+    original->AddRef();
+    entry.original = original;
+    entry.converted = converted;
+    converted->AddRef();
+    return converted;
+}
