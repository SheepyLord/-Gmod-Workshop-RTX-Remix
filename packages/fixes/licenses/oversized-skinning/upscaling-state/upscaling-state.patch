+// The export lookup also supports older SDK headers; no optional interface tail is dereferenced.
+LUA_FUNCTION(RemixConfig_GetUpscalingState) {
+    using Read = remixapi_ErrorCode(REMIXAPI_CALL*)(const char*, char*, uint32_t, uint32_t*);
+    HMODULE runtime = GetModuleHandleW(L"d3d9.dll");
+    auto read = runtime ? reinterpret_cast<Read>(GetProcAddress(runtime, "remixapi_GetGameValue")) : nullptr;
+    UpscalingReadback::State state;
+    if (!read || !UpscalingReadback::ReadState([read](const char* key, char* value, uint32_t size, uint32_t* actual) {
+            return read(key, value, size, actual) == REMIXAPI_ERROR_CODE_SUCCESS;
+        }, state)) {
+        LUA->PushNil();
+        return 1;
+    }
+    LUA->CreateTable();
+    LUA->PushBool(state.ready); LUA->SetField(-2, "ready");
+    LUA->PushNumber(state.upscaler); LUA->SetField(-2, "upscaler");
+    LUA->PushNumber(state.frameGeneration); LUA->SetField(-2, "frame_generation");
+    LUA->PushBool(state.dlss); LUA->SetField(-2, "dlss_supported");
+    LUA->PushBool(state.dlfg); LUA->SetField(-2, "dlss_frame_generation_supported");
+    LUA->PushBool(state.fsrfg); LUA->SetField(-2, "fsr_frame_generation_supported");
+    return 1;
+}
