+    Check(fs.opened.empty(), "the file system never sees such a path");
+    Check(!ReadVTFFile(&fs, "models/props/x", data, false) && fs.opened.size() == 2 &&
+              fs.opened[0] == "materials/models/props/x.vtf" && fs.opened[1] == "models/props/x",
+          "a game path is looked up as before");
+}
+
