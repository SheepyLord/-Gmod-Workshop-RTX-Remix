+    if(!m.packed.empty() || silverFamily)m.layout=Maps::Silver;
+    else if(stem.find("t_actor_")==0) {m.layout=Maps::Endfield;m.packed=find("_p");if(m.normal.empty())m.normal=find("_hn");}
