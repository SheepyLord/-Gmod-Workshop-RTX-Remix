+        // If we discovered a height map and don't have one yet, use it
+        if (props.hasDiscoveredHeight && !props.hasParallaxMap) {
+            props.parallaxMapPath = props.discoveredHeightPath;
+            props.hasParallaxMap = true;
+            if (m_debugOutput) {
