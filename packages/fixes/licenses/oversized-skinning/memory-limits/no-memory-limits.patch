+void ResourceManager::SetMemoryLimits(size_t, size_t) {
+    // Compatibility only: Remix has never supported these limits. Do not substitute
+    // other options here: API writes enter the User layer and may be saved to user.conf.
+    static const bool reported = [] {
+        Msg("[ResourceManager] SetMemoryLimits is a no-op: Remix has no cache/VRAM limit options; no limits were changed.\n");
+        return true;
+    }();
+    (void)reported;
 }
 
