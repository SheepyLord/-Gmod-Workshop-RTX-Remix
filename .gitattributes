# Auto detect text files and perform LF normalization
* text=auto

# Windows command scripts need CRLF; PowerShell is safest with CRLF too.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.sh    text eol=lf

# Vendored third-party code stays byte-identical to upstream (hashes in each README): no EOL conversion.
third_party/** -text

# The RTX package's inputs (ADR 0033) stay byte-identical to what packages/<part>/files.json indexes:
# no EOL conversion anywhere under packages/, and every binary there is stored xz-compressed in Git LFS.
packages/** -text
packages/**/*.xz filter=lfs diff=lfs merge=lfs -text

# The runtime fork's patches apply byte for byte.
runtime/patches/*.patch -text

# Binary formats this project handles; outside packages/ none is committed (AGENTS.md rule 6).
*.gma       binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.manifest  binary
