diff --git a/src/d3d9/d3d9_common_texture.cpp b/src/d3d9/d3d9_common_texture.cpp
index cf9700b1..76c6d9ca 100644
--- a/src/d3d9/d3d9_common_texture.cpp
+++ b/src/d3d9/d3d9_common_texture.cpp
@@ -123,11 +123,12 @@ namespace dxvk {
     const bool reupload = m_imageReleased;
     if (m_imageReleased) {
       m_imageReleased = false;
-      if (m_releasedHash != kEmptyHash) {
-        m_image->setHash(m_releasedHash);
-        ImGUI::AddTexture(m_releasedHash, m_sampleView.Color, ImGUI::kTextureFlagsDefault);
+      // The stable hash stays as it was throughout, so the API never sees the empty new image's hash.
+      const XXH64_hash_t releasedHash = m_stableHash.load(std::memory_order_relaxed);
+      if (releasedHash != kEmptyHash) {
+        m_image->setHash(releasedHash);
+        ImGUI::AddTexture(releasedHash, m_sampleView.Color, ImGUI::kTextureFlagsDefault);
       }
-      m_releasedHash = kEmptyHash;
     }
     if (m_memoryManaged) {
       m_device->TrackManagedTexture(this, reupload);
@@ -768,6 +769,9 @@ namespace dxvk {
 
     // save hash to dxvkImage
     m_image->setHash(imageHash);
+    // NV-DXVK start: R13 the copy the API reads from other threads
+    m_stableHash.store(imageHash, std::memory_order_release);
+    // NV-DXVK end
 
     // Let ImGUI know about this texture
     ImGUI::AddTexture(imageHash, m_sampleView.Color, ImGUI::kTextureFlagsDefault);
@@ -786,7 +790,7 @@ namespace dxvk {
 
   void D3D9CommonTexture::ClearHash() {
     // NV-DXVK start: R13 a rewrite while the image is released recomputes the hash on re-upload
-    m_releasedHash = kEmptyHash;
+    m_stableHash.store(kEmptyHash, std::memory_order_release);
     // NV-DXVK end
     if (m_image == nullptr) {
       return;
diff --git a/src/d3d9/d3d9_common_texture.h b/src/d3d9/d3d9_common_texture.h
index 4fbbb0b2..61ae8879 100644
--- a/src/d3d9/d3d9_common_texture.h
+++ b/src/d3d9/d3d9_common_texture.h
@@ -158,7 +158,14 @@ namespace dxvk {
      * \returns The image's hash, the hash it had when it was released, or kEmptyHash
      */
     XXH64_hash_t GetStableHash() const {
-      return m_image != nullptr ? m_image->getHash() : m_releasedHash;
+      // NV-DXVK start: R13 the device's pass may release a memory-managed texture's image on the
+      // render thread at any time, while the API reads the hash from other threads (ToPBR from Lua):
+      // for those textures read only the atomic copy, never m_image.
+      if (m_memoryManaged) {
+        return m_stableHash.load(std::memory_order_acquire);
+      }
+      return m_image != nullptr ? m_image->getHash() : XXH64_hash_t(0);
+      // NV-DXVK end
     }
 
     /**
@@ -574,7 +581,9 @@ namespace dxvk {
     uint32_t                      m_readbackTick = 0;
     uint64_t                      m_readbackSequence = 0;
     VkDeviceSize                  m_residentBytes = 0;       // image bytes counted while registered
-    XXH64_hash_t                  m_releasedHash = 0;       // kEmptyHash
+    // The hash the image has, or had when it was released (kEmptyHash = 0). Written with every hash
+    // change on the device's threads; read from any thread (GetStableHash).
+    std::atomic<XXH64_hash_t>     m_stableHash = { 0 };
     D3D9SubresourceBitset         m_hostCopyReleased = { };  // data only on the GPU
     // NV-DXVK end
 
