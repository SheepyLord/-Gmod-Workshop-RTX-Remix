diff --git a/src/d3d9/d3d9_managed_memory.h b/src/d3d9/d3d9_managed_memory.h
index f94d8b68..23bd9b61 100644
--- a/src/d3d9/d3d9_managed_memory.h
+++ b/src/d3d9/d3d9_managed_memory.h
@@ -107,6 +107,14 @@ namespace dxvk::managed_memory {
     return policy;
   }
 
+  // A writable lock with D3DLOCK_NO_DIRTY_UPDATE records no dirty region: what the application
+  // writes reaches the image only after an AddDirtyRect, which may come at any time later. Until
+  // then the data exists only in the CPU copy, so such a texture keeps its copy for good (as one
+  // that uses AddDirtyRect does). A read-only lock writes nothing.
+  inline bool lockKeepsHostCopy(bool readOnly, bool noDirtyUpdate) {
+    return !readOnly && noDirtyUpdate;
+  }
+
   struct Candidate {
     uint64_t bytes = 0;          // GPU bytes the release frees
     uint32_t lastUseTick = 0;    // presented second of the last draw, upload or creation
diff --git a/src/dxvk/rtx_render/rtx_fork_api_entry.cpp b/src/dxvk/rtx_render/rtx_fork_api_entry.cpp
