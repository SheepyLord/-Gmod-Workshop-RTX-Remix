diff --git a/src/dxvk/rtx_render/rtx_texture_budget.h b/src/dxvk/rtx_render/rtx_texture_budget.h
index 94c31d8b..d36f2694 100644
--- a/src/dxvk/rtx_render/rtx_texture_budget.h
+++ b/src/dxvk/rtx_render/rtx_texture_budget.h
@@ -76,6 +76,15 @@ namespace dxvk {
   enum class PreloadPinChange { Keep, Release, Restore };
   constexpr int64_t kPreloadIdleMs = 10000;
 
+  // A texture is in use ("drawn") while an instance's material retains it, or while something
+  // tracks it in the texture cache without retaining it: the terrain baker samples its source
+  // textures through the cache every frame it bakes, but the baked instance binds the baker's
+  // own material. Tracking in this frame or the two before counts.
+  constexpr uint32_t kNeverTracked = UINT32_MAX;
+  inline bool textureInUse(int32_t refCount, uint32_t lastTrackedFrame, uint32_t currentFrame) {
+    return refCount > 0 || (lastTrackedFrame != kNeverTracked && currentFrame - lastTrackedFrame <= 2);
+  }
+
   // undrawnMs: how long no instance has drawn the texture (INT64_MAX if it never was drawn).
   inline PreloadPinChange preloadPinChange(bool underPressure, bool pinned, bool drawn, int64_t undrawnMs) {
     if (pinned) {
diff --git a/src/dxvk/rtx_render/rtx_texture_manager.cpp b/src/dxvk/rtx_render/rtx_texture_manager.cpp
index 0bc18a66..f7382f52 100644
--- a/src/dxvk/rtx_render/rtx_texture_manager.cpp
+++ b/src/dxvk/rtx_render/rtx_texture_manager.cpp
@@ -1103,6 +1103,10 @@ namespace dxvk {
     if (tex == nullptr) {
       return;
     }
+    // NV-DXVK start: R13 every consumer tracks through here, also those that do not retain the
+    // texture (the terrain baker): a preload in use this frame does not give way
+    tex->m_lastTrackedFrame = m_device->getCurrentFrameId();
+    // NV-DXVK end
 
     if (!async || RtxOptions::TextureManager::neverDowngradeTextures()) {
       tex->m_needsReloadAfterPurge.store(false);
@@ -1613,9 +1617,10 @@ namespace dxvk {
         assert(tex != nullptr);
         // NV-DXVK start: R13 a released preload joins the lists below (an undrawn one drops to its
         // smallest mip there); a restored one is pinned and loaded whole again after the lock.
-        // Drawn means an instance holds the texture's material (retainSurfaceMaterial).
+        // Drawn means an instance holds the texture's material (retainSurfaceMaterial), or something
+        // tracked it in the last frames without retaining it (the terrain baker's sources).
         if (tex != nullptr && tex->m_preloadYields) {
-          const bool drawn = tex->m_refCount > 0;
+          const bool drawn = textureInUse(tex->m_refCount, tex->m_lastTrackedFrame, curframe);
           if (drawn) {
