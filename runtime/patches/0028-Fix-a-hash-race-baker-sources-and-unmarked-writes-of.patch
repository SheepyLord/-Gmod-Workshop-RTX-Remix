@@ -6030,6 +6036,10 @@ namespace dxvk {
 
 
   void D3D9DeviceEx::ManageManagedTextureMemory() {
+    // Neither option is on (other games, or GMod with both turned off): no pass, no log.
+    if (!m_managedMemoryPolicy.active()) {
+      return;
+    }
     // One pass per presented second. The tick advances once per pass, so time spent
     // minimized or loading without presenting does not make everything look idle.
     const auto now = std::chrono::steady_clock::now();
@@ -6041,14 +6051,12 @@ namespace dxvk {
     D3D9DeviceLock lock = LockDevice();
     std::lock_guard<dxvk::mutex> guard(m_managedMutex);
     ++m_managedTick;
-    if (m_managedMemoryPolicy.active()) {
-      FinishManagedReadbacks();
-      if (m_managedMemoryPolicy.releaseHostCopies) {
-        ReleaseIdleHostCopies();
-      }
-      if (m_managedMemoryPolicy.budgetBytes != 0) {
-        ReleaseIdleManagedImages();
-      }
+    FinishManagedReadbacks();
+    if (m_managedMemoryPolicy.releaseHostCopies) {
+      ReleaseIdleHostCopies();
+    }
+    if (m_managedMemoryPolicy.budgetBytes != 0) {
+      ReleaseIdleManagedImages();
     }
     LogManagedTextureMemory("pass");
   }
@@ -6190,10 +6198,12 @@ namespace dxvk {
 
 
   void D3D9DeviceEx::ReleaseManagedImage(D3D9CommonTexture* pResource) {
+    // The stable hash is the API's view of the texture: it holds the image's hash before the image
+    // goes, and keeps it while released (other threads never read m_image of this class).
+    const XXH64_hash_t hash = pResource->m_image->getHash();
+    pResource->m_stableHash.store(hash, std::memory_order_release);
     Rc<DxvkImage> image = std::move(pResource->m_image);
     pResource->m_sampleView = D3D9ColorView();
-    const XXH64_hash_t hash = image->getHash();
-    pResource->m_releasedHash = hash;
