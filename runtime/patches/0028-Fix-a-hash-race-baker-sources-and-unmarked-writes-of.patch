diff --git a/tests/rtx/unit/test_managed_texture_memory.cpp b/tests/rtx/unit/test_managed_texture_memory.cpp
index eff328c0..7eff9044 100644
--- a/tests/rtx/unit/test_managed_texture_memory.cpp
+++ b/tests/rtx/unit/test_managed_texture_memory.cpp
@@ -100,6 +100,11 @@ int main() {
   check(selectForRelease({ { kMiB, 200, false } }, 20 * kGiB, budget, 100, 0).empty(),
         "A use stamped after the pass's tick is never idle");
 
+  // A writable lock without a dirty region keeps the CPU copy for good.
+  check(lockKeepsHostCopy(false, true), "D3DLOCK_NO_DIRTY_UPDATE on a writable lock keeps the copy");
+  check(!lockKeepsHostCopy(false, false), "A writable lock with a dirty region does not");
+  check(!lockKeepsHostCopy(true, true), "A read-only lock writes nothing");
+
   std::cout << "managed texture memory policy: all checks passed\n";
   return 0;
 }
diff --git a/tests/rtx/unit/test_texture_budget_pressure.cpp b/tests/rtx/unit/test_texture_budget_pressure.cpp
index cecec872..973d3bd8 100644
--- a/tests/rtx/unit/test_texture_budget_pressure.cpp
+++ b/tests/rtx/unit/test_texture_budget_pressure.cpp
@@ -79,6 +79,15 @@ int main() {
   check(preloadPinChange(true, false, true, 0) == C::Restore, "A drawn released preload is preloaded again under pressure");
   check(preloadPinChange(false, false, true, 0) == C::Restore, "A drawn released preload is preloaded again");
 
+  // In use: retained by an instance, or tracked without a retain (the terrain baker) in this frame
+  // or the two before.
+  check(textureInUse(1, kNeverTracked, 100), "A retained texture is in use");
+  check(!textureInUse(0, kNeverTracked, 100), "A texture never tracked nor retained is not in use");
+  check(textureInUse(0, 100, 100), "A texture the baker tracked this frame is in use");
+  check(textureInUse(0, 98, 100), "Tracked two frames ago is still in use");
+  check(!textureInUse(0, 97, 100), "Tracked three frames ago is not in use any more");
+  check(textureInUse(0, UINT32_MAX - 1, 0), "The frame counter may wrap");
+
   std::cout << "texture budget pressure: all checks passed\n";
   return 0;
 }
