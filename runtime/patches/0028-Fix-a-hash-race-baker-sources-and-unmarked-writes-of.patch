+    if (commonTexture->IsMemoryManaged()) {
+      *out_hash = commonTexture->GetStableHash();
+      return REMIXAPI_ERROR_CODE_SUCCESS;
+    }
+
     // Get the underlying DXVK image.
     const Rc<DxvkImage>& image = commonTexture->GetImage();
     if (image == nullptr) {
@@ -431,8 +439,7 @@ namespace fork_hooks {
       // Keep that API result without forcing a GPU allocation during a metadata query.
       if (commonTexture->IsManaged() &&
           commonTexture->GetMapMode() == D3D9_COMMON_TEXTURE_MAP_MODE_BACKED) {
-        // R13: an image released for the budget keeps reporting the hash it had.
-        *out_hash = commonTexture->GetStableHash();
+        *out_hash = kEmptyHash;
         return REMIXAPI_ERROR_CODE_SUCCESS;
       }
       // Texture might be in system memory (not GPU).
diff --git a/src/dxvk/rtx_render/rtx_texture.h b/src/dxvk/rtx_render/rtx_texture.h
index a527dfbf..326d86f3 100644
--- a/src/dxvk/rtx_render/rtx_texture.h
