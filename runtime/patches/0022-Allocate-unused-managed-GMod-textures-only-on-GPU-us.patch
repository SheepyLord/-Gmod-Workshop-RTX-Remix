diff --git a/src/dxvk/rtx_render/rtx_fork_api_entry.cpp b/src/dxvk/rtx_render/rtx_fork_api_entry.cpp
index b69853a5..477b514c 100644
--- a/src/dxvk/rtx_render/rtx_fork_api_entry.cpp
+++ b/src/dxvk/rtx_render/rtx_fork_api_entry.cpp
@@ -427,6 +427,13 @@ namespace fork_hooks {
     // Get the underlying DXVK image.
     const Rc<DxvkImage>& image = commonTexture->GetImage();
     if (image == nullptr) {
+      // An unuploaded managed texture previously had an allocated image with an empty hash.
+      // Keep that API result without forcing a GPU allocation during a metadata query.
+      if (commonTexture->IsManaged() &&
+          commonTexture->GetMapMode() == D3D9_COMMON_TEXTURE_MAP_MODE_BACKED) {
+        *out_hash = 0;
+        return REMIXAPI_ERROR_CODE_SUCCESS;
+      }
       // Texture might be in system memory (not GPU).
       return REMIXAPI_ERROR_CODE_GENERAL_FAILURE;
     }
