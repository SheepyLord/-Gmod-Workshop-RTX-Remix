+#include "rtx_memory_stats_data.h"
+
+#include <ctime>
+#include <fstream>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace dxvk {
+
+  std::string MemorySnapshot::toJson(const char* event) const {
+    const std::time_t time = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+    std::tm utc {};
+#ifdef _WIN32
+    gmtime_s(&utc, &time);
+#else
+    gmtime_r(&time, &utc);
+#endif
+    std::ostringstream stream;
+    stream.imbue(std::locale::classic());
+    stream << "{\"schema\":1,\"time_utc\":\"" << std::put_time(&utc, "%Y-%m-%dT%H:%M:%SZ")
+           << "\",\"event\":\"" << event << "\",\"frame\":" << frame << ",\"heaps\":[";
+    for (uint32_t i = 0; i < heapCount && i < heaps.size(); ++i) {
+      if (i) {
+        stream << ',';
+      }
+      stream << "{\"index\":" << i << ",\"budget\":" << heaps[i].budget << ",\"usage\":" << heaps[i].usage << '}';
+    }
+    stream << "],\"dxvk\":{\"allocated\":" << allocated << ",\"used\":" << used << "},\"categories\":{";
+    constexpr std::array<const char*, CategoryCount> kCategoryNames = {
+      "app_buffer", "app_texture", "replacement_geometry", "buffer",
+      "acceleration_structure", "opacity_micromap", "material_texture", "render_target"
+    };
+    for (uint32_t i = 0; i < categories.size(); ++i) {
+      if (i) {
+        stream << ',';
+      }
+      stream << '"' << kCategoryNames[i] << "\":" << categories[i];
+    }
+    stream << "}}";
+    return stream.str();
+  }
+
+  bool MemorySnapshot::writeCrashReport(const std::filesystem::path& directory) const noexcept {
+    try {
+      const auto temporary = directory / "last_gpu_crash.json.tmp";
+      const auto destination = directory / "last_gpu_crash.json";
+      std::ofstream stream(temporary, std::ios::binary | std::ios::trunc);
+      stream << toJson("device_lost") << '\n';
+      stream.flush();
+      if (!stream) {
+        return false;
+      }
+      stream.close();
+      if (!stream) {
+        return false;
+      }
+#ifdef _WIN32
+      return MoveFileExW(temporary.c_str(), destination.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+      std::error_code error;
+      std::filesystem::rename(temporary, destination, error);
+      return !error;
+#endif
+    } catch (...) {
+      return false;
+    }
+  }
+
+}
