+
+namespace dxvk {
+
+  namespace {
+    void writeJsonString(std::ostream& stream, const char* text) {
+      constexpr char kHex[] = "0123456789abcdef";
+      stream << '"';
+      for (; *text; ++text) {
+        const auto c = static_cast<unsigned char>(*text);
+        if (c == '"' || c == '\\') {
+          stream << '\\' << static_cast<char>(c);
+        } else if (c < 0x20) {
+          stream << "\\u00" << kHex[c >> 4] << kHex[c & 0xf];
+        } else {
+          stream << static_cast<char>(c);
+        }
+      }
+      stream << '"';
+    }
+  }
+
+  std::string OmmBudgetDrop::toLog(uint64_t suppressed) const {
+    std::ostringstream stream;
+    stream.imbue(std::locale::classic());
+    stream << "[RTX Opacity Micromap] Free Vidmem dropped below a limit. Setting budget to 0."
+           << " Free VRAM: " << freeVram << " bytes, Previous budget: " << previousBudget
+           << " bytes, Used: " << used << " bytes, Hard free-VRAM limit: " << hardFreeVramLimit
+           << " bytes, Soft free-VRAM limit: " << softFreeVramLimit
+           << " bytes (suppressed repeats: " << suppressed << ')';
+    return stream.str();
+  }
+
+  std::string MemorySnapshot::toJson(const char* event, const char* reason) const {
+    const std::time_t timestamp = std::chrono::system_clock::to_time_t(time);
+    std::tm utc {};
+#ifdef _WIN32
+    gmtime_s(&utc, &timestamp);
+#else
+    gmtime_r(&timestamp, &utc);
+#endif
+    std::ostringstream stream;
+    stream.imbue(std::locale::classic());
+    stream << "{\"schema\":1,\"time_utc\":\"" << std::put_time(&utc, "%Y-%m-%dT%H:%M:%SZ")
+           << "\",\"event\":\"" << event << "\",\"frame\":" << frame << ",\"heaps\":[";
+    for (uint32_t i = 0; i < heapCount && i < heaps.size(); ++i) {
+      if (i) {
+        stream << ',';
+      }
+      stream << "{\"index\":" << i << ",\"budget\":" << heaps[i].budget << ",\"usage\":" << heaps[i].usage
+             << ",\"device_local\":" << (heaps[i].deviceLocal ? "true" : "false") << '}';
+    }
+    stream << "],\"driver\":{\"budget\":" << driverBudget << ",\"usage\":" << driverUsage
+           << "},\"dxvk\":{\"allocated\":" << allocated << ",\"used\":" << used << "},\"categories\":{";
+    constexpr std::array<const char*, CategoryCount> kCategoryNames = {
+      "app_buffer", "app_texture", "replacement_geometry", "buffer",
+      "acceleration_structure", "opacity_micromap", "material_texture", "render_target"
+    };
+    for (uint32_t i = 0; i < categories.size(); ++i) {
+      if (i) {
+        stream << ',';
+      }
+      stream << '"' << kCategoryNames[i] << "\":" << categories[i];
+    }
+    stream << "},\"omm_suppressed\":{\"budget_dropped\":" << ommBudgetDroppedSuppressed
+           << ",\"allocation_denied\":" << ommAllocationDeniedSuppressed << '}';
+    if (reason) {
+      stream << ",\"reason\":";
+      writeJsonString(stream, reason);
+    }
+    stream << '}';
+    return stream.str();
+  }
+
+  bool MemorySnapshot::writeCrashReport(const std::filesystem::path& directory, const char* reason) const noexcept {
+    try {
+#ifdef _WIN32
+      const auto processId = GetCurrentProcessId();
+#else
+      const auto processId = getpid();
+#endif
+      const auto temporary = directory / ("last_gpu_crash." + std::to_string(processId) + ".tmp");
+      const auto destination = directory / "last_gpu_crash.json";
+      const auto json = toJson("device_lost", reason) + '\n';
+#ifdef _WIN32
+      if (json.size() > MAXDWORD) {
+        return false;
+      }
+      const HANDLE file = CreateFileW(temporary.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+      if (file == INVALID_HANDLE_VALUE) {
+        return false;
+      }
+      DWORD written = 0;
+      const bool complete = WriteFile(file, json.data(), static_cast<DWORD>(json.size()), &written, nullptr)
+                         && written == json.size() && FlushFileBuffers(file);
+      const bool closed = CloseHandle(file) != 0;
+      if (complete && closed) {
+        // A scanner may briefly hold the old marker; limit added sleeps to 20 ms.
+        constexpr uint32_t kAttempts = 3;
+        for (uint32_t attempt = 0; attempt < kAttempts; ++attempt) {
+          if (MoveFileExW(temporary.c_str(), destination.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+            return true;
+          }
+          const DWORD error = GetLastError();
+          if (attempt + 1 == kAttempts || (error != ERROR_SHARING_VIOLATION && error != ERROR_ACCESS_DENIED)) {
+            break;
+          }
+          Sleep(10);
+        }
+      }
+      DeleteFileW(temporary.c_str());
+      return false;
+#else
+      std::ofstream stream(temporary, std::ios::binary | std::ios::trunc);
+      stream << json;
+      stream.flush();
+      if (!stream) {
+        stream.close();
+        std::error_code error;
+        std::filesystem::remove(temporary, error);
+        return false;
+      }
+      stream.close();
+      if (!stream) {
+        std::error_code error;
+        std::filesystem::remove(temporary, error);
+        return false;
+      }
+      std::error_code error;
+      std::filesystem::rename(temporary, destination, error);
+      if (!error) {
+        return true;
+      }
+      std::filesystem::remove(temporary, error);
+      return false;
+#endif
+    } catch (...) {
+      return false;
+    }
+  }
+
+}
