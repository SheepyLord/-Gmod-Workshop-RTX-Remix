+* FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+* DEALINGS IN THE SOFTWARE.
+*/
+#include "rtx_memory_stats.h"
+
+#include "../dxvk_device.h"
+#include "../../util/util_filesys.h"
+
+namespace dxvk {
+
+  MemorySnapshot RtxMemoryDiagnostics::capture() const {
+    MemorySnapshot snapshot;
+    snapshot.frame = m_device->getCurrentFrameId();
+    const auto heaps = m_device->adapter()->getMemoryHeapInfo();
+    snapshot.heapCount = heaps.heapCount;
+    static_assert(VK_MAX_MEMORY_HEAPS == 16);
+    constexpr std::array<DxvkMemoryStats::Category, MemorySnapshot::CategoryCount> kCategories = {
+      DxvkMemoryStats::AppBuffer, DxvkMemoryStats::AppTexture,
+      DxvkMemoryStats::RTXReplacementGeometry, DxvkMemoryStats::RTXBuffer,
+      DxvkMemoryStats::RTXAccelerationStructure, DxvkMemoryStats::RTXOpacityMicromap,
+      DxvkMemoryStats::RTXMaterialTexture, DxvkMemoryStats::RTXRenderTarget
+    };
+    for (uint32_t i = 0; i < heaps.heapCount; ++i) {
+      const auto& heap = heaps.heaps[i];
+      snapshot.heaps[i] = {heap.memoryBudget, heap.memoryAllocated};
+      if (!(heap.heapFlags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)) {
+        continue;
+      }
+      snapshot.driverBudget += heap.memoryBudget;
+      snapshot.driverUsage += heap.memoryAllocated;
+      const auto stats = m_device->getMemoryStats(i);
+      snapshot.allocated += stats.totalAllocated();
+      snapshot.used += stats.totalUsed();
+      for (uint32_t category = 0; category < kCategories.size(); ++category) {
+        snapshot.categories[category] += stats.usedByCategory(kCategories[category]);
+      }
+    }
+    return snapshot;
+  }
+
+  void RtxMemoryDiagnostics::onFrame(bool cameraCut) noexcept {
+    try {
+      if (m_schedule.update(m_device->getCurrentFrameId(), cameraCut, MemoryLogSchedule::Clock::now())) {
+        Logger::info(str::format("[RTX Memory] ", capture().toJson(cameraCut ? "camera_cut" : "periodic")));
+      }
+    } catch (...) {
+      // Diagnostics must not turn an allocation failure into a rendering failure.
+    }
+  }
+
+  void RtxMemoryDiagnostics::onDeviceLoss() const noexcept {
+    try {
+      const auto snapshot = capture();
+      // Preserve the marker even when formatting or emitting the log fails.
+      const bool written = snapshot.writeCrashReport(util::RtxFileSys::path(util::RtxFileSys::Logs));
+      Logger::err(str::format("[RTX Memory] ", snapshot.toJson("device_lost")));
+      if (!written) {
+        Logger::err("[RTX Memory] Could not write last_gpu_crash.json");
+      }
+    } catch (...) {
+      // Device-loss termination must run even if diagnostics run out of memory or disk.
+    }
+  }
+
+  void RtxMemoryDiagnostics::logOmmBudget(bool allocationDenied, uint64_t requested, uint64_t available, uint64_t budget) {
+    const auto suppressed = m_ommWarnings[allocationDenied ? 1 : 0].record(MemoryLogThrottle::Clock::now());
+    if (!suppressed) {
+      return;
+    }
+    if (allocationDenied) {
+      Logger::info(str::format("[RTX Opacity Micromap] Out of memory budget. Requested: ", requested,
+                              " bytes. Free: ", available, " bytes, Budget: ", budget,
+                              " bytes (suppressed repeats: ", *suppressed, ")"));
+    } else {
+      Logger::info(str::format("[RTX Opacity Micromap] Free Vidmem dropped below a limit. Setting budget to 0.",
+                              " (suppressed repeats: ", *suppressed, ")"));
+    }
+  }
+
+}
