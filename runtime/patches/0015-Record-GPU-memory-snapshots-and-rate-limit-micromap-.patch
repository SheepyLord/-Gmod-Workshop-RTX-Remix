+* THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+* LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+* FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+* DEALINGS IN THE SOFTWARE.
+*/
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <string>
+
+namespace dxvk {
+
+  class MemoryLogThrottle {
+  public:
+    using Clock = std::chrono::steady_clock;
+
+    std::optional<uint64_t> record(Clock::time_point now) {
+      if (m_nextLog && now < *m_nextLog) {
+        ++m_suppressed;
+        return std::nullopt;
+      }
+      const uint64_t suppressed = m_suppressed;
+      m_suppressed = 0;
+      m_nextLog = now + std::chrono::minutes(1);
+      return suppressed;
+    }
+
+  private:
+    std::optional<Clock::time_point> m_nextLog;
+    uint64_t m_suppressed = 0;
+  };
+
+  class MemoryLogSchedule {
+  public:
+    using Clock = std::chrono::steady_clock;
+
+    explicit MemoryLogSchedule(Clock::time_point now = Clock::now())
+      : m_nextPeriodic(now + std::chrono::minutes(5)) { }
+
+    bool update(uint32_t frame, bool cameraCut, Clock::time_point now) {
+      if (m_lastFrame && *m_lastFrame == frame) {
+        return false;
+      }
+      m_lastFrame = frame;
+      const bool periodic = now >= m_nextPeriodic;
+      if (periodic) {
+        m_nextPeriodic = now + std::chrono::minutes(5);
+      }
+      return cameraCut || periodic;
+    }
+
+  private:
+    Clock::time_point m_nextPeriodic;
+    std::optional<uint32_t> m_lastFrame;
+  };
+
+  struct MemorySnapshot {
+    struct Heap {
+      uint64_t budget = 0;
+      uint64_t usage = 0;
+    };
+
+    enum Category : uint32_t {
+      AppBuffer, AppTexture, ReplacementGeometry, Buffer,
+      AccelerationStructure, OpacityMicromap, MaterialTexture, RenderTarget, CategoryCount
+    };
+
+    uint32_t frame = 0;
+    uint32_t heapCount = 0;
+    std::array<Heap, 16> heaps {};
+    uint64_t allocated = 0;
+    uint64_t used = 0;
+    uint64_t driverBudget = 0;
+    uint64_t driverUsage = 0;
+    std::array<uint64_t, CategoryCount> categories {};
+
+    std::string toJson(const char* event) const;
+    bool writeCrashReport(const std::filesystem::path& directory) const noexcept;
+  };
+
+}
