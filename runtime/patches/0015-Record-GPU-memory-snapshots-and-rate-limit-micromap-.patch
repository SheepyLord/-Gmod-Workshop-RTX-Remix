+namespace dxvk {
+
+  class RtxMemoryDiagnostics : public CommonDeviceObject {
+  public:
+    explicit RtxMemoryDiagnostics(DxvkDevice* device) : CommonDeviceObject(device) { }
+
+    MemorySnapshot capture() const;
+    void onFrame(bool cameraCut) noexcept;
+    void onDeviceLoss(const char* reason = nullptr) const noexcept;
