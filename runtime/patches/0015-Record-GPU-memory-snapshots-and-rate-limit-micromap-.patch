+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <string>
+
+namespace dxvk {
+
+  class MemoryLogThrottle {
+  public:
+    using Clock = std::chrono::steady_clock;
+
+    std::optional<uint64_t> record(Clock::time_point now) {
+      if (m_nextLog && now < *m_nextLog) {
+        m_suppressed.fetch_add(1, std::memory_order_relaxed);
+        return std::nullopt;
+      }
+      const uint64_t suppressed = m_suppressed.exchange(0, std::memory_order_relaxed);
+      m_nextLog = now + std::chrono::minutes(1);
+      return suppressed;
+    }
+
+    uint64_t suppressed() const {
+      return m_suppressed.load(std::memory_order_relaxed);
+    }
+
+  private:
+    std::optional<Clock::time_point> m_nextLog;
+    std::atomic<uint64_t> m_suppressed { 0 };
+  };
+
+  class MemoryLogSchedule {
+  public:
+    using Clock = std::chrono::steady_clock;
+
+    explicit MemoryLogSchedule(Clock::time_point now = Clock::now())
+      : m_nextPeriodic(now + std::chrono::minutes(5)) { }
+
+    bool update(uint32_t frame, bool cameraCut, Clock::time_point now) {
+      if (m_lastFrame && *m_lastFrame == frame) {
+        return false;
+      }
+      m_lastFrame = frame;
+      const bool periodic = now >= m_nextPeriodic;
+      if (periodic) {
+        m_nextPeriodic = now + std::chrono::minutes(5);
+      }
+      return cameraCut || periodic;
+    }
+
+  private:
+    Clock::time_point m_nextPeriodic;
+    std::optional<uint32_t> m_lastFrame;
+  };
+
+  struct OmmBudgetDrop {
+    uint64_t freeVram;
+    uint64_t previousBudget;
+    uint64_t used;
+    uint64_t hardFreeVramLimit;
+    uint64_t softFreeVramLimit;
+
+    std::string toLog(uint64_t suppressed) const;
+  };
+
+  struct MemorySnapshot {
+    struct Heap {
+      uint64_t budget = 0;
+      uint64_t usage = 0;
+      bool deviceLocal = false;
+    };
+
+    enum Category : uint32_t {
+      AppBuffer, AppTexture, ReplacementGeometry, Buffer,
+      AccelerationStructure, OpacityMicromap, MaterialTexture, RenderTarget, CategoryCount
+    };
+
+    std::chrono::system_clock::time_point time = std::chrono::system_clock::now();
+    uint32_t frame = 0;
+    uint32_t heapCount = 0;
+    std::array<Heap, 16> heaps {};
+    uint64_t allocated = 0;
+    uint64_t used = 0;
+    uint64_t driverBudget = 0;
+    uint64_t driverUsage = 0;
+    uint64_t ommBudgetDroppedSuppressed = 0;
+    uint64_t ommAllocationDeniedSuppressed = 0;
+    std::array<uint64_t, CategoryCount> categories {};
+
+    std::string toJson(const char* event, const char* reason = nullptr) const;
+    bool writeCrashReport(const std::filesystem::path& directory, const char* reason = nullptr) const noexcept;
+  };
+
+}
