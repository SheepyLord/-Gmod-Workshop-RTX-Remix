@@ -0,0 +1,68 @@
+/* Copyright (c) 2026 native-loader contributors. SPDX-License-Identifier: MIT */
+#include <iostream>
+#include <limits>
+#include "../../../src/dxvk/rtx_render/rtx_eye_whites.h"
+#include "../../../src/dxvk/rtx_render/rtx_model_layers.h"
+#include "../../../src/dxvk/rtx_render/rtx_materials.h"
+#include "../../../src/dxvk/shaders/rtx/utility/adaptive_emission.h"
+namespace dxvk { Logger Logger::s_instance("test_eye_whites.log"); }
+int main() {
+  using namespace dxvk;
+  const auto require = [](bool ok, const char* message) {
+    if (!ok) { std::cerr << message << '\n'; std::exit(1); }
+  };
+  const auto registry = parseEyeWhiteAliases("0x0000000000000001=0x0000000000000002,0x0000000000000003=0x0000000000000002");
+  require(registry.size() == 2 && registry.at(1) == 2 && registry.at(3) == 2 && !registry.count(2),
+    "Only the eye identities, never their shared face atlas, may be automatic emitters");
+  for (const auto text : {"1=2", "0x0000000000000000=0x0000000000000002", "0x0000000000000001=0x0000000000000001",
+      "0x0000000000000001=0x0000000000000002,", "0x000000000000000g=0x0000000000000002",
+      "0x0000000000000001=0x0000000000000002,0x0000000000000001=0x0000000000000003",
+      "0x0000000000000001=0x0000000000000002,0x0000000000000002=0x0000000000000003"}) {
+    require(parseEyeWhiteAliases(text).empty(), "Malformed, conflicting or chained aliases must fail closed");
+  }
+  require(parseEyeWhiteAliases(std::string(73729, 'x')).empty(), "Registry must be bounded");
+  OpaqueMaterialData automatic;
+  automatic.setRoughnessConstant(.72f);
+  automatic.setOpacityConstant(.6f);
+  applyAutomaticEyeWhite(automatic);
+  require(automatic.getEnableEmission() && automatic.getEmissiveAdaptiveIntensity() == .625f &&
+      automatic.getEmissiveIntensity() == 0.f && !automatic.getEmissiveAlphaMask(), "Wrong automatic emission inputs");
+  require(automatic.getRoughnessConstant() == .72f && automatic.getOpacityConstant() == .6f,
+    "Eye correction must preserve the original material's lighting/coverage inputs");
+  require(automatic.getEmissiveColorConstant().x == 1.f && automatic.getEmissiveColorTint().x == 1.f,
+    "Automatic emission must use the original albedo without the legacy red tint");
+  const float nan = std::numeric_limits<float>::quiet_NaN();
+  require(eyeWhiteBrightness(-1.f) == 0.f && eyeWhiteBrightness(3.f) == 2.f && eyeWhiteBrightness(nan) == 1.f,
+    "Brightness must be finite and clamped");
+  for (float luminance : {0.f, .0001f, .05f, .18f, 5.f, 64.f}) {
+    const float pack = .025f / .6f * adaptiveEmissionIntensity(.6f, 15.f, true, luminance);
+    const float unscaled = adaptiveEmissionIntensity(0.f, automatic.getEmissiveAdaptiveIntensity(), true, luminance);
+    require(std::abs(pack - unscaled) < .00001f, "Automatic emission must equal C-16's normalized Robin sclera");
+    for (float scale : {0.f, 1.f, 2.f}) {
+      require(std::abs(adaptiveEmissionIntensity(0.f, .625f, true, luminance * eyeWhiteBrightness(scale)) - unscaled * scale) < .00001f,
+        "0/100/200 percent must scale emission once");
+    }
+  }
+  RtxOptionLayer::initializeSystemLayers();
+  EyeWhiteAliasCopy categories;
+  RtxModelLayers::eyeWhiteAliasesObject().setImmediately("0x0000000000000001=0x0000000000000002");
+  categories.refresh();
+  require(categories.original(1) == 2 && categories.original(7) == 7,
+    "D3D9 category snapshot must inherit the original atlas's alpha and normal categories");
+  EyeWhiteAliasCopy externalAliases;
+  externalAliases.refresh();
+  RtxModelLayers::eyeWhiteAliasesObject().setImmediately("");
+  categories.refresh();
+  externalAliases.refresh();
+  require(categories.original(1) == 1 && externalAliases.original(1) == 1,
+    "Removing an alias must refresh both D3D9 and external/CS snapshots");
+  const auto* derived = RtxOptionLayer::getDerivedLayer();
+  const auto* user = RtxOptionLayer::getUserLayer();
+  require(RtxModelLayers::eyeWhiteAliasesObject().getTargetLayer(user) == derived &&
+    RtxModelLayers::automaticEyeWhitesObject().getTargetLayer(user) == derived &&
+    RtxModelLayers::eyeWhiteBrightnessObject().getTargetLayer(user) == derived, "All companion eye options must be NoSave");
+  require(bool(RtxModelLayers::eyeWhiteAliasesObject().getFlags() & RtxOptionFlags::InvalidatesDrawcallTranslation) &&
+    bool(RtxModelLayers::automaticEyeWhitesObject().getFlags() & RtxOptionFlags::InvalidatesDrawcallTranslation),
+    "Changing aliases or automatic correction must invalidate preserved translation");
+  return 0;
+}
