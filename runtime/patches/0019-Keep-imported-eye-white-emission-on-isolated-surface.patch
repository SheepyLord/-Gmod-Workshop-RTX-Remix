diff --git a/src/dxvk/rtx_render/rtx_eye_whites.h b/src/dxvk/rtx_render/rtx_eye_whites.h
new file mode 100644
index 00000000..ae1c35bb
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_eye_whites.h
@@ -0,0 +1,88 @@
+/* Copyright (c) 2026 native-loader contributors. SPDX-License-Identifier: MIT */
+#pragma once
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <limits>
+#include <mutex>
+#include "../../util/util_vector.h"
+#include "rtx_model_layers.h"
+
+namespace dxvk {
+  // Strict, bounded, non-chaining aliases. Malformed input fails closed; ambiguous keys are dropped.
+  // A caller must never register the shared face atlas as a key (only an eye-only texture identity).
+  using EyeWhiteAliases = std::unordered_map<uint64_t, uint64_t>;
+  inline EyeWhiteAliases parseEyeWhiteAliases(std::string_view text) {
+    EyeWhiteAliases aliases;
+    if (text.size() > 73728) return aliases;
+    auto hash = [](std::string_view value, uint64_t& out) {
+      if (value.size() != 18 || value.substr(0, 2) != "0x") return false;
+      const auto parsed = std::from_chars(value.data() + 2, value.data() + value.size(), out, 16);
+      return parsed.ec == std::errc{} && parsed.ptr == value.data() + value.size() && out != 0;
+    };
+    while (!text.empty()) {
+      const auto comma = text.find(',');
+      auto item = text.substr(0, comma);
+      uint64_t proxy = 0, original = 0;
+      if (item.size() != 37 || item[18] != '=' || !hash(item.substr(0, 18), proxy) ||
+          !hash(item.substr(19), original) || proxy == original || aliases.count(proxy)) return {};
+      aliases.emplace(proxy, original);
+      if (aliases.size() > 1992) return {};
+      if (comma == std::string_view::npos) break;
+      text.remove_prefix(comma + 1);
+      if (text.empty()) return {};
+    }
+    for (const auto& entry : aliases) if (aliases.count(entry.second)) return {};
+    return aliases;
+  }
+
+  // Per-owner snapshot: D3D9 prepares ahead of dxvk-cs, so never retain a live option string/map
+  // across threads. A stable draw only reads the revision; parsing/copying holds the update mutex.
+  class EyeWhiteAliasCopy {
+  public:
+    void refresh() {
+      if (RtxModelLayers::eyeWhiteAliasesObject().getResolvedRevision() == m_revision) return;
+      std::lock_guard<std::mutex> lock(RtxOptionImpl::getUpdateMutex());
+      refreshLocked();
+    }
+    void refreshLocked() {
+      const auto& option = RtxModelLayers::eyeWhiteAliasesObject();
+      const auto revision = option.getResolvedRevision();
+      if (revision != m_revision) {
+        m_aliases = parseEyeWhiteAliases(option.getValueNoLock());
+        m_revision = revision;
+      }
+    }
+    uint64_t original(uint64_t hash) const {
+      RtxModelLayers::eyeWhiteAliasesObject().tagInvalidationScope();
+      const auto found = m_aliases.find(hash);
+      return found == m_aliases.end() ? hash : found->second;
+    }
+  private:
+    uint64_t m_revision = std::numeric_limits<uint64_t>::max();
+    EyeWhiteAliases m_aliases;
+  };
+
+  inline float eyeWhiteBrightness(float value) {
+    return std::isfinite(value) ? std::min(std::max(value, 0.f), 2.f) : 1.f;
+  }
+
+  // C-16: sclera class weight .025, published fallback .6, normalized map / .6, R = 25.
+  // .025 / .6 * (.6 * 25) = .625 times the eye's original linear albedo.
+  constexpr float kAutomaticEyeWhiteIntensity = 0.625f;
+
+  template<typename Opaque>
+  void applyAutomaticEyeWhite(Opaque& material) {
+    material.setEnableEmission(true);
+    material.setEmissiveColorTexture(material.getAlbedoOpacityTexture());
+    material.setEmissiveColorConstant(Vector3(1.f));
+    material.setEmissiveColorTint(Vector3(1.f));
+    material.setEmissiveAlphaMask(false);
+    material.setEmissiveIntensity(0.f); // disabling scene adaptation must not introduce a fixed night glow
+    material.setEmissiveAdaptiveIntensity(kAutomaticEyeWhiteIntensity);
+  }
+}
