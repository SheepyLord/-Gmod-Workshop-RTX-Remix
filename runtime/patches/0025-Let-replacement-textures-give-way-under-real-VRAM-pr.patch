+  // NV-DXVK start: R13 replacement textures give way under real memory pressure
+  static size_t calcConfiguredTextureBudget_Megabytes(DxvkDevice* device);
+
+  // Headroom of the largest device-local heap, where textures live, in MiB: the driver's live
+  // budget minus what the process uses there (less DXVK's free chunk space, which new
+  // allocations reuse). Negative when the driver holds the process over its budget.
+  static TextureBudgetPressure calcTexturePressure(DxvkDevice* device) {
+    TextureBudgetPressure pressure;
+    const VkPhysicalDeviceMemoryProperties memory = device->adapter()->memoryProperties();
+    const DxvkAdapterMemoryInfo memHeapInfo = device->adapter()->getMemoryHeapInfo();
+    VkDeviceSize largest = 0;
+    for (uint32_t i = 0; i < memory.memoryHeapCount; i++) {
+      if (!(memory.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) || memory.memoryHeaps[i].size <= largest) {
+        continue;
+      }
+      largest = memory.memoryHeaps[i].size;
+      const DxvkMemoryStats stats = device->getMemoryStats(i);
+      const int64_t retainedMib = int64_t(stats.totalAllocated() >> 20) - int64_t(stats.totalUsed() >> 20);
+      pressure.budgetMib = int64_t(memHeapInfo.heaps[i].memoryBudget >> 20);
+      pressure.usedMib = int64_t(memHeapInfo.heaps[i].memoryAllocated >> 20) - std::max<int64_t>(retainedMib, 0);
+      pressure.known = pressure.budgetMib > 0;
+    }
+    for (uint32_t i = 0; i < memory.memoryHeapCount; i++) {
+      if (memory.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) {
+        pressure.textureMib += int64_t(device->getMemoryStats(i).usedByCategory(DxvkMemoryStats::Category::RTXMaterialTexture) >> 20);
+      }
+    }
+    return pressure;
+  }
+
+  // The configured budget (percentage or fixed) where memory is free. Under real pressure it is
+  // capped: within the margin below the driver's budget textures stop growing, and over it they
+  // give back the overflow plus the margin. Nothing changes while the margin is free.
   static size_t calcTextureMemoryBudget_Megabytes(DxvkDevice* device) {
+    constexpr int64_t MinBudgetMib = 32;
+    const size_t configured = calcConfiguredTextureBudget_Megabytes(device);
+    const TextureBudgetPressure pressure = calcTexturePressure(device);
+    const int64_t limit = textureBudgetPressureLimitMib(pressure, MinBudgetMib);
+    g_lastTextureBudget = { pressure, configured, limit };
+    return limit < 0 ? configured : std::min(configured, size_t(limit));
+  }
+
+  // At a change of regime (free, within the margin, over the budget), every 10 s under pressure
+  // and every 5 minutes otherwise.
+  static void logTextureBudget(size_t budgetBytes, size_t requestedBytes, size_t prioritized, size_t demoted) {
+    static std::chrono::steady_clock::time_point s_last = {};
+    static int s_lastRegime = -2;
+    const TextureBudgetPressure& pressure = g_lastTextureBudget.pressure;
+    const int regime = !pressure.known ? -1
+                     : pressure.headroomMib() >= pressure.marginMib() ? 0
+                     : pressure.headroomMib() >= 0 ? 1 : 2;
+    const auto now = std::chrono::steady_clock::now();
+    const auto interval = regime >= 1 ? std::chrono::seconds(10) : std::chrono::seconds(300);
+    if (regime == s_lastRegime && now - s_last < interval) {
+      return;
+    }
+    s_lastRegime = regime;
+    s_last = now;
+    static const char* const kRegimes[] = { "unknown", "free", "margin", "over" };
+    Logger::info(str::format("[RTX Texture Budget] {\"regime\":\"", kRegimes[regime + 1],
+      "\",\"budget_bytes\":", budgetBytes, ",\"configured_mib\":", g_lastTextureBudget.configuredMib,
+      ",\"pressure_limit_mib\":", g_lastTextureBudget.limitMib,
+      ",\"fixed\":", RtxOptions::TextureManager::fixedBudgetEnable() ? "true" : "false",
+      ",\"percentage\":", RtxOptions::TextureManager::budgetPercentageOfAvailableVram(),
+      ",\"driver_budget_mib\":", pressure.budgetMib, ",\"driver_used_mib\":", pressure.usedMib,
+      ",\"texture_mib\":", pressure.textureMib, ",\"requested_bytes\":", requestedBytes,
+      ",\"prioritized\":", prioritized, ",\"demoted\":", demoted, "}"));
+  }
+
+  static size_t calcConfiguredTextureBudget_Megabytes(DxvkDevice* device) {
+  // NV-DXVK end
     constexpr int MinBudgetMib = 32;
 
     if (RtxOptions::TextureManager::fixedBudgetEnable()) {
