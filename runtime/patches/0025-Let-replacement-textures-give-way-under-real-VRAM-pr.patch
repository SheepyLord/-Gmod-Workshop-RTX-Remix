+#pragma once
+
+// R13: the replacement texture budget under real memory pressure. Pure, for the unit tests.
+
+#include <algorithm>
+#include <cstdint>
+
+namespace dxvk {
+
+  struct TextureBudgetPressure {
+    bool    known = false;   // the driver reported a budget for the heap textures live on
+    int64_t budgetMib = 0;   // the driver's live budget of the largest device-local heap
+    int64_t usedMib = 0;     // the process's use of that heap, less DXVK's free chunk space
+    int64_t textureMib = 0;  // replacement textures (RTXMaterialTexture) resident now
+
+    int64_t headroomMib() const {
+      return budgetMib - usedMib;
+    }
+
+    // Kept free below the driver's budget: 2 % of it, at least 256 MiB.
+    int64_t marginMib() const {
+      return std::max<int64_t>(256, budgetMib / 50);
+    }
+  };
+
+  // -1 while the margin is free: the configured budget applies unchanged. Otherwise the most
+  // the replacement textures may hold: their current size within the margin (no growth), and
+  // their size less the overflow and the margin when the driver holds the process over budget.
+  inline int64_t textureBudgetPressureLimitMib(const TextureBudgetPressure& pressure, int64_t minimumMib) {
+    if (!pressure.known) {
+      return -1;
+    }
+    const int64_t headroom = pressure.headroomMib();
+    const int64_t margin = pressure.marginMib();
+    if (headroom >= margin) {
+      return -1;
+    }
+    const int64_t limit = headroom >= 0 ? pressure.textureMib : pressure.textureMib + headroom - margin;
+    return std::max(limit, minimumMib);
+  }
+
+}
