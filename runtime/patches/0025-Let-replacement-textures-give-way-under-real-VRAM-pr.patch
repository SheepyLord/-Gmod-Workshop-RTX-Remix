+#include "../../../src/dxvk/rtx_render/rtx_texture_budget.h"
+
+#include <cstdlib>
+#include <iostream>
+
+int main() {
+  using namespace dxvk;
+  const auto check = [](bool passed, const char* message) {
+    if (!passed) {
+      std::cerr << message << '\n';
+      std::exit(1);
+    }
+  };
+
+  TextureBudgetPressure p;
+  check(textureBudgetPressureLimitMib(p, 32) == -1, "Without a driver budget the configured budget applies");
+
+  // The lag report's field numbers (MiB): budget 29,770, process use 32,170 less ~1,300 free chunk
+  // space, replacement textures 10,320.
+  p = { true, 29770, 32170 - 1300, 10320 };
+  check(p.marginMib() == 595, "The margin is 2 % of the budget on a large card");
+  check(textureBudgetPressureLimitMib(p, 32) == 10320 - 1100 - 595,
+        "Over the budget, textures give back the overflow and the margin");
+
+  // Free memory (a 16 GB card using 8 GB): no limit, the configured budget is unchanged.
+  p = { true, 16000, 8000, 3000 };
+  check(textureBudgetPressureLimitMib(p, 32) == -1, "Free memory never limits the configured budget");
+  // Exactly the margin free: still unchanged.
+  p = { true, 16000, 16000 - 320, 3000 };
+  check(textureBudgetPressureLimitMib(p, 32) == -1, "A free margin keeps the configured budget");
+  // Inside the margin: textures may keep what they hold but not grow.
+  p = { true, 16000, 15900, 3000 };
+  check(textureBudgetPressureLimitMib(p, 32) == 3000, "Within the margin textures stop growing");
+  // A small card: the margin is at least 256 MiB.
+  p = { true, 7000, 6900, 1000 };
+  check(p.marginMib() == 256 && textureBudgetPressureLimitMib(p, 32) == 1000, "Small cards keep 256 MiB free");
+  // Far over the budget with few textures: never below the minimum.
+  p = { true, 7000, 12000, 500 };
+  check(textureBudgetPressureLimitMib(p, 32) == 32, "The limit never goes below the minimum budget");
+
+  std::cout << "texture budget pressure: all checks passed\n";
+  return 0;
+}
