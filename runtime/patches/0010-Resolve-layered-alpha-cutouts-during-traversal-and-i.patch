+{
+  RAY_HIT_INFO_CREATE_TRACE_RAY_HIT(rayHitInfo);
+  Ray ray = rayCreateEmpty();
+  ray.origin = WorldRayOrigin();
+  ray.direction = WorldRayDirection();
+  ray.coneRadius = rayPayload.coneRadius;
+  ray.spreadAngle = rayPayload.coneSpreadAngle;
+  ray.tMax = RayTCurrent();
+  if (rejectCutoutCandidate(ray, rayHitInfo))
+  {
+    IgnoreHit();
+  }
