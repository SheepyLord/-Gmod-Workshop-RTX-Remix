--- a/src/dxvk/shaders/rtx/algorithm/resolve.slangh
+++ b/src/dxvk/shaders/rtx/algorithm/resolve.slangh
@@ -46,6 +46,32 @@ static const uint numDecalResolveBins = 4;
 
 // Resolve Helper Functions
 
+bool rejectCutoutCandidate(Ray ray, RayHitInfo hit)
+{
+  if (cb.forceFirstHitInGBufferPass)
+  {
+    return false;
+  }
+  const RayInteraction interaction = rayInteractionCreate(ray, hit);
+  if (interaction.materialType != surfaceMaterialTypeOpaque)
+  {
+    return false;
+  }
+  const Surface surface = surfaces[uint(interaction.surfaceIndex)];
+  if (surface.isFullyOpaque || !surface.isBlendingDisabled || surface.alphaTestType == uint8_t(AlphaTestType::kAlways))
+  {
+    return false;
+  }
+  const OpaqueSurfaceMaterial material = opaqueSurfaceMaterialCreate(surfaceMaterials[surface.surfaceMaterialIndex]);
+  if (material.flags & OPAQUE_SURFACE_MATERIAL_FLAG_IS_RAYTRACED_RENDER_TARGET)
+  {
+    return false;
+  }
+  SurfaceInteraction point = surfaceInteractionCreate<SurfaceGenerateTangents>(surface, interaction, ray);
+  const OpaqueSurfaceMaterialInteraction evaluated = opaqueSurfaceMaterialInteractionCreate(material, surface, point, interaction);
+  return evaluated.opacity <= cb.resolveTransparencyThreshold;
+}
+
 bool isRayMaskEmpty(uint8_t rayMask)
 {
   return rayMask == 0;
