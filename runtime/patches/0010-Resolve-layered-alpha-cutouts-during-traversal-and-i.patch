+++ b/tests/rtx/unit/test_model_layers.cpp
@@ -0,0 +1,27 @@
+/*
+ * Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+ * SPDX-License-Identifier: MIT
+ */
+#include <iostream>
+#include "../../../src/dxvk/rtx_render/rtx_model_layers.h"
+
+namespace dxvk {
+  Logger Logger::s_instance("test_model_layers.log");
+}
+
+int main() {
+  using namespace dxvk;
+  RtxOptionLayer::initializeSystemLayers();
+  const auto* user = RtxOptionLayer::getUserLayer();
+  const auto* derived = RtxOptionLayer::getDerivedLayer();
+  if (!user || !derived || user == derived ||
+      RtxModelLayers::ignoredOutlineTexturesObject().getTargetLayer(user) != derived ||
+      RtxModelLayers::ignoreOutlineMeshesObject().getTargetLayer(user) != derived ||
+      !(RtxModelLayers::ignoredOutlineTexturesObject().getFlags() & RtxOptionFlags::InvalidatesDrawcallTranslation) ||
+      !(RtxModelLayers::ignoreOutlineMeshesObject().getFlags() & RtxOptionFlags::InvalidatesDrawcallTranslation)) {
+    std::cerr << "Outline controls must invalidate cached draws and remain outside persistent user settings\n";
+    return 1;
+  }
+  std::cout << "Outline option lifetime tests passed\n";
+  return 0;
+}
