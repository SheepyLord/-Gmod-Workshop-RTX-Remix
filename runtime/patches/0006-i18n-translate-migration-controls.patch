diff --git a/i18n/tools/test_embed.py b/i18n/tools/test_embed.py
index 6aebcbc7..4da9b055 100644
--- a/i18n/tools/test_embed.py
+++ b/i18n/tools/test_embed.py
@@ -9,6 +9,7 @@ from unittest.mock import patch
 
 import embed
 import po
+import update_strings
 
 
 class CatalogBuildTests(unittest.TestCase):
@@ -61,6 +62,23 @@ class CatalogBuildTests(unittest.TestCase):
         result, log = self.run_build([po.Entry('Hello', 'Bonjour')], '--allow-incomplete')
         self.assertEqual(result, 0, log)
 
+    def test_dynamic_migration_counts_have_catalog_messages_and_stable_labels(self):
+        root = Path(__file__).resolve().parents[2]
+        extractor = update_strings.Extractor()
+        extractor.scan_file(str(root / 'src/dxvk/imgui/dxvk_imgui.cpp'), 'src/dxvk/imgui/dxvk_imgui.cpp')
+        labels = ['Migrate developer settings to rtx.conf', 'Migrate user settings to user.conf']
+        counts = ['Developer settings to migrate: %u', 'User settings to migrate: %u']
+        for label in labels + counts:
+            self.assertIn(label, extractor.messages)
+        for count in counts:
+            self.assertIn('c-format', extractor.messages[count]['flags'])
+        for language in ('zh-CN', 'zh-TW', 'ja', 'ko', 'fr', 'ru'):
+            _, entries = po.parse(root / 'i18n' / (language + '.po'))
+            translations = {entry.msgid: entry.msgstr for entry in entries if not entry.obsolete}
+            for text in labels + counts:
+                self.assertTrue(translations.get(text), (language, text))
+                self.assertNotEqual(translations[text], text)
+
 
 if __name__ == '__main__':
     unittest.main()
