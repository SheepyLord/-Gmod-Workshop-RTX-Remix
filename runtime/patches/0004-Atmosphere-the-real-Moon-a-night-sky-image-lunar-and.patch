+void RtxAtmosphere::applyEclipses(AtmosphereArgs& args) const {
+  args.sunEclipseLight = 1.0f;
+  const MoonParams& moon = args.moons[0];
+  if ((args.skyTextureFlags & SKY_TEXTURE_ECLIPSES) == 0u || moon.enabled < 0.5f) {
+    return;
+  }
+
+  const Vector3 sunDir = normalizedOr(Vector3(args.sunDirection.x, args.sunDirection.y, args.sunDirection.z),
+                                      Vector3(0.0f, 1.0f, 0.0f));
+  const Vector3 moonDir = normalizedOr(Vector3(moon.direction.x, moon.direction.y, moon.direction.z),
+                                       Vector3(0.0f, 0.0f, 0.0f));
+  if (dot(moonDir, moonDir) < 0.5f) {
+    return;
+  }
+  // Same fallback as evalMoonDisk for an unset size.
+  const float moonRadius = (moon.angularRadius >= 0.001f) ? moon.angularRadius : 0.5f * dxvk::kDegreesToRadians;
+
+  // Solar: the drawn sun disc is sized from the Moon (eclipseSunScale), so the two always match the
+  // way the real ones nearly do. What the Moon covers is lost from every sunlit path at once (sky
+  // bakes, clouds, the sun light); a little light from outside the Moon's shadow always remains.
+  {
+    const float sunRadius = moonRadius * args.eclipseSunScale;
+    const float covered = discOverlapArea(sunRadius, moonRadius, angleBetween(sunDir, moonDir))
+                        / (dxvk::kPi * sunRadius * sunRadius);
+    const float floorLight = std::clamp(RtxAtmosphere::eclipseTotalityLight(), 0.0f, 1.0f);
+    const float light = floorLight + (1.0f - floorLight) * std::clamp(1.0f - covered, 0.0f, 1.0f);
+    args.sunEclipseLight = light;
+    args.sunIlluminance = args.sunIlluminance * light;
+  }
+
+  // Lunar: average the shadow over the Moon's disc and fold it into the albedo every moon-light path
+  // reads (sky coupling, halo, clouds, the distant light), so moonlight dims and reddens with the
+  // Moon. The disc itself is shaded per pixel in evalMoonDisk.
+  {
+    const float centre = angleBetween(Vector3(-sunDir.x, -sunDir.y, -sunDir.z), moonDir);
+    if (centre < (args.eclipsePenumbraScale + 1.0f) * moonRadius) {
+      constexpr int kRings = 6;
+      constexpr int kSpokes = 16;
+      Vector3 sum(0.0f, 0.0f, 0.0f);
+      float weight = 0.0f;
+      for (int ring = 0; ring < kRings; ++ring) {
+        const float r = (float(ring) + 0.5f) / float(kRings) * moonRadius;
+        for (int spoke = 0; spoke < kSpokes; ++spoke) {
+          const float a = 2.0f * dxvk::kPi * (float(spoke) + 0.5f) / float(kSpokes);
+          const float dx = centre + r * std::cos(a);
+          const float dy = r * std::sin(a);
+          sum = sum + lunarEclipseLight(std::sqrt(dx * dx + dy * dy), moonRadius, args) * r;
+          weight += r;
+        }
+      }
+      const Vector3 light = sum * (1.0f / weight);
+      args.moons[0].color = vec3(moon.color.x * light.x, moon.color.y * light.y, moon.color.z * light.z);
+    }
+  }
+}
