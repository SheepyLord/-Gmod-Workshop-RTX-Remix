+namespace {
+  inline float lengthOf(const Vector3& v) {
+    return std::sqrt(dot(v, v));
+  }
+
+  inline Vector3 normalizedOr(const Vector3& v, const Vector3& fallback) {
+    const float len = lengthOf(v);
+    return (len > 1e-6f) ? v * (1.0f / len) : fallback;
+  }
+
+  // Angle between two unit vectors. atan2 of the cross and dot products stays accurate at the
+  // sub-degree separations eclipses work at, where acos of the dot product loses most of its bits.
+  inline float angleBetween(const Vector3& a, const Vector3& b) {
+    return std::atan2(lengthOf(cross(a, b)), dot(a, b));
+  }
+
+  // Area shared by two discs of radii r1 and r2 whose centres are d apart. The discs are a degree or
+  // two across, so the plane formula stands in for the spherical one.
+  float discOverlapArea(float r1, float r2, float d) {
+    if (d >= r1 + r2) {
+      return 0.0f;
+    }
+    if (d <= std::abs(r1 - r2)) {
+      const float r = std::min(r1, r2);
+      return dxvk::kPi * r * r;
+    }
+    const float a1 = std::acos(std::clamp((d * d + r1 * r1 - r2 * r2) / (2.0f * d * r1), -1.0f, 1.0f));
+    const float a2 = std::acos(std::clamp((d * d + r2 * r2 - r1 * r1) / (2.0f * d * r2), -1.0f, 1.0f));
+    const float k = (-d + r1 + r2) * (d + r1 - r2) * (d - r1 + r2) * (d + r1 + r2);
+    return r1 * r1 * a1 + r2 * r2 * a2 - 0.5f * std::sqrt(std::max(k, 0.0f));
+  }
+
+  // Sunlight reaching a point on the Moon `d` radians from the antisolar point (the centre of Earth's
+  // shadow), as an RGB fraction of full sunlight. CPU twin of evalLunarEclipseLight in
+  // atmosphere_sky.slangh: keep the two in lockstep.
+  Vector3 lunarEclipseLight(float d, float moonRadius, const AtmosphereArgs& args) {
+    const float umbra = args.eclipseUmbraScale * moonRadius;
+    const float penumbra = args.eclipsePenumbraScale * moonRadius;
+    const float edge = args.eclipseUmbraBrightness;
+    const Vector3 red(args.eclipseUmbraColor.x, args.eclipseUmbraColor.y, args.eclipseUmbraColor.z);
+    // The ozone layer passes blue light that grazes Earth's limb: a turquoise band along the umbra edge.
+    const Vector3 turquoise(0.35f, 0.75f, 1.0f);
+    if (d >= penumbra) {
+      return Vector3(1.0f, 1.0f, 1.0f);
+    }
+    if (d >= umbra) {
+      // Fraction of the sun's disc still visible from this point past Earth's limb.
+      const float t = (d - umbra) / (penumbra - umbra);
+      const float direct = t * t * (3.0f - 2.0f * t);
+      const float band = 1.5f * edge * std::exp(-t * t * 150.0f);
+      return Vector3(direct, direct, direct) + (red * edge + turquoise * band) * (1.0f - direct);
+    }
+    // Inside the umbra only refracted light arrives; deeper in it has crossed more air, so it is
+    // dimmer and redder.
+    const float x = (umbra > 0.0f) ? d / umbra : 0.0f;
+    const Vector3 deep(red.x * red.x, red.y * red.y, red.z * red.z);
+    const Vector3 tint = deep + (red - deep) * x;
+    const float band = 1.5f * edge * std::exp(-(1.0f - x) * (1.0f - x) * 150.0f);
+    return tint * (edge * (0.35f + 0.65f * x * x)) + turquoise * band;
+  }
+
+  // Folder holding the runtime's d3d9.dll; relative sky-texture paths resolve against it.
+  std::filesystem::path runtimeFolder() {
+    HMODULE module = nullptr;
+    wchar_t path[MAX_PATH] = {};
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            reinterpret_cast<LPCWSTR>(&runtimeFolder), &module)
+        || GetModuleFileNameW(module, path, MAX_PATH) == 0) {
+      return {};
+    }
+    return std::filesystem::path(path).parent_path();
+  }
+
+  std::string resolveSkyTexturePath(const std::string& option) {
+    if (option.empty()) {
+      return {};
+    }
+    std::filesystem::path path(option);
+    if (path.is_relative()) {
+      path = runtimeFolder() / path;
+    }
+    return path.lexically_normal().string();
+  }
+} // anonymous namespace
