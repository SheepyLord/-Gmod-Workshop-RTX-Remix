+void RtxAtmosphere::loadSkyTexture(Rc<DxvkContext> ctx, SkyTexture& tex, const std::string& option, const char* what) {
+  const std::string path = resolveSkyTexturePath(option);
+  if (path == tex.path) {
+    return;
+  }
+  tex.path = path;
+  tex.image = nullptr;
+  tex.view = nullptr;
+  if (path.empty()) {
+    return;
+  }
+
+  Rc<AssetData> asset = AssetDataManager::get().findAsset(path);
+  if (asset == nullptr) {
+    Logger::warn(str::format("[RTX Atmosphere] ", what, " texture missing or unreadable, keeping the procedural sky: ", path));
+    return;
+  }
+  const AssetInfo& info = asset->info();
+  const DxvkFormatInfo* formatInfo = imageFormatInfo(info.format);
+  if (info.type != AssetType::Image2D || info.mipLevels == 0 || formatInfo == nullptr) {
+    Logger::warn(str::format("[RTX Atmosphere] ", what, " texture is not a 2D DDS image: ", path));
+    return;
+  }
+
+  DxvkImageCreateInfo desc;
+  desc.type = VK_IMAGE_TYPE_2D;
+  desc.format = info.format;
+  desc.flags = 0;
+  desc.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+  desc.extent = VkExtent3D { info.extent.width, info.extent.height, 1 };
+  desc.numLayers = 1;
+  desc.mipLevels = info.mipLevels;
+  desc.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+  desc.stages = VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT
+              | VK_PIPELINE_STAGE_RAY_TRACING_SHADER_BIT_KHR;
+  desc.access = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+  desc.tiling = VK_IMAGE_TILING_OPTIMAL;
+  desc.layout = VK_IMAGE_LAYOUT_GENERAL;
+  Rc<DxvkImage> image = m_device->createImage(desc, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+                                              DxvkMemoryStats::Category::RTXMaterialTexture, what);
+
+  for (uint32_t level = 0; level < info.mipLevels; ++level) {
+    const void* data = asset->data(0, int(level));
+    if (data == nullptr) {
+      Logger::warn(str::format("[RTX Atmosphere] ", what, " texture has an unreadable mip ", level, ": ", path));
+      return;
+    }
+    // updateImage takes its pitches in bytes per row (and layer) of blocks.
+    const VkExtent3D levelExtent = util::computeMipLevelExtent(desc.extent, level);
+    const VkExtent3D blocks = util::computeBlockCount(levelExtent, formatInfo->blockSize);
+    const VkDeviceSize rowPitch = VkDeviceSize(blocks.width) * formatInfo->elementSize;
+    ctx->updateImage(image, VkImageSubresourceLayers { formatInfo->aspectMask, level, 0, 1 },
+                     VkOffset3D { 0, 0, 0 }, levelExtent, data, rowPitch, rowPitch * blocks.height);
+    asset->evictCache(0, int(level));
+  }
+  asset->releaseSource();
+
+  ctx->emitMemoryBarrier(0,
+                         VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_ACCESS_TRANSFER_WRITE_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_RAY_TRACING_SHADER_BIT_KHR,
+                         VK_ACCESS_SHADER_READ_BIT);
+
+  DxvkImageViewCreateInfo viewInfo;
+  viewInfo.type = VK_IMAGE_VIEW_TYPE_2D;
+  viewInfo.format = desc.format;
+  viewInfo.usage = VK_IMAGE_USAGE_SAMPLED_BIT;
+  viewInfo.aspect = formatInfo->aspectMask;
+  viewInfo.minLevel = 0;
+  viewInfo.numLevels = desc.mipLevels;
+  viewInfo.minLayer = 0;
+  viewInfo.numLayers = 1;
+  tex.image = image;
+  tex.view = m_device->createImageView(image, viewInfo);
+  Logger::info(str::format("[RTX Atmosphere] Loaded the ", what, " texture (", desc.extent.width, "x",
+                           desc.extent.height, ", ", desc.mipLevels, " mips): ", path));
+}
+
+void RtxAtmosphere::ensureSkyTextureStandIn(Rc<DxvkContext> ctx) {
+  if (m_skyTextureStandIn == nullptr) {
+    DxvkImageCreateInfo desc;
+    desc.type = VK_IMAGE_TYPE_2D;
+    desc.format = VK_FORMAT_R8G8B8A8_UNORM;
+    desc.flags = 0;
+    desc.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+    desc.extent = VkExtent3D { 1, 1, 1 };
+    desc.numLayers = 1;
+    desc.mipLevels = 1;
+    desc.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    desc.stages = VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT
+                | VK_PIPELINE_STAGE_RAY_TRACING_SHADER_BIT_KHR;
+    desc.access = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+    desc.tiling = VK_IMAGE_TILING_OPTIMAL;
+    desc.layout = VK_IMAGE_LAYOUT_GENERAL;
+    m_skyTextureStandIn = m_device->createImage(desc, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+                                                DxvkMemoryStats::Category::RTXMaterialTexture, "sky texture stand-in");
+    const uint32_t black = 0u;
+    ctx->updateImage(m_skyTextureStandIn, VkImageSubresourceLayers { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                     VkOffset3D { 0, 0, 0 }, desc.extent, &black, sizeof(black), sizeof(black));
+    ctx->emitMemoryBarrier(0,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_ACCESS_TRANSFER_WRITE_BIT,
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_RAY_TRACING_SHADER_BIT_KHR,
+                           VK_ACCESS_SHADER_READ_BIT);
+    DxvkImageViewCreateInfo viewInfo;
+    viewInfo.type = VK_IMAGE_VIEW_TYPE_2D;
+    viewInfo.format = desc.format;
+    viewInfo.usage = VK_IMAGE_USAGE_SAMPLED_BIT;
+    viewInfo.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    viewInfo.minLevel = 0;
+    viewInfo.numLevels = 1;
+    viewInfo.minLayer = 0;
+    viewInfo.numLayers = 1;
+    m_skyTextureStandInView = m_device->createImageView(m_skyTextureStandIn, viewInfo);
+  }
+}
+
+void RtxAtmosphere::loadSkyTextures(Rc<DxvkContext> ctx) {
+  ensureSkyTextureStandIn(ctx);
+
+  // Only what is switched on stays resident: the star map alone is tens of megabytes.
+  const bool moonTextures = RtxAtmosphere::moonTextureEnable();
+  loadSkyTexture(ctx, m_moonAlbedo, moonTextures ? RtxAtmosphere::moonAlbedoTexture() : std::string(), "Moon albedo");
+  loadSkyTexture(ctx, m_moonNormal, moonTextures ? RtxAtmosphere::moonNormalTexture() : std::string(), "Moon relief");
+  const bool starMap = RtxAtmosphere::starMapEnable();
+  loadSkyTexture(ctx, m_starMap, starMap ? RtxAtmosphere::starMapTexture() : std::string(), "night sky stars");
+  loadSkyTexture(ctx, m_starMapGalaxy, starMap ? RtxAtmosphere::starMapGalaxyTexture() : std::string(), "night sky galaxy");
+  loadSkyTexture(ctx, m_starMapNebula, starMap ? RtxAtmosphere::starMapNebulaTexture() : std::string(), "night sky nebula");
+}
