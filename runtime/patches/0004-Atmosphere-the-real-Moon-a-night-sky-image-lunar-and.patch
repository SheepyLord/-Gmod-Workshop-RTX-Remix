+// Moon 0 as the real Moon (fork — 2026-10-29). The point of the sphere under
+// viewDir is found on the disc, turned into selenographic latitude and
+// longitude for the albedo and relief maps, and lit by a sun the phase option
+// places: the phase sets the angle between sunlight and the view, the real
+// sun's place on the sky sets which limb is bright, so a waxing Moon after
+// sunset is lit from the west. The Moon's north points at the ecliptic pole,
+// which its spin axis nearly shares, so it tilts across the sky the way the
+// real one does. Returns radiance before the caller's edge coverage.
+vec3 evalTexturedMoon(vec3 viewDir, MoonParams m, vec3 moonDir, float moonRadius, AtmosphereArgs args) {
+  // Disc frame: north towards the ecliptic pole (RA 18h, dec +66.56 deg),
+  // east to the viewer's right (lunar east for an upright Moon).
+  vec3 P, M, W;
+  getCelestialFrame(args, P, M, W);
+  const float kEclipticPoleDec = 66.56f * kPi / 180.0f;
+  float poleHourAngle = getLocalSiderealTime(args) - 1.5f * kPi;
+  vec3 eclipticPole = sin(kEclipticPoleDec) * P
+                    + cos(kEclipticPoleDec) * (cos(poleHourAngle) * M + sin(poleHourAngle) * W);
+  vec3 north = eclipticPole - moonDir * dot(eclipticPole, moonDir);
+  if (dot(north, north) < 1e-6f) {
+    north = (abs(moonDir.y) < 0.999f) ? vec3(0.0f, 1.0f, 0.0f) - moonDir * moonDir.y : vec3(1.0f, 0.0f, 0.0f);
+  }
+  north = normalize(north);
+  vec3 east = cross(north, moonDir);
+
+  // Visible point of the unit sphere in (east, north, towards the viewer).
+  vec3 offset = viewDir - moonDir * dot(viewDir, moonDir);
+  vec2 disc = vec2(dot(offset, east), dot(offset, north)) / sin(moonRadius);
+  float r2 = dot(disc, disc);
+  if (r2 > 0.9999f) {
+    disc *= sqrt(0.9999f / r2);
+    r2 = 0.9999f;
+  }
+  float z = sqrt(1.0f - r2);
+  float lat = asin(clamp(disc.y, -1.0f, 1.0f));
+  float lon = atan2(disc.x, z);
+  vec2 uv = vec2(0.5f + lon / (2.0f * kPi), 0.5f - lat / kPi);
+
+  // Mip: one traced pixel spans skyPixelAngle / moonRadius of the disc, i.e.
+  // that many radians of longitude at the centre (this fraction of the map's
+  // width); foreshortening widens it towards the limb.
+  uint width, height;
+  AtmosphereMoonAlbedo.GetDimensions(width, height);
+  float limbLod = 0.5f * log2(1.0f / max(z, 0.05f));
+  float mapWidthPerPixel = args.skyPixelAngle / moonRadius / (2.0f * kPi);
+  float lod = max(log2(max(mapWidthPerPixel * float(width), 1e-4f)) + limbLod, 0.0f);
+  // The map is stored with its near-side mean linear luminance at 0.25.
+  const float kMoonMapNearSideMean = 0.25f;
+  vec3 albedo = AtmosphereMoonAlbedo.SampleLevel(AtmosphereSkyViewSampler, uv, lod).rgb
+              * (args.moonTextureAlbedo / kMoonMapNearSideMean);
+
+  vec3 n = vec3(disc, z);
+  if ((args.skyTextureFlags & SKY_TEXTURE_MOON_NORMAL) != 0u && args.moonReliefStrength > 0.0f) {
+    uint normalWidth, normalHeight;
+    AtmosphereMoonNormal.GetDimensions(normalWidth, normalHeight);
+    float normalLod = max(log2(max(mapWidthPerPixel * float(normalWidth), 1e-4f)) + limbLod, 0.0f);
+    vec2 slope = AtmosphereMoonNormal.SampleLevel(AtmosphereSkyViewSampler, uv, normalLod).rg * 2.0f - 1.0f;
+    vec3 tangentEast = vec3(cos(lon), 0.0f, -sin(lon));
+    vec3 tangentNorth = vec3(-sin(lat) * sin(lon), cos(lat), -sin(lat) * cos(lon));
+    n = normalize(n + (tangentEast * slope.x + tangentNorth * slope.y) * args.moonReliefStrength);
+  }
+
+  // Sunlight as seen from the Moon: phase angle 0 at full (from behind the
+  // viewer), pi at new; tilted towards where the sun is on the sky.
+  vec3 sunDir = normalize(args.sunDirection);
+  vec2 towardSun = vec2(dot(sunDir, east), dot(sunDir, north));
+  towardSun = (dot(towardSun, towardSun) > 1e-10f) ? normalize(towardSun) : vec2(1.0f, 0.0f);
+  float phaseAngle = abs(kPi - 2.0f * kPi * frac(m.phase));
+  vec3 toLight = vec3(towardSun * sin(phaseAngle), cos(phaseAngle));
+
+  // Lunar-Lambert: mostly Lommel-Seeliger, which gives the full Moon its flat,
+  // limb-bright face and hides relief at full, plus a little Lambert. The
+  // shadow line follows the smooth sphere, softened over about two pixels so it
+  // does not break into steps; the relief shades the lit side and darkens the
+  // slopes turned from the sun smoothly (softplus) instead of cutting single
+  // texels to black.
+  float pixelOnDisc = args.skyPixelAngle / moonRadius;
+  float terminatorWidth = clamp(2.0f * pixelOnDisc, 0.004f, 0.08f);
+  float terminator = smoothstep(-terminatorWidth, terminatorWidth, dot(vec3(disc, z), toLight));
+  float slopeSoftness = max(terminatorWidth, 0.02f);
+  float cosI = slopeSoftness * log(1.0f + exp(min(dot(n, toLight) / slopeSoftness, 30.0f)));
+  float cosE = max(n.z, 1e-3f);
+  float lit = terminator * (0.75f * 2.0f * cosI / (cosI + cosE) + 0.25f * cosI);
+
+  vec3 eclipse = vec3(1.0f);
+  if ((args.skyTextureFlags & SKY_TEXTURE_ECLIPSES) != 0u) {
+    eclipse = evalLunarEclipseLight(skyAngleBetween(viewDir, -sunDir), moonRadius, args);
+  }
+
+  // Earthshine lights the night side from the viewer's direction (flat under
+  // Lommel-Seeliger), strongest when the Moon is thinnest and Earth seen from
+  // it fullest.
+  float earthshine = m.darkSideBrightness * (0.5f - 0.5f * cos(phaseAngle));
+
+  vec3 moonAirTrans = getAtmosphericTransmittanceForDir(moonDir, args);
+  vec3 sunlit = args.sunIlluminance * moonAirTrans * (m.brightness / kPi);
+  return max(sunlit * albedo * (lit * eclipse + earthshine), vec3(0.0f));
+}
