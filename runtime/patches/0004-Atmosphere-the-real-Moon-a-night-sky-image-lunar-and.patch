+    if (m_starMap.view != nullptr)       args.skyTextureFlags |= SKY_TEXTURE_STAR_MAP;
+    if (m_starMapGalaxy.view != nullptr) args.skyTextureFlags |= SKY_TEXTURE_GALAXY;
+    if (m_starMapNebula.view != nullptr) args.skyTextureFlags |= SKY_TEXTURE_NEBULA;
+  }
+  if (RtxAtmosphere::eclipseEnable()) {
+    args.skyTextureFlags |= SKY_TEXTURE_ECLIPSES;
