 AtmosphereArgs RtxAtmosphere::getAtmosphereArgs() const {
   AtmosphereArgs args = {};
 
@@ -699,6 +986,36 @@ AtmosphereArgs RtxAtmosphere::getAtmosphereArgs() const {
     populateMoonParams(args.moons[i], i);
   }
 
+  // ----- Textured Moon, star map and eclipses (fork — 2026-10-29) -----
+  // A texture flag is set only once its file is resident, so the sky never samples a stand-in.
+  args.skyTextureFlags = 0u;
+  if (RtxAtmosphere::moonTextureEnable() && m_moonAlbedo.view != nullptr) {
+    args.skyTextureFlags |= SKY_TEXTURE_MOON_ALBEDO;
+    if (m_moonNormal.view != nullptr) {
+      args.skyTextureFlags |= SKY_TEXTURE_MOON_NORMAL;
