+  // Inside the umbra only refracted light arrives; deeper in it has crossed
+  // more air, so it is dimmer and redder.
+  float x = (umbra > 0.0f) ? d / umbra : 0.0f;
+  vec3 tint = mix(red * red, red, x);
+  float band = 1.5f * edge * exp(-(1.0f - x) * (1.0f - x) * 150.0f);
+  return tint * (edge * (0.35f + 0.65f * x * x)) + turquoise * band;
+}
