+// ============================================================================
+// Solar eclipse (fork — 2026-10-29)
+// ============================================================================
+// The sky has no sun disc of its own (the sun reads as the Mie aureole baked in
+// the sky-view LUT). While moon 0 nears the sun this draws one, sized from the
+// Moon by eclipseSunScale, plus the chromosphere and corona, all behind the
+// Moon's silhouette. Daylight itself (sky bakes, clouds, the sun light) is
+// already dimmed by the covered fraction through sunIlluminance; the disc
+// undoes that factor, because what is left of it keeps its full surface
+// brightness. Returns radiance to add over the sky, and moonMask = the Moon's
+// silhouette for hiding the stars that come out at totality.
+vec3 evalSolarEclipse(vec3 viewDir, AtmosphereArgs args, out float moonMask) {
+  moonMask = 0.0f;
+  MoonParams m = args.moons[0];
+  vec3 sunDir = normalize(args.sunDirection);
+  if (m.enabled < 0.5f || sunDir.y < -0.02f) {
+    return vec3(0.0f);
+  }
+  vec3 moonDir = normalize(m.direction);
+  float moonRadius = getMoonDiscRadius(m);
+  float sunRadius = moonRadius * args.eclipseSunScale;
+
+  // The disc fades in over the Moon's last two sun radii of approach.
+  float approach = 1.0f - smoothstep(sunRadius + moonRadius, 3.0f * sunRadius + moonRadius,
+                                     skyAngleBetween(sunDir, moonDir));
+  if (approach <= 0.0f) {
+    return vec3(0.0f);
+  }
+  const float kCoronaReach = 8.0f;  // sun radii
+  float fromSun = skyAngleBetween(viewDir, sunDir);
+  // Edges about two pixels wide: a one-pixel step from the disc to the dark
+  // Moon is the strongest contrast in any frame, and the upscaler rang on it
+  // into black pixels along the Moon's limb.
+  float edge = 2.0f * max(args.skyPixelAngle, 1e-5f);
+  moonMask = saturate((moonRadius - skyAngleBetween(viewDir, moonDir)) / edge + 0.5f);
+  if (fromSun > kCoronaReach * sunRadius) {
+    return vec3(0.0f);
+  }
+
+  // Centre radiance of a limb-darkened disc that integrates to the full
+  // (uneclipsed) illuminance, reddened by the air it shines through.
+  const float kLimbDarkening = 0.6f;
+  vec3 fullIlluminance = args.sunIlluminance / max(args.sunEclipseLight, 1e-6f);
+  vec3 discRadiance = fullIlluminance * getAtmosphericTransmittanceForDir(sunDir, args)
+                    / (kPi * sunRadius * sunRadius * (1.0f - kLimbDarkening / 3.0f));
+
+  float rho = fromSun / sunRadius;
+  float inDisc = saturate((sunRadius - fromSun) / edge + 0.5f);
+  float mu = sqrt(max(1.0f - min(rho * rho, 1.0f), 0.0f));
+  vec3 light = discRadiance * (inDisc * (1.0f - kLimbDarkening * (1.0f - mu)));
+
+  // Position angle about the sun, from celestial north.
+  vec3 P, M, W;
+  getCelestialFrame(args, P, M, W);
+  vec3 north = P - sunDir * dot(P, sunDir);
+  north = (dot(north, north) > 1e-6f) ? normalize(north) : vec3(0.0f, 0.0f, 1.0f);
+  vec3 east = cross(north, sunDir);
+  vec3 offset = viewDir - sunDir * dot(viewDir, sunDir);
+  float positionAngle = atan2(dot(offset, east), dot(offset, north));
+  vec2 around = vec2(cos(positionAngle), sin(positionAngle));
+  float outside = 1.0f - inDisc;
+
+  // Corona: the steep K-corona plus a longer F-corona tail, combed into
+  // streamers along the position angle and longest about the solar equator.
+  {
+    float r = max(rho, 1.0f);
+    float profile = 0.75f * pow(r, -5.0f) + 0.25f * pow(r, -2.2f);
+    float streamers = saturate(0.6f + 1.2f * fbmNoise3D(vec3(around * 3.0f, 0.15f * r), 3, 517.0f));
+    float equator = 0.55f + 0.45f * around.y * around.y;
+    float comb = mix(1.0f, 1.6f * streamers * equator, saturate((r - 1.0f) * 0.9f));
+    float reach = 1.0f - smoothstep(0.6f * kCoronaReach, kCoronaReach, r);
+    light += vec3(1.0f, 0.97f, 0.92f) * discRadiance
+           * (args.eclipseCoronaBrightness * profile * comb * reach * outside);
+  }
+
+  // Chromosphere and prominences: a thin rose rim flaring into small arcs,
+  // seen in the moments the Moon's edge runs just inside the sun's.
+  {
+    float rim = exp(-((rho - 1.0f) * (rho - 1.0f)) / (0.012f * 0.012f));
+    float flares = smoothstep(0.1f, 0.35f, fbmNoise3D(vec3(around * 14.0f, 0.0f), 2, 731.0f));
+    float arcs = flares * exp(-max(rho - 1.0f, 0.0f) / 0.035f) * step(1.0f, rho);
+    light += vec3(1.0f, 0.28f, 0.38f) * discRadiance
+           * (args.eclipseCoronaBrightness * 40.0f * (rim + 1.5f * arcs) * outside);
+  }
+
+  // Under the weather presets' sun (illuminance 20) the disc's centre is about
+  // 4e4, and near totality the sky around it has dimmed to a few per cent.
+  // From the dark Moon to that the upscaler rang into black and red pixels
+  // along the Moon's limb (the composite before it is clean), so the brightest
+  // channel is held to 64 times the daylight that is left, keeping the hue:
+  // still white on screen, the chromosphere still rose.
+  float daylight = max(max(args.sunIlluminance.x, args.sunIlluminance.y), args.sunIlluminance.z);
+  float peak = max(max(light.x, light.y), light.z);
+  light *= min(1.0f, 64.0f * max(daylight, 1e-4f) / max(peak, 1e-6f));
+  return light * (approach * (1.0f - moonMask));
+}
