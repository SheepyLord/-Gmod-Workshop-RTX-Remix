+  // ============================================================================
+
+  void test_stringReadsDuringResolve() {
+    std::cout << "  Running test_stringReadsDuringResolve..." << std::endl;
+    // Longer than the small-string buffer, so every value lives on the heap.
+    const std::string first(300, 'a');
+    const std::string second(500, 'b');
+    RtxOption<std::string>& text = TestOptions::textObject();
+    const RtxOptionLayer* userLayer = RtxOptionLayer::getUserLayer();
+    RenderThread render;
+
+    uint64_t reads = 0;
+    const auto end = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    while (std::chrono::steady_clock::now() < end) {
+      text.setDeferred((reads & 1) ? first : second, userLayer);
+      const std::string value = text.getCopy();
+      TEST_ASSERT(value.empty() || value == first || value == second,
+                  "a copy of the string option is torn: " << value.size() << " bytes");
+      ++reads;
+    }
+    render.stop();
+    text.setDeferred(first, userLayer);
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    TEST_ASSERT(text.getCopy() == first, "the last write was resolved");
+    std::cout << "    " << reads << " reads; PASSED" << std::endl;
+  }
