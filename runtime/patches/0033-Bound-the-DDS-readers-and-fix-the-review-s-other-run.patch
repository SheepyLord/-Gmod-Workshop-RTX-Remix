+	// NV-DXVK start: never read or copy past a DDS file's end (R19)
+	// GLI_ASSERT is empty in release builds, so nothing below may rely on it. A DDS file comes from any
+	// mod the runtime loads; its header decides how much is read and written. Both DDS readers (this
+	// one and the runtime's partial loader, rtx_dds_file_parser.h) check the header with
+	// dds_check_layout before they read a byte of the data.
+
+	// The most mip levels a reader takes: 16 make a 32768 texel side, the largest image a GPU creates.
+	// The partial loader's table of level sizes and GLI's texture cache (texture.hpp) both hold 16.
+	static std::uint32_t const dds_max_levels = 16;
+	// The most array layers: D3D11's and the usual Vulkan limit.
+	static std::uint32_t const dds_max_layers = 2048;
+	// The longest side: twice the largest a GPU creates. It keeps every size GLI computes in int.
+	static std::uint32_t const dds_max_side = 65536;
+
+	// What a DDS file's data holds, from its headers.
+	struct dds_layout
+	{
+		std::uint32_t Width;
+		std::uint32_t Height;
+		std::uint32_t Depth;	// a volume's depth, else 1
+		std::uint32_t Levels;	// 1 to dds_max_levels
+		std::uint32_t Layers;	// the DX10 header's array size, at least 1
+		std::uint32_t Faces;	// a cube map's faces (1 to 6), else 1
+		std::uint64_t LevelSize[dds_max_levels];	// bytes of each level of one face
+		std::uint64_t FaceSize;	// bytes of every level of one face
+		std::uint64_t Size;		// bytes of the data: FaceSize * Faces * Layers
+	};
+
+	inline bool dds_mul(std::uint64_t A, std::uint64_t B, std::uint64_t & Result)
+	{
+		if(A != 0 && B > UINT64_MAX / A)
+			return false;
+		Result = A * B;
+		return true;
+	}
+
+	inline bool dds_add(std::uint64_t A, std::uint64_t B, std::uint64_t & Result)
+	{
+		if(B > UINT64_MAX - A)
+			return false;
+		Result = A + B;
+		return true;
+	}
+
+	// Fills Layout from the headers. False for a format GLI does not know, a side of 0 or longer than
+	// dds_max_side, more mip levels than dds_max_levels or than the sides allow (floor(log2(longest
+	// side)) + 1), no cube face, more than dds_max_layers layers, or data larger than DataSize, the
+	// bytes after the headers. A mip count of 0 reads as 1, as Microsoft's DDS loaders read it. Sizes
+	// are summed in 64 bits with overflow checks; nothing is written past Layout.
+	inline bool dds_check_layout(dds_header const & Header, dds_header10 const & Header10, gli::format Format, std::uint64_t DataSize, dds_layout & Layout)
+	{
+		Layout = dds_layout();
+		if(!is_valid(Format))
+			return false;
+		std::uint64_t const BlockSize = block_size(Format);
+		ivec3 const BlockExtent = block_extent(Format);
+		if(BlockSize == 0 || BlockExtent.x < 1 || BlockExtent.y < 1 || BlockExtent.z < 1)
+			return false;
+
+		std::uint32_t const Width = Header.Width;
+		std::uint32_t const Height = Header.Height;
+		std::uint32_t const Depth = (Header.CubemapFlags & DDSCAPS2_VOLUME) ? Header.Depth : 1;
+		if(Width < 1 || Height < 1 || Depth < 1 || Width > dds_max_side || Height > dds_max_side || Depth > dds_max_side)
+			return false;
+
+		std::uint32_t const Levels = (Header.Flags & DDSD_MIPMAPCOUNT) ? std::max<std::uint32_t>(Header.MipMapLevels, 1) : 1;
+		std::uint32_t const Longest = std::max<std::uint32_t>(Width, std::max<std::uint32_t>(Height, Depth));
+		std::uint32_t LevelsAllowed = 1;
+		while((Longest >> LevelsAllowed) != 0)
+			++LevelsAllowed;
+		if(Levels > LevelsAllowed || Levels > dds_max_levels)
+			return false;
+
+		std::uint32_t Faces = 1;
+		if(Header.CubemapFlags & DDSCAPS2_CUBEMAP)
+			Faces = static_cast<std::uint32_t>(glm::bitCount(Header.CubemapFlags & DDSCAPS2_CUBEMAP_ALLFACES));
+		std::uint32_t const Layers = std::max<std::uint32_t>(Header10.ArraySize, 1);
+		if(Faces < 1 || Layers > dds_max_layers)
+			return false;
+
+		std::uint64_t FaceSize = 0;
+		for(std::uint32_t Level = 0; Level < Levels; ++Level)
+		{
+			std::uint64_t const BlocksX = (std::max<std::uint64_t>(Width >> Level, 1) + BlockExtent.x - 1) / BlockExtent.x;
+			std::uint64_t const BlocksY = (std::max<std::uint64_t>(Height >> Level, 1) + BlockExtent.y - 1) / BlockExtent.y;
+			std::uint64_t const BlocksZ = (std::max<std::uint64_t>(Depth >> Level, 1) + BlockExtent.z - 1) / BlockExtent.z;
+			std::uint64_t Blocks = 0;
+			std::uint64_t LevelSize = 0;
+			if(!dds_mul(BlocksX, BlocksY, Blocks) || !dds_mul(Blocks, BlocksZ, Blocks))
+				return false;
+			// GLI's storage multiplies a level's block counts in int.
+			if(Blocks > static_cast<std::uint64_t>(INT_MAX))
+				return false;
+			if(!dds_mul(Blocks, BlockSize, LevelSize) || !dds_add(FaceSize, LevelSize, FaceSize))
+				return false;
+			Layout.LevelSize[Level] = LevelSize;
+		}
+
+		std::uint64_t Size = 0;
+		if(!dds_mul(FaceSize, Faces, Size) || !dds_mul(Size, Layers, Size) || Size > DataSize)
+			return false;
+
+		Layout.Width = Width;
+		Layout.Height = Height;
+		Layout.Depth = Depth;
+		Layout.Levels = Levels;
+		Layout.Layers = Layers;
+		Layout.Faces = Faces;
+		Layout.FaceSize = FaceSize;
+		Layout.Size = Size;
+		return true;
+	}
+	// NV-DXVK end
 }//namespace detail
 
