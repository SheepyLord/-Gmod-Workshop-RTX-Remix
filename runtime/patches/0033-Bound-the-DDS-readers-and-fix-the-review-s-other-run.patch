+  // ============================================================================
+  // Test: Config refuses non-finite floats (R19)
+  // NaN passes every option's clamp (std::max/std::min keep it), so the float
+  // parser refuses "nan" and the infinities, and a float vector keeps its old
+  // value whole when any component is refused.
+  // ============================================================================
+
+  void test_configNonFiniteValues() {
+    std::cout << "  Running test_configNonFiniteValues..." << std::endl;
+
+    for (const char* text : { "nan", "NaN", "-nan", "inf", "-inf", "infinity", "1e39" }) {
+      float value = 0.25f;
+      TEST_ASSERT(!Config::parseOptionValue(text, value), std::string("Parsing '") + text + "' as a float should fail");
+      TEST_ASSERT(value == 0.25f, std::string("A refused '") + text + "' should leave the float unchanged");
+    }
+    float value = 0.25f;
+    TEST_ASSERT(Config::parseOptionValue("1e38", value) && value == 1e38f, "A large finite float should parse");
+
+    Vector2 v2(1.0f, 2.0f);
+    TEST_ASSERT(!Config::parseOptionValue("5, nan", v2), "A Vector2 with a NaN should fail");
+    TEST_ASSERT(v2.x == 1.0f && v2.y == 2.0f, "A refused Vector2 should keep its old value whole");
+    TEST_ASSERT(!Config::parseOptionValue("inf", v2), "A Vector2 promoted from inf should fail");
+    TEST_ASSERT(v2.x == 1.0f && v2.y == 2.0f, "A refused promoted Vector2 should keep its old value");
+
+    Vector3 v3(1.0f, 2.0f, 3.0f);
+    TEST_ASSERT(!Config::parseOptionValue("4, 5, nan", v3), "A Vector3 with a NaN should fail");
+    TEST_ASSERT(v3.x == 1.0f && v3.y == 2.0f && v3.z == 3.0f, "A refused Vector3 should keep its old value whole");
+    TEST_ASSERT(Config::parseOptionValue("4, 5, 6", v3) && v3.x == 4.0f && v3.y == 5.0f && v3.z == 6.0f,
+                "A finite Vector3 should still parse");
+
+    Vector4 v4(1.0f, 2.0f, 3.0f, 4.0f);
+    TEST_ASSERT(!Config::parseOptionValue("5, 6, 7, -inf", v4), "A Vector4 with an infinity should fail");
+    TEST_ASSERT(v4.x == 1.0f && v4.y == 2.0f && v4.z == 3.0f && v4.w == 4.0f, "A refused Vector4 should keep its old value whole");
+
+    // Through a config: the fallback stays.
+    Config config;
+    config.setOption("rtx.test.nanFloat", std::string("nan"));
+    TEST_ASSERT(config.getOption<float>("rtx.test.nanFloat", 1.5f) == 1.5f, "A NaN in a config should leave the fallback");
