+
+// R19 (H1): both DDS readers on crafted files. A mip count of 17 or more used to overwrite the partial
+// loader's object (its level table holds 16), and GLI's fallback copied as many bytes as a header
+// claimed from a buffer as large as the file. Every crafted file must be rejected without a write
+// outside the reader's object or a copy; valid files must keep their layout.
+
+#include "rtx_render/rtx_dds_file_parser.h"
+
+#include <gli/gli.hpp>
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace {
+
+  using namespace gli::detail;
+
+  void check(bool passed, const std::string& message) {
+    if (!passed) {
+      std::cerr << "FAILED: " << message << '\n';
+      std::exit(1);
+    }
+  }
+
+  // The headers of a crafted DDS file. Uncompressed formats go through the DX10 header (as DXGI
+  // formats), BC1 through the legacy DXT1 FourCC unless dx10 is set.
+  struct Spec {
+    uint32_t width = 4;
+    uint32_t height = 4;
+    uint32_t depth = 0;
+    uint32_t mips = 1;
+    bool mipFlag = true;
+    bool volume = false;
+    uint32_t cubeFlags = 0;
+    bool dx10 = true;
+    gli::dx::dxgi_format_dds dxgi = gli::dx::DXGI_FORMAT_R8G8B8A8_UNORM;
+    uint32_t arraySize = 0;
+  };
+
+  std::vector<char> headers(const Spec& spec) {
+    dds_header header {};
+    header.Size = sizeof(dds_header);
+    header.Flags = DDSD_CAPS | DDSD_HEIGHT | DDSD_WIDTH | DDSD_PIXELFORMAT
+                 | (spec.mipFlag ? DDSD_MIPMAPCOUNT : 0) | (spec.volume ? DDSD_DEPTH : 0);
+    header.Height = spec.height;
+    header.Width = spec.width;
+    header.Depth = spec.depth;
+    header.MipMapLevels = spec.mips;
+    header.Format.size = 32;
+    header.Format.flags = gli::dx::DDPF_FOURCC;
+    header.Format.fourCC = spec.dx10 ? gli::dx::D3DFMT_DX10 : gli::dx::D3DFMT_DXT1;
+    header.SurfaceFlags = DDSCAPS_TEXTURE | (spec.mips > 1 ? DDSCAPS_COMPLEX | DDSCAPS_MIPMAP : 0);
+    header.CubemapFlags = spec.cubeFlags | (spec.volume ? DDSCAPS2_VOLUME : 0);
+
+    std::vector<char> bytes(FOURCC_DDS, FOURCC_DDS + sizeof(FOURCC_DDS));
+    const char* h = reinterpret_cast<const char*>(&header);
+    bytes.insert(bytes.end(), h, h + sizeof(header));
+    if (spec.dx10) {
+      dds_header10 header10;
+      header10.Format = spec.dxgi;
+      header10.ResourceDimension = spec.volume ? D3D10_RESOURCE_DIMENSION_TEXTURE3D : D3D10_RESOURCE_DIMENSION_TEXTURE2D;
+      header10.ArraySize = spec.arraySize;
+      const char* h10 = reinterpret_cast<const char*>(&header10);
+      bytes.insert(bytes.end(), h10, h10 + sizeof(header10));
+    }
+    return bytes;
+  }
+
+  // The headers followed by dataBytes bytes of a recognizable pattern.
+  std::vector<char> file(const Spec& spec, size_t dataBytes) {
+    std::vector<char> bytes = headers(spec);
+    for (size_t i = 0; i < dataBytes; ++i) {
+      bytes.push_back(char(i * 7 + 3));
+    }
+    return bytes;
+  }
+
+  // DdsFileParser with its fields readable.
+  struct Probe : dxvk::DdsFileParser {
+    int levels() const { return m_levels; }
+    int layers() const { return m_layers; }
+    int faces() const { return m_faces; }
+    uint32_t depth() const { return m_depth; }
+    uint64_t dataOffset() const { return m_dataOffset; }
+    uint64_t dataSize() const { return m_dataSize; }
+    size_t faceSize() const { return m_sizeOfAllLevels; }
+    size_t levelSize(size_t level) const { return m_levelSizes[level]; }
+    size_t tableSize() const { return m_levelSizes.size(); }
+    bool place(int layer, int face, int level, uint64_t& offset, size_t& size) const {
+      return getDataPlacement(layer, face, level, offset, size);
+    }
+  };
+
+  constexpr uint64_t kCanary = 0xA5C3E1F00F1E3C5Aull;
+
+  // The parser between two canary blocks: a write past its level table reaches the fields after the
+  // table, and past the object the canary after it.
+  struct Guarded {
+    uint64_t before[32];
+    Probe probe;
+    uint64_t after[32];
+
+    Guarded() {
+      for (uint64_t& word : before) word = kCanary;
+      for (uint64_t& word : after) word = kCanary;
+    }
+
+    bool intact() const {
+      for (uint64_t word : before) if (word != kCanary) return false;
+      for (uint64_t word : after) if (word != kCanary) return false;
+      return true;
+    }
+
+    // Nothing recorded: a rejected file leaves the parser as it was constructed.
+    bool untouched() const {
+      if (probe.levels() != 0 || probe.layers() != 0 || probe.faces() != 0 || probe.faceSize() != 0 || probe.dataSize() != 0)
+        return false;
+      for (size_t level = 0; level < probe.tableSize(); ++level) {
+        if (probe.levelSize(level) != 0) return false;
+      }
+      return true;
+    }
+  };
+
+  struct Fixture {
+    std::filesystem::path directory;
+    int count = 0;
+
+    std::string write(const std::vector<char>& bytes) {
+      const std::filesystem::path path = directory / ("case" + std::to_string(count++) + ".dds");
+      std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+      stream.write(bytes.data(), std::streamsize(bytes.size()));
+      return path.string();
+    }
+  };
+
+  // Each reader must refuse the file: the partial loader without recording anything or writing outside
+  // itself, GLI (from memory and from the file) without a texture.
+  void expectRejected(Fixture& fixture, const std::vector<char>& bytes, const std::string& what) {
+    const std::string path = fixture.write(bytes);
+    {
+      auto guarded = std::make_unique<Guarded>();
+      check(!guarded->probe.parse(path), what + ": the partial loader accepted it");
+      check(guarded->intact(), what + ": the partial loader wrote outside its object");
+      check(guarded->untouched(), what + ": the partial loader recorded a layout");
+    }
+    check(gli::load_dds(bytes.empty() ? nullptr : bytes.data(), bytes.size()).empty(), what + ": GLI loaded it from memory");
+    check(gli::load_dds(path.c_str()).empty(), what + ": GLI loaded it from the file");
+  }
+
+  // Each reader must take the file with this layout. GLI's copy must hold the file's data.
+  void expectAccepted(Fixture& fixture, const std::vector<char>& bytes, const std::string& what,
+                      int levels, int layers, int faces, const std::vector<size_t>& levelSizes) {
+    const std::string path = fixture.write(bytes);
+    size_t faceSize = 0;
+    for (size_t size : levelSizes) faceSize += size;
+    const uint64_t dataSize = uint64_t(faceSize) * uint64_t(layers) * uint64_t(faces);
+
+    auto guarded = std::make_unique<Guarded>();
+    Probe& probe = guarded->probe;
+    check(probe.parse(path), what + ": the partial loader refused it");
+    check(guarded->intact(), what + ": the partial loader wrote outside its object");
+    check(probe.levels() == levels && probe.layers() == layers && probe.faces() == faces,
+          what + ": the partial loader read another shape");
+    for (size_t level = 0; level < levelSizes.size(); ++level) {
+      check(probe.levelSize(level) == levelSizes[level], what + ": level " + std::to_string(level) + " has another size");
+    }
+    check(probe.faceSize() == faceSize && probe.dataSize() == dataSize, what + ": another data size");
+    check(probe.dataOffset() + dataSize <= bytes.size(), what + ": the layout runs past the file");
+
+    // The last level of the last layer's last face ends where the data ends; past it nothing is placed.
+    uint64_t offset = 0;
+    size_t size = 0;
+    check(probe.place(layers - 1, faces - 1, levels - 1, offset, size) && offset + size == probe.dataOffset() + dataSize,
+          what + ": the last level is not at the end of the data");
+    check(!probe.place(layers, 0, 0, offset, size) && size == 0, what + ": a layer past the file was placed");
+    check(!probe.place(0, faces, 0, offset, size) && size == 0, what + ": a face past the file was placed");
+    check(!probe.place(0, 0, levels, offset, size) && size == 0, what + ": a level past the file was placed");
+    check(!probe.place(-1, 0, 0, offset, size) && size == 0, what + ": a negative layer was placed");
+
+    const gli::texture fromMemory = gli::load_dds(bytes.data(), bytes.size());
+    check(!fromMemory.empty(), what + ": GLI refused it from memory");
+    check(int(fromMemory.levels()) == levels && int(fromMemory.layers()) == layers && int(fromMemory.faces()) == faces,
+          what + ": GLI read another shape");
+    check(fromMemory.size() == dataSize, what + ": GLI holds another size");
+    check(std::memcmp(fromMemory.data(), bytes.data() + probe.dataOffset(), size_t(dataSize)) == 0,
+          what + ": GLI's copy differs from the file");
+    check(!gli::load_dds(path.c_str()).empty(), what + ": GLI refused it from the file");
+  }
+
+}
+
+int main(int argc, char** argv) {
+  if (argc != 2) {
+    std::cerr << "usage: test_dds_reader <fixture folder>\n";
+    return 1;
+  }
+  Fixture fixture { std::filesystem::path(argv[1]) };
+  std::filesystem::remove_all(fixture.directory);
+  std::filesystem::create_directories(fixture.directory);
+
+  // Valid files keep their layout. RGBA8 4x4 with 3 mips: 64 + 16 + 4 bytes.
+  Spec rgba;
+  rgba.mips = 3;
+  expectAccepted(fixture, file(rgba, 84), "RGBA8 4x4, 3 mips", 3, 1, 1, { 64, 16, 4 });
+  // Trailing bytes are ignored.
+  expectAccepted(fixture, file(rgba, 100), "RGBA8 4x4, 3 mips and trailing bytes", 3, 1, 1, { 64, 16, 4 });
+
+  // Legacy DXT1 8x8 with a mip count of 0: one level, as Microsoft's loaders read it (2x2 blocks of 8).
+  Spec dxt1;
+  dxt1.width = 8;
+  dxt1.height = 8;
+  dxt1.mips = 0;
+  dxt1.dx10 = false;
+  expectAccepted(fixture, file(dxt1, 32), "DXT1 8x8, mip count 0", 1, 1, 1, { 32 });
+
+  // A BC1 array: 3 layers of 8x8 with 4 mips (32, 8, 8, 8 bytes).
+  Spec array;
+  array.width = 8;
+  array.height = 8;
+  array.mips = 4;
+  array.dxgi = gli::dx::DXGI_FORMAT_BC1_UNORM;
+  array.arraySize = 3;
+  expectAccepted(fixture, file(array, 3 * 56), "BC1 array of 3", 4, 3, 1, { 32, 8, 8, 8 });
+
+  // A cube map: 6 faces of R8 4x4.
+  Spec cube;
+  cube.dxgi = gli::dx::DXGI_FORMAT_R8_UNORM;
+  cube.cubeFlags = DDSCAPS2_CUBEMAP | DDSCAPS2_CUBEMAP_ALLFACES;
+  expectAccepted(fixture, file(cube, 6 * 16), "R8 cube map", 1, 1, 6, { 16 });
+
+  // A volume: each level holds all of its slices (4x4x4, 2x2x2, 1x1x1 of R8). R18's partial loader
+  // left the depth out of the level sizes, so the uploader read a volume past what was checked.
+  Spec volume;
+  volume.dxgi = gli::dx::DXGI_FORMAT_R8_UNORM;
+  volume.volume = true;
+  volume.depth = 4;
+  volume.mips = 3;
+  {
+    const std::vector<char> bytes = file(volume, 73);
+    expectAccepted(fixture, bytes, "R8 volume 4x4x4", 3, 1, 1, { 64, 8, 1 });
+    Probe probe;
+    check(probe.parse(fixture.write(bytes)) && probe.depth() == 4, "R8 volume 4x4x4: the depth was lost");
+  }
+
+  // The most levels a reader takes: 16, for a 32768 texel side (R8 32768x1: 65535 bytes).
+  Spec longest;
+  longest.width = 32768;
+  longest.height = 1;
+  longest.mips = 16;
+  longest.dxgi = gli::dx::DXGI_FORMAT_R8_UNORM;
+  {
+    std::vector<size_t> sizes;
+    for (uint32_t level = 0; level < 16; ++level) sizes.push_back(32768u >> level);
+    expectAccepted(fixture, file(longest, 65535), "R8 32768x1, 16 mips", 16, 1, 1, sizes);
+  }
+
+  // The most layers: 2048 of R8 1x1.
+  Spec layers;
+  layers.width = 1;
+  layers.height = 1;
+  layers.dxgi = gli::dx::DXGI_FORMAT_R8_UNORM;
+  layers.arraySize = 2048;
+  expectAccepted(fixture, file(layers, 2048), "R8 1x1, 2048 layers", 1, 2048, 1, { 1 });
+
+  // Mip counts the level table cannot hold. 17 overwrote the table's neighbours (the data size, the
+  // file handle), 18 and more the object's vtable and beyond; 2^31 read as a negative count.
+  Spec many = rgba;
+  many.width = 64;
+  many.height = 64;
+  for (uint32_t mips : { 17u, 18u, 32u, 0x80000000u, 0xFFFFFFFFu }) {
+    many.mips = mips;
+    expectRejected(fixture, file(many, 1 << 20), "64x64 with " + std::to_string(mips) + " mips");
+  }
+  // 17 mips on a side that has 17 (65536): still more than the table.
+  Spec wide = longest;
+  wide.width = 65536;
+  wide.mips = 17;
+  expectRejected(fixture, file(wide, 131071), "R8 65536x1 with 17 mips");
+  // More mips than the sides allow: a 2x2 image has 2.
+  Spec small = rgba;
+  small.width = 2;
+  small.height = 2;
+  small.mips = 3;
+  expectRejected(fixture, file(small, 1024), "2x2 with 3 mips");
+
+  // Sides of 0, a volume of depth 0, a side past the limit.
+  Spec zero = rgba;
+  zero.mips = 1;
+  zero.width = 0;
+  expectRejected(fixture, file(zero, 1024), "width 0");
+  zero.width = 4;
+  zero.height = 0;
+  expectRejected(fixture, file(zero, 1024), "height 0");
+  Spec flat = volume;
+  flat.depth = 0;
+  flat.mips = 1;
+  expectRejected(fixture, file(flat, 1024), "volume of depth 0");
+  Spec huge = longest;
+  huge.width = 65537;
+  huge.mips = 1;
+  expectRejected(fixture, file(huge, 65537), "R8 65537x1");
+
+  // Short files. Before, GLI's fallback copied the header's 64 bytes from a buffer of 10.
+  Spec one = rgba;
+  one.mips = 1;
+  expectRejected(fixture, file(one, 10), "4x4 RGBA8 with 10 of its 64 bytes");
+  expectRejected(fixture, file(one, 63), "4x4 RGBA8 with 63 of its 64 bytes");
+  {
+    const std::vector<char> whole = file(one, 64);
+    expectRejected(fixture, std::vector<char>(whole.begin(), whole.begin() + 4 + 100), "a header cut short");
+    expectRejected(fixture, std::vector<char>(whole.begin(), whole.begin() + 4 + 124 + 10), "a DX10 header cut short");
+    expectRejected(fixture, std::vector<char>(whole.begin(), whole.begin() + 3), "3 bytes");
+    // An empty file: GLI's reader used to call strncmp on a null pointer.
+    expectRejected(fixture, std::vector<char>(), "an empty file");
+    std::vector<char> wrongMagic = whole;
+    wrongMagic[0] = 'X';
+    expectRejected(fixture, wrongMagic, "a wrong magic number");
+  }
+
+  // Array sizes the size check could overflow on, and more layers than any GPU takes.
+  Spec layered = rgba;
+  layered.mips = 1;
+  for (uint32_t arraySize : { 2049u, 0x10000u, 0x80000000u, 0xFFFFFFFFu }) {
+    layered.arraySize = arraySize;
+    expectRejected(fixture, file(layered, 1 << 20), "array size " + std::to_string(arraySize));
+  }
+  // A fitting array size with too little data.
+  layered.arraySize = 2048;
+  expectRejected(fixture, file(layered, 64 * 2047), "2048 layers with 2047 layers of data");
+
+  // A cube map with no face.
+  Spec faceless = cube;
+  faceless.cubeFlags = DDSCAPS2_CUBEMAP;
+  expectRejected(fixture, file(faceless, 1024), "a cube map with no face");
+
+#ifdef NDEBUG
+  // A format GLI does not know (GLI asserts on it in debug builds). Its block size was read from
+  // before GLI's format table.
+  Spec unknown = rgba;
+  unknown.dxgi = static_cast<gli::dx::dxgi_format_dds>(0x7000);
+  expectRejected(fixture, file(unknown, 1024), "an unknown format");
+#endif
+
+  // dds_check_layout writes nothing past its result.
+  {
+    struct GuardedLayout {
+      uint64_t before[8];
+      dds_layout layout;
+      uint64_t after[8];
+    } guarded;
+    for (uint64_t& word : guarded.before) word = kCanary;
+    for (uint64_t& word : guarded.after) word = kCanary;
+    std::vector<char> bytes = headers(many);
+    dds_header header;
+    std::memcpy(&header, bytes.data() + 4, sizeof(header));
+    dds_header10 header10;
+    std::memcpy(&header10, bytes.data() + 4 + sizeof(header), sizeof(header10));
+    for (uint32_t mips : { 16u, 17u, 18u, 0x80000000u }) {
+      header.Width = 65535;
+      header.Height = 1;
+      header.MipMapLevels = mips;
+      const bool accepted = dds_check_layout(header, header10, get_dds_format(header, header10), UINT64_MAX, guarded.layout);
+      check(accepted == (mips == 16), "dds_check_layout with " + std::to_string(mips) + " mips");
+      bool intact = true;
+      for (uint64_t word : guarded.before) intact = intact && word == kCanary;
+      for (uint64_t word : guarded.after) intact = intact && word == kCanary;
+      check(intact, "dds_check_layout wrote outside its result with " + std::to_string(mips) + " mips");
+    }
+  }
+
+  std::filesystem::remove_all(fixture.directory);
+  std::cout << "DDS reader tests passed (" << fixture.count << " files)\n";
+  return 0;
+}
