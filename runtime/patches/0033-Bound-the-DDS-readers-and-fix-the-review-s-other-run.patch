+#pragma once
+
+// The partial DDS loader's header reader: where each level of a DDS file's data is, without reading
+// the data (DdsTextureData in rtx_asset_data_manager.cpp maps the file and hands those ranges to the
+// texture uploader). NV-DXVK (R19): moved here from rtx_asset_data_manager.cpp so the unit test
+// (tests/rtx/unit/test_dds_reader.cpp) runs it on crafted files. A DDS file comes from any mod the
+// runtime loads, and its header used to index the level table unchecked (a mip count of 17 or more
+// overwrote the rest of this object and what follows it): the headers' layout is now checked against
+// the table and the file before anything is recorded (gli::detail::dds_check_layout).
+
+#include <array>
+#include <cassert>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include <gli/gli.hpp>
+
+#include "../../util/util_error.h"
+
+namespace dxvk {
+
+  class DdsFileParser {
+  public:
+    virtual ~DdsFileParser() {
+      closeHandle();
+    }
+
+    bool parse(const std::string& filename) {
+      using namespace gli::detail;
+
+      m_filename = filename;
+
+      if (openHandle() == nullptr)
+        return false;
+
+      // NV-DXVK start: never read or index past the file or the level table (R19). The size is 64-bit
+      // (ftell's long stops at 2 GB), every read is checked, and nothing is recorded unless the headers'
+      // whole layout fits in the table and in the file.
+      if (_fseeki64(m_file, 0, SEEK_END) != 0)
+        return false;
+      const int64_t fileSize = _ftelli64(m_file);
+      if (fileSize < 0 || _fseeki64(m_file, 0, SEEK_SET) != 0)
+        return false;
+
+      dds_header header;
+      dds_header10 header10;
+      uint64_t dataOffset = sizeof(FOURCC_DDS) + sizeof(header);
+
+      if (uint64_t(fileSize) < dataOffset)
+        return false;
+
+      char fourcc[sizeof(FOURCC_DDS)];
+      if (std::fread(fourcc, sizeof(fourcc), 1, m_file) != 1 || std::memcmp(fourcc, FOURCC_DDS, 4) != 0)
+        return false;
+
+      if (std::fread(&header, sizeof(header), 1, m_file) != 1)
+        return false;
+
+      if ((header.Format.flags & gli::dx::DDPF_FOURCC) &&
+          (header.Format.fourCC == gli::dx::D3DFMT_DX10 || header.Format.fourCC == gli::dx::D3DFMT_GLI1)) {
+        if (uint64_t(fileSize) < dataOffset + sizeof(header10) || std::fread(&header10, sizeof(header10), 1, m_file) != 1)
+          return false;
+        dataOffset += sizeof(header10);
+      }
+
+      const gli::format format = get_dds_format(header, header10);
+      dds_layout layout;
+      if (!dds_check_layout(header, header10, format, uint64_t(fileSize) - dataOffset, layout))
+        return false;
+
+      static_assert(std::tuple_size<decltype(m_levelSizes)>::value >= dds_max_levels,
+                    "The level table must hold every level dds_check_layout accepts");
+      m_fileSize = uint64_t(fileSize);
+      m_dataOffset = dataOffset;
+      m_format = format;
+      m_width = layout.Width;
+      m_height = layout.Height;
+      m_depth = layout.Depth;
+      m_levels = int(layout.Levels);
+      m_layers = int(layout.Layers);
+      m_faces = int(layout.Faces);
+      for (uint32_t level = 0; level < layout.Levels; ++level) {
+        m_levelSizes[level] = size_t(layout.LevelSize[level]);
+      }
+      m_sizeOfAllLevels = size_t(layout.FaceSize);
+      m_dataSize = layout.Size;
+      // NV-DXVK end
+
+      closeHandle();
+
+      return true;
+    }
+
+    FILE* openHandle() {
+      assert(!m_filename.empty() && "DDS filename cannot be empty");
+      if (m_file == nullptr) {
+        errno = 0;
+        m_file = std::fopen(m_filename.c_str(), "rb");
+
+        if (m_file == nullptr) {
+          if (errno == EMFILE) {
+            throw DxvkError("Unable to open a DDS file: too many open files. "
+                            "Please consider using AssetData::releaseSource() "
+                            "method to keep the number of open files low.");
+          }
+        }
+      }
+      return m_file;
+    }
+
+    void closeHandle() {
+      if (m_file) {
+        std::fclose(m_file);
+        m_file = nullptr;
+      }
+    }
+
+  protected:
+    std::string m_filename;
+
+    // NV-DXVK start: 64-bit file positions (R19)
+    uint64_t m_fileSize = 0;
+    // NV-DXVK end
+
+    uint32_t m_width = 0;
+    uint32_t m_height = 0;
+    uint32_t m_depth = 0;
+    gli::format m_format = gli::FORMAT_UNDEFINED;
+    // NV-DXVK start: 64-bit file positions (R19)
+    uint64_t m_dataOffset = 0;
+    // NV-DXVK end
+    int m_levels = 0;
+    int m_layers = 0;
+    int m_faces = 0;
+    std::array<size_t, gli::detail::dds_max_levels> m_levelSizes = {};
+    size_t m_sizeOfAllLevels = 0;
+    // NV-DXVK start: bytes of the whole data, every layer and face (R19)
+    uint64_t m_dataSize = 0;
+    // NV-DXVK end
+
+    // NV-DXVK start: false, with nothing placed, for a layer, face or level the file does not have (R19)
+    bool getDataPlacement(int layer, int face, int level, uint64_t& offset, size_t& size) const {
+      if (layer < 0 || layer >= m_layers || face < 0 || face >= m_faces || level < 0 || level >= m_levels) {
+        offset = 0;
+        size = 0;
+        return false;
+      }
+      const uint64_t linearFace = uint64_t(layer) * uint64_t(m_faces) + uint64_t(face);
+      offset = m_dataOffset + linearFace * m_sizeOfAllLevels;
+
+      for (int i = 0; i < level; ++i)
+        offset += m_levelSizes[i];
+
+      size = m_levelSizes[level];
+      return true;
+    }
+    // NV-DXVK end
+
+  private:
+    FILE* m_file = nullptr;
+  };
+
+} // namespace dxvk
