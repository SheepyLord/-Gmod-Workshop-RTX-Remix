+  require(static_cast<unsigned>(BlendType::kMaxValue) == 10, "The authored MDL blend-mode range must stay unchanged");
+  for (float alpha : {0.f, .125f, .5f, 1.f}) {
+    for (float transmission : {0.f, .2f, .8f, 1.f}) {
+      const float premultiplied = alpha * transmission;
+      const float nativeDestinationFactor = premultiplied + 1.f - alpha;
+      require(std::abs(legacyPremultipliedFilterOpacity(alpha, premultiplied) - (1.f - nativeDestinationFactor)) < 1e-6f,
+        "Filter opacity must reproduce the native destination factor, including zero-alpha backgrounds");
+    }
+  }
+  require(legacyPremultipliedFilterOpacity(.5f, 2.f) == 0.f && legacyPremultipliedFilterOpacity(2.f, 0.f) == 1.f,
+    "Legacy filter opacity must stay bounded");
   const auto* user = RtxOptionLayer::getUserLayer();
   const auto* derived = RtxOptionLayer::getDerivedLayer();
   for (auto* option : {&RtxGmodEffects::particleTexturesForSessionObject(),
