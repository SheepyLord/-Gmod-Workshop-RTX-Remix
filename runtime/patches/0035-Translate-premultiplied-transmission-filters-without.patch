 #pragma once
 
 #include "rtx/concept/surface/surface_shared.h"
+#include "rtx/utility/legacy_blending.h"
 
 // Double multiplicative colors this close to mid-grey count as fully transparent. Mid-grey is the "no change" color of
 // modulate 2x textures (decals_mod2x holds Source's blood and bullet hole decals), but 8 bit textures store it as 127 or 128
@@ -179,6 +180,10 @@ void calcOpaqueSurfaceMaterialOpacity(
     opacity = float(1.0f) - luminanceOpacity;
 
     break;
+  case uint(BlendType::kLegacyPremultipliedMultiplicative):
+    opacity = legacyPremultipliedFilterOpacity(alphaOpacity, luminanceOpacity);
+    break;
+
   case uint(BlendType::kDoubleMultiplicative):
     // Note: Double multiplicative blending is a version of multiplicative where the end result is multiplied by 2.
     // Approximate that by using a V-shaped function so that luminance = 0.5 means a transparent surface,
diff --git a/src/dxvk/shaders/rtx/utility/legacy_blending.h b/src/dxvk/shaders/rtx/utility/legacy_blending.h
new file mode 100644
index 00000000..f0e999f0
--- /dev/null
+++ b/src/dxvk/shaders/rtx/utility/legacy_blending.h
@@ -0,0 +1,11 @@
+/* Copyright (c) 2026 native-loader contributors. SPDX-License-Identifier: MIT */
+#pragma once
+
+// Dst * (premultipliedColor + 1 - alpha) transmits 1 - alpha + luminance(color).
+#ifdef __cplusplus
+constexpr
+#endif
+float legacyPremultipliedFilterOpacity(float alpha, float luminance) {
+  const float opacity = alpha - luminance;
+  return opacity < 0.0f ? 0.0f : (opacity > 1.0f ? 1.0f : opacity);
+}
