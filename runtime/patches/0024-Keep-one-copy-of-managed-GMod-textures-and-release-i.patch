+  bool D3D9DeviceEx::IsManagedTextureBound(const D3D9CommonTexture* pResource) const {
+    for (IDirect3DBaseTexture9* texture : m_state.textures) {
+      if (texture != nullptr && GetCommonTexture(texture) == pResource) {
+        return true;
+      }
+    }
+    return false;
+  }
