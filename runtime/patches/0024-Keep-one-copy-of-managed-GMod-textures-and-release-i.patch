+* DEALINGS IN THE SOFTWARE.
+*/
+#pragma once
+
+// Policy for the memory of static managed textures (R13): one copy of each texture's data,
+// and GPU images released when they hold more than a budget and were not used for a while.
+// Pure functions, so the unit tests can check the rules without a device.
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace dxvk::managed_memory {
+
+  constexpr uint64_t kMiB = 1ull << 20;
+  constexpr uint64_t kGiB = 1ull << 30;
+
+  // The R13 plan's minimum profile: computers below 28 GiB of RAM or 15 GiB of VRAM
+  // release the CPU copy of a texture once its data is on the GPU.
+  constexpr uint64_t kHostCopyAutoRamLimit  = 28 * kGiB;
+  constexpr uint64_t kHostCopyAutoVramLimit = 15 * kGiB;
+
+  // An image is released only after this many presented seconds without a draw: a minute
+  // covers turning around, menus and short trips, so normal play never re-uploads.
+  constexpr uint32_t kDefaultImageIdleSeconds = 60;
+  // A CPU copy is released this many presented seconds after the texture's last lock, so a
+  // texture the game keeps writing or reading never pays a read-back per lock.
+  constexpr uint32_t kDefaultHostCopyIdleSeconds = 10;
+  // Work per one-second pass: read-backs cross PCIe and are spread out; plain releases only
+  // drop references, but freeing thousands of images at once would still stall a frame.
+  constexpr uint64_t kReadbackBytesPerPass = 256 * kMiB;
+  constexpr uint64_t kReleaseBytesPerPass  = 2 * kGiB;
+
+  enum class Mode : int32_t { Auto = -1, Off = 0, On = 1 };
+
+  // True/False/Auto as DXVK writes them, and 1/0/-1 as environment variables do.
+  inline Mode parseMode(std::string value, Mode fallback) {
+    std::string text;
+    for (char c : value) {
+      if (!std::isspace(static_cast<unsigned char>(c)))
+        text += char(std::tolower(static_cast<unsigned char>(c)));
+    }
+    if (text == "true" || text == "1" || text == "on")
+      return Mode::On;
+    if (text == "false" || text == "0" || text == "off")
+      return Mode::Off;
+    if (text == "auto" || text == "-1")
+      return Mode::Auto;
+    return fallback;
+  }
+
+  inline const char* toString(Mode mode) {
+    return mode == Mode::Auto ? "Auto" : mode == Mode::On ? "True" : "False";
+  }
+
+  struct Policy {
+    uint64_t budgetBytes = 0;        // 0: images are never released for a budget
+    bool     budgetAuto = false;     // the budget is a quarter of the VRAM
+    bool     releaseHostCopies = false;
+    bool     releaseAuto = false;    // decided from the computer's RAM and VRAM
+    uint32_t imageIdleSeconds = kDefaultImageIdleSeconds;
+    uint32_t hostCopyIdleSeconds = kDefaultHostCopyIdleSeconds;
+
+    bool active() const {
+      return budgetBytes != 0 || releaseHostCopies;
+    }
+  };
+
+  // budgetMiB: -1 automatic (VRAM / 4), 0 off, otherwise MiB. vramBytes is the largest
+  // device-local heap, ramBytes the installed physical memory; 0 means unknown.
+  inline Policy resolvePolicy(int32_t budgetMiB, Mode releaseHostCopies, uint64_t vramBytes, uint64_t ramBytes) {
+    Policy policy;
+    if (budgetMiB < 0) {
+      policy.budgetAuto = true;
+      policy.budgetBytes = vramBytes / 4;
+    } else {
+      policy.budgetBytes = uint64_t(budgetMiB) * kMiB;
+    }
+    if (releaseHostCopies == Mode::Auto) {
+      policy.releaseAuto = true;
+      policy.releaseHostCopies = (ramBytes != 0 && ramBytes < kHostCopyAutoRamLimit)
+                              || (vramBytes != 0 && vramBytes < kHostCopyAutoVramLimit);
+    } else {
+      policy.releaseHostCopies = releaseHostCopies == Mode::On;
+    }
+    return policy;
+  }
+
+  struct Candidate {
+    uint64_t bytes = 0;          // GPU bytes the release frees
+    uint32_t lastUseTick = 0;    // presented second of the last draw, upload or creation
+    bool     needsReadback = false; // its CPU copy was released: read it back before the image goes
+  };
+
+  // Indices of the candidates to release, least recently used first, until the resident
+  // bytes fit the budget. Candidates used within idleTicks are never chosen, so the result
+  // may leave the resident bytes over the budget. Read-backs and releases are capped per pass;
+  // the first candidate of each kind is always allowed so one huge texture cannot stall it.
+  inline std::vector<size_t> selectForRelease(const std::vector<Candidate>& candidates,
+                                              uint64_t residentBytes, uint64_t budgetBytes,
+                                              uint32_t nowTick, uint32_t idleTicks,
+                                              uint64_t maxReadbackBytes = kReadbackBytesPerPass,
+                                              uint64_t maxReleaseBytes = kReleaseBytesPerPass) {
+    std::vector<size_t> result;
+    if (budgetBytes == 0 || residentBytes <= budgetBytes)
+      return result;
+
+    std::vector<size_t> order;
+    for (size_t i = 0; i < candidates.size(); i++) {
+      const Candidate& c = candidates[i];
+      if (c.bytes != 0 && nowTick >= c.lastUseTick && nowTick - c.lastUseTick >= idleTicks)
+        order.push_back(i);
+    }
+    std::stable_sort(order.begin(), order.end(), [&candidates] (size_t a, size_t b) {
+      if (candidates[a].lastUseTick != candidates[b].lastUseTick)
+        return candidates[a].lastUseTick < candidates[b].lastUseTick;
+      return candidates[a].bytes > candidates[b].bytes;
+    });
+
+    uint64_t excess = residentBytes - budgetBytes;
+    uint64_t readback = 0, released = 0;
+    for (size_t index : order) {
+      if (excess == 0)
+        break;
+      const Candidate& c = candidates[index];
+      if (c.needsReadback) {
+        if (readback != 0 && readback + c.bytes > maxReadbackBytes)
+          continue;
+        readback += c.bytes;
+      } else {
+        if (released != 0 && released + c.bytes > maxReleaseBytes)
+          continue;
+        released += c.bytes;
+      }
+      result.push_back(index);
+      excess -= std::min(excess, c.bytes);
+    }
+    return result;
+  }
+
+}
