+
+  void D3D9DeviceEx::TrackManagedTexture(D3D9CommonTexture* pResource, bool reupload) {
+    pResource->MarkUsed(m_managedTick);
+    if (pResource->m_registered || pResource->m_image == nullptr) {
+      return;
+    }
+    std::lock_guard<dxvk::mutex> lock(m_managedMutex);
+    m_managedCounters.reuploads += reupload ? 1 : 0;
+    pResource->m_registered = true;
+    pResource->m_residentBytes = pResource->m_image->memSize();
+    m_managedResident.insert(pResource);
+    m_managedResidentBytes += pResource->m_residentBytes;
+  }
+
+
+  void D3D9DeviceEx::ForgetManagedTexture(D3D9CommonTexture* pResource) {
+    std::lock_guard<dxvk::mutex> lock(m_managedMutex);
+    if (pResource->m_registered) {
+      m_managedResident.erase(pResource);
+      m_managedResidentBytes -= std::min(m_managedResidentBytes, uint64_t(pResource->m_residentBytes));
+      pResource->m_registered = false;
+    }
+    if (pResource->m_readbackPending) {
+      m_managedReadbacks.erase(std::remove(m_managedReadbacks.begin(), m_managedReadbacks.end(), pResource),
+        m_managedReadbacks.end());
+      pResource->m_readbackPending = false;
+    }
+    for (uint32_t i = 0; i < pResource->CountSubresources(); i++) {
+      if (pResource->m_hostCopyReleased.get(i)) {
+        m_managedCounters.hostCopyBytes -= std::min(m_managedCounters.hostCopyBytes, uint64_t(pResource->GetMipSize(i)));
+      }
+    }
+    pResource->m_hostCopyReleased.clearAll();
+  }
+
