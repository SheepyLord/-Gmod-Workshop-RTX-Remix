+* IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+* FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+* THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+* LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+* FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+* DEALINGS IN THE SOFTWARE.
+*/
+#include "../../../src/d3d9/d3d9_managed_memory.h"
+
+#include <cstdlib>
+#include <iostream>
+
+int main() {
+  using namespace dxvk::managed_memory;
+  const auto check = [](bool passed, const char* message) {
+    if (!passed) {
+      std::cerr << message << '\n';
+      std::exit(1);
+    }
+  };
+
+  // Options: DXVK's Tristate words and the environment's numbers.
+  check(parseMode("True", Mode::Off) == Mode::On, "True turns host copy release on");
+  check(parseMode(" false ", Mode::On) == Mode::Off, "False turns it off, ignoring spaces and case");
+  check(parseMode("AUTO", Mode::Off) == Mode::Auto, "Auto is accepted in any case");
+  check(parseMode("1", Mode::Off) == Mode::On && parseMode("0", Mode::On) == Mode::Off && parseMode("-1", Mode::Off) == Mode::Auto,
+        "1, 0 and -1 are the environment forms");
+  check(parseMode("", Mode::Auto) == Mode::Auto && parseMode("maybe", Mode::Off) == Mode::Off,
+        "An empty or unknown value keeps the default");
+
+  // The automatic budget is a quarter of the VRAM; 0 is off; a positive value is MiB.
+  const uint64_t vram8 = 8176 * kMiB, vram16 = 16376 * kMiB, vram32 = 32607 * kMiB;
+  const uint64_t ram16 = 16 * kGiB - 512 * kMiB, ram32 = 32 * kGiB - 600 * kMiB, ram64 = 64 * kGiB - kGiB;
+  Policy p = resolvePolicy(-1, Mode::Off, vram16, ram32);
+  check(p.budgetAuto && p.budgetBytes == vram16 / 4, "Auto budget is VRAM / 4");
+  check(resolvePolicy(0, Mode::Off, vram16, ram32).budgetBytes == 0 && !resolvePolicy(0, Mode::Off, vram16, ram32).active(),
+        "Budget 0 with host copies off leaves the policy inactive");
+  check(resolvePolicy(3000, Mode::Off, vram16, ram32).budgetBytes == 3000 * kMiB, "An explicit budget is MiB");
+  check(resolvePolicy(-1, Mode::Off, 0, ram32).budgetBytes == 0, "Unknown VRAM gives no automatic budget");
+
+  // Automatic host copy release matches the plan's minimum profile: below 28 GiB RAM or 15 GiB VRAM.
+  check(resolvePolicy(-1, Mode::Auto, vram8, ram16).releaseHostCopies, "8 GB / 16 GB computers release host copies");
+  check(resolvePolicy(-1, Mode::Auto, vram16, ram16).releaseHostCopies, "16 GB RAM alone is below the recommended profile");
+  check(resolvePolicy(-1, Mode::Auto, vram8, ram64).releaseHostCopies, "8 GB VRAM alone is below the recommended profile");
+  check(!resolvePolicy(-1, Mode::Auto, vram16, ram32).releaseHostCopies, "16 GB / 32 GB computers keep host copies");
+  check(!resolvePolicy(-1, Mode::Auto, vram32, ram64).releaseHostCopies, "Large computers keep host copies");
+  check(resolvePolicy(-1, Mode::Auto, vram32, ram64).releaseAuto, "The automatic choice is reported as automatic");
+  check(!resolvePolicy(-1, Mode::Auto, 0, 0).releaseHostCopies, "Unknown RAM and VRAM keep host copies");
+  check(resolvePolicy(-1, Mode::On, vram32, ram64).releaseHostCopies && !resolvePolicy(-1, Mode::Off, vram8, ram16).releaseHostCopies,
+        "Explicit values win over the automatic choice");
+
+  // Release selection: least recently used first, only idle candidates, until the budget fits.
+  const uint64_t budget = 100 * kMiB;
+  std::vector<Candidate> candidates = {
+    { 40 * kMiB, 50, false },   // 0: idle since tick 50
+    { 40 * kMiB, 10, false },   // 1: oldest
+    { 40 * kMiB, 115, false },  // 2: used 5 ticks ago, never chosen with a 60 tick idle time
+    { 40 * kMiB, 30, false },   // 3
+  };
+  check(selectForRelease(candidates, budget, budget, 120, 60).empty(), "Nothing is released at or under the budget");
+  auto chosen = selectForRelease(candidates, 160 * kMiB, budget, 120, 60);
+  check(chosen.size() == 2 && chosen[0] == 1 && chosen[1] == 3, "The two oldest idle images cover a 60 MiB excess");
+  chosen = selectForRelease(candidates, 400 * kMiB, budget, 120, 60);
+  check(chosen.size() == 3 && chosen[2] == 0, "Every idle image may go, oldest first");
+  for (size_t index : chosen)
+    check(index != 2, "A recently used image is never released, even over the budget");
+  chosen = selectForRelease(candidates, 160 * kMiB, budget, 120, 0);
+  check(chosen.size() == 2 && chosen[0] == 1, "An idle time of zero still releases the oldest first");
+
+  // Ties: the larger image first, so fewer releases cover the excess.
+  std::vector<Candidate> tied = { { 10 * kMiB, 5, false }, { 90 * kMiB, 5, false } };
+  chosen = selectForRelease(tied, 150 * kMiB, budget, 100, 60);
+  check(chosen.size() == 1 && chosen[0] == 1, "Equally old: the larger image covers the excess alone");
+
+  // Caps per pass: read-backs and plain releases are limited separately; the first of each kind always fits.
+  std::vector<Candidate> readbacks = {
+    { 200 * kMiB, 1, true }, { 200 * kMiB, 2, true }, { 10 * kMiB, 3, false }, { 300 * kMiB, 4, true },
+  };
+  chosen = selectForRelease(readbacks, 10 * kGiB, budget, 100, 60, 256 * kMiB, 2 * kGiB);
+  check(chosen.size() == 2 && chosen[0] == 0 && chosen[1] == 2,
+        "One 200 MiB read-back fits the 256 MiB cap; the next waits, plain releases go on");
+  std::vector<Candidate> huge = { { 4 * kGiB, 1, false }, { 4 * kGiB, 2, false } };
+  chosen = selectForRelease(huge, 20 * kGiB, budget, 100, 60, 256 * kMiB, 2 * kGiB);
+  check(chosen.size() == 1 && chosen[0] == 0, "A single image larger than the cap still goes, one per pass");
+  check(selectForRelease({ { 0, 1, false } }, 20 * kGiB, budget, 100, 60).empty(), "Empty candidates are ignored");
+  check(selectForRelease({ { kMiB, 200, false } }, 20 * kGiB, budget, 100, 0).empty(),
+        "A use stamped after the pass's tick is never idle");
+
+  std::cout << "managed texture memory policy: all checks passed\n";
+  return 0;
+}
