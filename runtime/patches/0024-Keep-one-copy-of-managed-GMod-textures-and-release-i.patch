+      policy.budgetAuto ? "auto: VRAM/4" : (policy.budgetBytes != 0 ? "set" : "off"), "); VRAM ", vram >> 20, " MiB"));
+    Logger::info(str::format("[RTX Managed Textures] release host copies: ", policy.releaseHostCopies ? "on" : "off", " (",
+      policy.releaseAuto ? str::format("auto: RAM ", ram >> 20, " MiB, VRAM ", vram >> 20, " MiB; on below 28 GiB RAM or 15 GiB VRAM")
