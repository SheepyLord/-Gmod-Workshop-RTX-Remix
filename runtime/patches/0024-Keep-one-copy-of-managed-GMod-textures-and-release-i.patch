+
+  void D3D9DeviceEx::ManageManagedTextureMemory() {
+    // One pass per presented second. The tick advances once per pass, so time spent
+    // minimized or loading without presenting does not make everything look idle.
+    const auto now = std::chrono::steady_clock::now();
+    if (now - m_managedPassTime < std::chrono::seconds(1)) {
+      return;
+    }
+    m_managedPassTime = now;
+
+    D3D9DeviceLock lock = LockDevice();
+    std::lock_guard<dxvk::mutex> guard(m_managedMutex);
+    ++m_managedTick;
+    if (m_managedMemoryPolicy.active()) {
+      FinishManagedReadbacks();
+      if (m_managedMemoryPolicy.releaseHostCopies) {
+        ReleaseIdleHostCopies();
+      }
+      if (m_managedMemoryPolicy.budgetBytes != 0) {
+        ReleaseIdleManagedImages();
+      }
+    }
+    LogManagedTextureMemory("pass");
+  }
+
+
+  void D3D9DeviceEx::ReleaseIdleHostCopies() {
+    const uint32_t idle = m_managedMemoryPolicy.hostCopyIdleSeconds;
+    m_managedCounters.keptHostCopyTextures = 0;
+    for (D3D9CommonTexture* texture : m_managedResident) {
+      m_managedCounters.keptHostCopyTextures += texture->m_keepHostCopy ? 1 : 0;
+      if (texture->m_keepHostCopy || texture->m_readbackPending || texture->m_image == nullptr ||
+          texture->IsAnySubresourceLocked() || texture->NeedsAnyUpload() ||
+          m_managedTick - texture->m_lastLockTick < idle) {
+        continue;
+      }
+      // The image holds every subresource: uploads already in the command stream keep their
+      // own reference to the buffer, so dropping ours frees it once they ran.
+      for (uint32_t i = 0; i < texture->CountSubresources(); i++) {
+        if (texture->m_buffers[i] == nullptr) {
+          continue;
+        }
+        const uint64_t bytes = texture->GetMipSize(i);
+        texture->DropBuffer(i);
+        texture->m_mappedSlices[i] = DxvkBufferSliceHandle();
+        texture->m_hostCopyReleased.set(i, true);
+        texture->SetWrittenByGPU(i, true);
+        m_managedCounters.hostCopiesReleased += 1;
+        m_managedCounters.hostCopyBytesReleased += bytes;
+        m_managedCounters.hostCopyBytes += bytes;
+      }
+    }
+  }
+
+
+  void D3D9DeviceEx::ReleaseIdleManagedImages() {
+    if (RtxOptions::keepTexturesForTagging()) {
+      return; // the texture browser keeps every image anyway
+    }
+    uint64_t pending = 0;
+    for (const D3D9CommonTexture* texture : m_managedReadbacks) {
+      pending += texture->m_residentBytes;
+    }
+    const uint64_t resident = m_managedResidentBytes > pending ? m_managedResidentBytes - pending : 0;
+    if (resident <= m_managedMemoryPolicy.budgetBytes) {
+      return;
+    }
+
+    std::vector<const D3D9CommonTexture*> bound;
+    for (IDirect3DBaseTexture9* texture : m_state.textures) {
+      if (texture != nullptr) {
+        bound.push_back(GetCommonTexture(texture));
+      }
+    }
+    std::vector<managed_memory::Candidate> candidates;
+    std::vector<D3D9CommonTexture*> textures;
+    candidates.reserve(m_managedResident.size());
+    textures.reserve(m_managedResident.size());
+    for (D3D9CommonTexture* texture : m_managedResident) {
+      if (texture->m_readbackPending || texture->m_image == nullptr || texture->IsAnySubresourceLocked() ||
+          std::find(bound.begin(), bound.end(), texture) != bound.end()) {
+        continue;
+      }
+      candidates.push_back({ uint64_t(texture->m_residentBytes), texture->m_lastUseTick, texture->m_hostCopyReleased.any() });
+      textures.push_back(texture);
+    }
+    const auto selected = managed_memory::selectForRelease(candidates, resident,
+      m_managedMemoryPolicy.budgetBytes, m_managedTick, m_managedMemoryPolicy.imageIdleSeconds);
+    for (size_t index : selected) {
+      if (candidates[index].needsReadback) {
+        StartManagedReadback(textures[index]);
+      } else {
+        ReleaseManagedImage(textures[index]);
+      }
+    }
+  }
+
+
+  void D3D9DeviceEx::StartManagedReadback(D3D9CommonTexture* pResource) {
+    // The same copy LockImage makes for a subresource the GPU wrote: 4-byte rows,
+    // exactly the layout of the CPU copy the application filled.
+    const Rc<DxvkImage> image = pResource->GetImage();
+    const DxvkFormatInfo* formatInfo = imageFormatInfo(pResource->GetFormatMapping().FormatColor);
+    for (uint32_t i = 0; i < pResource->CountSubresources(); i++) {
+      if (!pResource->m_hostCopyReleased.get(i)) {
+        continue;
+      }
+      pResource->CreateBufferSubresource(i);
+      const VkImageSubresource subresource = pResource->GetSubresourceFromIndex(formatInfo->aspectMask, i);
+      EmitCs([
+        cBuffer       = pResource->GetBuffer(i),
+        cImage        = image,
+        cSubresources = vk::makeSubresourceLayers(subresource),
+        cLevelExtent  = pResource->GetExtentMip(i)
+      ] (DxvkContext* ctx) {
+        ctx->copyImageToBuffer(cBuffer, 0, 4, 0,
+          cImage, cSubresources, VkOffset3D { 0, 0, 0 }, cLevelExtent);
+      });
+      const uint64_t bytes = pResource->GetMipSize(i);
+      pResource->m_hostCopyReleased.set(i, false);
+      pResource->SetWrittenByGPU(i, false);
+      m_managedCounters.hostCopyBytes -= std::min(m_managedCounters.hostCopyBytes, bytes);
+      m_managedCounters.readbackBytes += bytes;
+    }
+    pResource->m_readbackPending = true;
+    pResource->m_readbackTick = m_managedTick;
+    pResource->m_readbackSequence = GetCurrentSequenceNumber();
+    m_managedReadbacks.push_back(pResource);
+    m_managedCounters.readbacks += 1;
+  }
+
+
+  void D3D9DeviceEx::FinishManagedReadbacks() {
+    if (m_managedReadbacks.empty()) {
+      return;
+    }
+    const uint64_t executed = m_csThread.lastSequenceNumber();
+    std::vector<D3D9CommonTexture*> waiting;
+    for (D3D9CommonTexture* texture : m_managedReadbacks) {
+      bool busy = executed < texture->m_readbackSequence;
+      for (uint32_t i = 0; i < texture->CountSubresources() && !busy; i++) {
+        busy = texture->m_buffers[i] != nullptr && texture->m_buffers[i]->isInUse(DxvkAccess::Write);
+      }
+      if (busy) {
+        waiting.push_back(texture);
+        continue;
+      }
+      texture->m_readbackPending = false;
+      // A draw or lock since the read-back started means the texture is in use again:
+      // keep the image (the CPU copies just made are current and go again when idle).
+      if (texture->m_lastUseTick >= texture->m_readbackTick || texture->m_lastLockTick >= texture->m_readbackTick ||
+          texture->IsAnySubresourceLocked() || IsManagedTextureBound(texture)) {
+        m_managedCounters.cancelledReleases += 1;
+        continue;
+      }
+      ReleaseManagedImage(texture);
+    }
+    m_managedReadbacks = std::move(waiting);
+  }
+
+
+  void D3D9DeviceEx::ReleaseManagedImage(D3D9CommonTexture* pResource) {
+    Rc<DxvkImage> image = std::move(pResource->m_image);
+    pResource->m_sampleView = D3D9ColorView();
+    const XXH64_hash_t hash = image->getHash();
+    pResource->m_releasedHash = hash;
+    pResource->m_imageReleased = true;
+    if (hash != kEmptyHash) {
+      ImGUI::ReleaseTextureImage(hash, image.ptr());
+    }
+    // Remix's texture cache frees the image once no instance samples it any more.
+    image->markApplicationReleased();
+    if (pResource->m_registered) {
+      m_managedResident.erase(pResource);
+      m_managedResidentBytes -= std::min(m_managedResidentBytes, uint64_t(pResource->m_residentBytes));
+      pResource->m_registered = false;
+    }
+    // Every subresource that has data uploads again on the next use; the others are zero
+    // and the new image is cleared to zero.
+    for (uint32_t i = 0; i < pResource->CountSubresources(); i++) {
+      pResource->SetNeedsUpload(i, true);
+    }
+    for (uint32_t layer = 0; layer < pResource->Desc()->ArraySize; layer++) {
+      pResource->AddDirtyBox(nullptr, layer);
+    }
+    m_managedCounters.imagesReleased += 1;
+    m_managedCounters.imageBytesReleased += pResource->m_residentBytes;
+  }
