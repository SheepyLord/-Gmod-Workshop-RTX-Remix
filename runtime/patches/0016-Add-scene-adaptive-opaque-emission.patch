       ctx->bindShader(VK_SHADER_STAGE_COMPUTE_BIT, AutoExposureShader::getShader());
       ctx->dispatch(1, 1, 1);
     }
+
+    const uint32_t frameId = device()->getCurrentFrameId();
+    auto& slot = m_adaptationReadback[frameId % kReadbackFrames];
+    if (!slot.pending && !slot.buffer->isInUse()) {
+      ctx->copyBuffer(slot.buffer, 0, m_adaptationState, 0, sizeof(AdaptationSample));
+      slot.frameId = frameId;
+      slot.pending = true;
+    }
