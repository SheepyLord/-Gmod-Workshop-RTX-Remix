+#include <array>
+#include <cmath>
+#include <cstring>
+#include <iostream>
+
+#include "../../../src/dxvk/rtx_render/rtx_materials.h"
+#include "../../../src/lssusd/usd_include_begin.h"
+#include <pxr/usd/sdf/types.h>
+#include <pxr/usd/usd/attribute.h>
+#include <pxr/usd/usd/stage.h>
+#include "../../../src/lssusd/usd_include_end.h"
+
+namespace dxvk {
+  Logger Logger::s_instance("test_adaptive_emission.log");
+}
+
+namespace {
+  bool check(bool result, const char* message) {
+    if (!result) {
+      std::cerr << message << '\n';
+    }
+    return result;
+  }
+
+  bool materialInput() {
+    dxvk::OpaqueMaterialData data;
+    bool ok = check(data.getEmissiveAdaptiveIntensity() == 0.f, "Adaptive emission must be opt-in");
+    const auto hash = data.getHash();
+    data.setEmissiveAdaptiveIntensity(2.f);
+    ok &= check(data.getHash() != hash, "Material identity must include adaptive emission");
+    ok &= check(dxvk::OpaqueMaterialData::getEmissiveAdaptiveIntensityToken() ==
+      pxr::TfToken("inputs:emissive_adaptive_intensity"), "Wrong USD token");
+
+    const auto stage = pxr::UsdStage::CreateInMemory("adaptive_emission.usda");
+    const auto shader = stage->DefinePrim(pxr::SdfPath("/Shader"), pxr::TfToken("Shader"));
+    const auto getTexture = [](const pxr::UsdPrim&, const pxr::TfToken&) { return dxvk::TextureRef {}; };
+    ok &= check(dxvk::OpaqueMaterialData::deserialize(getTexture, shader).getEmissiveAdaptiveIntensity() == 0.f,
+      "Absent USD input must remain zero");
+    auto attr = shader.CreateAttribute(dxvk::OpaqueMaterialData::getEmissiveAdaptiveIntensityToken(), pxr::SdfValueTypeNames->Float);
+    for (const auto pair : {std::pair{-1.f, 0.f}, std::pair{2.5f, 2.5f}, std::pair{70000.f, 65504.f}}) {
+      attr.Set(pair.first);
+      ok &= check(dxvk::OpaqueMaterialData::deserialize(getTexture, shader).getEmissiveAdaptiveIntensity() == pair.second,
+        "USD input did not deserialize and clamp to the half-float range");
+    }
+    return ok;
+  }
+
+  dxvk::RtOpaqueSurfaceMaterial material(float adaptive, bool emission, uint32_t subsurface) {
+    constexpr auto invalid = dxvk::kSurfaceMaterialInvalidTextureIndex;
+    return dxvk::RtOpaqueSurfaceMaterial {
+      invalid, invalid, invalid, invalid, invalid, invalid, invalid,
+      0.f, 7.f, dxvk::Vector4(1.f), 0.4f, 0.2f,
+      dxvk::Vector3(1.f), emission, false, false, dxvk::Vector3(1.f),
+      false, false, false, 200.f, 0, 0.f, 0.f,
+      true, 0.25f, 0.5f, 0.75f, subsurface, false, false, 123,
+      0, false, false, false, adaptive
+    };
+  }
+
+  bool packing() {
+    bool ok = true;
+    for (const uint32_t index : {0u, 0x123456u, uint32_t(MATERIAL_INDEX_MAX_VALUE - 1), uint32_t(MATERIAL_INDEX_INVALID)}) {
+      for (const bool emission : {false, true}) {
+        const auto baseline = material(0.f, emission, index);
+        std::array<unsigned char, dxvk::kSurfaceMaterialGPUSize> baseBytes {};
+        size_t offset = 0;
+        baseline.writeGPUData(baseBytes.data(), offset);
+        ok &= check(offset == 64, "Opaque record grew");
+        std::array<uint32_t, 16> baseWords;
+        std::memcpy(baseWords.data(), baseBytes.data(), 64);
+        ok &= check(baseWords[14] == index && (baseWords[15] >> 24) == 0xffu,
+          "Absent input changed legacy index or DLSS alpha bytes");
+        for (const float value : {0.f, 0.025f, 1.f, 2.5f, 65504.f}) {
+          const auto m = material(value, emission, index);
+          std::array<unsigned char, 64> bytes {};
+          offset = 0;
+          m.writeGPUData(bytes.data(), offset);
+          std::array<uint32_t, 16> words;
+          std::memcpy(words.data(), bytes.data(), 64);
+          const float expected = emission ? value : 0.f;
+          const float unpacked = glm::unpackHalf1x16(uint16_t(dxvk::unpackAdaptiveEmissionBits(words[14], words[15])));
+          ok &= check(std::abs(unpacked - expected) <= std::max(1e-6f, expected * 0.0005f), "GPU half-float round trip failed");
+          ok &= check(dxvk::unpackAdaptiveEmissionIndex(words[14]) == index, "Adaptive emission corrupted the subsurface index");
+          ok &= check(dxvk::unpackAdaptiveEmissionMask(words[15]) == baseWords[15], "Adaptive emission corrupted DLSS control RGB/alpha");
+          ok &= check(std::memcmp(bytes.data(), baseBytes.data(), 56) == 0, "Adaptive input changed another packed field");
+          if (value > 0.f) {
+            ok &= check(m.getHash() != baseline.getHash(), "GPU material identity omitted adaptive intensity");
+          }
+        }
+      }
+    }
+    return ok;
+  }
+
+  bool formula() {
+    using namespace dxvk;
+    bool ok = true;
+    for (const float luminance : {0.f, 0.001f, 0.18f, 1.f, 100.f}) {
+      const float clamped = adaptiveEmissionLuminance(true, luminance, 0.18f, 0.01f, 16.f);
+      const float expected = luminance < 0.01f ? 0.01f : luminance > 16.f ? 16.f : luminance;
+      ok &= check(std::abs(adaptiveEmissionIntensity(7.f, 2.f, true, 3.f * clamped) - 6.f * expected) < 1e-5f,
+        "Enabled emission formula or luminance clamps failed");
+      ok &= check(adaptiveEmissionIntensity(7.f, 2.f, false, clamped) == 7.f, "Feature-off must retain fixed emission");
+      ok &= check(adaptiveEmissionIntensity(7.f, 0.f, true, clamped) == 7.f, "Input zero must retain fixed emission");
+    }
+    ok &= check(adaptiveEmissionIntensity(0.f, 2.f, true, 0.5f) == 1.f, "Adaptive input must work with fixed intensity zero");
+    ok &= check(adaptiveEmissionIntensity(7.f, 2.f, true, 0.f) == 0.f, "Global scale zero must disable adaptive radiance");
+    ok &= check(adaptiveEmissionLuminance(false, 100.f, 0.18f, 0.f, 64.f) == 0.18f,
+      "Auto-exposure off/startup must use fallback");
+    ok &= check(adaptiveEmissionLuminance(false, 100.f, 0.18f, 0.5f, 64.f) == 0.5f,
+      "Fallback must obey the lower clamp");
+    ok &= check(adaptiveEmissionLuminance(false, 0.f, 100.f, 0.f, 64.f) == 64.f,
+      "Fallback must obey the upper clamp");
+    ok &= check(adaptiveEmissionLuminance(true, 0.f, 0.18f, 0.f, 64.f) == 0.f,
+      "Default lower clamp must permit fading to black");
+    ok &= check(adaptiveEmissionLuminance(true, 1.f, 0.18f, 2.f, 1.f) == 2.f,
+      "Inverted clamps must resolve to the minimum");
+    // Compare settled scene-referred emission through the actual cone-noise law.
+    const float dark = 0.05f;
+    const float bright = 5.f;
+    const float darkDisplay = (0.18f / (dark + 0.0032f)) * adaptiveEmissionIntensity(7.f, 2.f, true, dark);
+    const float brightDisplay = (0.18f / (bright + 0.0032f)) * adaptiveEmissionIntensity(7.f, 2.f, true, bright);
+    ok &= check(darkDisplay / brightDisplay > 0.93f && darkDisplay / brightDisplay < 1.f,
+      "Settled adaptive emission should remain nearly constant before the exposure cap");
+    ok &= check(16.f * adaptiveEmissionIntensity(7.f, 2.f, true, 0.0001f) < darkDisplay * 0.01f,
+      "Exposure-capped emission must fade in very dark scenes");
+    return ok;
+  }
+}
+
+int main() {
+  return materialInput() && packing() && formula() ? 0 : -1;
+}
