+
+#ifdef __cplusplus
+namespace dxvk {
+#endif
+
+// Material indices use 21 bits. The other byte is the DLSS mask's constant alpha.
+// XOR preserves the old 0xff alpha byte when the optional intensity is zero.
+inline uint32_t packAdaptiveEmissionIndex(uint32_t index, uint32_t halfBits) {
+  return (index & 0x00ffffffu) | ((halfBits & 0xffu) << 24);
+}
+
+inline uint32_t packAdaptiveEmissionMask(uint32_t mask, uint32_t halfBits) {
+  return (mask & 0x00ffffffu) | (((halfBits >> 8) ^ 0xffu) << 24);
+}
+
+inline uint32_t unpackAdaptiveEmissionBits(uint32_t index, uint32_t mask) {
+  return (index >> 24) | (((mask >> 24) ^ 0xffu) << 8);
+}
+
+inline uint32_t unpackAdaptiveEmissionIndex(uint32_t index) {
+  return index & 0x00ffffffu;
+}
+
+inline uint32_t unpackAdaptiveEmissionMask(uint32_t mask) {
+  return mask | 0xff000000u;
+}
+
+inline float adaptiveEmissionLuminance(bool useAutoExposure, float adaptedYf, float fallback,
+                                     float minimum, float maximum) {
+  const float lower = minimum > 0.0f ? minimum : 0.0f;
+  const float upper = maximum > lower ? maximum : lower;
+  const float luminance = useAutoExposure ? adaptedYf : fallback;
+  const float clampedLower = luminance > lower ? luminance : lower;
+  return clampedLower < upper ? clampedLower : upper;
+}
+
+inline float adaptiveEmissionIntensity(float fixedIntensity, float adaptiveIntensity,
+                                     bool enabled, float scaleLuminance) {
+  return enabled && adaptiveIntensity > 0.0f ? adaptiveIntensity * scaleLuminance : fixedIntensity;
+}
