+  float DxvkAutoExposure::updateAdaptiveEmission(uint32_t frameId, bool cameraCut) {
+    ScopedCpuProfileZone();
+    for (auto& slot : m_adaptationReadback) {
+      if (!enabled()) {
+        slot.pending = false;
+        m_hasAdaptationSample = false;
+      }
+      // Never map an outstanding transfer or wait for the GPU. Under load keep the last completed sample.
+      if (!slot.pending || uint32_t(frameId - slot.frameId) < kReadbackFrames - 1 || slot.buffer->isInUse()) {
+        continue;
+      }
+      const auto sample = *static_cast<const AdaptationSample*>(slot.buffer->mapPtr(0));
+      if (std::isfinite(sample.adaptedYf) && sample.adaptedYf >= 0.f &&
+          std::isfinite(sample.exposure) && sample.exposure > 0.f &&
+          (!m_hasAdaptationSample || uint32_t(frameId - slot.frameId) < uint32_t(frameId - m_sampleFrameId))) {
+        m_adaptationSample = sample;
+        m_sampleFrameId = slot.frameId;
+        m_hasAdaptationSample = true;
+      }
+      slot.pending = false;
+    }
+
+    const auto finiteOr = [](float value, float fallback) { return std::isfinite(value) ? value : fallback; };
+    const bool useSample = enabled() && m_hasAdaptationSample;
+    const float luminance = adaptiveEmissionLuminance(useSample, m_adaptationSample.adaptedYf,
+      finiteOr(AdaptiveEmission::fallbackLuminance(), 0.18f),
+      finiteOr(AdaptiveEmission::minLuminance(), 0.f), finiteOr(AdaptiveEmission::maxLuminance(), 64.f));
+    const float scale = std::max(finiteOr(AdaptiveEmission::scale(), 1.f), 0.f);
+
+    const auto now = std::chrono::steady_clock::now();
+    if (cameraCut || now >= m_nextAdaptationLog) {
+      Logger::info(str::format("[RTX Adaptive Emission] event=", cameraCut ? "camera_cut" : "interval",
+        " frame=", frameId, " source=", useSample ? "auto_exposure" : "fallback",
+        " sample_frame=", useSample ? std::to_string(m_sampleFrameId) : "none",
+        " age_frames=", useSample ? std::to_string(uint32_t(frameId - m_sampleFrameId)) : "none",
+        " adapted_yf=", useSample ? m_adaptationSample.adaptedYf : luminance,
+        " exposure=", useSample ? m_adaptationSample.exposure : 1.f,
+        " luminance=", luminance, " scale=", scale, " enabled=", AdaptiveEmission::enable()));
+      m_nextAdaptationLog = now + std::chrono::minutes(5);
+    }
+    return scale * luminance;
+  }
+
