diff --git a/tests/rtx/unit/test_splash_message.cpp b/tests/rtx/unit/test_splash_message.cpp
new file mode 100644
index 00000000..f166bf8a
--- /dev/null
+++ b/tests/rtx/unit/test_splash_message.cpp
@@ -0,0 +1,39 @@
+#include "../../../src/util/util_startup_message.h"
+#include <cstdlib>
+#include <iostream>
+
+int main(int argc, char** argv) {
+  using dxvk::StartupMessage;
+  const auto check = [](bool passed) {
+    if (!passed) { std::cerr << "Startup text policy failed\n"; std::exit(1); }
+  };
+  if (argc != 2) return 1;
+  const std::filesystem::path directory(argv[1]);
+  std::filesystem::create_directories(directory);
+  const auto english = directory / "startup_message.txt";
+  const auto japanese = directory / "startup_message.ja.txt";
+  const auto write = [](const auto& path, const std::string& text) {
+    std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+    stream.write(text.data(), static_cast<std::streamsize>(text.size()));
+  };
+  if (std::filesystem::exists(english) || std::filesystem::exists(japanese)) return 1;
+  write(english, "English {hotkey} {seconds} 100%\n");
+  check(StartupMessage::language("../../other") == "en");
+  check(StartupMessage::language("zh-cn") == "zh-CN");
+  check(StartupMessage::language("zh-tw") == "zh-TW");
+  check(StartupMessage::load(directory, "ja") == "English {hotkey} {seconds} 100%\n");
+  write(japanese, "\xef\xbb\xbf" "日本語\r\n{hotkey} {seconds}\r\n");
+  check(StartupMessage::load(directory, "ja") == "日本語\n{hotkey} {seconds}\n");
+  check(StartupMessage::format("{hotkey} {hotkey} {seconds} 100%", "ALT+X", 12) == "ALT+X ALT+X 12 100%");
+  write(japanese, std::string(8193, 'x'));
+  check(StartupMessage::load(directory, "ja").find("English") == 0);
+  write(japanese, std::string("bad\0data", 8));
+  check(StartupMessage::load(directory, "ja").find("English") == 0);
+  std::filesystem::remove(english);
+  write(japanese, " \r\n\t");
+  check(StartupMessage::load(directory, "ja") == StartupMessage::fallback);
+  std::filesystem::remove(japanese);
+  std::filesystem::remove(directory);
+  std::cout << "Startup text policy tests passed\n";
+  return 0;
+}
