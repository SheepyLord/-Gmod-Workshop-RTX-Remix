diff --git a/src/util/util_startup_message.h b/src/util/util_startup_message.h
new file mode 100644
index 00000000..47138929
--- /dev/null
+++ b/src/util/util_startup_message.h
@@ -0,0 +1,56 @@
+#pragma once
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <string_view>
+
+namespace dxvk {
+  class StartupMessage {
+  public:
+    static constexpr std::string_view fallback =
+      "RTX Remix for Garry's Mod\nPress {hotkey} to open the Remix menu.\n\n"
+      "Project and issue reports:\nhttps://github.com/SheepyLord/-Gmod-Workshop-RTX-Remix\n\n"
+      "Closing in {seconds} seconds.\n";
+
+    static std::string language(std::string_view code) {
+      if (code == "zh" || code == "zh-cn") return "zh-CN";
+      if (code == "zh-tw") return "zh-TW";
+      for (const auto value : {"zh-CN", "zh-TW", "ja", "ko", "fr", "ru"}) {
+        if (code == value) return std::string(code);
+      }
+      return "en";
+    }
+
+    static std::string load(const std::filesystem::path& directory, std::string_view code) {
+      const auto selected = language(code);
+      for (const auto& locale : {selected, std::string("en")}) {
+        const auto name = locale == "en" ? "startup_message.txt" : "startup_message." + locale + ".txt";
+        std::ifstream input(directory / name, std::ios::binary | std::ios::ate);
+        if (!input) continue;
+        const auto size = input.tellg();
+        if (size <= 0 || size > 8192) continue;
+        std::string text(static_cast<std::size_t>(size), '\0');
+        input.seekg(0);
+        if (!input.read(text.data(), static_cast<std::streamsize>(text.size())) || text.find('\0') != std::string::npos) continue;
+        if (text.compare(0, 3, "\xef\xbb\xbf") == 0) text.erase(0, 3);
+        text.erase(std::remove(text.begin(), text.end(), '\r'), text.end());
+        if (text.find_first_not_of(" \t\n") != std::string::npos) return text;
+      }
+      return std::string(fallback);
+    }
+
+    static std::string format(std::string text, std::string_view hotkey, unsigned seconds) {
+      const auto replace = [&](std::string_view token, std::string_view value) {
+        std::size_t at = 0;
+        while ((at = text.find(token, at)) != std::string::npos) {
+          text.replace(at, token.size(), value);
+          at += value.size();
+        }
+      };
+      replace("{hotkey}", hotkey);
+      replace("{seconds}", std::to_string(seconds));
+      return text;
+    }
+  };
+}
