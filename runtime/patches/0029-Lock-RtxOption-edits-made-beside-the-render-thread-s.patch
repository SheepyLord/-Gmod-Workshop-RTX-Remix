+#include <functional>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace dxvk {
+  // Logger needed by some shared code used in this Unit Test.
+  Logger Logger::s_instance("test_rtx_option_threads.log");
+
+namespace rtx_option_threads_test {
+
+  #define TEST_ASSERT(condition, message) \
+    do { \
+      if (!(condition)) { \
+        std::ostringstream oss; \
+        oss << "FAILED: " << __FUNCTION__ << " line " << __LINE__ << ": " << message; \
+        throw DxvkError(oss.str()); \
+      } \
+    } while(0)
+
+  // In a game the render thread resolves options at the end of every frame (applyPendingValues), and its graph
+  // acquires and releases option layers, while the game's own thread sets options through the Remix API
+  // (remixapi_SetConfigVariable calls readOption) and draws the Remix menu. These tests run those paths against
+  // each other. A missing lock shows as a crash, or as a write that is never resolved.
+
+#define THREAD_TEST_OPTION(index) RTX_OPTION("rtx.threadTest", float, value##index, 0.0f, "Option for the threading tests.")
+  class TestOptions {
+  public:
+    THREAD_TEST_OPTION(0)  THREAD_TEST_OPTION(1)  THREAD_TEST_OPTION(2)  THREAD_TEST_OPTION(3)
+    THREAD_TEST_OPTION(4)  THREAD_TEST_OPTION(5)  THREAD_TEST_OPTION(6)  THREAD_TEST_OPTION(7)
+    THREAD_TEST_OPTION(8)  THREAD_TEST_OPTION(9)  THREAD_TEST_OPTION(10) THREAD_TEST_OPTION(11)
+    THREAD_TEST_OPTION(12) THREAD_TEST_OPTION(13) THREAD_TEST_OPTION(14) THREAD_TEST_OPTION(15)
+    THREAD_TEST_OPTION(16) THREAD_TEST_OPTION(17) THREAD_TEST_OPTION(18) THREAD_TEST_OPTION(19)
+    THREAD_TEST_OPTION(20) THREAD_TEST_OPTION(21) THREAD_TEST_OPTION(22) THREAD_TEST_OPTION(23)
+    THREAD_TEST_OPTION(24) THREAD_TEST_OPTION(25) THREAD_TEST_OPTION(26) THREAD_TEST_OPTION(27)
+    THREAD_TEST_OPTION(28) THREAD_TEST_OPTION(29) THREAD_TEST_OPTION(30) THREAD_TEST_OPTION(31)
+  };
+#undef THREAD_TEST_OPTION
+
+  constexpr int kOptionCount = 32;
+
+  std::string optionName(int index) {
+    return "rtx.threadTest.value" + std::to_string(index);
+  }
+
+  std::vector<RtxOption<float>*> testOptions() {
+    std::vector<RtxOption<float>*> options;
+    for (int i = 0; i < kOptionCount; ++i) {
+      options.push_back(static_cast<RtxOption<float>*>(RtxOptionImpl::getOptionByFullName(optionName(i))));
+    }
+    return options;
+  }
+
+  // What remixapi_SetConfigVariable does with a key that is not in a dynamic namespace.
+  void setConfigVariable(RtxOptionImpl& option, const std::string& value) {
+    Config setting;
+    setting.setOption(option.getFullName(), value);
+    option.readOption(setting, option.getTargetLayer(RtxOptionLayer::getUserLayer()));
+  }
+
+  // Stands in for the render thread: resolves options like the end of a frame, after its own work, until stopped.
+  class RenderThread {
+  public:
+    explicit RenderThread(std::function<void()> work = {})
+      : m_work(std::move(work))
+      , m_thread([this] { run(); }) { }
+
+    ~RenderThread() {
+      stop();
+    }
+
+    void stop() {
+      m_stop = true;
+      if (m_thread.joinable()) {
+        m_thread.join();
+      }
+    }
+
+    // Returns once two whole passes have run after the call, so every write made before it has been resolved.
+    void waitForPasses() const {
+      const uint64_t target = m_passes.load() + 2;
+      while (m_passes.load() < target) {
+        std::this_thread::yield();
+      }
+    }
+
+  private:
+    void run() {
+      while (!m_stop.load()) {
+        if (m_work) {
+          m_work();
+        }
+        RtxOptionManager::applyPendingValues(nullptr, false);
+        m_passes.fetch_add(1);
+      }
+    }
+
+    std::function<void()> m_work;
+    std::atomic<bool> m_stop { false };
+    std::atomic<uint64_t> m_passes { 0 };
+    std::thread m_thread;  // Last, so the members above exist when it starts.
+  };
+
+  // Writes round * 100 + index to every option, then checks each was resolved once the render thread has caught up.
+  void writeRoundAndCheck(const std::vector<RtxOption<float>*>& options, const RenderThread& render, int round) {
+    for (int i = 0; i < kOptionCount; ++i) {
+      setConfigVariable(*options[i], std::to_string(round * 100 + i));
+    }
+    render.waitForPasses();
+    for (int i = 0; i < kOptionCount; ++i) {
+      const float expected = static_cast<float>(round * 100 + i);
+      TEST_ASSERT(options[i]->get() == expected,
+                  "round " << round << ": " << optionName(i) << " resolved to " << options[i]->get() << ", not "
+                  << expected << "; the write was not resolved");
+    }
+  }
+
+  // ============================================================================
+  // remixapi_SetConfigVariable on the game's thread while the render thread resolves: the R13 crash. readOption
+  // inserted into the option's layer values and the dirty option map without the update mutex, while
+  // applyPendingValues walked that map under it (an entry still holding nullptr was resolved: 0x50 is m_type).
+  // ============================================================================
+
+  void test_apiWritesDuringResolve() {
+    std::cout << "  Running test_apiWritesDuringResolve..." << std::endl;
+    const std::vector<RtxOption<float>*> options = testOptions();
+    RenderThread render;
+
+    // As fast as the API allows; the companion's sky sends each changed value every 20 ms.
+    const auto end = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    uint64_t writes = 0;
+    while (std::chrono::steady_clock::now() < end) {
+      for (RtxOption<float>* option : options) {
+        setConfigVariable(*option, std::to_string(writes++ % 1000));
+      }
+    }
+
+    // A write made while applyPendingValues ends its frame must be resolved too, not dropped with the frame's marks.
+    for (int round = 1; round <= 500; ++round) {
+      writeRoundAndCheck(options, render, round);
+    }
+    render.stop();
+    std::cout << "    " << writes << " writes; PASSED" << std::endl;
+  }
+
+  // ============================================================================
+  // The render thread's graph acquires and releases an option layer (RtxOptionLayerAction) while the game's thread
+  // sets options and the menu asks which layer blocks an edit. acquireLayer and releaseLayer added to and removed from
+  // every option's layer values, marked them dirty and changed the layer registry holding only the layer mutex.
+  // ============================================================================
+
+  void test_layerChurnDuringApiWrites() {
+    std::cout << "  Running test_layerChurnDuringApiWrites..." << std::endl;
+    const std::vector<RtxOption<float>*> options = testOptions();
+    Config graphConfig;
+    for (int i = 0; i < kOptionCount; ++i) {
+      graphConfig.setOption(optionName(i), std::string("-1"));
+    }
+    const RtxOptionLayerKey graphKey = { kDefaultDynamicRtxOptionLayerPriority, "ThreadTestGraphLayer" };
+    std::atomic<uint64_t> cycles { 0 };
+    RenderThread render([&] {
+      const RtxOptionLayer* layer = RtxOptionManager::acquireLayer("", graphKey, 1.0f, 0.1f, false, &graphConfig);
+      RtxOptionManager::applyPendingValues(nullptr, false);
+      RtxOptionManager::releaseLayer(layer);
+      cycles.fetch_add(1);
+    });
+
+    const RtxOptionLayer* userLayer = RtxOptionLayer::getUserLayer();
+    const auto end = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    uint64_t writes = 0;
+    while (std::chrono::steady_clock::now() < end) {
+      for (RtxOption<float>* option : options) {
+        setConfigVariable(*option, std::to_string(writes++ % 1000));
+        TEST_ASSERT(option->getBlockingLayer(userLayer) == nullptr, "only the quality layer is stronger, and it is empty");
+      }
+    }
+
+    // The user layer is stronger than the graph's, so the last API write wins whether or not the graph layer is there.
+    for (int round = 1; round <= 100; ++round) {
+      writeRoundAndCheck(options, render, round);
+    }
+    render.stop();
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    TEST_ASSERT(RtxOptionManager::getLayer(graphKey) == nullptr, "the graph layer is released");
+    std::cout << "    " << writes << " writes, " << cycles.load() << " layer cycles; PASSED" << std::endl;
+  }
+
+  // ============================================================================
+  // The Remix menu runs on the game's thread (ImGUI::render, from Present). Its migration moves a layer's misplaced
+  // values, Discard Changes reloads a layer from its file, and Unblock clears the layers stronger than the one edited.
+  // None held the update mutex, while the render thread resolved and edited options (onChange callbacks do).
+  // ============================================================================
+
+  void test_menuActionsDuringResolve() {
+    std::cout << "  Running test_menuActionsDuringResolve..." << std::endl;
+    const std::vector<RtxOption<float>*> options = testOptions();
+    const std::filesystem::path path = std::filesystem::temp_directory_path() / "rtx_option_threads_menu.conf";
+    {
+      std::ofstream file(path, std::ios::trunc);
+      for (int i = 0; i < kOptionCount; ++i) {
+        file << optionName(i) << " = " << (7 + i) << "\n";
+      }
+    }
+    const RtxOptionLayerKey fileKey = { kDefaultDynamicRtxOptionLayerPriority + 1, "ThreadTestFileLayer" };
+    RtxOptionLayer* fileLayer = RtxOptionManager::acquireLayer(path.string(), fileKey, 1.0f, 0.1f, false, nullptr);
+    TEST_ASSERT(fileLayer != nullptr && fileLayer->isValid(), "the file layer was read");
+
+    std::atomic<uint64_t> edits { 0 };
+    RenderThread render([&] {
+      const uint64_t edit = edits.fetch_add(1);
+      options[edit % kOptionCount]->setDeferred(static_cast<float>(edit % 1000), fileLayer);
+    });
+
+    RtxOptionLayer* userLayer = const_cast<RtxOptionLayer*>(RtxOptionLayer::getUserLayer());
+    uint64_t actions = 0;
+    const auto end = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    while (std::chrono::steady_clock::now() < end) {
+      // The test options lack the UserSetting flag, so in user.conf they are developer settings for rtx.conf.
+      setConfigVariable(*options[actions % kOptionCount], "3");
+      userLayer->migrateMiscategorizedOptions();
+      fileLayer->reload();
+      for (RtxOption<float>* option : options) {
+        option->clearFromStrongerLayers(fileLayer);
+      }
+      ++actions;
+    }
+    render.stop();
+
+    // With the render thread's edits discarded and nothing stronger, every option has the file's value.
+    TEST_ASSERT(fileLayer->reload(), "the file layer reloads");
+    for (RtxOption<float>* option : options) {
+      option->clearFromStrongerLayers(fileLayer);
+    }
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    for (int i = 0; i < kOptionCount; ++i) {
+      TEST_ASSERT(options[i]->get() == static_cast<float>(7 + i),
+                  optionName(i) << " resolved to " << options[i]->get() << ", not the file's " << (7 + i));
+    }
+    RtxOptionManager::releaseLayer(fileLayer);
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    std::filesystem::remove(path);
+    std::cout << "    " << actions << " menu rounds, " << edits.load() << " render-thread edits; PASSED" << std::endl;
+  }
+
+  void runAllTests() {
+    std::cout << "Running RtxOption threading tests" << std::endl;
+
+    RtxOptionLayer::initializeSystemLayers();
+    RtxOptionImpl::setInitialized(true);
+    RtxOptionManager::markOptionsWithCallbacksDirty();
+    RtxOptionManager::applyPendingValues(nullptr, true);
+
+    test_apiWritesDuringResolve();
+    test_layerChurnDuringApiWrites();
+    test_menuActionsDuringResolve();
+
+    std::cout << "All RtxOption threading tests PASSED" << std::endl;
+  }
+
+}  // namespace rtx_option_threads_test
+}  // namespace dxvk
+
+int main() {
+  try {
+    dxvk::rtx_option_threads_test::runAllTests();
+  } catch (const dxvk::DxvkError& error) {
+    std::cerr << "TEST FAILED: " << error.message() << std::endl;
+    return -1;
+  } catch (const std::exception& e) {
+    std::cerr << "TEST FAILED with exception: " << e.what() << std::endl;
+    return -1;
+  }
+  return 0;
+}
