+    double calculateChernoffMargin(const double mu) {
+      if (mu <= 0.0) {
+        return 0.0;
+      }
+
+      const double t = std::log(1.0 / kCapacityOverflowProbability);
+      return (t + std::sqrt(t * t + 8.0 * mu * t)) / (2.0 * mu);
