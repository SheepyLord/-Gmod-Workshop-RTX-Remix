@@ -69,6 +69,113 @@ namespace {
 
 namespace dxvk {
 
+  namespace {
+    // A replacement (mesh, or a light or material attached to one) authored against a mesh hash
+    // silently stops applying when the game, a module or the runtime changes that hash.
+    struct ReplacementLookupLog {
+      RTX_OPTION("rtx.usd", bool, logReplacementLookups, false,
+                 "Diagnostic: logs each distinct mesh replacement hash once when it is first looked up, with whether a mod "
+                 "matched it, its geometry and material hash parts, albedo texture hash, vertex count and world-space centre. "
+                 "Game (D3D9) lights are logged the same way with their light hash, and where a matched light override lands. "
+                 "Used to find mod replacements whose hash no longer occurs.");
+    };
+
+    void logGameLight(const D3DLIGHT9& light, const RtLight& rtLight, bool matched) {
+      static std::unordered_set<XXH64_hash_t> s_logged;  // only touched on the render (CS) thread
+      if (s_logged.size() >= 10000 || !s_logged.insert(rtLight.getInitialHash()).second) {
+        return;
+      }
+      Logger::info(str::format("[Replacement-GameLight] light 0x", std::hex, rtLight.getInitialHash(), std::dec,
+                               matched ? " MATCH" : " miss", " d3dtype ", uint32_t(light.Type),
+                               " pos (", light.Position.x, ", ", light.Position.y, ", ", light.Position.z, ")",
+                               " dir (", light.Direction.x, ", ", light.Direction.y, ", ", light.Direction.z, ")",
+                               " diffuse (", light.Diffuse.r, ", ", light.Diffuse.g, ", ", light.Diffuse.b, ")",
+                               " range ", light.Range, " atten (", light.Attenuation0, ", ", light.Attenuation1, ", ", light.Attenuation2, ")",
+                               " radiance (", rtLight.getRadiance().x, ", ", rtLight.getRadiance().y, ", ", rtLight.getRadiance().z, ")"));
+    }
+
+    // How often a replaced game light's replacement had to be created again (its instance was
+    // collected in between) against how many frames it was submitted; logged at 1, 2, 4, 8, ... creations,
+    // and per 600-frame window in which the game submitted it at all.
+    void logGameLightReplacementLifetime(XXH64_hash_t gameLightHash, bool created, uint32_t frameId) {
+      struct Lifetime { uint32_t created = 0, framesSeen = 0, lastFrame = UINT32_MAX, windowStart = 0, windowSeen = 0, windows = 0; };
+      static std::unordered_map<XXH64_hash_t, Lifetime> s_lifetimes;  // only touched on the render (CS) thread
+      if (s_lifetimes.size() >= 10000 && s_lifetimes.find(gameLightHash) == s_lifetimes.end()) {
+        return;
+      }
+      Lifetime& l = s_lifetimes[gameLightHash];
+      if (l.lastFrame != frameId) {
+        if (l.lastFrame == UINT32_MAX || frameId - l.windowStart >= 600) {
+          if (l.lastFrame != UINT32_MAX && l.windows < 64) {
+            ++l.windows;
+            Logger::info(str::format("[Replacement-GameLight] light 0x", std::hex, gameLightHash, std::dec, " submitted in ", l.windowSeen,
+                                     " frames of window from frame ", l.windowStart, " (last ", l.lastFrame, "), created ", l.created, " times"));
+          }
+          l.windowStart = frameId;
+          l.windowSeen = 0;
+        }
+        l.lastFrame = frameId;
+        ++l.framesSeen;
+        ++l.windowSeen;
+      }
+      if (created && (++l.created & (l.created - 1)) == 0) {
+        Logger::info(str::format("[Replacement-GameLight] light 0x", std::hex, gameLightHash, std::dec,
+                                 " replacement created ", l.created, " times, submitted in ", l.framesSeen, " frames (frame ", frameId, ")"));
+      }
+    }
+
+    void logGameLightReplacement(const RtLight& gameLight, size_t index, const RtLight& replacement) {
+      static std::unordered_set<XXH64_hash_t> s_logged;  // only touched on the render (CS) thread
+      if (s_logged.size() >= 10000 || !s_logged.insert(gameLight.getInitialHash() ^ (0x9E3779B97F4A7C15ull * (index + 1))).second) {
+        return;
+      }
+      const Vector3 p = replacement.getPosition();
+      const Vector3 r = replacement.getRadiance();
