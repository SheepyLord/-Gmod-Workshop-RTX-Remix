+    const XXH64_hash_t hashA = 0x0123456789ABCDEF;
+    const XXH64_hash_t hashB = 0xFEDCBA9876543210;
+    RtxOptionHashSetCopy copy(TestOptions::testHashSetCopy);
+    auto refresh = [&copy] {
+      std::lock_guard<std::mutex> lock(RtxOptionImpl::getUpdateMutex());
+      copy.refreshLocked();
