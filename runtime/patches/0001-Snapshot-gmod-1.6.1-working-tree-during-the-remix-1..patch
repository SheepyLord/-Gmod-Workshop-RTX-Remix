-
-    if (idx > 0 && eq(b, m_table.back())) {
-      return idx - 1;
-    }
-
-    m_table.push_back(b);
-    return idx;
-  }
-
-  const std::vector<BufferType>& getObjectTable() const {
-    return m_table;
-  }
-
-  uint32_t getActiveCount() const {
-    return m_table.size();
-  }
-
-  uint32_t getTotalCount() const {
-    return m_table.size();
-  }
-
-  std::vector<BufferType> m_table;
-};
-
