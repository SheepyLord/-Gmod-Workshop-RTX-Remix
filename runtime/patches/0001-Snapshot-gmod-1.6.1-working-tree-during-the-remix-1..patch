diff --git a/src/dxvk/rtx_render/rtx_usd_value.h b/src/dxvk/rtx_render/rtx_usd_value.h
new file mode 100644
index 00000000..ee261944
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_usd_value.h
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: MIT (same terms as the rest of dxvk-remix)
+#pragma once
+
+// Checked conversion of authored USD values into Remix parameter types.
+//
+// Upstream reads material and light attributes with VtValue::UncheckedGet<T>(),
+// which is undefined behaviour (and can crash) whenever the authored type is not
+// exactly T. This fork then required an exact VtValue::IsHolding<T>() match,
+// which made every colour unreadable (USD holds GfVec3f/GfVec3d/GfVec3h, never
+// dxvk's Vector3) together with enums and any byte-sized value not authored as
+// uchar: diffuse/emissive colour constants, subsurface colours, light colours,
+// filter and wrap modes, sprite sheets and alpha-test settings all fell back to
+// their defaults. These conversions accept the types USD tools actually write,
+// range-check integers and reject non-finite values, without ever reinterpreting
+// storage. Two authoring slips seen in shipped mods are read by intent: a scalar
+// written for a colour is a grey, and a float alpha_test_reference_value is the
+// [0, 1] alpha MDL declares rather than Remix's 0-255 byte.
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <type_traits>
+
+#include "../../util/util_vector.h"
+#include "rtx_option.h"
+
+#include "../../lssusd/usd_include_begin.h"
+#include <pxr/base/vt/value.h>
+#include <pxr/base/gf/half.h>
+#include <pxr/base/gf/vec3d.h>
+#include <pxr/base/gf/vec3f.h>
+#include <pxr/base/gf/vec3h.h>
+#include "../../lssusd/usd_include_end.h"
+
+namespace dxvk::usd_value {
+
+  // Before its Remix 1.6.1 update this fork rejected every colour input (an exact type
+  // check against dxvk's Vector3), so lights stayed white and material colour constants
+  // kept their defaults. Scenes and mods tuned on that fork were tuned with that look.
+  struct LegacyOptions {
+    RTX_OPTION("rtx.usd", bool, legacyIgnoreColors, false,
+               "Ignores authored colour inputs the way this fork did before its Remix 1.6.1 update: light colors stay white and "
+               "material colour constants (diffuse, emissive, emissive tint, transmittance, subsurface colours and radius) keep their defaults. "
+               "Keeps the look of scenes tuned on that fork; mods authored for upstream Remix expect these colours applied. "
+               "Read when a mod loads, so a change takes effect after a mod reload.");
+  };
+
+  template<typename T>
+  inline bool legacyIgnored() {
+    return std::is_same_v<T, Vector3> && LegacyOptions::legacyIgnoreColors();
+  }
+
+  // Any integral USD scalar (uchar, int, uint, int64, uint64, bool).
+  inline bool toInteger(const pxr::VtValue& value, int64_t& out) {
+    if (value.IsHolding<unsigned char>()) { out = value.UncheckedGet<unsigned char>(); return true; }
+    if (value.IsHolding<int>()) { out = value.UncheckedGet<int>(); return true; }
+    if (value.IsHolding<unsigned int>()) { out = value.UncheckedGet<unsigned int>(); return true; }
+    if (value.IsHolding<int64_t>()) { out = value.UncheckedGet<int64_t>(); return true; }
+    if (value.IsHolding<uint64_t>()) {
+      const uint64_t v = value.UncheckedGet<uint64_t>();
+      if (v > uint64_t(std::numeric_limits<int64_t>::max())) {
+        return false;
+      }
+      out = int64_t(v);
+      return true;
+    }
+    if (value.IsHolding<bool>()) { out = value.UncheckedGet<bool>() ? 1 : 0; return true; }
+    return false;
+  }
+
+  inline bool isReal(const pxr::VtValue& value) {
+    return value.IsHolding<float>() || value.IsHolding<double>() || value.IsHolding<pxr::GfHalf>();
+  }
+
+  // Any real or integral USD scalar.
+  inline bool toReal(const pxr::VtValue& value, double& out) {
+    if (value.IsHolding<float>()) { out = value.UncheckedGet<float>(); }
+    else if (value.IsHolding<double>()) { out = value.UncheckedGet<double>(); }
+    else if (value.IsHolding<pxr::GfHalf>()) { out = float(value.UncheckedGet<pxr::GfHalf>()); }
+    else {
+      int64_t i;
+      if (!toInteger(value, i)) {
+        return false;
+      }
+      out = double(i);
+    }
+    return std::isfinite(out);
+  }
+
+  inline bool convert(const pxr::VtValue& value, float& out) {
+    double d;
+    if (!toReal(value, d) || std::abs(d) > double(std::numeric_limits<float>::max())) {
+      return false;
+    }
+    out = float(d);
+    return true;
+  }
+
+  inline bool convert(const pxr::VtValue& value, bool& out) {
+    int64_t i;
+    if (!toInteger(value, i)) {
+      return false;
+    }
+    out = i != 0;
+    return true;
+  }
+
+  // Integers, or reals holding a whole number (4.0 rows, 128.0), in 0-255.
+  inline bool convert(const pxr::VtValue& value, uint8_t& out) {
+    int64_t i;
+    double d;
+    if (toInteger(value, i)) {
+      if (i < 0 || i > 255) {
+        return false;
+      }
+      out = uint8_t(i);
+      return true;
+    }
+    if (!toReal(value, d) || d < 0.0 || d > 255.0 || d != std::floor(d)) {
+      return false;
+    }
+    out = uint8_t(d);
+    return true;
+  }
+
+  inline bool convert(const pxr::VtValue& value, Vector3& out) {
+    Vector3 v;
+    double d;
+    if (toReal(value, d) && std::abs(d) <= double(std::numeric_limits<float>::max())) {
+      v = Vector3(float(d));  // a scalar authored for a colour input is a grey
+    } else if (value.IsHolding<pxr::GfVec3f>()) {
+      const pxr::GfVec3f& g = value.UncheckedGet<pxr::GfVec3f>();
+      v = Vector3(g[0], g[1], g[2]);
+    } else if (value.IsHolding<pxr::GfVec3d>()) {
+      const pxr::GfVec3d& g = value.UncheckedGet<pxr::GfVec3d>();
+      v = Vector3(float(g[0]), float(g[1]), float(g[2]));
+    } else if (value.IsHolding<pxr::GfVec3h>()) {
+      const pxr::GfVec3h& g = value.UncheckedGet<pxr::GfVec3h>();
+      v = Vector3(float(g[0]), float(g[1]), float(g[2]));
+    } else {
+      return false;
+    }
+    if (!std::isfinite(v.x) || !std::isfinite(v.y) || !std::isfinite(v.z)) {
+      return false;
+    }
+    out = v;
+    return true;
+  }
+
+  // Enums with kMinValue/kMaxValue (BlendType, AlphaTestType), authored as any integer.
+  template<typename E, std::enable_if_t<std::is_enum_v<E>, int> = 0>
+  inline bool convert(const pxr::VtValue& value, E& out) {
+    int64_t i;
+    if (!toInteger(value, i) || i < int64_t(E::kMinValue) || i > int64_t(E::kMaxValue)) {
+      return false;
+    }
+    out = E(i);
+    return true;
+  }
+
+  // Per-attribute entry point for material constants.
+  template<typename T>
+  inline bool convertAttribute(const char* /*usdAttr*/, const pxr::VtValue& value, T& out) {
+    return convert(value, out);
+  }
+
+  // MDL declares alpha_test_reference_value as a float alpha in [0, 1]; Remix keeps the
+  // D3D9 0-255 byte (and captures write it as uchar). Reals in [0, 1] are scaled.
+  inline bool convertAttribute(const char* usdAttr, const pxr::VtValue& value, uint8_t& out) {
+    double d;
+    if (std::strcmp(usdAttr, "alpha_test_reference_value") == 0 &&
+        isReal(value) && toReal(value, d) && d >= 0.0 && d <= 1.0) {
+      out = uint8_t(std::lround(d * 255.0));
+      return true;
+    }
+    return convert(value, out);
+  }
+
+} // namespace dxvk::usd_value
