+    TEST_ASSERT(!copy.contains(hashA), "The copy should not change until it is refreshed");
+    refresh();
+    TEST_ASSERT(copy.contains(hashA) && !copy.contains(hashB), "A refreshed copy should match the resolved set");
+
+    // Bit distinct from real RtxOptionFlags values, like test_invalidationScope's.
