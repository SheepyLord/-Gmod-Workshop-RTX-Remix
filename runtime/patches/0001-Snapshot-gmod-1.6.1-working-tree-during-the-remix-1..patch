+  io.AddKeyEvent(ImGuiKey_ModAlt, down[4] || down[5]);
+  io.AddKeyEvent(ImGuiKey_ModSuper, down[6] || down[7]);
+  for (int i = 0; i < IM_ARRAYSIZE(virtualKeys); ++i) {
