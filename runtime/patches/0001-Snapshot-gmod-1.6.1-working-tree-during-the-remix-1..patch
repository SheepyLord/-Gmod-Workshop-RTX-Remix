diff --git a/src/d3d9/d3d9_texture_hash.h b/src/d3d9/d3d9_texture_hash.h
new file mode 100644
index 00000000..6e1b8033
--- /dev/null
+++ b/src/d3d9/d3d9_texture_hash.h
@@ -0,0 +1,154 @@
+#pragma once
+
+#include "d3d9_format.h"
+
+#include "../util/util_math.h"
+
+// XXH64_state_t and XXH3_state_t, so the hash states can live on the stack
+#ifndef XXH_STATIC_LINKING_ONLY
+#define XXH_STATIC_LINKING_ONLY
+#endif
+#include "../util/xxHash/xxhash.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+namespace dxvk {
+
+  /**
+   * \brief Texel bits a D3D9 format defines
+   *
+   * The X channel of formats such as X8R8G8B8 is padding: applications
+   * need not write it, and it reads as one. So it often holds leftover
+   * bytes that differ between uploads of the same image (Source's opaque
+   * textures do), and it must not reach texture hashes.
+   */
+  struct D3D9TexelBits {
+    uint32_t Size; ///< Texel size in bytes, 0 if the format defines every bit
+    uint32_t Mask; ///< Defined bits of a little-endian texel
+  };
+
+
+  inline D3D9TexelBits GetDefinedTexelBits(D3D9Format Format) {
+    switch (Format) {
+      case D3D9Format::X8R8G8B8:
+      case D3D9Format::X8B8G8R8:
+      case D3D9Format::X8L8V8U8: return { 4, 0x00ffffff };
+      case D3D9Format::X1R5G5B5: return { 2, 0x7fff };
+      case D3D9Format::X4R4G4B4: return { 2, 0x0fff };
+      default:                   return { 0, 0 };
+    }
+  }
+
+
+  /**
+   * \brief Copies whole texels, clearing their undefined bits
+   */
+  inline void CopyDefinedTexelBits(
+          uint8_t*      pDst,
+    const uint8_t*      pSrc,
+          size_t        Size,
+          D3D9TexelBits Bits) {
+    if (Bits.Size == 4) {
+      for (size_t i = 0; i < Size; i += 4) {
+        uint32_t texel;
+        std::memcpy(&texel, pSrc + i, sizeof(texel));
+        texel &= Bits.Mask;
+        std::memcpy(pDst + i, &texel, sizeof(texel));
+      }
+    } else {
+      for (size_t i = 0; i < Size; i += 2) {
+        uint16_t texel;
+        std::memcpy(&texel, pSrc + i, sizeof(texel));
+        texel &= uint16_t(Bits.Mask);
+        std::memcpy(pDst + i, &texel, sizeof(texel));
+      }
+    }
+  }
+
+
+  /**
+   * \brief Passes rows of texels to \p Consume in small chunks,
+   * with undefined texel bits and the row padding zeroed
+   */
+  template<typename Fn>
+  void ForEachDefinedTexelChunk(
+    const uint8_t*      pData,
+          size_t        Size,
+          size_t        RowBytes,
+          size_t        RowPitch,
+          D3D9TexelBits Bits,
+    const Fn&           Consume) {
+    // Texels and row padding come in multiples of the texel size, and
+    // the chunk size is a multiple of 4, so no texel spans two chunks.
+    alignas(16) uint8_t chunk[4096];
+    size_t chunkSize = 0;
+
+    for (size_t rowOffset = 0; rowOffset < Size; rowOffset += RowPitch) {
+      for (size_t i = 0; i < RowPitch; ) {
+        const bool   isTexel = i < RowBytes;
+        const size_t count   = std::min((isTexel ? RowBytes : RowPitch) - i, sizeof(chunk) - chunkSize);
+
+        if (isTexel)
+          CopyDefinedTexelBits(chunk + chunkSize, pData + rowOffset + i, count, Bits);
+        else
+          std::memset(chunk + chunkSize, 0, count);
+
+        chunkSize += count;
+        i += count;
+
+        if (chunkSize == sizeof(chunk)) {
+          Consume(chunk, chunkSize);
+          chunkSize = 0;
+        }
+      }
+    }
+
+    if (chunkSize != 0)
+      Consume(chunk, chunkSize);
+  }
+
+
+  /**
+   * \brief Hashes the top mip of a texture for RTX
+   *
+   * XXH64 (seed 0) if \p UseXXH64 is set, XXH3 otherwise, of \p Size bytes
+   * of rows with the pitch of D3D9 mappings, align(Width * texel size, 4).
+   * For formats with undefined bits, those bits and the row padding are
+   * hashed as zero, so the hash only depends on what the application wrote.
+   * Data that has them zero already hashes as a one-shot hash of it does,
+   * and other formats hash their bytes unchanged.
+   */
+  inline XXH64_hash_t HashTextureData(
+    const void*       pData,
+          size_t      Size,
+          D3D9Format  Format,
+          uint32_t    Width,
+          bool        UseXXH64) {
+    const D3D9TexelBits bits = GetDefinedTexelBits(Format);
+    const size_t rowBytes = size_t(Width) * bits.Size;
+    const size_t rowPitch = align(rowBytes, 4);
+
+    // Formats without undefined bits, and data that is not whole rows, hash as they are
+    if (rowBytes == 0 || Size % rowPitch != 0)
+      return UseXXH64 ? XXH64(pData, Size, 0) : XXH3_64bits(pData, Size);
+
+    const uint8_t* data = reinterpret_cast<const uint8_t*>(pData);
+
+    if (UseXXH64) {
+      XXH64_state_t state;
+      XXH64_reset(&state, 0);
+      ForEachDefinedTexelChunk(data, Size, rowBytes, rowPitch, bits,
+        [&state] (const void* pChunk, size_t ChunkSize) { XXH64_update(&state, pChunk, ChunkSize); });
+      return XXH64_digest(&state);
+    }
+
+    XXH3_state_t state;
+    XXH3_64bits_reset(&state);
+    ForEachDefinedTexelChunk(data, Size, rowBytes, rowPitch, bits,
+      [&state] (const void* pChunk, size_t ChunkSize) { XXH3_64bits_update(&state, pChunk, ChunkSize); });
+    return XXH3_64bits_digest(&state);
+  }
+
+}
