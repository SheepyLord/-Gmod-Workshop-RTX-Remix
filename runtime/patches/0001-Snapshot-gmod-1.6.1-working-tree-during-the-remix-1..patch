diff --git a/.github/workflows/gmod-release.yml b/.github/workflows/gmod-release.yml
new file mode 100644
index 00000000..d8703a1d
--- /dev/null
+++ b/.github/workflows/gmod-release.yml
@@ -0,0 +1,101 @@
+name: GMod Release
+
+# Builds the x64 Garry's Mod runtime and publishes it in the layout RTXLauncher installs:
+# a single zip whose contents are copied flat into GarrysMod/bin/win64.
+#   - Pushes to the GMod branch refresh the rolling "nightly" prerelease.
+#   - Running the workflow manually with a tag publishes a stable release under that tag.
+
+on:
+  push:
+    branches: [ gmod-1.6.1 ]
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: Stable release tag to publish. Leave empty to refresh the nightly.
+        required: false
+        default: ''
+
+permissions:
+  contents: write
+
+concurrency:
+  group: gmod-release-${{ github.ref }}-${{ inputs.tag }}
+  cancel-in-progress: true
+
+jobs:
+  build-windows-x64:
+    runs-on: windows-2022
+
+    steps:
+    - name: Checkout code
+      uses: actions/checkout@v4
+      with:
+        submodules: recursive
+
+    - name: Setup Meson
+      run: pip install meson==1.1.0
+
+    - name: Install Pillow for FAST-noise embedder
+      run: pip install pillow
+
+    # No scripts/update-dlss-dlls.ps1 here: its pinned bundle (310.6.0) is older than the
+    # DLSS SDK submodule that RTX Remix 1.6.1 ships (310.9.1).
+    - name: Build
+      shell: pwsh
+      run: |
+        Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope Process
+        . .\build_common.ps1
+        PerformBuild -BuildFlavour release -BuildSubDir _CompRelease_x64 -Backend ninja -EnableTracy false -InstallTags output -SkipApics $true
+
+    - name: Upload build logs
+      if: ${{ always() }}
+      continue-on-error: true
+      uses: actions/upload-artifact@v4
+      with:
+        name: build-logs-${{ github.run_number }}
+        path: |
+          _CompRelease_x64\meson-logs\meson-log.txt
+          _CompRelease_x64\update-deps.log
+          update-deps.log
+        if-no-files-found: ignore
+        retention-days: 14
+
+    - name: Package
+      id: package
+      shell: pwsh
+      run: |
+        $shortSha = "${{ github.sha }}".Substring(0, 7)
+        $tag = "${{ inputs.tag }}"
+        if ([string]::IsNullOrEmpty($tag)) {
+          $zipName = "dxvk-remix-gmod-nightly.zip"
+        } else {
+          $zipName = "remix-$tag-gmod.zip"
+        }
+        Compress-Archive -Path _output\* -DestinationPath $zipName -CompressionLevel Optimal
+        "zip=$zipName" >> $env:GITHUB_OUTPUT
+        "shortsha=$shortSha" >> $env:GITHUB_OUTPUT
+
+    - name: Publish nightly
+      if: ${{ inputs.tag == '' }}
+      shell: pwsh
+      env:
+        GH_TOKEN: ${{ github.token }}
+      run: |
+        # RTXLauncher's nightly channel looks for the release tagged "nightly".
