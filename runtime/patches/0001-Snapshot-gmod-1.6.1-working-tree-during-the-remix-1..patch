+static const uint kNrcTrainingQueryOffsetBitsPerAxis = NRC_TRAINING_QUERY_OFFSET_BITS_PER_AXIS;
+static const uint kNrcTrainingQueryOffsetMask = (1u << kNrcTrainingQueryOffsetBitsPerAxis) - 1u;
+static const uint kNrcTrainingQueryKeyShift = 2u * kNrcTrainingQueryOffsetBitsPerAxis;
