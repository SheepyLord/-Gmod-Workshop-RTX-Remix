+uint packNrcTrainingQueryReservoirEntry(uint key, uvec2 queryPixelOffsetInCell)
+{
+  return (key << kNrcTrainingQueryKeyShift) |
+         ((queryPixelOffsetInCell.y & kNrcTrainingQueryOffsetMask) << kNrcTrainingQueryOffsetBitsPerAxis) |
+         (queryPixelOffsetInCell.x & kNrcTrainingQueryOffsetMask);
