+
+  class DlssNeuralRendering : public DxvkDLSS {
+  public:
+    explicit DlssNeuralRendering(DxvkDevice* device);
+
+    bool supportsDlssNeuralRendering() const;
+
+    void showDlssNeuralRenderingImguiSettings();
+
