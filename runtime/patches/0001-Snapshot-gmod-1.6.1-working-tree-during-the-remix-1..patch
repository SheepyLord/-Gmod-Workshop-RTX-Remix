diff --git a/tests/rtx/unit/test_d3d9_texture_hash.cpp b/tests/rtx/unit/test_d3d9_texture_hash.cpp
new file mode 100644
index 00000000..da7b87a0
--- /dev/null
+++ b/tests/rtx/unit/test_d3d9_texture_hash.cpp
@@ -0,0 +1,182 @@
+#include <cstring>
+#include <iostream>
+#include <random>
+#include <vector>
+
+#include "../../../src/d3d9/d3d9_texture_hash.h"
+
+using namespace dxvk;
+
+namespace {
+
+  bool g_passed = true;
+
+  void Check(bool condition, const char* what, D3D9Format format, uint32_t width, uint32_t height, bool xxh64) {
+    if (condition)
+      return;
+
+    std::cerr << "FAILED: " << what << " (format " << uint32_t(format) << ", " << width << "x" << height
+              << ", " << (xxh64 ? "XXH64" : "XXH3") << ")\n";
+    g_passed = false;
+  }
+
+  XXH64_hash_t HashOneShot(const std::vector<uint8_t>& data, bool xxh64) {
+    return xxh64 ? XXH64(data.data(), data.size(), 0) : XXH3_64bits(data.data(), data.size());
+  }
+
+  uint32_t ReadTexel(const std::vector<uint8_t>& data, size_t offset, uint32_t size) {
+    uint32_t texel = 0;
+    std::memcpy(&texel, data.data() + offset, size);
+    return texel;
+  }
+
+  void WriteTexel(std::vector<uint8_t>& data, size_t offset, uint32_t size, uint32_t texel) {
+    std::memcpy(data.data() + offset, &texel, size);
+  }
+
+  // Rows as D3D9 maps them, align(width * texel size, 4) bytes each. Clean has the
+  // undefined bits and the row padding zero, dirty the same texels with random ones.
+  struct TestImage {
+    size_t rowBytes;
+    size_t rowPitch;
+    std::vector<uint8_t> clean;
+    std::vector<uint8_t> dirty;
+  };
+
+  TestImage MakeImage(D3D9TexelBits bits, uint32_t width, uint32_t height, std::mt19937& rng) {
+    TestImage image;
+    image.rowBytes = size_t(width) * bits.Size;
+    image.rowPitch = align(image.rowBytes, 4);
+    image.clean.resize(image.rowPitch * height);
+    image.dirty.resize(image.rowPitch * height);
+
+    const uint32_t texelBits = bits.Size == 4 ? 0xffffffffu : 0xffffu;
+    const uint32_t undefined = texelBits & ~bits.Mask;
+
+    for (uint32_t y = 0; y < height; y++) {
+      for (size_t x = 0; x < image.rowPitch; x += bits.Size) {
+        const size_t offset = y * image.rowPitch + x;
+
+        if (x < image.rowBytes) {
+          const uint32_t texel = rng() & bits.Mask;
+          // Set every undefined bit of a row's first texel, so each row differs
+          const uint32_t pad = x == 0 ? undefined : rng() & undefined;
+          WriteTexel(image.clean, offset, bits.Size, texel);
+          WriteTexel(image.dirty, offset, bits.Size, texel | pad);
+        } else {
+          WriteTexel(image.clean, offset, bits.Size, 0);
+          WriteTexel(image.dirty, offset, bits.Size, rng() | 1);
+        }
+      }
+    }
+
+    return image;
+  }
+
+  struct FormatBits {
+    D3D9Format    format;
+    D3D9TexelBits bits;
+  };
+
+  // The formats with undefined bits, and the bits they define
+  const FormatBits g_undefinedBitFormats[] = {
+    { D3D9Format::X8R8G8B8, { 4, 0x00ffffff } },
+    { D3D9Format::X8B8G8R8, { 4, 0x00ffffff } },
+    { D3D9Format::X8L8V8U8, { 4, 0x00ffffff } },
+    { D3D9Format::X1R5G5B5, { 2, 0x7fff } },
+    { D3D9Format::X4R4G4B4, { 2, 0x0fff } },
+  };
+
+  void TestFormatWithUndefinedBits(D3D9Format format, D3D9TexelBits bits, uint32_t width, uint32_t height, std::mt19937& rng) {
+    const TestImage image = MakeImage(bits, width, height, rng);
+
+    for (bool xxh64 : { true, false }) {
+      const XXH64_hash_t expected = HashOneShot(image.clean, xxh64);
+
+      Check(HashTextureData(image.clean.data(), image.clean.size(), format, width, xxh64) == expected,
+        "zero pads no longer hash as the one-shot hash", format, width, height, xxh64);
+      Check(HashTextureData(image.dirty.data(), image.dirty.size(), format, width, xxh64) == expected,
+        "random pads change the hash", format, width, height, xxh64);
+      Check(HashOneShot(image.dirty, xxh64) != expected,
+        "the test data has no random pads", format, width, height, xxh64);
+
+      // The top defined bit of the last texel must still count
+      std::vector<uint8_t> changed = image.dirty;
+      const size_t offset = (height - 1) * image.rowPitch + image.rowBytes - bits.Size;
+      uint32_t topBit = 1u << 31;
+      while (!(bits.Mask & topBit))
+        topBit >>= 1;
+      WriteTexel(changed, offset, bits.Size, ReadTexel(changed, offset, bits.Size) ^ topBit);
+
+      Check(HashTextureData(changed.data(), changed.size(), format, width, xxh64) != expected,
+        "a defined bit does not change the hash", format, width, height, xxh64);
+    }
+  }
+
+  void TestFormatHashedUnchanged(D3D9Format format, std::mt19937& rng) {
+    constexpr uint32_t width = 37;
+
+    std::vector<uint8_t> data(width * 4 * 13 + 3);
+    for (uint8_t& byte : data)
+      byte = uint8_t(rng());
+
+    for (bool xxh64 : { true, false }) {
+      Check(HashTextureData(data.data(), data.size(), format, width, xxh64) == HashOneShot(data, xxh64),
+        "a format without undefined bits no longer hashes as the one-shot hash", format, width, 13, xxh64);
+    }
+  }
+
+}
+
+int main() {
+  std::mt19937 rng(0x5eed);
+
+  // Sizes with and without row padding (odd widths of 2-byte formats), and
+  // ones whose rows end inside and exactly at the 4 KiB hashing chunks
+  const uint32_t sizes[][2] = {
+    { 1, 1 }, { 3, 5 }, { 64, 64 }, { 300, 37 }, { 333, 29 }, { 1024, 8 }, { 2048, 3 },
+  };
+
+  for (const FormatBits& entry : g_undefinedBitFormats) {
+    for (const auto& size : sizes)
+      TestFormatWithUndefinedBits(entry.format, entry.bits, size[0], size[1], rng);
+  }
+
+  // Only the X formats are masked, with exactly their X bits
+  for (uint32_t value = 0; value < 256; value++) {
+    const D3D9Format format = D3D9Format(value);
+    D3D9TexelBits expected = { 0, 0 };
+
+    for (const FormatBits& entry : g_undefinedBitFormats) {
+      if (entry.format == format)
+        expected = entry.bits;
+    }
+
+    const D3D9TexelBits bits = GetDefinedTexelBits(format);
+    Check(bits.Size == expected.Size && bits.Mask == expected.Mask,
+      "the format has the wrong defined bits", format, 0, 0, true);
+  }
+
+  const D3D9Format unchangedFormats[] = {
+    D3D9Format::A8R8G8B8, D3D9Format::A8B8G8R8, D3D9Format::A2R10G10B10,
+    D3D9Format::R5G6B5, D3D9Format::A1R5G5B5, D3D9Format::A4R4G4B4,
+    D3D9Format::L8, D3D9Format::A8L8, D3D9Format::V8U8, D3D9Format::Q8W8V8U8,
+    D3D9Format::A16B16G16R16F, D3D9Format::DXT1, D3D9Format::DXT5, D3D9Format::ATI2,
+  };
+
+  for (D3D9Format format : unchangedFormats)
+    TestFormatHashedUnchanged(format, rng);
+
+  // Data that is not whole rows hashes as it is
+  {
+    const D3D9Format format = D3D9Format::X8R8G8B8;
+    std::vector<uint8_t> data(4 * 5 * 3 + 4, 0xff);
+
+    for (bool xxh64 : { true, false }) {
+      Check(HashTextureData(data.data(), data.size(), format, 5, xxh64) == HashOneShot(data, xxh64),
+        "partial rows no longer hash as the one-shot hash", format, 5, 3, xxh64);
+    }
+  }
+
+  return g_passed ? 0 : -1;
+}
