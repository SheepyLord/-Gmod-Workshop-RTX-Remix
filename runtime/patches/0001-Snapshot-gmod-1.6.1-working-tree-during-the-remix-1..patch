new file mode 100644
index 00000000..141ab8a1
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_texture_category_sets.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include "rtx_options.h"
+
+#include <initializer_list>
+#include <limits>
+#include <mutex>
+
+namespace dxvk {
+
+  // Copies of the texture category hash sets that D3D9 draw preparation looks up for every draw. The D3D9 thread
+  // prepares later frames while dxvk-cs re-resolves the live sets at the end of its frame, so it reads these copies
+  // instead: no update mutex per lookup, and no lookup inside a set that is being rewritten. Owned by D3D9Rtx and
+  // used only from D3D9 device calls.
+  struct TextureCategorySets {
+    // Re-copies the sets whose options changed since the last call. One atomic load when no option changed.
+    void refresh() {
+      const uint64_t revision = RtxOptionImpl::getAnyResolvedRevision();
+      if (revision == m_revision) {
+        return;
+      }
+      std::lock_guard<std::mutex> lock(RtxOptionImpl::getUpdateMutex());
+      // Read again under the mutex: the copies below include every change up to this revision.
+      m_revision = RtxOptionImpl::getAnyResolvedRevision();
+      for (RtxOptionHashSetCopy* set : {
+             &uiTextures, &worldSpaceUiTextures, &worldSpaceUiBackgroundTextures, &legacyEmissiveTextures,
+             &ignoreTextures, &ignoreLights, &antiCullingTextures, &motionBlurMaskOutTextures,
+             &opacityMicromapIgnoreTextures, &ignoreAlphaOnTextures, &hideInstanceTextures, &particleTextures,
+             &beamTextures, &decalTextures, &dynamicDecalTextures, &singleOffsetDecalTextures, &nonOffsetDecalTextures,
+             &animatedWaterTextures, &playerModelTextures, &playerModelBodyTextures, &terrainTextures, &skyBoxTextures,
+             &particleEmitterTextures, &hairCardTextures, &allowBakedLightingTextures, &lightmapTextures,
+             &smoothNormalsTextures, &raytracedRenderTargetTextures }) {
+        set->refreshLocked();
+      }
+    }
+
+    RtxOptionHashSetCopy uiTextures { RtxOptions::uiTexturesObject() };
+    RtxOptionHashSetCopy worldSpaceUiTextures { RtxOptions::worldSpaceUiTexturesObject() };
+    RtxOptionHashSetCopy worldSpaceUiBackgroundTextures { RtxOptions::worldSpaceUiBackgroundTexturesObject() };
+    RtxOptionHashSetCopy legacyEmissiveTextures { RtxOptions::legacyEmissiveTexturesObject() };
+    RtxOptionHashSetCopy ignoreTextures { RtxOptions::ignoreTexturesObject() };
+    RtxOptionHashSetCopy ignoreLights { RtxOptions::ignoreLightsObject() };
+    RtxOptionHashSetCopy antiCullingTextures { RtxOptions::antiCullingTexturesObject() };
+    RtxOptionHashSetCopy motionBlurMaskOutTextures { RtxOptions::motionBlurMaskOutTexturesObject() };
+    RtxOptionHashSetCopy opacityMicromapIgnoreTextures { RtxOptions::opacityMicromapIgnoreTexturesObject() };
+    RtxOptionHashSetCopy ignoreAlphaOnTextures { RtxOptions::ignoreAlphaOnTexturesObject() };
+    RtxOptionHashSetCopy hideInstanceTextures { RtxOptions::hideInstanceTexturesObject() };
+    RtxOptionHashSetCopy particleTextures { RtxOptions::particleTexturesObject() };
+    RtxOptionHashSetCopy beamTextures { RtxOptions::beamTexturesObject() };
+    RtxOptionHashSetCopy decalTextures { RtxOptions::decalTexturesObject() };
+    RtxOptionHashSetCopy dynamicDecalTextures { RtxOptions::dynamicDecalTexturesObject() };
+    RtxOptionHashSetCopy singleOffsetDecalTextures { RtxOptions::singleOffsetDecalTexturesObject() };
+    RtxOptionHashSetCopy nonOffsetDecalTextures { RtxOptions::nonOffsetDecalTexturesObject() };
+    RtxOptionHashSetCopy animatedWaterTextures { RtxOptions::animatedWaterTexturesObject() };
+    RtxOptionHashSetCopy playerModelTextures { RtxOptions::playerModelTexturesObject() };
+    RtxOptionHashSetCopy playerModelBodyTextures { RtxOptions::playerModelBodyTexturesObject() };
+    RtxOptionHashSetCopy terrainTextures { RtxOptions::terrainTexturesObject() };
+    RtxOptionHashSetCopy skyBoxTextures { RtxOptions::skyBoxTexturesObject() };
+    RtxOptionHashSetCopy particleEmitterTextures { RtxOptions::particleEmitterTexturesObject() };
+    RtxOptionHashSetCopy hairCardTextures { RtxOptions::hairCardTexturesObject() };
+    RtxOptionHashSetCopy allowBakedLightingTextures { RtxOptions::allowBakedLightingTexturesObject() };
+    RtxOptionHashSetCopy lightmapTextures { RtxOptions::lightmapTexturesObject() };
+    RtxOptionHashSetCopy smoothNormalsTextures { RtxOptions::smoothNormalsTexturesObject() };
+    RtxOptionHashSetCopy raytracedRenderTargetTextures { RtxOptions::raytracedRenderTargetTexturesObject() };
+
+  private:
+    uint64_t m_revision = std::numeric_limits<uint64_t>::max();
+  };
+
+}
