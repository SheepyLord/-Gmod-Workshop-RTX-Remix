+  check(preloadPinChange(true, false, false, never) == C::Keep, "A released preload stays released while undrawn");
+  check(preloadPinChange(false, false, false, never) == C::Keep, "Free memory does not reload an undrawn released preload");
+  check(preloadPinChange(true, false, true, 0) == C::Restore, "A drawn released preload is preloaded again under pressure");
+  check(preloadPinChange(false, false, true, 0) == C::Restore, "A drawn released preload is preloaded again");
+
