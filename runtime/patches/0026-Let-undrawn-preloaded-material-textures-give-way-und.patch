 #pragma once
 
-// R13: the replacement texture budget under real memory pressure. Pure, for the unit tests.
+// R13: the replacement texture budget under real memory pressure, and when a material's preload
+// gives way. Pure, for the unit tests.
 
 #include <algorithm>
 #include <cstdint>
@@ -60,4 +61,27 @@ namespace dxvk {
     return std::max(limit, minimumMib);
   }
 
+  // The limit above is for all replacement textures. The budget pass can only shrink those that
+  // stream, so under pressure they get the limit less what pinned textures hold (-1: no limit).
+  inline int64_t streamedTextureLimitMib(int64_t limitMib, int64_t pinnedMib, int64_t minimumMib) {
+    return limitMib < 0 ? -1 : std::max(limitMib - pinnedMib, minimumMib);
+  }
+
+  // A USD material's preloaded texture (preload_textures) is pinned at all its mips, which the
+  // budget above never touches. It stays so while memory is free. Under real pressure (the limit
+  // above applies), one that no instance has drawn for kPreloadIdleMs gives way: it streams like
+  // any texture and drops to its smallest mip. Remix drops an instance one frame after its last
+  // draw, so the wait keeps a character the camera turned away from for a moment whole. As soon as
+  // an instance draws it, it is preloaded again.
+  enum class PreloadPinChange { Keep, Release, Restore };
+  constexpr int64_t kPreloadIdleMs = 10000;
+
+  // undrawnMs: how long no instance has drawn the texture (INT64_MAX if it never was drawn).
+  inline PreloadPinChange preloadPinChange(bool underPressure, bool pinned, bool drawn, int64_t undrawnMs) {
+    if (pinned) {
+      return underPressure && !drawn && undrawnMs >= kPreloadIdleMs ? PreloadPinChange::Release : PreloadPinChange::Keep;
+    }
+    return drawn ? PreloadPinChange::Restore : PreloadPinChange::Keep;
+  }
+
 }
