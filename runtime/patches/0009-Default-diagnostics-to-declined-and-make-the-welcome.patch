diff --git a/src/util/util_welcome_policy.h b/src/util/util_welcome_policy.h
new file mode 100644
index 00000000..43c54318
--- /dev/null
+++ b/src/util/util_welcome_policy.h
@@ -0,0 +1,113 @@
+/*
+ * Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#include <cmath>
+#include <filesystem>
+#include <fstream>
+
+#include "util_local_data.h"
+
+namespace dxvk::diagnostics {
+  inline constexpr const char* kPolicyKey = "explicitDiagnosticsPolicy";
+  inline constexpr const char* kCrashKey = "allowCrashReporting";
+  inline constexpr const char* kUsageKey = "allowUsageReporting";
+  inline constexpr const char* kNeverShowKey = "neverShowFirstUseGuide";
+  inline constexpr int kPolicyVersion = 1;
+
+  inline bool allowCrash(LocalData::Scope& scope) {
+    return scope.get<int>(kPolicyKey, 0) >= kPolicyVersion && scope.get<bool>(kCrashKey, false);
+  }
+
+  inline bool allowUsage(LocalData::Scope& scope) {
+    return scope.get<int>(kPolicyKey, 0) >= kPolicyVersion && scope.get<bool>(kUsageKey, false);
+  }
+
+  inline bool saveChoices(LocalData::Scope& scope, bool crash, bool usage, bool neverShow) {
+    const int previousPolicy = scope.get<int>(kPolicyKey, 0);
+    const bool previousCrash = scope.get<bool>(kCrashKey, false);
+    const bool previousUsage = scope.get<bool>(kUsageKey, false);
+    const bool previousNever = scope.get<bool>(kNeverShowKey, false);
+    scope.set(kPolicyKey, kPolicyVersion);
+    scope.set(kCrashKey, crash);
+    scope.set(kUsageKey, usage);
+    scope.set(kNeverShowKey, neverShow);
+    if (scope.save()) {
+      return true;
+    }
+    scope.set(kPolicyKey, previousPolicy);
+    scope.set(kCrashKey, previousCrash);
+    scope.set(kUsageKey, previousUsage);
+    scope.set(kNeverShowKey, previousNever);
+    return false;
+  }
+
+  inline bool initializePolicy(LocalData::Scope& scope, const std::filesystem::path& database) {
+    const bool current = scope.get<int>(kPolicyKey, 0) >= kPolicyVersion;
+    if (current && allowCrash(scope)) {
+      return true;
+    }
+    // The old welcome window saved checked defaults on Close. Archive its SDK database before
+    // initialization so unconfirmed grants and cached telemetry cannot be uploaded later.
+    const auto consent = database / "user-consent";
+    const auto source = current ? consent : database;
+    std::error_code error;
+    const bool exists = std::filesystem::exists(source, error);
+    if (error) {
+      return false;
+    }
+    if (exists) {
+      if (current) {
+        std::ifstream savedConsent(consent);
+        int value = 1;
+        if ((savedConsent >> value) && (value == 0 || value == -1)) {
+          return true;
+        }
+      }
+      bool archived = false;
+      for (int index = 0; index < 32; ++index) {
+        auto backup = source;
+        backup += ".before-default-decline." + std::to_string(index);
+        if (std::filesystem::exists(backup, error)) {
+          continue;
+        }
+        if (error) {
+          return false;
+        }
+        std::filesystem::rename(source, backup, error);
+        if (error) {
+          return false;
+        }
+        archived = true;
+        break;
+      }
+      if (!archived) {
+        return false;
+      }
+    }
+    return current || saveChoices(scope, false, false, scope.get<bool>(kNeverShowKey, false));
+  }
+
+  class WelcomeDismissal {
+  public:
+    void reset() { m_started = -1.0; m_interacted = false; }
+    bool started() const { return m_started >= 0.0; }
+    bool interacted() const { return m_interacted; }
+    bool update(double now, bool interaction) {
+      if (!started()) {
+        m_started = now;
+      }
+      m_interacted |= interaction;
+      return !m_interacted && now - m_started >= 12.0;
+    }
+    int secondsLeft(double now) const {
+      const double remaining = 12.0 - (now - m_started);
+      return remaining > 0.0 ? static_cast<int>(std::ceil(remaining)) : 0;
+    }
+  private:
+    double m_started = -1.0;
+    bool m_interacted = false;
+  };
+}
