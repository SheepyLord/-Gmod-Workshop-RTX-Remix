+    const auto preferences = root / "preferences.conf";
+    const auto consent = root / "sdk/user-consent";
+    Config legacy;
+    legacy.setOption(diagnostics::kCrashKey, true);
+    legacy.setOption(diagnostics::kUsageKey, true);
+    legacy.setOption(diagnostics::kNeverShowKey, true);
+    legacy.setOption("unrelated", std::string("kept"));
+    TEST_ASSERT(Config::serializeCustomConfig(legacy, preferences.string()), "Fixture save failed");
+    { std::ofstream stream(consent); stream << "1"; }
+    LocalData::Scope scope([&] { return preferences.string(); });
+    TEST_ASSERT(!diagnostics::allowCrash(scope) && !diagnostics::allowUsage(scope), "Legacy defaults counted as consent");
+    TEST_ASSERT(diagnostics::initializePolicy(scope, root / "sdk"), "Consent migration failed");
+    TEST_ASSERT(!diagnostics::allowCrash(scope) && !diagnostics::allowUsage(scope), "Migration opted in");
+    TEST_ASSERT(!fs::exists(root / "sdk") && fs::exists(root / "sdk.before-default-decline.0/user-consent"), "Legacy SDK data was not archived");
+    TEST_ASSERT(scope.get<bool>(diagnostics::kNeverShowKey, false), "Permanent dismissal lost");
+    TEST_ASSERT(scope.get<std::string>("unrelated", "") == "kept", "Unrelated preference lost");
+
+    TEST_ASSERT(diagnostics::saveChoices(scope, true, false, true), "Explicit choice failed");
+    LocalData::Scope restart([&] { return preferences.string(); });
+    TEST_ASSERT(diagnostics::allowCrash(restart) && !diagnostics::allowUsage(restart), "Explicit choice did not persist");
+    TEST_ASSERT(diagnostics::initializePolicy(restart, root / "sdk"), "Confirmed consent was reset");
+    TEST_ASSERT(diagnostics::saveChoices(restart, false, false, true), "Explicit opt-out failed");
+
+    const HANDLE lock = CreateFileA(preferences.string().c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, 0, nullptr);
+    TEST_ASSERT(lock != INVALID_HANDLE_VALUE, "Could not lock preferences");
+    const bool changed = diagnostics::saveChoices(restart, true, true, false);
+    CloseHandle(lock);
+    TEST_ASSERT(!changed && !diagnostics::allowCrash(restart) && !diagnostics::allowUsage(restart), "Failed save granted consent");
+    TEST_ASSERT(restart.get<bool>(diagnostics::kNeverShowKey, false), "Failed save lost dismissal");
+
+    fs::create_directories(root / "sdk");
+    { std::ofstream stream(consent); stream << "1"; }
+    TEST_ASSERT(diagnostics::initializePolicy(restart, root / "sdk"), "Stale SDK grant was not revoked");
+    TEST_ASSERT(!fs::exists(consent) && fs::exists(root / "sdk/user-consent.before-default-decline.0"), "Stale grant was not archived");
+    TEST_ASSERT(diagnostics::initializePolicy(restart, root / "sdk"), "Repeated startup failed");
+
+    diagnostics::WelcomeDismissal timer;
+    TEST_ASSERT(!timer.update(0.0, false) && timer.secondsLeft(0.0) == 12, "Countdown did not start on display");
+    TEST_ASSERT(!timer.update(11.999, false) && timer.update(12.0, false), "12-second dismissal incorrect");
+    timer.reset();
+    TEST_ASSERT(!timer.update(100.0, false), "Reopen reused previous deadline");
+    TEST_ASSERT(!timer.update(111.99, true) && !timer.update(1000.0, false), "Interaction did not cancel dismissal");
+    timer.reset();
+    TEST_ASSERT(!timer.update(2000.0, true) && !timer.update(2012.0, false), "First-frame explicit interaction was lost");
+    fs::remove_all(root);
+  }
