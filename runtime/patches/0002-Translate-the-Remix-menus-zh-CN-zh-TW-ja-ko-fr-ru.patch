+msgstr "粒子生成時賦予的最小尺寸（以 1080p 參考解析度下的像素計）。"
+
+#. option rtx.dust.maxParticleSize
+#: src/dxvk/rtx_render/rtx_dust_particles.h:45
+msgid "Maximum size (in pixels at 1080p reference resolution) to give to a particle when spawned."
+msgstr "粒子生成時賦予的最大尺寸（以 1080p 參考解析度下的像素計）。"
+
+#. option rtx.dust.opacity
+#: src/dxvk/rtx_render/rtx_dust_particles.h:46
+msgid "Opacity of the particles."
+msgstr "粒子的不透明度。"
+
+#. option rtx.dust.anisotropy
+#: src/dxvk/rtx_render/rtx_dust_particles.h:47
+msgid "Anisotropy of the particles for lighting purposes."
+msgstr "用於照明計算的粒子非等向性。"
+
+#. option rtx.dust.gravityForce
+#: src/dxvk/rtx_render/rtx_dust_particles.h:48
+msgid "Net influence of gravity acting on each particle (meters per second squared)."
+msgstr "作用於每個粒子的重力淨影響（公尺/秒平方）。"
+
+#. option rtx.dust.maxSpeed
+#: src/dxvk/rtx_render/rtx_dust_particles.h:49
+msgid "Maximum speed of a particle in world space."
+msgstr "粒子在世界空間中的最大速度。"
+
+#. option rtx.dust.useTurbulence
+#. option rtx.particles.globalPreset.useTurbulence
+#: src/dxvk/rtx_render/rtx_dust_particles.h:50 src/dxvk/rtx_render/rtx_particle_system.h:246
+msgid "Enable turbulence simulation."
+msgstr "啟用亂流模擬。"
+
+#. option rtx.dust.turbulenceAmplitude
+#: src/dxvk/rtx_render/rtx_dust_particles.h:51
+msgid "How much turbulence influences the force of a particle."
+msgstr "亂流對粒子受力的影響程度。"
+
+#. option rtx.dust.turbulenceFrequency
+#: src/dxvk/rtx_render/rtx_dust_particles.h:52
+msgid "The rate of change of turbulence forces."
+msgstr "亂流力的變化速率。"
+
+#. option rtx.dust.rotationSpeed
+#: src/dxvk/rtx_render/rtx_dust_particles.h:53
+msgid "How quickly the particle is rotating (this primarily only affects light interaction)."
+msgstr "粒子旋轉的速度（主要只影響與光線的交互）。"
+
+#. option rtx.fsr.preset
+#: src/dxvk/rtx_render/rtx_fork_fsr.h:83
+msgid "Adjusts FSR scaling factor, trades quality for performance."
+msgstr "調整 FSR 縮放倍數，以品質換取效能。"
+
+#. option rtx.fsrfg.enable
+#: src/dxvk/rtx_render/rtx_fork_fsr_framegen.h:145
+msgid "Enables FSR 3 frame generation which generates interpolated frames to increase framerate."
+msgstr "啟用 FSR 3 畫格生成，產生插補畫格以提高畫格率。"
+
