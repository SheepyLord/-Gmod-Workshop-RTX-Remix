+msgid "Ray Traced Bias Correction"
+msgstr "Correction du biais en ray tracing"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:340
+msgid "Discard Invisible Samples"
+msgstr "Ignorer les échantillons invisibles"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:341
+msgid "Indirect Sample Stealing"
+msgstr "Vol d'échantillons indirects"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:342
+msgid "Steal Boundary Samples When Outside Of Screen"
+msgstr "Voler les échantillons du bord hors de l'écran"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:343
+msgid "Cross Portal Light"
+msgstr "Lumière à travers les portails"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:344
+msgid "Compute Denoiser Gradient"
+msgstr "Calculer le gradient du débruiteur"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:345
+msgid "Compute Denoiser Confidence"
+msgstr "Calculer la confiance du débruiteur"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:347
+msgid "Confidence Settings"
+msgstr "Paramètres de confiance"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:350
