+msgstr "Длина временной истории (кадры)"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:217
+msgid "Permutation Sampling Size"
+msgstr "Размер перестановочной выборки"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:218 src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:329
