+#: src/dxvk/rtx_render/rtx_debug_view.cpp:1072 src/dxvk/rtx_render/rtx_debug_view.cpp:1093
+msgid "Max Value"
+msgstr "최댓값"
+
+#: src/dxvk/rtx_render/rtx_debug_view.cpp:1091
