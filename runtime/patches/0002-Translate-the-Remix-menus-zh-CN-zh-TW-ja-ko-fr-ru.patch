+#. option rtx.dust.numberOfParticles
+#: src/dxvk/rtx_render/rtx_dust_particles.h:38
+msgid "Maximum number of particles to simulate simultaneously."
+msgstr "Максимальное число одновременно симулируемых частиц."
+
+#. option rtx.dust.timeScale
+#. option rtx.particles.timeScale
+#: src/dxvk/rtx_render/rtx_dust_particles.h:39 src/dxvk/rtx_render/rtx_particle_system.h:205
+msgid "Time modifier, can be used to slow/speed up time."
+msgstr "Модификатор времени; позволяет замедлить или ускорить время."
+
+#. option rtx.dust.minSpawnDistance
+#: src/dxvk/rtx_render/rtx_dust_particles.h:40
+msgid "Minimum distance in world space from camera to spawn particles."
+msgstr "Минимальное расстояние от камеры в мировом пространстве для появления частиц."
+
+#. option rtx.dust.maxSpawnDistance
+#: src/dxvk/rtx_render/rtx_dust_particles.h:41
+msgid "Maximum distance in world space from camera to spawn particles."
+msgstr "Максимальное расстояние от камеры в мировом пространстве для появления частиц."
+
+#. option rtx.dust.minParticleLife
+#. option rtx.particles.globalPreset.minParticleLife
+#: src/dxvk/rtx_render/rtx_dust_particles.h:42 src/dxvk/rtx_render/rtx_particle_system.h:215
+msgid "Minimum lifetime (in seconds) to give to a particle when spawned."
+msgstr "Минимальное время жизни (в секундах), назначаемое частице при появлении."
+
+#. option rtx.dust.maxParticleLife
+#. option rtx.particles.globalPreset.maxParticleLife
+#: src/dxvk/rtx_render/rtx_dust_particles.h:43 src/dxvk/rtx_render/rtx_particle_system.h:216
+msgid "Maximum lifetime (in seconds) to give to a particle when spawned."
+msgstr "Максимальное время жизни (в секундах), назначаемое частице при появлении."
+
+#. option rtx.dust.minParticleSize
+#: src/dxvk/rtx_render/rtx_dust_particles.h:44
+msgid "Minimum size (in pixels at 1080p reference resolution) to give to a particle when spawned."
+msgstr "Минимальный размер (в пикселях при эталонном разрешении 1080p), назначаемый частице при появлении."
+
+#. option rtx.dust.maxParticleSize
+#: src/dxvk/rtx_render/rtx_dust_particles.h:45
+msgid "Maximum size (in pixels at 1080p reference resolution) to give to a particle when spawned."
+msgstr "Максимальный размер (в пикселях при эталонном разрешении 1080p), назначаемый частице при появлении."
+
+#. option rtx.dust.opacity
+#: src/dxvk/rtx_render/rtx_dust_particles.h:46
+msgid "Opacity of the particles."
+msgstr "Непрозрачность частиц."
+
+#. option rtx.dust.anisotropy
+#: src/dxvk/rtx_render/rtx_dust_particles.h:47
+msgid "Anisotropy of the particles for lighting purposes."
+msgstr "Анизотропия частиц для расчёта освещения."
+
+#. option rtx.dust.gravityForce
+#: src/dxvk/rtx_render/rtx_dust_particles.h:48
+msgid "Net influence of gravity acting on each particle (meters per second squared)."
+msgstr "Итоговое влияние силы тяжести на каждую частицу (метров в секунду в квадрате)."
+
+#. option rtx.dust.maxSpeed
+#: src/dxvk/rtx_render/rtx_dust_particles.h:49
+msgid "Maximum speed of a particle in world space."
+msgstr "Максимальная скорость частицы в мировом пространстве."
+
+#. option rtx.dust.useTurbulence
+#. option rtx.particles.globalPreset.useTurbulence
+#: src/dxvk/rtx_render/rtx_dust_particles.h:50 src/dxvk/rtx_render/rtx_particle_system.h:246
+msgid "Enable turbulence simulation."
+msgstr "Включает симуляцию турбулентности."
+
+#. option rtx.dust.turbulenceAmplitude
+#: src/dxvk/rtx_render/rtx_dust_particles.h:51
+msgid "How much turbulence influences the force of a particle."
+msgstr "Насколько турбулентность влияет на силу, действующую на частицу."
+
+#. option rtx.dust.turbulenceFrequency
+#: src/dxvk/rtx_render/rtx_dust_particles.h:52
+msgid "The rate of change of turbulence forces."
+msgstr "Скорость изменения сил турбулентности."
+
+#. option rtx.dust.rotationSpeed
+#: src/dxvk/rtx_render/rtx_dust_particles.h:53
+msgid "How quickly the particle is rotating (this primarily only affects light interaction)."
+msgstr "Как быстро вращается частица (в основном влияет только на взаимодействие со светом)."
+
+#. option rtx.fsr.preset
+#: src/dxvk/rtx_render/rtx_fork_fsr.h:83
+msgid "Adjusts FSR scaling factor, trades quality for performance."
+msgstr "Настраивает коэффициент масштабирования FSR, жертвуя качеством ради производительности."
+
+#. option rtx.fsrfg.enable
+#: src/dxvk/rtx_render/rtx_fork_fsr_framegen.h:145
+msgid "Enables FSR 3 frame generation which generates interpolated frames to increase framerate."
+msgstr "Включает генерацию кадров FSR 3, которая создаёт интерполированные кадры для повышения частоты кадров."
+
+#: src/dxvk/rtx_render/rtx_fork_i18n.cpp:418
+msgid "Language"
+msgstr "Язык"
+
+#. option rtx.gui.language
+#: src/dxvk/rtx_render/rtx_fork_i18n.h:16
+msgid ""
+"Language of the Remix menus: en (English), zh-CN (Simplified Chinese), zh-TW (Traditional Chinese), ja (Japanese), ko (Korean), fr (French), ru (Russian).\n"
+"The translations come from the i18n folder of the runtime's source, built into the runtime."
+msgstr ""
+"Язык меню Remix: en (английский), zh-CN (упрощённый китайский), zh-TW (традиционный китайский), ja (японский), ko (корейский), fr (французский), ru (русский).\n"
+"Переводы берутся из папки i18n исходного кода среды выполнения и встраиваются в неё."
+
+#. option rtx.sharpening.sharpness
+#: src/dxvk/rtx_render/rtx_fork_rcas.h:42
+msgid "Post-upscale RCAS sharpening amount. 0.0 = off (no sharpening pass is dispatched), 1.0 = maximum. Applies to DLSS, DLSS Ray Reconstruction, XeSS and TAA-U through a standalone RCAS pass, and is forwarded to FSR's built-in sharpener when FSR is the active upscaler."
+msgstr "Сила повышения резкости RCAS после масштабирования. 0.0 = выкл. (проход повышения резкости не запускается), 1.0 = максимум. Применяется к DLSS, DLSS Ray Reconstruction, XeSS и TAA-U через отдельный проход RCAS и передаётся встроенному фильтру резкости FSR, если активный апскейлер — FSR."
+
