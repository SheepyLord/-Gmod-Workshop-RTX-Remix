+msgid "Speed (smoothed):    %.3f"
+msgstr "Скорость (сглаж.):      %.3f"
+
+#: src/dxvk/rtx_render/rtx_weather.cpp:1088
+#, c-format
+msgid "Intensity (smoothed):%.3f"
+msgstr "Интенсивность (сглаж.): %.3f"
+
+#: src/dxvk/rtx_render/rtx_weather.cpp:1090
+msgid "Reset to defaults"
+msgstr "Сбросить к значениям по умолчанию"
