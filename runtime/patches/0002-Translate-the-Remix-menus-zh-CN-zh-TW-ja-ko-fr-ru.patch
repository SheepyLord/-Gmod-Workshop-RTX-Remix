+msgstr "Longueur de l'historique"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:351
+msgid "Gradient Power"
+msgstr "Puissance du gradient"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:352
