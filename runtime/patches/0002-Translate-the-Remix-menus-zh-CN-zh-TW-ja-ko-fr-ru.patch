+#. option rtx.neeCache.enable
+#: src/dxvk/rtx_render/rtx_nee_cache.h:50
+msgid "Enable NEE cache. The integrator will perform NEE on emissive triangles, which usually have significant light contributions, stored in the cache."
+msgstr "Active le cache NEE. L'intégrateur effectue le NEE sur les triangles émissifs stockés dans le cache, qui apportent généralement une contribution lumineuse importante."
+
+#. option rtx.neeCache.enableImportanceSampling
+#: src/dxvk/rtx_render/rtx_nee_cache.h:52
+msgid "Enable importance sampling."
+msgstr "Active l'échantillonnage préférentiel."
+
+#. option rtx.neeCache.enableMIS
+#: src/dxvk/rtx_render/rtx_nee_cache.h:53
+msgid "Enable MIS."
+msgstr "Active le MIS."
+
+#. option rtx.neeCache.enableUpdate
+#: src/dxvk/rtx_render/rtx_nee_cache.h:54
+msgid "Enable Update."
+msgstr "Active la mise à jour."
+
+#. option rtx.neeCache.enableOnFirstBounce
+#: src/dxvk/rtx_render/rtx_nee_cache.h:55
+msgid "Enable NEE Cache on a first bounce."
+msgstr "Active le cache NEE au premier rebond."
+
+#. option rtx.neeCache.enableModeAfterFirstBounce
+#: src/dxvk/rtx_render/rtx_nee_cache.h:56
+msgid "NEE Cache enable mode on a second and higher bounces. 0 means off, 1 means enabled for specular rays only, 2 means always enabled."
+msgstr "Mode d'activation du cache NEE à partir du deuxième rebond. 0 = désactivé, 1 = activé uniquement pour les rayons spéculaires, 2 = toujours activé."
+
+#. option rtx.neeCache.enableAnalyticalLight
+#: src/dxvk/rtx_render/rtx_nee_cache.h:58
+msgid "Enable NEE Cache on analytical light."
+msgstr "Active le cache NEE pour les lumières analytiques."
+
+#. option rtx.neeCache.specularFactor
+#: src/dxvk/rtx_render/rtx_nee_cache.h:59
+msgid "Specular component factor."
+msgstr "Facteur de la composante spéculaire."
+
+#. option rtx.neeCache.learningRate
+#: src/dxvk/rtx_render/rtx_nee_cache.h:60
+msgid "Learning rate. Higher values makes the cache adapt to lighting changes more quickly."
+msgstr "Taux d'apprentissage. Des valeurs plus élevées permettent au cache de s'adapter plus vite aux changements d'éclairage."
+
+#. option rtx.neeCache.uniformSamplingProbability
+#: src/dxvk/rtx_render/rtx_nee_cache.h:61
+msgid "Uniform sampling probability."
+msgstr "Probabilité d'échantillonnage uniforme."
+
+#. option rtx.neeCache.cullingThreshold
+#: src/dxvk/rtx_render/rtx_nee_cache.h:62
+msgid "Culling threshold."
+msgstr "Seuil d'élimination."
+
+#. option rtx.neeCache.resolution
+#: src/dxvk/rtx_render/rtx_nee_cache.h:63
+msgid "Cell resolution. Higher values mean smaller cells."
+msgstr "Résolution des cellules. Des valeurs plus élevées signifient des cellules plus petites."
+
+#. option rtx.neeCache.minRange
+#: src/dxvk/rtx_render/rtx_nee_cache.h:64
+msgid "The range for lowest level cells."
+msgstr "Portée des cellules du niveau le plus bas."
+
+#. option rtx.neeCache.emissiveTextureSampleFootprintScale
+#: src/dxvk/rtx_render/rtx_nee_cache.h:65
+msgid "Emissive texture sample footprint scale."
+msgstr "Échelle de l'empreinte d'échantillonnage des textures émissives."
+
+#. option rtx.neeCache.approximateParticleLighting
+#: src/dxvk/rtx_render/rtx_nee_cache.h:66
+msgid "Use particle albedo as emissive color."
+msgstr "Utilise l'albédo des particules comme couleur émissive."
+
+#. option rtx.neeCache.ageCullingSpeed
+#: src/dxvk/rtx_render/rtx_nee_cache.h:67
+msgid "This threshold determines culling speed of an old triangle. A triangle that is not detected for several frames will be deemed less important and culled quicker."
+msgstr "Ce seuil détermine la vitesse d'élimination d'un ancien triangle. Un triangle non détecté pendant plusieurs images est jugé moins important et éliminé plus rapidement."
+
+#. option rtx.neeCache.enableTriangleExploration
+#: src/dxvk/rtx_render/rtx_nee_cache.h:68
+msgid "Explore emissive triangle candidates in the same object."
+msgstr "Explore les triangles émissifs candidats dans le même objet."
+
+#. option rtx.neeCache.triangleExplorationProbability
+#: src/dxvk/rtx_render/rtx_nee_cache.h:69
+msgid "The probability to explore new triangles."
+msgstr "Probabilité d'explorer de nouveaux triangles."
+
+#. option rtx.neeCache.triangleExplorationMaxRange
+#: src/dxvk/rtx_render/rtx_nee_cache.h:70
+msgid "Index range to explore, when triangle exploration is enabled."
+msgstr "Plage d'index à explorer lorsque l'exploration des triangles est activée."
+
+#. option rtx.neeCache.triangleExplorationRangeRatio
+#: src/dxvk/rtx_render/rtx_nee_cache.h:71
+msgid "Index range to triangle count ratio, when triangle exploration is enabled."
+msgstr "Rapport entre la plage d'index et le nombre de triangles, lorsque l'exploration des triangles est activée."
+
+#. option rtx.neeCache.triangleExplorationAcceptRangeRatio
+#: src/dxvk/rtx_render/rtx_nee_cache.h:72
+msgid "Accept index range to search range ratio, when triangle exploration is enabled."
+msgstr "Rapport entre la plage d'index acceptée et la plage de recherche, lorsque l'exploration des triangles est activée."
+
+#. option rtx.neeCache.enableSpatialReuse
+#: src/dxvk/rtx_render/rtx_nee_cache.h:73
+msgid "Enable NEE cell share statistics information with neighbors."
+msgstr "Permet aux cellules NEE de partager leurs statistiques avec leurs voisines."
+
+#. option rtx.neeCache.enableReshuffleResilience
+#: src/dxvk/rtx_render/rtx_nee_cache.h:74
+msgid "Preserve cached light samples through BLAS primitive reshuffles. Reduces flicker when geometry is re-indexed but may show stale lighting for one extra frame when emissive surfaces are removed."
+msgstr "Préserve les échantillons de lumière en cache lors des réarrangements de primitives des BLAS. Réduit le scintillement lorsque la géométrie est réindexée, mais peut afficher un éclairage obsolète pendant une image supplémentaire lorsque des surfaces émissives sont supprimées."
+
+#. option rtx.neeCache.reshuffleMaxAge
+#: src/dxvk/rtx_render/rtx_nee_cache.h:75
+msgid "Maximum consecutive reshuffled frames before forcing a sample refresh. Prevents permanently stale samples from continuously animating emissive geometry (e.g. particle systems). 0 disables the limit."
+msgstr "Nombre maximal d'images consécutives avec réarrangement avant de forcer l'actualisation des échantillons. Évite que des échantillons restent obsolètes en permanence avec une géométrie émissive animée en continu (par ex. des systèmes de particules). 0 désactive la limite."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:47
+msgid "NRC Debug Visualization Mode"
+msgstr "Mode de visualisation de débogage NRC"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:49
+msgid "Add Query Result To Output"
+msgstr "Ajouter le résultat de la requête à la sortie"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:50
+msgid "Takes the query result and adds it to the output buffer"
+msgstr "Prend le résultat de la requête et l'ajoute au tampon de sortie"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:54
+msgid "Replace Output With Query Result"
+msgstr "Remplacer la sortie par le résultat de la requête"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:55
+msgid "Overwrites the output buffer with the query results"
+msgstr "Écrase le tampon de sortie avec les résultats de la requête"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:56
+msgid "Training Bounce Heat Map"
+msgstr "Carte de chaleur des rebonds d'entraînement"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:57
+msgid ""
+"Shows a heatmap for the number of training bounces.\n"
+"You should see more bounces in corners, and from smooth surfaces.\n"
+"How the number of vertices in the training path translates to colors:\n"
+"          1 : Dark Red           ( 0.5, 0,   0   )\n"
+"          2 : Bright Red         ( 1,   0,   0   )\n"
+"          3 : Dark Yellow        ( 0.5, 0.5, 0   )\n"
+"          4 : Green              ( 0,   1,   0   )\n"
+"          5 : Dark Cyan          ( 0,   0.5, 0.5 )\n"
+"          6 : Blue               ( 0,   0,   1   )\n"
+"          7 : Bleugh (?)         ( 0.5, 0.5, 1   )\n"
+"Miss or > 8 : White              ( 1,   1,   1   )"
+msgstr ""
+"Affiche une carte de chaleur du nombre de rebonds d'entraînement.\n"
+"Vous devriez voir davantage de rebonds dans les coins et sur les surfaces lisses.\n"
+"Correspondance entre le nombre de sommets du chemin d'entraînement et les couleurs :\n"
+"          1 : Rouge foncé        ( 0.5, 0,   0   )\n"
+"          2 : Rouge vif          ( 1,   0,   0   )\n"
+"          3 : Jaune foncé        ( 0.5, 0.5, 0   )\n"
+"          4 : Vert               ( 0,   1,   0   )\n"
+"          5 : Cyan foncé         ( 0,   0.5, 0.5 )\n"
+"          6 : Bleu               ( 0,   0,   1   )\n"
+"          7 : Bleuâtre (?)       ( 0.5, 0.5, 1   )\n"
+"Raté ou > 8 : Blanc              ( 1,   1,   1   )"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:68
+msgid "Training Bounce Heat Map Smoothed"
+msgstr "Carte de chaleur des rebonds d'entraînement lissée"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:69
+msgid ""
+"Same as TrainingBounceHeatMap, but smoothed over time\n"
+"to give a result more like you would see with accumulation."
+msgstr ""
+"Comme TrainingBounceHeatMap, mais lissée dans le temps\n"
+"pour donner un résultat plus proche de celui obtenu avec l'accumulation."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:71
+msgid "Primary Vertex Training Radiance"
+msgstr "Radiance d'entraînement du sommet primaire"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:72
+msgid ""
+"Shows the training radiance for the primary ray segment.\n"
+"This should look like a low resolution version of the path-traced result, and it will be noisy.\n"
+"The radiance shown here will include 'self training', where cache\n"
+"lookups are injected at the tails of many of the paths.\n"
+"When debugging cache issues, it can sometimes be useful to disable\n"
+"this self training using nrc::FrameSettings::selfTrainingAttenuation."
+msgstr ""
+"Affiche la radiance d'entraînement du segment de rayon primaire.\n"
+"Cela doit ressembler à une version basse résolution du résultat en path tracing, et ce sera bruité.\n"
+"La radiance affichée ici inclut l'« auto-entraînement », où des lectures\n"
+"du cache sont injectées à la fin de nombreux chemins.\n"
+"Pour déboguer des problèmes de cache, il peut parfois être utile de désactiver\n"
+"cet auto-entraînement avec nrc::FrameSettings::selfTrainingAttenuation."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:78
+msgid "Primary Vertex Training Radiance Smoothed"
+msgstr "Radiance d'entraînement du sommet primaire lissée"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:79
+msgid ""
+"The same as PrimaryVertexTrainingRadiance, but smoothed over time.\n"
+"to give a result more like you would see with accumulation"
+msgstr ""
+"Comme PrimaryVertexTrainingRadiance, mais lissée dans le temps,\n"
+"pour donner un résultat plus proche de celui obtenu avec l'accumulation"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:81
+msgid "Secondary Vertex Training Radiance"
+msgstr "Radiance d'entraînement du sommet secondaire"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:82
+msgid "As PrimaryVertexTrainingRadiance, but for the secondary ray segment."
+msgstr "Comme PrimaryVertexTrainingRadiance, mais pour le segment de rayon secondaire."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:83
+msgid "Secondary Vertex Training Radiance Smoothed"
+msgstr "Radiance d'entraînement du sommet secondaire lissée"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:84
+msgid "The same as SecondaryVertexTrainingRadiance, but smoothed over time.\n"
+msgstr "Comme SecondaryVertexTrainingRadiance, mais lissée dans le temps.\n"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:85
+msgid "Query Index"
+msgstr "Index de requête"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:86
+msgid ""
+"shows a random colour that's a hash of the query index.\n"
+"When things are working correctly - this should look like colored noise."
+msgstr ""
+"Affiche une couleur aléatoire issue d'un hash de l'index de requête.\n"
+"Si tout fonctionne correctement, cela doit ressembler à du bruit coloré."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:88
+msgid "Training Query Index"
+msgstr "Index de requête d'entraînement"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:89
+msgid ""
+"Same as QueryIndex, but for the training pass's self-training records.\n"
+"When things are working correctly - this should look like colored noise."
+msgstr ""
+"Comme QueryIndex, mais pour les enregistrements d'auto-entraînement de la passe d'entraînement.\n"
+"Si tout fonctionne correctement, cela doit ressembler à du bruit coloré."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:91
+msgid "Direct Cache View"
+msgstr "Vue directe du cache"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:92
+msgid ""
+"Direct visualization of the cache (equivalent of querying at vertex zero).\n"
+"The recommended tool to assess correctness of integration, this debug view should\n"
+"capture features such as shadows and view-dependent specular highlights and display\n"
+"them in a low-detail, over-smoothed output."
+msgstr ""
+"Visualisation directe du cache (équivaut à une requête au sommet zéro).\n"
+"Outil recommandé pour évaluer l'exactitude de l'intégration, cette vue de débogage doit\n"
+"capturer des éléments comme les ombres et les reflets spéculaires dépendant de la vue, et les afficher\n"
+"sous une forme peu détaillée et excessivement lissée."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:101
+msgid "NRC Quality Preset"
+msgstr "Préréglage de qualité NRC"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:278
+#, c-format
+msgid "Number of Training Records: %u"
+msgstr "Nombre d'enregistrements d'entraînement : %u"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:280
+#, c-format
+msgid "Number of Training Records: Not Available"
+msgstr "Nombre d'enregistrements d'entraînement : non disponible"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:284
+#, c-format
+msgid "Video Memory Usage: %u MiB"
+msgstr "Utilisation de la mémoire vidéo : %u MiB"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:289
+msgid "Train Cache"
+msgstr "Entraîner le cache"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:290
+msgid "Use Custom Network Config \"CustomNetworkConfig.json\""
