+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:196
+msgid "Virtual Sample Luminance Threshold"
+msgstr "가상 샘플 휘도 임계값"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:197
+msgid "Virtual Sample Roughness Threshold"
+msgstr "가상 샘플 거칠기 임계값"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:198
+msgid "Virtual Sample Specular Threshold"
+msgstr "가상 샘플 스페큘러 임계값"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:199
+msgid "Virtual Sample Max Distance Ratio"
+msgstr "가상 샘플 최대 거리 비율"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:200
+msgid "Demodulate Target Function"
+msgstr "목표 함수 디모듈레이션"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:201
