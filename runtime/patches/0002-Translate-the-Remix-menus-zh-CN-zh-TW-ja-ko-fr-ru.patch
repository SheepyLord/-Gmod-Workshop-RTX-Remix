+msgstr "雨滴寬度 x"
+
+#: src/dxvk/rtx_render/rtx_precipitation.cpp:671
+msgid "Drop Length x"
+msgstr "雨滴長度 x"
+
+#: src/dxvk/rtx_render/rtx_precipitation.cpp:674
+msgid "Motion Streak x"
+msgstr "運動條紋 x"
+
+#: src/dxvk/rtx_render/rtx_precipitation.cpp:677
+msgid "Size Variance"
+msgstr "大小變化"
+
+#: src/dxvk/rtx_render/rtx_precipitation.cpp:680
+msgid "Opacity Variance"
+msgstr "不透明度變化"
+
+#: src/dxvk/rtx_render/rtx_precipitation.cpp:686
+msgid "Particle Budget"
+msgstr "粒子預算"
+
+#: src/dxvk/rtx_render/rtx_precipitation.cpp:689
