+msgstr "DLSS-RR 호환 모드"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:203
+msgid "DLSS-RR Compatible Temporal Randomization Radius"
+msgstr "DLSS-RR 호환 시간적 무작위화 반경"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:204
+msgid "Light Stealing"
+msgstr "조명 가로채기"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:204
+msgid "Steal Pixel"
+msgstr "픽셀 가로채기"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:204
+msgid "Steal Sample"
+msgstr "샘플 가로채기"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:205
+msgid "Light Stealing Jitter"
+msgstr "조명 가로채기 지터"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:206
+msgid "Steal Boundary Pixels When Outside Of Screen"
+msgstr "화면 밖일 때 경계 픽셀 가로채기"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:207
