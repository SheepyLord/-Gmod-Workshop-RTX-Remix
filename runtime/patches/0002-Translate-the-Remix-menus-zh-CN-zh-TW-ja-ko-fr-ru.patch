+#. option rtx.neeCache.enable
+#: src/dxvk/rtx_render/rtx_nee_cache.h:50
+msgid "Enable NEE cache. The integrator will perform NEE on emissive triangles, which usually have significant light contributions, stored in the cache."
+msgstr "Включает кэш NEE. Интегратор будет выполнять NEE для хранящихся в кэше эмиссивных треугольников, которые обычно вносят значительный вклад в освещение."
+
+#. option rtx.neeCache.enableImportanceSampling
+#: src/dxvk/rtx_render/rtx_nee_cache.h:52
+msgid "Enable importance sampling."
+msgstr "Включает выборку по значимости."
+
+#. option rtx.neeCache.enableMIS
+#: src/dxvk/rtx_render/rtx_nee_cache.h:53
+msgid "Enable MIS."
+msgstr "Включает MIS."
+
+#. option rtx.neeCache.enableUpdate
+#: src/dxvk/rtx_render/rtx_nee_cache.h:54
+msgid "Enable Update."
+msgstr "Включает обновление."
+
+#. option rtx.neeCache.enableOnFirstBounce
+#: src/dxvk/rtx_render/rtx_nee_cache.h:55
+msgid "Enable NEE Cache on a first bounce."
+msgstr "Включает кэш NEE на первом отскоке."
+
+#. option rtx.neeCache.enableModeAfterFirstBounce
+#: src/dxvk/rtx_render/rtx_nee_cache.h:56
+msgid "NEE Cache enable mode on a second and higher bounces. 0 means off, 1 means enabled for specular rays only, 2 means always enabled."
+msgstr "Режим включения кэша NEE на втором и последующих отскоках. 0 — выкл., 1 — только для зеркальных лучей, 2 — всегда включён."
+
+#. option rtx.neeCache.enableAnalyticalLight
+#: src/dxvk/rtx_render/rtx_nee_cache.h:58
+msgid "Enable NEE Cache on analytical light."
+msgstr "Включает кэш NEE для аналитических источников света."
+
+#. option rtx.neeCache.specularFactor
+#: src/dxvk/rtx_render/rtx_nee_cache.h:59
+msgid "Specular component factor."
+msgstr "Коэффициент зеркальной составляющей."
+
+#. option rtx.neeCache.learningRate
+#: src/dxvk/rtx_render/rtx_nee_cache.h:60
+msgid "Learning rate. Higher values makes the cache adapt to lighting changes more quickly."
+msgstr "Скорость обучения. При больших значениях кэш быстрее адаптируется к изменениям освещения."
+
+#. option rtx.neeCache.uniformSamplingProbability
+#: src/dxvk/rtx_render/rtx_nee_cache.h:61
+msgid "Uniform sampling probability."
+msgstr "Вероятность равномерной выборки."
+
+#. option rtx.neeCache.cullingThreshold
+#: src/dxvk/rtx_render/rtx_nee_cache.h:62
+msgid "Culling threshold."
+msgstr "Порог отсечения."
+
+#. option rtx.neeCache.resolution
+#: src/dxvk/rtx_render/rtx_nee_cache.h:63
+msgid "Cell resolution. Higher values mean smaller cells."
+msgstr "Разрешение ячеек. Большие значения означают меньшие ячейки."
+
+#. option rtx.neeCache.minRange
+#: src/dxvk/rtx_render/rtx_nee_cache.h:64
+msgid "The range for lowest level cells."
+msgstr "Диапазон для ячеек самого нижнего уровня."
+
+#. option rtx.neeCache.emissiveTextureSampleFootprintScale
+#: src/dxvk/rtx_render/rtx_nee_cache.h:65
+msgid "Emissive texture sample footprint scale."
+msgstr "Масштаб области выборки эмиссивной текстуры."
+
+#. option rtx.neeCache.approximateParticleLighting
+#: src/dxvk/rtx_render/rtx_nee_cache.h:66
+msgid "Use particle albedo as emissive color."
+msgstr "Использовать альбедо частиц как цвет эмиссии."
+
+#. option rtx.neeCache.ageCullingSpeed
+#: src/dxvk/rtx_render/rtx_nee_cache.h:67
+msgid "This threshold determines culling speed of an old triangle. A triangle that is not detected for several frames will be deemed less important and culled quicker."
+msgstr "Этот порог определяет скорость отсечения старых треугольников. Треугольник, который не обнаруживается несколько кадров, считается менее важным и отсекается быстрее."
+
+#. option rtx.neeCache.enableTriangleExploration
+#: src/dxvk/rtx_render/rtx_nee_cache.h:68
+msgid "Explore emissive triangle candidates in the same object."
+msgstr "Исследовать кандидатов среди эмиссивных треугольников того же объекта."
+
+#. option rtx.neeCache.triangleExplorationProbability
+#: src/dxvk/rtx_render/rtx_nee_cache.h:69
+msgid "The probability to explore new triangles."
+msgstr "Вероятность исследования новых треугольников."
+
+#. option rtx.neeCache.triangleExplorationMaxRange
+#: src/dxvk/rtx_render/rtx_nee_cache.h:70
+msgid "Index range to explore, when triangle exploration is enabled."
+msgstr "Диапазон индексов для исследования при включённом исследовании треугольников."
+
+#. option rtx.neeCache.triangleExplorationRangeRatio
+#: src/dxvk/rtx_render/rtx_nee_cache.h:71
+msgid "Index range to triangle count ratio, when triangle exploration is enabled."
+msgstr "Отношение диапазона индексов к числу треугольников при включённом исследовании треугольников."
+
+#. option rtx.neeCache.triangleExplorationAcceptRangeRatio
+#: src/dxvk/rtx_render/rtx_nee_cache.h:72
+msgid "Accept index range to search range ratio, when triangle exploration is enabled."
+msgstr "Отношение диапазона индексов для принятия к диапазону поиска при включённом исследовании треугольников."
+
+#. option rtx.neeCache.enableSpatialReuse
+#: src/dxvk/rtx_render/rtx_nee_cache.h:73
+msgid "Enable NEE cell share statistics information with neighbors."
+msgstr "Позволяет ячейкам NEE делиться статистикой с соседями."
+
+#. option rtx.neeCache.enableReshuffleResilience
+#: src/dxvk/rtx_render/rtx_nee_cache.h:74
+msgid "Preserve cached light samples through BLAS primitive reshuffles. Reduces flicker when geometry is re-indexed but may show stale lighting for one extra frame when emissive surfaces are removed."
+msgstr "Сохранять закэшированные сэмплы света при перетасовке примитивов BLAS. Уменьшает мерцание при переиндексации геометрии, но может на один лишний кадр показывать устаревшее освещение при удалении эмиссивных поверхностей."
+
+#. option rtx.neeCache.reshuffleMaxAge
+#: src/dxvk/rtx_render/rtx_nee_cache.h:75
+msgid "Maximum consecutive reshuffled frames before forcing a sample refresh. Prevents permanently stale samples from continuously animating emissive geometry (e.g. particle systems). 0 disables the limit."
+msgstr "Максимальное число кадров подряд с перетасовкой до принудительного обновления сэмплов. Предотвращает постоянно устаревшие сэмплы от непрерывно анимируемой эмиссивной геометрии (например, систем частиц). 0 отключает ограничение."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:47
+msgid "NRC Debug Visualization Mode"
+msgstr "Режим отладочной визуализации NRC"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:49
+msgid "Add Query Result To Output"
+msgstr "Добавить результат запроса к выводу"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:50
+msgid "Takes the query result and adds it to the output buffer"
+msgstr "Берёт результат запроса и добавляет его к выходному буферу"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:54
+msgid "Replace Output With Query Result"
+msgstr "Заменить вывод результатом запроса"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:55
+msgid "Overwrites the output buffer with the query results"
+msgstr "Перезаписывает выходной буфер результатами запроса"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:56
+msgid "Training Bounce Heat Map"
+msgstr "Тепловая карта отскоков обучения"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:57
+msgid ""
+"Shows a heatmap for the number of training bounces.\n"
+"You should see more bounces in corners, and from smooth surfaces.\n"
+"How the number of vertices in the training path translates to colors:\n"
+"          1 : Dark Red           ( 0.5, 0,   0   )\n"
+"          2 : Bright Red         ( 1,   0,   0   )\n"
+"          3 : Dark Yellow        ( 0.5, 0.5, 0   )\n"
+"          4 : Green              ( 0,   1,   0   )\n"
+"          5 : Dark Cyan          ( 0,   0.5, 0.5 )\n"
+"          6 : Blue               ( 0,   0,   1   )\n"
+"          7 : Bleugh (?)         ( 0.5, 0.5, 1   )\n"
+"Miss or > 8 : White              ( 1,   1,   1   )"
+msgstr ""
+"Показывает тепловую карту числа отскоков обучения.\n"
+"Больше отскоков должно быть в углах и от гладких поверхностей.\n"
+"Как число вершин в обучающем пути переводится в цвета:\n"
+"          1 : Тёмно-красный      ( 0.5, 0,   0   )\n"
+"          2 : Ярко-красный       ( 1,   0,   0   )\n"
+"          3 : Тёмно-жёлтый       ( 0.5, 0.5, 0   )\n"
+"          4 : Зелёный            ( 0,   1,   0   )\n"
+"          5 : Тёмно-бирюзовый    ( 0,   0.5, 0.5 )\n"
+"          6 : Синий              ( 0,   0,   1   )\n"
+"          7 : Бе-е (?)           ( 0.5, 0.5, 1   )\n"
+"Промах, > 8 : Белый              ( 1,   1,   1   )"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:68
+msgid "Training Bounce Heat Map Smoothed"
+msgstr "Тепловая карта отскоков обучения (сглаженная)"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:69
+msgid ""
+"Same as TrainingBounceHeatMap, but smoothed over time\n"
+"to give a result more like you would see with accumulation."
+msgstr ""
+"То же, что TrainingBounceHeatMap, но со сглаживанием во времени,\n"
+"чтобы результат был ближе к тому, что дало бы накопление."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:71
+msgid "Primary Vertex Training Radiance"
+msgstr "Обучающее излучение первичной вершины"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:72
+msgid ""
+"Shows the training radiance for the primary ray segment.\n"
+"This should look like a low resolution version of the path-traced result, and it will be noisy.\n"
+"The radiance shown here will include 'self training', where cache\n"
+"lookups are injected at the tails of many of the paths.\n"
+"When debugging cache issues, it can sometimes be useful to disable\n"
+"this self training using nrc::FrameSettings::selfTrainingAttenuation."
+msgstr ""
+"Показывает обучающее излучение для сегмента первичного луча.\n"
+"Это должно выглядеть как версия результата трассировки пути в низком разрешении, и изображение будет шумным.\n"
+"Показанное здесь излучение включает «самообучение», при котором обращения к кэшу\n"
+"вставляются в конец многих путей.\n"
+"При отладке проблем с кэшем иногда полезно отключить\n"
+"это самообучение с помощью nrc::FrameSettings::selfTrainingAttenuation."
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:78
+msgid "Primary Vertex Training Radiance Smoothed"
+msgstr "Обучающее излучение первичной вершины (сглаженное)"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:79
+msgid ""
+"The same as PrimaryVertexTrainingRadiance, but smoothed over time.\n"
+"to give a result more like you would see with accumulation"
+msgstr ""
+"То же, что PrimaryVertexTrainingRadiance, но со сглаживанием во времени,\n"
+"чтобы результат был ближе к тому, что дало бы накопление"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:81
+msgid "Secondary Vertex Training Radiance"
+msgstr "Обучающее излучение вторичной вершины"
+
+#: src/dxvk/rtx_render/rtx_neural_radiance_cache.cpp:82
