diff --git a/src/dxvk/rtx_render/rtx_fork_i18n.cpp b/src/dxvk/rtx_render/rtx_fork_i18n.cpp
new file mode 100644
index 00000000..674513f8
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fork_i18n.cpp
@@ -0,0 +1,439 @@
+// src/dxvk/rtx_render/rtx_fork_i18n.cpp
+//
+// Fork-owned file. Implements the fork_hooks:: functions that translate the Remix menus: applying
+// rtx.gui.language, the ImGui text translator (ImGui swaps the displayed text, IDs keep hashing the
+// English), the glyphs and fonts the font atlas needs, and the language selector.
+// The text lives in i18n/*.po; i18n/tools/embed.py builds it into rtx_i18n_strings.cpp.
+// See i18n/README.md and docs/fork-touchpoints.md.
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "rtx_fork_hooks.h"
+#include "rtx_fork_i18n.h"
+#include "rtx_fork_i18n_data.h"
+#include "rtx_imgui.h"
+#include "rtx_option_layer.h"
+#include "../imgui/imgui.h"
+#include "../imgui/imgui_internal.h"
+#include "../../util/log/log.h"
+#include "../../util/util_string.h"
+
+#include <NotoSansSC.otf.h>
+#include <NotoSansTC.otf.h>
+#include <NotoSansJP.otf.h>
+#include <NotoSansKR.otf.h>
+
+namespace dxvk {
+
+  namespace {
+
+    struct EmbeddedFont {
+      const char* name;
+      unsigned char* data;
+      size_t size;
+    };
+
+    EmbeddedFont kEmbeddedFonts[] = {
+      { "NotoSansSC", ___NotoSansSC, sizeof(___NotoSansSC) },
+      { "NotoSansTC", ___NotoSansTC, sizeof(___NotoSansTC) },
+      { "NotoSansJP", ___NotoSansJP, sizeof(___NotoSansJP) },
+      { "NotoSansKR", ___NotoSansKR, sizeof(___NotoSansKR) },
+    };
+
+    // Kept out of string literals in widget calls so update_strings.py does not offer it for translation:
+    // every language is listed by its own name.
+    constexpr const char* kEnglishName = "English";
+    constexpr size_t kMaxLoggedTexts = 4096;
+
+    struct Translation {
+      const char* text;
+      const char* textEnd;
+      bool formatSafe;
+    };
+
+    struct FontGlyphs {
+      EmbeddedFont* font;
+      float heightPerEm;
+      std::vector<ImWchar> ranges;
+    };
+
+    // ImGui's translator callback takes no context and the menus have one ImGui context, so the
+    // selected language is file state.
+    struct UiLanguage {
+      bool applied = false;
+      std::string code;                                       // rtx.gui.language when it was last applied
+      const i18n_data::Language* language = nullptr;          // null: English
+      std::unordered_map<std::string_view, Translation> translations;
+      std::vector<ImWchar> extraRanges;                       // non-ASCII characters of the translations and of all language names
+      std::vector<FontGlyphs> fonts;                          // the selected language's font first
+      std::unordered_map<std::string, std::string> upperLabels;  // header label -> its translation in capitals
+      std::unordered_set<const char*> upperTexts;             // the strings above, which are not messages
+      std::unordered_set<std::string> logged;
+      bool logUntranslated = false;
+      bool reportAtlas = false;                               // log the atlas size once it is rebuilt
+    };
+
+    UiLanguage s_ui;
+
+    const std::vector<std::string_view>& englishTexts() {
+      static const std::vector<std::string_view> texts = [] {
+        std::vector<std::string_view> result;
+        result.reserve(i18n_data::kMessageCount);
+        const char* p = reinterpret_cast<const char*>(i18n_data::kEnglish);
+        const char* end = p + i18n_data::kEnglishSize;
+        while (p < end) {
+          const size_t length = strlen(p);
+          result.emplace_back(p, length);
+          p += length + 1;
+        }
+        return result;
+      }();
+      return texts;
+    }
+
+    bool sameCode(std::string_view a, std::string_view b) {
+      if (a.size() != b.size()) {
+        return false;
+      }
+      for (size_t i = 0; i < a.size(); i++) {
+        const char ca = a[i] == '_' ? '-' : static_cast<char>(std::tolower(static_cast<unsigned char>(a[i])));
+        const char cb = b[i] == '_' ? '-' : static_cast<char>(std::tolower(static_cast<unsigned char>(b[i])));
+        if (ca != cb) {
+          return false;
+        }
+      }
+      return true;
+    }
+
+    const i18n_data::Language* findLanguage(std::string_view code) {
+      for (size_t i = 0; i < i18n_data::kLanguageCount; i++) {
+        if (sameCode(code, i18n_data::kLanguages[i].code)) {
+          return &i18n_data::kLanguages[i];
+        }
+      }
+      return nullptr;
+    }
+
+    EmbeddedFont* findFont(std::string_view name) {
+      for (EmbeddedFont& font : kEmbeddedFonts) {
+        if (name == font.name) {
+          return &font;
+        }
+      }
+      return nullptr;
+    }
+
+    float heightPerEm(std::string_view font) {
+      for (size_t i = 0; i < i18n_data::kFontMetricsCount; i++) {
+        if (font == i18n_data::kFontMetrics[i].font) {
+          return i18n_data::kFontMetrics[i].heightPerEm;
+        }
+      }
+      return i18n_data::kBaseFontHeightPerEm;
+    }
+
+    // Capital of a letter NVIDIA Sans has (ASCII, Latin-1, Latin Extended-A, Cyrillic); other characters stay.
+    uint32_t toUpper(uint32_t c) {
+      if (c >= 'a' && c <= 'z') {
+        return c - 0x20;
+      }
+      if (c >= 0xE0 && c <= 0xFE && c != 0xF7) {
+        return c - 0x20;
+      }
+      if (c == 0xFF) {
+        return 0x178;
+      }
+      if (c >= 0x100 && c <= 0x17F) {
+        if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E)) {
+          return (c % 2 == 0) ? c - 1 : c;
+        }
+        if (c == 0x131 || c == 0x138 || c == 0x149 || c == 0x17F) {
+          return c;
+        }
+        return (c % 2 == 1) ? c - 1 : c;
+      }
+      if (c >= 0x430 && c <= 0x44F) {
+        return c - 0x20;
+      }
+      if (c >= 0x450 && c <= 0x45F) {
+        return c - 0x50;
+      }
+      return c;
+    }
+
+    void addCodepoints(std::string_view text, std::vector<uint32_t>& codepoints) {
+      const char* p = text.data();
+      const char* end = p + text.size();
+      while (p < end) {
+        unsigned int c = 0;
+        p += ImTextCharFromUtf8(&c, p, end);
+        if (c > 0x7E && c <= IM_UNICODE_CODEPOINT_MAX) {
+          codepoints.push_back(c);
+        }
+        // Section headers are drawn in capitals.
+        const uint32_t upper = toUpper(c);
+        if (upper != c && upper > 0x7E) {
+          codepoints.push_back(upper);
+        }
+      }
+    }
+
+    std::string toUpper(std::string_view text) {
+      std::string result;
+      result.reserve(text.size());
+      const char* p = text.data();
+      const char* end = p + text.size();
+      while (p < end) {
+        unsigned int c = 0;
+        p += ImTextCharFromUtf8(&c, p, end);
+        char utf8[5];
+        ImTextCharToUtf8(utf8, toUpper(c));
+        result += utf8;
+      }
+      return result;
+    }
+
+    std::vector<ImWchar> toRanges(std::vector<uint32_t> codepoints) {
+      std::sort(codepoints.begin(), codepoints.end());
+      codepoints.erase(std::unique(codepoints.begin(), codepoints.end()), codepoints.end());
+      std::vector<ImWchar> ranges;
+      for (size_t i = 0; i < codepoints.size();) {
+        size_t last = i;
+        while (last + 1 < codepoints.size() && codepoints[last + 1] == codepoints[last] + 1) {
+          last++;
+        }
+        ranges.push_back(static_cast<ImWchar>(codepoints[i]));
+        ranges.push_back(static_cast<ImWchar>(codepoints[last]));
+        i = last + 1;
+      }
+      ranges.push_back(0);
+      return ranges;
+    }
+
+    void activate(const i18n_data::Language* language) {
+      s_ui.language = language;
+      s_ui.translations.clear();
+      s_ui.upperLabels.clear();
+      s_ui.upperTexts.clear();
+      s_ui.logged.clear();
+
+      std::vector<uint32_t> extra;
+      if (language != nullptr) {
+        const std::vector<std::string_view>& english = englishTexts();
+        const unsigned char* p = language->records;
+        const unsigned char* end = p + language->recordsSize;
+        s_ui.translations.reserve(language->recordCount);
+        while (p + 3 < end) {
+          const uint32_t index = p[0] | (static_cast<uint32_t>(p[1]) << 8);
+          const bool formatSafe = (p[2] & i18n_data::kFormatSafe) != 0;
+          const char* text = reinterpret_cast<const char*>(p + 3);
+          const size_t length = strlen(text);
+          if (index < english.size()) {
+            s_ui.translations[english[index]] = Translation { text, text + length, formatSafe };
+          }
+          addCodepoints(std::string_view(text, length), extra);
+          p += 3 + length + 1;
+        }
+      }
+      for (size_t i = 0; i < i18n_data::kLanguageCount; i++) {
+        addCodepoints(i18n_data::kLanguages[i].name, extra);
+      }
+      s_ui.extraRanges = toRanges(std::move(extra));
+
+      // The selected language's font gets all of its characters; every other font only the names of its languages.
+      s_ui.fonts.clear();
+      EmbeddedFont* own = language != nullptr ? findFont(language->font) : nullptr;
+      if (own != nullptr) {
+        s_ui.fonts.push_back(FontGlyphs { own, heightPerEm(own->name), s_ui.extraRanges });
+      }
+      for (EmbeddedFont& font : kEmbeddedFonts) {
+        if (&font == own) {
+          continue;
+        }
+        std::vector<uint32_t> names;
+        for (size_t i = 0; i < i18n_data::kLanguageCount; i++) {
+          if (font.name == std::string_view(i18n_data::kLanguages[i].font)) {
+            addCodepoints(i18n_data::kLanguages[i].name, names);
+          }
+        }
+        if (!names.empty()) {
+          s_ui.fonts.push_back(FontGlyphs { &font, heightPerEm(font.name), toRanges(std::move(names)) });
+        }
+      }
+    }
+
+    void logUntranslated(const char* text, const char* textEnd) {
+      // ImGui formats every Text() into its temp buffer; formatted values are not messages.
+      const ImGuiContext* g = ImGui::GetCurrentContext();
+      if (g != nullptr && text >= g->TempBuffer && text < g->TempBuffer + IM_ARRAYSIZE(g->TempBuffer)) {
+        return;
+      }
+      if (s_ui.upperTexts.count(text) != 0) {
+        return;
+      }
+      // Not messages: the language names, the selector's composed label, option tooltips joined with the option name.
+      const std::string_view view(text, static_cast<size_t>(textEnd - text));
+      if (view == kEnglishName || view.find(" (Language)") != std::string_view::npos || view.find("\nrtx.") != std::string_view::npos) {
+        return;
+      }
+      for (size_t i = 0; i < i18n_data::kLanguageCount; i++) {
+        if (view == i18n_data::kLanguages[i].name) {
+          return;
+        }
+      }
+      if (s_ui.logged.size() >= kMaxLoggedTexts) {
+        return;
+      }
+      int letters = 0;
+      for (const char* c = text; c < textEnd; c++) {
+        letters += std::isalpha(static_cast<unsigned char>(*c)) ? 1 : 0;
+      }
+      if (letters < 2) {
+        return;
+      }
+      std::string message(text, textEnd);
+      if (s_ui.logged.insert(message).second) {
+        std::string escaped;
+        for (const char c : message) {
+          escaped += c == '\n' ? std::string("\\n") : std::string(1, c);
+        }
+        Logger::info(str::format("[i18n] untranslated (", s_ui.code, "): \"", escaped, "\""));
+      }
+    }
+
+    bool translateText(const char* text, const char* textEnd, bool asFormat, const char** outText, const char** outTextEnd) {
+      const i18n_data::Language* language = s_ui.language;
+      const unsigned char* p = reinterpret_cast<const unsigned char*>(text);
+      if (language == nullptr || (p >= language->records && p < language->records + language->recordsSize)) {
+        return false;  // English, or already a translation being measured or clipped again
+      }
+      const auto it = s_ui.translations.find(std::string_view(text, static_cast<size_t>(textEnd - text)));
+      if (it == s_ui.translations.end()) {
+        if (s_ui.logUntranslated) {
+          logUntranslated(text, textEnd);
+        }
+        return false;
+      }
+      if (asFormat && !it->second.formatSafe) {
+        return false;
+      }
+      *outText = it->second.text;
+      *outTextEnd = it->second.textEnd;
+      return true;
+    }
+
+  } // anonymous namespace
+
+namespace fork_hooks {
+
+  bool updateUiLanguage() {
+    s_ui.logUntranslated = RtxForkI18n::logUntranslatedText();
+    if (s_ui.reportAtlas && ImGui::GetCurrentContext() != nullptr && ImGui::GetIO().Fonts->IsBuilt()) {
+      const ImFontAtlas* atlas = ImGui::GetIO().Fonts;
+      int glyphs = 0;
+      for (const ImFont* font : atlas->Fonts) {
+        glyphs += font->Glyphs.Size;
+      }
+      Logger::info(str::format("[i18n] font atlas for ", s_ui.code.empty() ? "en" : s_ui.code, ": ",
+                               atlas->TexWidth, "x", atlas->TexHeight, ", ", glyphs, " glyphs"));
+      s_ui.reportAtlas = false;
+    }
+    const std::string& code = RtxForkI18n::language();
+    if (s_ui.applied && code == s_ui.code) {
+      return false;
+    }
+    s_ui.reportAtlas = true;
+    s_ui.applied = true;
+    s_ui.code = code;
+    const i18n_data::Language* language = findLanguage(code);
+    if (language == nullptr && !code.empty() && !sameCode(code, "en")) {
+      Logger::warn(str::format("[i18n] rtx.gui.language = ", code, " has no translation; the menus stay in English."));
+    }
+    activate(language);
+    ImGui::SetTextTranslator(language != nullptr ? &translateText : nullptr);
+    Logger::info(str::format("[i18n] menu language: ", language != nullptr ? language->code : "en",
+                             ", ", s_ui.translations.size(), " translated texts"));
+    return true;
+  }
+
+  void addUiLanguageFonts(ImFontAtlas* atlas, const ImFontConfig& baseConfig, void* baseFontData, size_t baseFontDataSize) {
+    ImFontConfig config = baseConfig;
+    config.MergeMode = true;
+    config.FontDataOwnedByAtlas = false;
+    if (s_ui.extraRanges.size() > 1) {
+      atlas->AddFontFromMemoryTTF(baseFontData, static_cast<int>(baseFontDataSize), 0.0f, &config, s_ui.extraRanges.data());
+    }
+    for (const FontGlyphs& font : s_ui.fonts) {
+      ImFontConfig fontConfig = config;
+      fontConfig.SizePixels = baseConfig.SizePixels * font.heightPerEm / i18n_data::kBaseFontHeightPerEm;
+      // One horizontal sample keeps a CJK atlas small; these glyphs gain little from oversampling.
+      fontConfig.OversampleH = 1;
+      fontConfig.PixelSnapH = true;
+      atlas->AddFontFromMemoryTTF(font.font->data, static_cast<int>(font.font->size), 0.0f, &fontConfig, font.ranges.data());
+    }
+  }
+
+  const char* translateUiText(const char* text) {
+    if (text == nullptr || s_ui.language == nullptr) {
+      return text;
+    }
+    const auto it = s_ui.translations.find(std::string_view(text));
+    return it != s_ui.translations.end() ? it->second.text : text;
+  }
+
+  const char* uppercaseUiLabel(const char* label, const char* labelEnd) {
+    const std::string english(label, labelEnd);
+    auto it = s_ui.upperLabels.find(english);
+    if (it == s_ui.upperLabels.end()) {
+      const char* text = english.c_str();
+      const char* textEnd = text + english.size();
+      if (s_ui.language != nullptr) {
+        const char* translated;
+        const char* translatedEnd;
+        if (translateText(text, textEnd, false, &translated, &translatedEnd)) {
+          text = translated;
+          textEnd = translatedEnd;
+        }
+      }
+      it = s_ui.upperLabels.emplace(english, toUpper(std::string_view(text, static_cast<size_t>(textEnd - text)))).first;
+      s_ui.upperTexts.insert(it->second.c_str());
+    }
+    return it->second.c_str();
+  }
+
+  void showUiLanguageSelector() {
+    RtxOptionLayerTarget layerTarget(RtxOptionEditTarget::User);
+    const i18n_data::Language* selected = findLanguage(RtxForkI18n::language());
+    int current = selected != nullptr ? static_cast<int>(selected - i18n_data::kLanguages) + 1 : 0;
+
+    // "Language" stays readable in English beside the translation, for whoever picked a language they cannot read.
+    // ### keeps the widget ID the same in every language.
+    std::string label = translateUiText("Language");
+    if (selected != nullptr) {
+      label += " (Language)";
+    }
+    label += "###rtxGuiLanguage";
+
+    auto languageName = [](void*, int index, const char** text, const char** tooltip) {
+      *text = index == 0 ? kEnglishName : i18n_data::kLanguages[index - 1].name;
+      if (tooltip != nullptr) {
+        *tooltip = nullptr;
+      }
+      return true;
+    };
+    if (RemixGui::Combo(label.c_str(), &current, languageName, nullptr, static_cast<int>(i18n_data::kLanguageCount) + 1)) {
+      RtxForkI18n::languageObject().setDeferred(current == 0 ? std::string("en") : std::string(i18n_data::kLanguages[current - 1].code));
+    }
+    RemixGui::SetTooltipToLastWidgetOnHover(RtxForkI18n::languageObject().getDescription());
+  }
+
+} // namespace fork_hooks
+
+} // namespace dxvk
