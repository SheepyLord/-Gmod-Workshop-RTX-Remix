+#: src/dxvk/rtx_render/rtx_particle_system.cpp:228
+msgid "Use Spawn Texture Coordinates"
+msgstr ""
+
+#: src/dxvk/rtx_render/rtx_particle_system.cpp:230 src/dxvk/rtx_render/rtx_particle_system.cpp:252
+msgid "Max Velocity"
+msgstr ""
+
+#: src/dxvk/rtx_render/rtx_particle_system.cpp:231
+msgid "Initial Velocity From Motion"
+msgstr ""
+
+#: src/dxvk/rtx_render/rtx_particle_system.cpp:232
+msgid "Initial Velocity From Normal"
+msgstr ""
