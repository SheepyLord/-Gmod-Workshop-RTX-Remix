+#. option rtx.bloom.enable
+#: src/dxvk/rtx_render/rtx_bloom.h:81
+msgid "Enable bloom - glowing halos around intense, bright areas."
+msgstr "启用泛光——在强烈的明亮区域周围产生发光光晕。"
+
+#. option rtx.bloom.burnIntensity
+#: src/dxvk/rtx_render/rtx_bloom.h:82
+msgid "Amount of bloom to add to the final image."
+msgstr "添加到最终画面中的泛光量。"
+
+#. option rtx.bloom.luminanceThreshold
+#: src/dxvk/rtx_render/rtx_bloom.h:83
+msgid "Adjust the bloom threshold to suppress blooming of the dim areas. Pixels with luminance lower than the threshold are multiplied by the weight value that smoothly transitions from 1.0 (at luminance=threshold) to 0.0 (at luminance=0)."
+msgstr "调整泛光阈值，以抑制较暗区域的泛光。亮度低于阈值的像素会乘以一个权重值，该值从 1.0（亮度 = 阈值时）平滑过渡到 0.0（亮度 = 0 时）。"
+
+#. option rtx.bloom.steps
+#: src/dxvk/rtx_render/rtx_bloom.h:87
+msgid "Number of downsampling steps to perform [1..8]. A higher value produces a wider blooming radius."
+msgstr "执行的降采样步数 [1..8]。值越高，泛光半径越大。"
