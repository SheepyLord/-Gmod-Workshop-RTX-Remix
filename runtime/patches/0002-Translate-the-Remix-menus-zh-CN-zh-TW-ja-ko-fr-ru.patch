+msgstr "Отбрасывать невидимые сэмплы"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:341
+msgid "Indirect Sample Stealing"
+msgstr "Заимствование непрямых сэмплов"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:342
+msgid "Steal Boundary Samples When Outside Of Screen"
+msgstr "Заимствовать граничные сэмплы за пределами экрана"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:343
