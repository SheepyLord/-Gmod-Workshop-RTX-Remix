+msgstr "沸騰過濾最小臨界值"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:209
+msgid "Boiling Filter Max Threshold"
+msgstr "沸騰過濾最大臨界值"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:210
+msgid "Boiling Filter Remove Reservoir Threshold"
+msgstr "沸騰過濾移除儲存池臨界值"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:211
+msgid "Use Adaptive Temporal History"
+msgstr "使用自適應時域歷史"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:213
+msgid "Temporal History Length (ms)"
+msgstr "時域歷史長度 (ms)"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:215
+msgid "Temporal History Length (frame)"
+msgstr "時域歷史長度（畫格）"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:217
+msgid "Permutation Sampling Size"
+msgstr "排列取樣大小"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:218 src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:329
+msgid "Discard Enlarged Pixels"
+msgstr "捨棄放大的像素"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:219
+msgid "History Discard Strength"
+msgstr "歷史捨棄強度"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:220
