+#. option rtx.di.enableInitialVisibility
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:52
+msgid "Whether to trace a visibility ray for the light sample selected in the initial sampling pass."
+msgstr "初期サンプリングパスで選択したライトサンプルについて、可視性レイをトレースするかどうか。"
+
+#. option rtx.di.enableBestLightSampling
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:53
+msgid "Whether to include a single best light from the previous frame's pixel neighborhood into initial sampling."
+msgstr "前フレームのピクセル近傍から最適なライトを 1 つ、初期サンプリングに含めるかどうか。"
+
+#. option rtx.di.enableRayTracedBiasCorrection
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:55
+msgid "Whether to use ray traced bias correction in the spatial reuse pass."
+msgstr "空間再利用パスで、レイトレーシングによるバイアス補正を使用するかどうか。"
+
+#. option rtx.di.enableSampleStealing
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:57
+msgid "No visibile IQ gains, but exhibits considerable perf drop (8% in integrate pass)."
+msgstr "目に見える画質の向上はありませんが、パフォーマンスがかなり低下します (積分パスで 8%)。"
+
+#. option rtx.di.stealBoundaryPixelSamplesWhenOutsideOfScreen
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:59
+msgid "Steal screen boundary samples when a hit point is outside the screen."
+msgstr "ヒット位置が画面外にある場合に、画面の境界のサンプルを横取りします。"
+
+#. option rtx.di.enableSpatialReuse
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:61
+msgid "Whether to apply spatial reuse."
+msgstr "空間再利用を適用するかどうか。"
+
+#. option rtx.di.enableTemporalReuse
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:63
+msgid "Whether to apply temporal reuse."
+msgstr "テンポラル再利用を適用するかどうか。"
+
+#. option rtx.di.enableDiscardInvisibleSamples
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:64
+msgid "Whether to discard reservoirs that are determined to be invisible in final shading."
+msgstr "最終シェーディングで見えないと判定されたリザーバーを破棄するかどうか。"
+
+#. option rtx.di.enableDenoiserGradient
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:68
+msgid "Enable gradient calculation, which is used by confidence calculation and GI sample validation."
+msgstr "勾配の計算を有効にします。勾配は信頼度の計算と GI サンプルの検証に使用されます。"
+
+#. option rtx.di.initialSampleCount
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:69
+msgid "The number of lights randomly selected from the global pool to consider when selecting a light with RTXDI."
+msgstr "RTXDI でライトを選択するときに考慮する、グローバルプールからランダムに選ばれるライトの数。"
+
+#. option rtx.di.spatialSamples
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:71
+msgid "The number of spatial reuse samples in converged areas."
+msgstr "収束した領域での空間再利用のサンプル数。"
+
+#. option rtx.di.disocclusionSamples
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:73
+msgid "The number of spatial reuse samples in disocclusion areas."
+msgstr "ディスオクルージョン領域での空間再利用のサンプル数。"
+
+#. option rtx.di.permutationSamplingNthFrame
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:77
+msgid "Apply permutation sampling when (frameIdx % this == 0), 0 means off."
+msgstr "(frameIdx % この値 == 0) のときに順列サンプリングを適用します。0 はオフを意味します。"
+
+#. option rtx.di.maxHistoryLength
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.h:79
+msgid "Maximum age of reservoirs for temporal reuse."
+msgstr "テンポラル再利用に使うリザーバーの最大経過時間。"
+
