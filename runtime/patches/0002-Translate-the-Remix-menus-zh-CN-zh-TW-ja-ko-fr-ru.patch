+#. option rtx.restirGI.useTemporalReuse
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:91
+msgid "Enables temporal reuse."
+msgstr "Включает временное переиспользование."
+
+#. option rtx.restirGI.useSpatialReuse
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:92
+msgid "Enables spatial reuse."
+msgstr "Включает пространственное переиспользование."
+
+#. option rtx.restirGI.useFinalVisibility
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:93
+msgid "Tests visiblity in output."
+msgstr "Проверяет видимость на выходе."
+
+#. option rtx.restirGI.misMode
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:96
+msgid "MIS mode to mix specular output with input."
+msgstr "Режим MIS для смешивания зеркального вывода со входом."
+
+#. option rtx.restirGI.misRoughness
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:97
+msgid "Reference roughness when roughness MIS is used. Higher values give ReSTIR inputs higher weight."
+msgstr "Опорная шероховатость при использовании MIS по шероховатости. Большие значения дают входам ReSTIR больший вес."
+
+#. option rtx.restirGI.parallaxAmount
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:98
+msgid "Parallax strength when parallax MIS is used. Higher values give ReSTIR inputs higher weight."
+msgstr "Сила параллакса при использовании MIS по параллаксу. Большие значения дают входам ReSTIR больший вес."
+
+#. option rtx.restirGI.useVirtualSample
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:106
+msgid "Uses virtual position for samples from highly specular surfaces."
+msgstr "Использует виртуальную позицию для сэмплов с сильно зеркальных поверхностей."
+
+#. option rtx.restirGI.virtualSampleLuminanceThreshold
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:107
+msgid "The last path vertex with luminance greater than 2 times of the previous accumulated radiance will get virtualized. Higher values tend to keep the first path vertex with non-zero contribution."
+msgstr "Виртуализируется последняя вершина пути, яркость которой более чем в 2 раза выше ранее накопленного излучения. Большие значения склонны сохранять первую вершину пути с ненулевым вкладом."
+
+#. option rtx.restirGI.virtualSampleRoughnessThreshold
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:108
+msgid "Surface with roughness under this threshold is considered to be highly specular, i.e. a \"mirror\"."
+msgstr "Поверхность с шероховатостью ниже этого порога считается сильно зеркальной, т. е. «зеркалом»."
+
+#. option rtx.restirGI.virtualSampleSpecularThreshold
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:109
+msgid "If a highly specular path vertex's direct specular light portion is higher than this. Its distance to the light source will get accumulated."
+msgstr "Если доля прямого зеркального света в сильно зеркальной вершине пути выше этого значения, её расстояние до источника света накапливается."
+
+#. option rtx.restirGI.virtualSampleMaxDistanceRatio
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:110
+msgid "Clamp max virtual distance, measured by the proportion of distance to camera. 0 disables clamping."
+msgstr "Ограничивает максимальное виртуальное расстояние долей от расстояния до камеры. 0 отключает ограничение."
+
+#. option rtx.restirGI.useTemporalBiasCorrection
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:112
+msgid "Corrects bias caused by temporal reprojection."
+msgstr "Корректирует смещение, вызванное временной репроекцией."
+
+#. option rtx.restirGI.biasCorrectionMode
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:113
+msgid "Bias correction mode to combine central with its neighbors in spatial reuse."
+msgstr "Режим коррекции смещения для объединения центрального сэмпла с соседями при пространственном переиспользовании."
+
+#. option rtx.restirGI.pairwiseMISCentralWeight
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:115
+msgid "The importance of central sample in pairwise bias correction modes."
+msgstr "Важность центрального сэмпла в режимах попарной коррекции смещения."
+
+#. option rtx.restirGI.useDemodulatedTargetFunction
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:117
+msgid "Demodulates target function. This will improve the result in non-pairwise modes."
+msgstr "Демодулирует целевую функцию. Улучшает результат в непопарных режимах."
+
+#. option rtx.restirGI.usePermutationSampling
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:118
+msgid "Uses permutation sample to perturb samples. This will improve results in DLSS."
+msgstr "Использует перестановочную выборку для возмущения сэмплов. Улучшает результат с DLSS."
+
+#. option rtx.restirGI.useDLSSRRCompatibilityMode
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:119
+msgid "DLSS-RR compatibility mode. In this mode temporal reprojection is randomized to reduce sample coherency."
+msgstr "Режим совместимости с DLSS-RR. В этом режиме временная репроекция рандомизируется, чтобы уменьшить когерентность сэмплов."
+
+#. option rtx.restirGI.DLSSRRTemporalRandomizationRadius
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:120
+msgid "In DLSS-RR compatibility mode temporal reprojection is randomized to reduce sample coherency. This option determines the randomization radius."
+msgstr "В режиме совместимости с DLSS-RR временная репроекция рандомизируется, чтобы уменьшить когерентность сэмплов. Этот параметр задаёт радиус рандомизации."
+
+#. option rtx.restirGI.useSampleStealing
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:121
+msgid "Steals ReSTIR GI samples in path tracer. This will improve highly specular results."
+msgstr "Заимствует сэмплы ReSTIR GI в трассировщике пути. Улучшает результат на сильно зеркальных поверхностях."
+
+#. option rtx.restirGI.sampleStealingJitter
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:122
+msgid "Jitter samples by k pixels to avoid aliasing."
+msgstr "Смещать сэмплы на k пикселей для избежания алиасинга."
+
+#. option rtx.restirGI.stealBoundaryPixelSamplesWhenOutsideOfScreen
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:123
+msgid "Steals ReSTIR GI samples even a hit point is outside the screen. This will further improve highly specular samples at the cost of some bias."
+msgstr "Заимствует сэмплы ReSTIR GI, даже если точка попадания за пределами экрана. Это дополнительно улучшает сильно зеркальные сэмплы ценой некоторого смещения."
+
+#. option rtx.restirGI.useDiscardEnlargedPixels
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:124
+msgid "Discards enlarged samples when the camera is moving towards an object."
+msgstr "Отбрасывает увеличенные сэмплы, когда камера движется к объекту."
+
+#. option rtx.restirGI.historyDiscardStrength
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:125
+msgid "The sensitivity of discarding history. Higher values discard more history."
+msgstr "Чувствительность отбрасывания истории. Большие значения отбрасывают больше истории."
+
+#. option rtx.restirGI.useTemporalJacobian
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:126
+msgid "Calculates Jacobian determinant in temporal reprojection."
+msgstr "Вычисляет определитель Якоби при временной репроекции."
+
+#. option rtx.restirGI.useReflectionReprojection
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:127
+msgid "Uses reflection reprojection for reflective objects to achieve stable result when the camera is moving."
+msgstr "Использует репроекцию отражений для отражающих объектов, чтобы получить стабильный результат при движении камеры."
+
+#. option rtx.restirGI.reflectionMinParallax
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:129
+msgid "When the parallax between normal and reflection reprojection is greater than this threshold, randomly choose one reprojected position and reuse the sample on it. Otherwise, get a sample between the two positions."
+msgstr "Если параллакс между обычной репроекцией и репроекцией отражения больше этого порога, случайно выбирается одна из репроецированных позиций и сэмпл берётся из неё. Иначе берётся сэмпл между двумя позициями."
+
+#. option rtx.restirGI.useBoilingFilter
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:130
+msgid "Enables boiling filter to suppress boiling artifacts."
+msgstr "Включает фильтр «кипения» для подавления артефактов «кипения»."
+
+#. option rtx.restirGI.boilingFilterMinThreshold
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:131
+msgid "Boiling filter threshold when surface normal is perpendicular to view direction."
+msgstr "Порог фильтра «кипения», когда нормаль поверхности перпендикулярна направлению взгляда."
+
+#. option rtx.restirGI.boilingFilterMaxThreshold
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:132
+msgid "Boiling filter threshold when surface normal is parallel to view direction."
+msgstr "Порог фильтра «кипения», когда нормаль поверхности параллельна направлению взгляда."
+
+#. option rtx.restirGI.boilingFilterRemoveReservoirThreshold
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:133
+msgid "Removes a sample when a sample's weight exceeds this threshold."
+msgstr "Удаляет сэмпл, если его вес превышает этот порог."
+
+#. option rtx.restirGI.useAdaptiveTemporalHistory
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:134
+msgid "Adjust temporal history length based on frame rate."
+msgstr "Подстраивать длину временной истории под частоту кадров."
+
+#. option rtx.restirGI.temporalAdaptiveHistoryLengthMs
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:135
+msgid "Temporal history time length, when adaptive temporal history is enabled."
+msgstr "Длина временной истории во времени при включённой адаптивной временной истории."
+
+#. option rtx.restirGI.temporalFixedHistoryLength
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:136
+msgid "Fixed temporal history length, when adaptive temporal history is disabled."
+msgstr "Фиксированная длина временной истории при отключённой адаптивной временной истории."
+
+#. option rtx.restirGI.permutationSamplingSize
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:137
+msgid "Permutation sampling strength."
+msgstr "Сила перестановочной выборки."
+
+#. option rtx.restirGI.roughnessClamp
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:138
+msgid "Clamps minimum roughness a sample's importance is evaluated."
+msgstr "Ограничивает минимальную шероховатость, при которой оценивается важность сэмпла."
+
+#. option rtx.restirGI.validateLightingChange
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:139
+msgid "Remove samples when direct light has changed."
+msgstr "Удалять сэмплы при изменении прямого света."
+
+#. option rtx.restirGI.validateVisibilityChange
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:140
+msgid "Remove samples when visibility has changed. This feature is automatically disabled when virtual sample is enabled."
+msgstr "Удалять сэмплы при изменении видимости. Эта функция автоматически отключается при включённом виртуальном сэмпле."
+
+#. option rtx.restirGI.lightingValidationThreshold
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:141
+msgid "Invalidate a sample when pixel change ratio is above this value."
+msgstr "Аннулировать сэмпл, если доля изменения пикселя выше этого значения."
+
+#. option rtx.restirGI.visibilityValidationRange
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.h:142
+msgid "Check actual hit distance of a shadow ray, invalidate a sample if hit length is longer than one plus this portion, compared to the distance from the surface to the sample."
+msgstr "Проверять фактическое расстояние попадания теневого луча и аннулировать сэмпл, если длина до попадания больше расстояния от поверхности до сэмпла, умноженного на (1 + это значение)."
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:320
+msgid "Initial Sample Count"
+msgstr "Начальное число сэмплов"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:321
+msgid "Sample Best Lights"
+msgstr "Сэмплировать лучшие источники"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:322
+msgid "Initial Visibility"
+msgstr "Начальная видимость"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:326
+msgid "Max History Length"
+msgstr "Макс. длина истории"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:327
+msgid "Permutation Sampling on Nth Frame"
+msgstr "Перестановочная выборка на N-м кадре"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:334
+msgid "Spatial Sample Count"
+msgstr "Число пространственных сэмплов"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:335
+msgid "Disocclusion Sample Count"
+msgstr "Число сэмплов при дисокклюзии"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:336
+msgid "Disocclusion Frames"
+msgstr "Кадры дисокклюзии"
+
+#: src/dxvk/rtx_render/rtx_rtxdi_rayquery.cpp:338
