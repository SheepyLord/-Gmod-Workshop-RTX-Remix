+// src/dxvk/rtx_render/rtx_fork_i18n.h
+//
+// Fork-owned file. Options of the menu translations; the fork_hooks:: entry points that use them
+// are declared in rtx_fork_hooks.h and implemented in rtx_fork_i18n.cpp. See i18n/README.md.
+
+#pragma once
+
+#include <string>
+
+#include "rtx_option.h"
+
+namespace dxvk {
+
+  class RtxForkI18n {
+  public:
+    RTX_OPTION_ARGS("rtx.gui", std::string, language, "en",
+                    "Language of the Remix menus: en (English), zh-CN (Simplified Chinese), zh-TW (Traditional Chinese), ja (Japanese), ko (Korean), fr (French), ru (Russian).\n"
+                    "The translations come from the i18n folder of the runtime's source, built into the runtime.",
+                    args.flags = RtxOptionFlags::UserSetting);
+    RTX_OPTION_ENV("rtx.gui", bool, logUntranslatedText, false, "RTX_GUI_LOG_UNTRANSLATED_TEXT",
+                   "Writes each menu text that has no translation in the selected language to the log, once, to show translators what is missing.");
+  };
+
+} // namespace dxvk
diff --git a/src/dxvk/rtx_render/rtx_fork_i18n_data.h b/src/dxvk/rtx_render/rtx_fork_i18n_data.h
new file mode 100644
index 00000000..466c5737
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fork_i18n_data.h
@@ -0,0 +1,47 @@
+// src/dxvk/rtx_render/rtx_fork_i18n_data.h
+//
+// Fork-owned file. Layout of the translation tables that i18n/tools/embed.py generates from the
+// i18n folder (remix.pot and <language>.po) into rtx_i18n_strings.cpp at build time.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace dxvk {
+  namespace i18n_data {
+
+    // English text of every message, each zero-terminated, in message index order.
+    extern const unsigned char kEnglish[];
+    extern const size_t kEnglishSize;
+    extern const uint32_t kMessageCount;
+
+    // A language's records: per translated message a little-endian uint16 message index, a flags
+    // byte, the UTF-8 translation and a zero byte.
+    enum RecordFlags : uint8_t {
+      kFormatSafe = 1,  // the translation has the English text's printf conversions, so it can stand in for it as a format
+    };
+
+    struct Language {
+      const char* code;             // the language's code in GMod: zh-CN, zh-TW, ja, ko, fr, ru
+      const char* name;             // the language's name in itself, UTF-8
+      const char* font;             // embedded font for the characters NVIDIA Sans lacks, or ""
+      const unsigned char* records;
+      size_t recordsSize;
+      uint32_t recordCount;
+    };
+    extern const Language kLanguages[];
+    extern const size_t kLanguageCount;
+
+    // ImGui sizes a font by its line height, (ascender - descender) / unitsPerEm em; these let an
+    // embedded font be merged at the em size of NVIDIA Sans.
+    struct FontMetrics {
+      const char* font;
