+msgstr "Тау адаптации к свету (s)"
+
+#: src/dxvk/rtx_render/rtx_auto_exposure.cpp:79
+msgid "Dark Adapt Tau (s)"
+msgstr "Тау адаптации к темноте (s)"
+
+#: src/dxvk/rtx_render/rtx_auto_exposure.cpp:80
