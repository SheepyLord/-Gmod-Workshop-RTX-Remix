+#: src/dxvk/rtx_render/rtx_weather.cpp:1035
+msgid "Target Preset"
+msgstr "Целевой пресет"
+
+#: src/dxvk/rtx_render/rtx_weather.cpp:1036
+msgid "Blend Duration (sec)"
+msgstr "Длительность смешивания (sec)"
+
+#: src/dxvk/rtx_render/rtx_weather.cpp:1037
