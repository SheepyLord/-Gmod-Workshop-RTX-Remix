+msgstr "최솟값(Log10)"
+
+#: src/dxvk/rtx_render/rtx_debug_view.cpp:1140
+msgid "Max Value (Log10)"
+msgstr "최댓값(Log10)"
+
+#: src/dxvk/rtx_render/rtx_debug_view.cpp:1144
+msgid "Histogram Normalization Scale"
+msgstr "히스토그램 정규화 배율"
+
+#: src/dxvk/rtx_render/rtx_debug_view.cpp:1147
+msgid "Display Resolution Scale"
+msgstr "표시 해상도 배율"
+
+#: src/dxvk/rtx_render/rtx_debug_view.cpp:1153
+msgid "Display Position"
+msgstr "표시 위치"
+
+#: src/dxvk/rtx_render/rtx_debug_view.cpp:1162
+msgid "Enable GPU Printing On Press CTRL"
+msgstr "CTRL을 누르면 GPU 출력 활성화"
+
+#: src/dxvk/rtx_render/rtx_debug_view.cpp:1164
+msgid "GPU Print"
+msgstr "GPU 출력"
+
+#: src/dxvk/rtx_render/rtx_debug_view.cpp:1165
