+#. option rtx.opacityMicromap.showAdvancedOptions
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:45
+msgid "Shows advanced options."
+msgstr "顯示進階選項。"
+
+#. option rtx.opacityMicromap.enableBinding
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:47
+msgid "Enables binding of built Opacity Micromaps to bottom level acceleration structures."
+msgstr "啟用將已建置的不透明度微貼圖繫結至底層加速結構。"
+
+#. option rtx.opacityMicromap.enableBakingArrays
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:48
+msgid "Enables baking of opacity textures into Opacity Micromap arrays per triangle."
+msgstr "啟用將不透明度紋理逐三角形烘焙至不透明度微貼圖陣列。"
+
+#. option rtx.opacityMicromap.enableBuilding
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:49
+msgid "Enables building of Opacity Micromap arrays."
+msgstr "啟用不透明度微貼圖陣列的建置。"
+
+#. option rtx.opacityMicromap.enableResetEveryFrame
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:50
+msgid "Debug: resets Opacity Micromap runtime data every frame. "
+msgstr "偵錯：每個畫格重設不透明度微貼圖的執行階段資料。 "
+
+#. option rtx.opacityMicromap.cache.minFreeVidmemMBToNotAllocate
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:56
+msgid "Min Video Memory [MB] to keep free before allocating any for Opacity Micromaps."
+msgstr "為不透明度微貼圖配置任何記憶體之前，需保持可用的最小顯示記憶體 [MB]。"
+
+#. option rtx.opacityMicromap.cache.minBudgetSizeMB
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:65
+msgid ""
+"Budget: Min Video Memory [MB] required.\n"
+"If the min amount is not available, then the budget will be set to 0."
+msgstr ""
+"預算：所需的最小顯示記憶體 [MB]。\n"
+"若無法取得最小量，預算會設為 0。"
+
+#. option rtx.opacityMicromap.cache.maxBudgetSizeMB
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:67
+msgid "Budget: Max Allowed Size [MB]."
+msgstr "預算：最大允許大小 [MB]。"
+
+#. option rtx.opacityMicromap.cache.maxVidmemSizePercentage
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:68
+msgid "Budget: Max Video Memory Size %."
+msgstr "預算：最大顯示記憶體大小 %。"
+
+#. option rtx.opacityMicromap.cache.minUsageFrameAgeBeforeEviction
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:69
+msgid ""
+"Min Opacity Micromap usage frame age before eviction.\n"
+"Opacity Micromaps unused longer than this can be evicted when freeing up memory for new Opacity Micromaps."
+msgstr ""
+"逐出前不透明度微貼圖的最小使用畫格存續期。\n"
+"為新的不透明度微貼圖釋放記憶體時，閒置超過此時間的不透明度微貼圖可被逐出。"
+
+#. option rtx.opacityMicromap.cache.hashInstanceIndexOnly
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:72
+msgid "Uses instance index as an Opacity Micromap hash."
+msgstr "使用實例索引作為不透明度微貼圖雜湊。"
+
+#. option rtx.opacityMicromap.buildRequests.filtering
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:81
+msgid "Enables filtering of Opacity Micromap requests. Filtering reduces and slows down acceptance of Opacity Micromap requests to maximize resources to requests that are more likely to be reused across instances and frames."
+msgstr "啟用不透明度微貼圖要求的篩選。篩選會減少並減緩接受不透明度微貼圖要求，將資源集中在較可能跨實例與畫格重複使用的要求上。"
+
+#. option rtx.opacityMicromap.buildRequests.maxRequests
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:82
+msgid ""
+"Max number of staged unique Opacity Micromap build requests.\n"
+"Any further requests will simply be discarded until the number of staged requests decreases below this threshold.\n"
+"Once a staged request passes filters for building, it is removed from the staging list."
+msgstr ""
+"已暫存之唯一不透明度微貼圖建置要求的最大數量。\n"
+"在暫存要求數降到此臨界值以下之前，任何後續要求都會直接被捨棄。\n"
+"暫存的要求一旦通過建置篩選，就會從暫存清單中移除。"
+
+#. option rtx.opacityMicromap.buildRequests.enableParticles
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:86
+msgid "Enables Opacity Micromaps for particles."
+msgstr "為粒子啟用不透明度微貼圖。"
+
+#. option rtx.opacityMicromap.buildRequests.enableAnimatedInstances
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:87
+msgid "Enables Opacity Micromaps for animated instances."
+msgstr "為動畫實例啟用不透明度微貼圖。"
+
+#. option rtx.opacityMicromap.buildRequests.minInstanceFrameAge
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:89
+msgid "Min instance's frame age which to allow building Opacity Micromaps for."
+msgstr "允許為其建置不透明度微貼圖的最小實例畫格存續期。"
+
+#. option rtx.opacityMicromap.buildRequests.maxRequestFrameAge
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:90
+msgid "Max request frame age to allow building Opacity Micromaps for. Any requests older than this are purged."
+msgstr "允許建置不透明度微貼圖的最大要求畫格存續期。超過此存續期的要求都會被清除。"
+
+#. option rtx.opacityMicromap.buildRequests.minNumFramesRequested
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:91
+msgid "Min number of frames for a staged Opacity Micromap request before it is allowed to be built."
+msgstr "已暫存的不透明度微貼圖要求在允許建置前所需的最少畫格數。"
+
+#. option rtx.opacityMicromap.buildRequests.minNumRequests
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:93
+msgid "Min number of Opacity Micromap usage requests for a staged Opacity Micromap request before it is allowed to be built."
+msgstr "已暫存的不透明度微貼圖要求在允許建置前所需的最少使用要求數。"
+
+#. option rtx.opacityMicromap.buildRequests.customFiltersForBillboards
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:96
+msgid "Applies custom filters for staged Billboard requests."
+msgstr "對已暫存的公告板要求套用自訂篩選。"
+
+#. option rtx.opacityMicromap.building.splitBillboardGeometry
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:103
+msgid ""
+"Splits billboard geometry and corresponding Opacity Micromaps to quads for higher reuse.\n"
+"Games often batch instanced geometry that reuses same geometry and textures, such as for particles.\n"
+"Splitting such batches into unique subgeometries then allows higher reuse of build Opacity Micromaps."
+msgstr ""
+"將公告板幾何與對應的不透明度微貼圖分割為四邊形，以提高重複使用率。\n"
+"遊戲通常會將重複使用相同幾何與紋理的實例化幾何批次處理，例如粒子。\n"
+"將這類批次分割為唯一的子幾何，即可提高已建置不透明度微貼圖的重複使用率。"
+
+#. option rtx.opacityMicromap.building.maxAllowedBillboardsPerInstanceToSplit
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:107
+msgid "Max billboards per instance to consider for splitting (large value results in increased CPU costs on BLAS builds)."
+msgstr "每個實例考慮分割的最大公告板數（值越大，建置 BLAS 時的 CPU 成本越高）。"
+
+#. option rtx.opacityMicromap.building.enableVertexAndTextureOperations
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:109
+msgid "Applies vertex and texture operations during baking."
+msgstr "烘焙時套用頂點與紋理運算。"
+
+#. option rtx.opacityMicromap.building.allow2StateOpacityMicromaps
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:110
+msgid "Allows generation of two state Opacity Micromaps."
+msgstr "允許產生雙態不透明度微貼圖。"
+
+#. option rtx.opacityMicromap.building.force2StateOpacityMicromaps
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:111
+msgid "Forces generation of two state Opacity Micromaps."
+msgstr "強制產生雙態不透明度微貼圖。"
+
+#. option rtx.opacityMicromap.building.subdivisionLevel
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:112
+msgid "Opacity Micromap subdivision level per triangle. "
+msgstr "每個三角形的不透明度微貼圖細分等級。 "
+
+#. option rtx.opacityMicromap.building.decalsMinResolveTransparencyThreshold
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:114
+msgid "Min resolve transparency threshold for decals."
+msgstr "貼花的最小解析透明度臨界值。"
+
+#. option rtx.opacityMicromap.building.maxMicroTrianglesToBakeMillionPerSecond
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:119
+msgid ""
+"Max Micro Triangles to bake [Million/Second].\n"
+"The actual number of issued micro triangles also depends on \"costPerTexelTapPerMicroTriangleBudget\" option."
+msgstr ""
+"最大烘焙微三角形數 [百萬/秒]。\n"
+"實際發出的微三角形數也取決於 \"costPerTexelTapPerMicroTriangleBudget\" 選項。"
+
+#. option rtx.opacityMicromap.building.maxMicroTrianglesToBuildMillionPerSecond
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:122
+msgid "Max Micro Triangles to build [Million/Second]."
+msgstr "最大建置微三角形數 [百萬/秒]。"
+
+#. option rtx.opacityMicromap.building.numFramesAtStartToBuildWithHighWorkload
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:140
+msgid ""
+"Number of frames at start to to bake and build Opacity Micromaps with high workload multiplier.\n"
+"This is used for testing to decrease frame latency for Opacity Micromaps being ready."
+msgstr ""
+"開始時以高工作負載倍數烘焙與建置不透明度微貼圖的畫格數。\n"
+"用於測試，以減少不透明度微貼圖準備就緒所需的畫格延遲。"
+
+#. option rtx.opacityMicromap.building.highWorkloadMultiplier
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:143
+msgid ""
+"High workload multiplier that is applied to number of Opacity Micromaps to bake and build per frame.\n"
+"This is used for testing to decrease frame latency for Opacity Micromaps being ready."
+msgstr ""
+"套用於每個畫格要烘焙與建置之不透明度微貼圖數量的高工作負載倍數。\n"
+"用於測試，以減少不透明度微貼圖準備就緒所需的畫格延遲。"
+
+#. option rtx.opacityMicromap.building.conservativeEstimation.enable
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:151
+msgid "Enables Conservative Estimation of micro triangle opacities."
+msgstr "啟用微三角形不透明度的保守估計。"
+
+#. option rtx.opacityMicromap.building.conservativeEstimation.maxTexelTapsPerMicroTriangle
+#: src/dxvk/rtx_render/rtx_opacity_micromap_manager.h:161
+msgid ""
+"Max number of texel taps per micro triangle when Conservative Estimation is enabled.\n"
+"Set to 64 as a safer cap. 512 has been found to cause a timeout.\n"
+"Any micro triangles requiring more texel taps will be tagged as Opaque Unknown."
+msgstr ""
+"啟用保守估計時，每個微三角形的最大紋素讀取次數。\n"
+"設為 64 作為較安全的上限。已發現 512 會導致逾時。\n"
+"需要更多紋素讀取次數的微三角形都會被標記為 Opaque Unknown。"
+
+#: src/dxvk/rtx_render/rtx_option_blocking_popup.cpp:226
+msgid "View per-layer values"
+msgstr "檢視各層的值"
+
+#: src/dxvk/rtx_render/rtx_option_blocking_popup.cpp:231
+#, c-format
+msgid "No layer values found."
+msgstr "找不到任何層的值。"
+
+#: src/dxvk/rtx_render/rtx_option_blocking_popup.cpp:243 src/dxvk/rtx_render/rtx_option_blocking_popup.cpp:289
+msgid "Always Unblock"
+msgstr "一律解除封鎖"
+
+#: src/dxvk/rtx_render/rtx_option_blocking_popup.cpp:243 src/dxvk/rtx_render/rtx_option_blocking_popup.cpp:253
+msgid "Cancel"
+msgstr "取消"
+
+#: src/dxvk/rtx_render/rtx_option_blocking_popup.cpp:243 src/dxvk/rtx_render/rtx_option_blocking_popup.cpp:263
+msgid "Unblock Option"
+msgstr "解除封鎖選項"
+
+#: src/dxvk/rtx_render/rtx_option_blocking_popup.cpp:308
+#, c-format
+msgid "Same action as 'Unblock Option', but will also remember this decision so you will not be asked again. (stored as rtx.autoUnblockOptionEdits in the User layer)"
+msgstr "與「解除封鎖選項」的動作相同，但也會記住此決定，之後不會再詢問您。（以 rtx.autoUnblockOptionEdits 儲存在使用者層中）"
+
+#: src/dxvk/rtx_render/rtx_option_layer_gui.cpp:302
+msgid "Save"
+msgstr "儲存"
+
+#: src/dxvk/rtx_render/rtx_option_layer_gui.cpp:308
+#, c-format
+msgid "Save unsaved changes to %s."
+msgstr "將未儲存的變更儲存至 %s。"
+
+#: src/dxvk/rtx_render/rtx_option_layer_gui.cpp:315
+msgid "Discard Changes"
+msgstr "捨棄變更"
+
+#: src/dxvk/rtx_render/rtx_option_layer_gui.cpp:321
+#, c-format
+msgid "Reload from disk, discarding unsaved changes."
+msgstr "從磁碟重新載入，並捨棄未儲存的變更。"
+
+#: src/dxvk/rtx_render/rtx_option_layer_gui.cpp:327
+msgid "Delete All"
+msgstr "全部刪除"
+
+#: src/dxvk/rtx_render/rtx_option_layer_gui.cpp:333
+#, c-format
+msgid "Clear all settings from this layer, resulting in an empty file if saved."
+msgstr "清除此層中的所有設定；若儲存，將產生空白檔案。"
+
+#: src/dxvk/rtx_render/rtx_option_layer_gui.cpp:339
+msgid "Remove Dupes"
+msgstr "移除重複項"
+
+#: src/dxvk/rtx_render/rtx_option_layer_gui.cpp:345
+#, c-format
+msgid ""
+"Remove entries that have no effect. If this layer's value\n"
+"matches what lower layers already resolve to, it's removed."
+msgstr ""
+"移除沒有作用的項目。若此層的值\n"
+"與較低層已解析出的值相同，就會將其移除。"
+
+#. option rtx.lightmapTextures
+#: src/dxvk/rtx_render/rtx_options.h:197
+msgid ""
+"Textures used for lightmapping (baked static lighting on surfaces) in older games.\n"
+"These textures will be ignored when attempting to determine the desired textures from a draw to use for ray tracing."
+msgstr ""
+"舊遊戲中用於光照貼圖（表面上烘焙的靜態照明）的紋理。\n"
+"在判斷繪製呼叫中要用於光線追蹤的紋理時，會忽略這些紋理。"
+
+#. option rtx.skyBoxTextures
+#: src/dxvk/rtx_render/rtx_options.h:200
+msgid ""
+"Textures on draw calls used for the sky or are otherwise intended to be very far away from the camera at all times (no parallax).\n"
+"Any draw calls using a texture in this list will be treated as sky and rendered as such in a manner different from typical geometry."
+msgstr ""
+"用於天空、或在其他情況下始終位於離攝影機非常遠處（無視差）之繪製呼叫上的紋理。\n"
+"任何使用此清單中紋理的繪製呼叫都會被視為天空，並以不同於一般幾何的方式渲染。"
+
+#. option rtx.ignoreTextures
+#: src/dxvk/rtx_render/rtx_options.h:207
+msgid ""
+"Textures on draw calls that should be ignored.\n"
+"Any draw call using an ignore texture will be skipped and not ray traced, useful for removing undesirable rasterized effects or geometry not suitable for ray tracing."
+msgstr ""
+"應被忽略之繪製呼叫上的紋理。\n"
+"任何使用忽略紋理的繪製呼叫都會被略過，不進行光線追蹤，適合用來移除不想要的點陣化效果或不適合光線追蹤的幾何。"
+
+#. option rtx.ignoreLights
+#: src/dxvk/rtx_render/rtx_options.h:210
+msgid ""
+"Lights that should be ignored.\n"
+"Any matching light will be skipped and not added to be ray traced."
+msgstr ""
+"應被忽略的光源。\n"
+"任何相符的光源都會被略過，不會加入光線追蹤。"
+
+#. option rtx.uiTextures
+#: src/dxvk/rtx_render/rtx_options.h:212
+msgid ""
+"Textures on draw calls that should be treated as screenspace UI elements.\n"
+"All exclusively UI-related textures should be classified this way and doing so allows the UI to be rasterized on top of the ray traced scene like usual.\n"
+"Note that currently the first UI texture encountered triggers RTX injection (though this may change in the future as this does cause issues with games that draw UI mid-frame)."
+msgstr ""
+"應被視為螢幕空間 UI 元素之繪製呼叫上的紋理。\n"
+"所有僅與 UI 相關的紋理都應如此分類，這樣 UI 就能像平常一樣點陣化在光線追蹤場景上方。\n"
+"請注意，目前遇到的第一個 UI 紋理會觸發 RTX 注入（未來可能會變更，因為這確實會對在畫格中途繪製 UI 的遊戲造成問題）。"
+
+#. option rtx.worldSpaceUiTextures
+#: src/dxvk/rtx_render/rtx_options.h:216
+msgid ""
+"Textures on draw calls that should be treated as worldspace UI elements.\n"
+"Unlike typical UI textures this option is useful for improved rendering of UI elements which appear as part of the scene (moving around in 3D space rather than as a screenspace element)."
+msgstr ""
+"應被視為世界空間 UI 元素之繪製呼叫上的紋理。\n"
+"與一般 UI 紋理不同，此選項有助於改善作為場景一部分出現之 UI 元素的渲染（在 3D 空間中移動，而非作為螢幕空間元素）。"
+
+#. option rtx.worldSpaceUiBackgroundTextures
+#: src/dxvk/rtx_render/rtx_options.h:219
+msgid ""
+"Hack/workaround option for dynamic world space UI textures with a coplanar background.\n"
+"Apply to backgrounds if the foreground material is a dynamic world texture rendered in UI that is unpredictable and rapidly changing.\n"
+"This offsets the background texture backwards."
+msgstr ""
+"針對具有共平面背景之動態世界空間 UI 紋理的權宜/變通選項。\n"
+"若前景材質是以 UI 渲染、無法預測且快速變化的動態世界紋理，請將此選項套用於背景。\n"
+"這會將背景紋理向後偏移。"
+
+#. option rtx.legacyEmissiveTextures
+#: src/dxvk/rtx_render/rtx_options.h:223
+msgid ""
+"Textures on draw calls that should be treated as legacy emissive elements.\n"
+"Similar to worldspace UI but uses alpha channel for emissive if available, with per-texture controllable emissive strength."
+msgstr ""
+"應被視為舊版自發光元素之繪製呼叫上的紋理。\n"
+"類似世界空間 UI，但若有 alpha 通道會用於自發光，且可逐紋理控制自發光強度。"
+
+#. option rtx.legacyEmissiveIntensitiesString
+#: src/dxvk/rtx_render/rtx_options.h:226
+msgid ""
+"Per-texture emissive intensity values for legacy emissive textures.\n"
+"Format: hash1:intensity1,hash2:intensity2,hash3:intensity3\n"
+"Default intensity is 2.0f if not specified."
+msgstr ""
+"舊版自發光紋理的逐紋理自發光強度值。\n"
+"格式：hash1:intensity1,hash2:intensity2,hash3:intensity3\n"
+"若未指定，預設強度為 2.0f。"
+
+#. option rtx.legacyEmissiveColorsString
+#: src/dxvk/rtx_render/rtx_options.h:231
+msgid ""
+"Per-texture emissive color tint values for legacy emissive textures.\n"
+"Format: hash1:r,g,b;hash2:r,g,b;hash3:r,g,b\n"
+"Default color is white (1.0,1.0,1.0) if not specified."
+msgstr ""
+"舊版自發光紋理的逐紋理自發光色調值。\n"
+"格式：hash1:r,g,b;hash2:r,g,b;hash3:r,g,b\n"
+"若未指定，預設色彩為白色 (1.0,1.0,1.0)。"
+
+#. option rtx.legacyEmissiveAlphaInvertString
+#: src/dxvk/rtx_render/rtx_options.h:235
+msgid ""
+"Per-texture alpha invert flags for legacy emissive textures.\n"
+"Format: hash1,hash2,hash3 (only lists hashes that should have inverted alpha)\n"
+"When inverted: black alpha = full emission, white alpha = no emission."
+msgstr ""
+"舊版自發光紋理的逐紋理 alpha 反轉旗標。\n"
+"格式：hash1,hash2,hash3（只列出應反轉 alpha 的雜湊）\n"
+"反轉時：黑色 alpha = 完全發光，白色 alpha = 不發光。"
+
+#. option rtx.legacyEmissiveForceAlbedoString
+#: src/dxvk/rtx_render/rtx_options.h:239
+msgid ""
+"Per-texture force albedo emission flags for legacy emissive textures.\n"
+"Format: hash1,hash2,hash3\n"
+"By default, emission is blocked for textures without an alpha channel. Adding a hash here\n"
+"forces full albedo-based emission even when the texture has no alpha channel."
+msgstr ""
+"舊版自發光紋理的逐紋理強制反照率發光旗標。\n"
+"格式：hash1,hash2,hash3\n"
+"預設情況下，沒有 alpha 通道的紋理不會發光。在此加入雜湊\n"
+"可強制以反照率完全發光，即使紋理沒有 alpha 通道。"
+
+#. option rtx.thinWalledOverrideTextures
+#: src/dxvk/rtx_render/rtx_options.h:244
+msgid ""
+"Per-texture Thin-Walled override for legacy Translucent materials, set via the in-game\n"
+"Texture Selection menu.\n"
+"Textures listed here force their Translucent material's thin_walled input to true\n"
+"(no refraction, treated as a thin sheet) regardless of the value baked into the\n"
+"generated/authored material."
+msgstr ""
+"舊版半透明材質的逐紋理「薄壁」覆寫，透過遊戲內的\n"
+"紋理選擇選單設定。\n"
+"此處列出的紋理會強制將其半透明材質的 thin_walled 輸入設為 true\n"
+"（不折射，視為薄片），不論產生/製作的材質中\n"
+"烘焙的是什麼值。"
+
+#. option rtx.thinWallThicknessOverridesString
+#: src/dxvk/rtx_render/rtx_options.h:250
+msgid ""
+"Per-texture Thin Wall Thickness override for legacy Translucent materials with\n"
+"rtx.thinWalledOverrideTextures enabled, set via the in-game Texture Selection menu.\n"
+"Format: hash1:thickness1,hash2:thickness2\n"
+"Only takes effect for hashes also present in rtx.thinWalledOverrideTextures."
+msgstr ""
+"舊版半透明材質（已啟用 rtx.thinWalledOverrideTextures）的逐紋理薄壁厚度覆寫，\n"
+"透過遊戲內的紋理選擇選單設定。\n"
+"格式：hash1:thickness1,hash2:thickness2\n"
+"只對同樣存在於 rtx.thinWalledOverrideTextures 中的雜湊生效。"
+
+#. option rtx.hideInstanceTextures
+#: src/dxvk/rtx_render/rtx_options.h:255
+msgid ""
+"Textures on draw calls that should be hidden from rendering, but not totally ignored.\n"
+"This is similar to rtx.ignoreTextures but instead of completely ignoring such draw calls they are only hidden from rendering, allowing for the hidden objects to still appear in captures.\n"
+"As such, this is mostly only a development tool to hide objects during development until they are properly replaced, otherwise the objects should be ignored with rtx.ignoreTextures instead for better performance."
+msgstr ""
+"應在渲染中隱藏、但不完全忽略之繪製呼叫上的紋理。\n"
+"這與 rtx.ignoreTextures 類似，但不是完全忽略這類繪製呼叫，而只是在渲染中隱藏，讓隱藏的物件仍會出現在擷取中。\n"
+"因此，這主要是開發工具，用於在開發期間隱藏物件，直到它們被正確替換為止；否則應改用 rtx.ignoreTextures 忽略這些物件，以獲得更好的效能。"
+
+#. option rtx.playerModelTextures
+#: src/dxvk/rtx_render/rtx_options.h:259
+msgid ""
+"Textures on draw calls that are part of the third-person player model, such as body, head, or held equipment.\n"
+"By default, tagged instances appear in shadows and reflections but are not drawn in the primary camera view."
+msgstr ""
+"屬於第三人稱玩家模型一部分（例如身體、頭部或手持裝備）之繪製呼叫上的紋理。\n"
+"預設情況下，已標記的實例會出現在陰影與反射中，但不會在主要攝影機視角中繪製。"
+
+#. option rtx.playerModelBodyTextures
+#: src/dxvk/rtx_render/rtx_options.h:262
+msgid ""
+"Textures on the body/root of the third-person player model.\n"
+"Apply together with third_person_player_model to give the body the same visibility behavior. This category also identifies the anchor Remix uses to filter nearby player-model parts and position virtual instances through portals."
+msgstr ""
+"第三人稱玩家模型身體/根部上的紋理。\n"
+"請與 third_person_player_model 一起套用，讓身體具有相同的可見性行為。此類別也用來識別錨點，Remix 會以此錨點篩選鄰近的玩家模型部位，並透過傳送門放置虛擬實例。"
+
+#. option rtx.lightConverter
+#: src/dxvk/rtx_render/rtx_options.h:265
+msgid ""
+"Textures on draw calls that should spawn Remix effect lights.\n"
+"An effect light is a dynamic sphere light placed at the tagged draw call's geometry centroid; radius, intensity, color, and plasma-ball animation are controlled in the Runtime UI's Lighting > Effect Light section."
+msgstr ""
+"應產生 Remix 效果光源之繪製呼叫上的紋理。\n"
+"效果光源是放置在已標記繪製呼叫幾何中心的動態球形光源；其半徑、強度、色彩與電漿球動畫，可在執行階段 UI 的「照明 > 效果光源」區段中控制。"
+
+#. option rtx.particleTextures
+#: src/dxvk/rtx_render/rtx_options.h:268
+msgid ""
+"Textures on draw calls that should be treated as particles.\n"
+"When objects are marked as particles more approximate rendering methods are leveraged allowing for more effecient and typically better looking particle rendering.\n"
+"Generally any billboard-like blended particle objects in the original application should be classified this way."
+msgstr ""
+"應被視為粒子之繪製呼叫上的紋理。\n"
+"當物件被標記為粒子時，會使用較近似的渲染方法，讓粒子渲染更有效率，通常也更好看。\n"
+"一般而言，原始應用程式中任何類似公告板的混合粒子物件都應如此分類。"
+
+#. option rtx.hairCardTextures
+#: src/dxvk/rtx_render/rtx_options.h:272
+msgid ""
+"Textures on draw calls that should be treated as alpha-tested hair cards.\n"
+"Tagged materials preserve fine texture detail, render as cutouts instead of alpha blends, and disable backface culling."
+msgstr ""
+"應被視為 alpha 測試髮片之繪製呼叫上的紋理。\n"
+"已標記的材質會保留細緻的紋理細節，以鏤空而非 alpha 混合方式渲染，並停用背面剔除。"
+
+#. option rtx.hairCardMipBias
+#: src/dxvk/rtx_render/rtx_options.h:275
+msgid "The mip level bias applied to textures on materials tagged as hair cards. Large negative values preserve thin strand detail at a distance."
+msgstr "套用於標記為髮片之材質上紋理的 mip 層級偏差。較大的負值可在遠處保留細髮絲的細節。"
+
+#. option rtx.hairCardRoughnessScale
+#: src/dxvk/rtx_render/rtx_options.h:277
+msgid "An additional roughness multiplier applied only to materials tagged as hair cards."
+msgstr "僅套用於標記為髮片之材質的額外粗糙度倍數。"
+
+#. option rtx.beamTextures
+#: src/dxvk/rtx_render/rtx_options.h:279
+msgid ""
+"Textures on draw calls that are already particles or emissively blended and have beam-like geometry.\n"
+"Typically objects marked as particles or objects using emissive blending will be rendered with a special method which allows re-orientation of the billboard geometry assumed to make up the draw call in indirect rays (reflections for example).\n"
+"This method works fine for typical particles, but some (e.g. a laser beam) may not be well-represented with the typical billboard assumption of simply needing to rotate around its centroid to face the view direction.\n"
+"To handle such cases a different beam mode is used to treat objects as more of a cylindrical beam and re-orient around its main spanning axis, allowing for better rendering of these beam-like effect objects."
+msgstr ""
+"已是粒子或使用自發光混合、且具有光束狀幾何之繪製呼叫上的紋理。\n"
+"通常，標記為粒子或使用自發光混合的物件，會以特殊方法渲染，讓間接光線（例如反射）中被假設構成該繪製呼叫的公告板幾何能重新定向。\n"
+"此方法對一般粒子效果很好，但有些物件（例如雷射光束）並不適合用一般公告板的假設來表現，也就是只需繞著中心點旋轉以面向視線方向。\n"
+"為處理這類情況，會使用另一種光束模式，將物件視為較接近圓柱狀的光束，並繞其主要延伸軸重新定向，讓這類光束狀效果物件的渲染效果更好。"
+
+#. option rtx.decalTextures
+#: src/dxvk/rtx_render/rtx_options.h:284
+msgid ""
+"Textures on draw calls used for static geometric decals or decals with complex topology.\n"
+"These materials will be blended over the materials underneath them when decal material blending is enabled.\n"
+"A small configurable offset is applied to each flat/co-planar part of these decals to prevent coplanar geometric cases (which poses problems for ray tracing)."
+msgstr ""
+"用於靜態幾何貼花或具有複雜拓撲之貼花的繪製呼叫上的紋理。\n"
+"啟用貼花材質混合時，這些材質會混合在其下方的材質之上。\n"
+"這些貼花的每個平坦/共平面部分都會套用一個可設定的小偏移，以避免共平面幾何的情況（這會對光線追蹤造成問題）。"
+
+#. option rtx.terrainTextures
+#: src/dxvk/rtx_render/rtx_options.h:313
+msgid ""
+"Albedo textures that are baked blended together to form a unified terrain texture used during ray tracing.\n"
+"Put albedo textures into this category if the game renders terrain as a blend of multiple textures."
+msgstr ""
+"會被烘焙混合成光線追蹤時所用之統一地形紋理的反照率紋理。\n"
+"若遊戲以多張紋理混合的方式渲染地形，請將反照率紋理放入此類別。"
+
+#. option rtx.opacityMicromapIgnoreTextures
+#: src/dxvk/rtx_render/rtx_options.h:315
+msgid "Textures to ignore when generating Opacity Micromaps. This generally does not have to be set and is only useful for black listing problematic cases for Opacity Micromap usage."
+msgstr "產生不透明度微貼圖時要忽略的紋理。一般不需要設定，只在需要將使用不透明度微貼圖時出問題的情況列入封鎖清單時才有用。"
+
+#. option rtx.animatedWaterTextures
+#: src/dxvk/rtx_render/rtx_options.h:316
+msgid ""
+"Textures on draw calls to be treated as \"animated water\".\n"
+"Objects with this flag applied will animate their normals to fake a basic water effect based on the layered water material parameters, and only when rtx.opaqueMaterial.layeredWaterNormalEnable is set to true.\n"
+"Should typically be used on static water planes that the original application may have relied on shaders to animate water on."
+msgstr ""
+"應被視為「動畫水面」之繪製呼叫上的紋理。\n"
+"套用此旗標的物件會依分層水面材質參數讓法線產生動畫，以模擬基本的水面效果，且只在 rtx.opaqueMaterial.layeredWaterNormalEnable 設為 true 時才會生效。\n"
+"通常應用於原始應用程式可能依賴著色器製作水面動畫的靜態水面。"
+
+#. option rtx.allowBakedLightingTextures
+#: src/dxvk/rtx_render/rtx_options.h:320
+msgid ""
+"Textures for which to allow two types of baked lighting, Texture Factors and Vertex Color.\n"
+"\n"
+"By default, all textures have their baked lighting ignored to ensure proper ray-traced lighting. Only textures explicitly listed here will preserve their original baked lighting effects.\n"
+"\n"
+"Texture Factor enablement:\n"
+"Using this feature on selected textures will preserve the texture factors.\n"
+"For instance, if a game bakes lighting information into the Texture Factor for particular textures, applying this option will keep them.\n"
+"This becomes useful when you want to preserve specific lighting effects that are intentionally baked into the Texture Factor.\n"
+"Consider an example where the original texture contains intentional red tints baked into the Texture Factor that should be preserved for artistic reasons.\n"
+"Similarly, you can tag textures if shadows are intentionally baked into the Texture Factor and should remain.\n"
+"\n"
+"Vertex Color enablement:\n"
+"Using this feature on selected textures will preserve the vertex colors.\n"
+"\n"
+"Note, enabling this setting will automatically enable multiple-stage texture factor blendings for the selected textures.\n"
+"Only use this option when you specifically want to preserve the original game's lighting effects, as by default RTX Remix provides superior ray-traced lighting."
+msgstr ""
+"允許兩種烘焙照明（紋理因子與頂點色彩）的紋理。\n"
+"\n"
+"預設情況下，所有紋理的烘焙照明都會被忽略，以確保正確的光線追蹤照明。只有此處明確列出的紋理才會保留其原始的烘焙照明效果。\n"
+"\n"
+"紋理因子啟用：\n"
+"對所選紋理使用此功能會保留紋理因子。\n"
+"例如，若遊戲將特定紋理的照明資訊烘焙進紋理因子，套用此選項就會保留它們。\n"
+"當您想保留刻意烘焙進紋理因子的特定照明效果時，這就很有用。\n"
+"舉例來說，原始紋理可能包含刻意烘焙進紋理因子的紅色色調，基於藝術考量應予以保留。\n"
+"同樣地，若陰影是刻意烘焙進紋理因子且應該保留，也可以標記這些紋理。\n"
+"\n"
+"頂點色彩啟用：\n"
+"對所選紋理使用此功能會保留頂點色彩。\n"
+"\n"
+"注意，啟用此設定會自動為所選紋理啟用多階段紋理因子混合。\n"
+"只有在您確實想保留原始遊戲的照明效果時才使用此選項，因為 RTX Remix 預設會提供更出色的光線追蹤照明。"
+
+#. option rtx.ignoreAlphaOnTextures
+#: src/dxvk/rtx_render/rtx_options.h:333
+msgid "Textures for which to ignore the alpha channel of the legacy colormap. Textures will be rendered fully opaque as a result."
+msgstr "忽略舊版色彩貼圖 alpha 通道的紋理。因此這些紋理會以完全不透明的方式渲染。"
+
+#. option rtx.antiCulling.antiCullingTextures
+#: src/dxvk/rtx_render/rtx_options.h:335
+msgid ""
+"Textures that are forced to extend life length when anti-culling is enabled.\n"
+"Some games use different culling methods we can't fully match, use this option to manually add textures to force extend their life when anti-culling fails."
+msgstr ""
+"啟用反剔除時，強制延長存續時間的紋理。\n"
+"有些遊戲使用我們無法完全比對的剔除方法；當反剔除失效時，可使用此選項手動加入紋理，強制延長其存續時間。"
+
+#. option rtx.postfx.motionBlurMaskOutTextures
+#: src/dxvk/rtx_render/rtx_options.h:338
+msgid "Disable motion blur for meshes with specific texture."
+msgstr "對使用特定紋理的網格停用動態模糊。"
+
+#. option rtx.raytracedRenderTargetTextures
+#: src/dxvk/rtx_render/rtx_options.h:359
+msgid "DescriptorHashes for Render Targets. (Screens that should display the output of another camera)."
+msgstr "渲染目標的 DescriptorHashes。（應顯示另一台攝影機輸出的螢幕。）"
+
+#. option rtx.particleEmitterTextures
+#: src/dxvk/rtx_render/rtx_options.h:361
+msgid "Objects rendered with these textures will emit particles that inherit the material of the object itself."
+msgstr "使用這些紋理渲染的物件會發射粒子，粒子會繼承物件本身的材質。"
+
+#. option rtx.smoothNormalsTextures
+#: src/dxvk/rtx_render/rtx_options.h:362
+msgid ""
+"Textures on draw calls whose geometry should have smooth normals generated on the GPU.\n"
+"This is useful for older D3D9 games where the geometry may be missing smooth normals, especially when using the VertexShader Capture mechanism.\n"
+"When a draw call matches, area-weighted smooth normals will be computed from the triangle mesh and used for ray tracing."
+msgstr ""
+"其幾何應在 GPU 上產生平滑法線之繪製呼叫上的紋理。\n"
+"這適用於幾何可能缺少平滑法線的舊版 D3D9 遊戲，尤其是在使用 VertexShader 擷取機制時。\n"
+"當繪製呼叫相符時，會從三角形網格計算面積加權的平滑法線，並用於光線追蹤。"
+
+#. option rtx.enableRaytracing
+#: src/dxvk/rtx_render/rtx_options.h:369
+msgid ""
+"Globally enables or disables ray tracing. When set to false the original game should render mostly as it would in DXVK typically.\n"
+"Some artifacts may still appear however compared to the original game either due to issues with the underlying DXVK translation or issues in Remix itself."
+msgstr ""
+"全域啟用或停用光線追蹤。設為 false 時，原始遊戲的渲染大致會與一般在 DXVK 中相同。\n"
+"不過與原始遊戲相比，仍可能出現一些瑕疵，原因可能是底層 DXVK 轉譯的問題，或 Remix 本身的問題。"
+
+#. option rtx.sceneScale
+#: src/dxvk/rtx_render/rtx_options.h:373
+msgid "Defines the ratio of rendering unit (1cm) to game unit, i.e. sceneScale = 1cm / GameUnit."
+msgstr "定義渲染單位 (1cm) 與遊戲單位的比例，即 sceneScale = 1cm / GameUnit。"
+
+#. option rtx.zUp
+#: src/dxvk/rtx_render/rtx_options.h:374
+msgid "Indicates that the Z axis is the \"upward\" axis in the world when true, otherwise the Y axis when false."
+msgstr "為 true 時表示 Z 軸是世界中的「向上」軸，為 false 時則為 Y 軸。"
+
+#. option rtx.leftHandedCoordinateSystem
+#: src/dxvk/rtx_render/rtx_options.h:375
+msgid "Indicates that the world space coordinate system is left-handed when true, otherwise right-handed when false."
+msgstr "為 true 時表示世界空間座標系為左手座標系，為 false 時則為右手座標系。"
+
+#. option rtx.keepTexturesForTagging
+#: src/dxvk/rtx_render/rtx_options.h:381
+msgid "A flag to keep all textures in video memory, which can drastically increase VRAM consumption. Intended to assist with tagging textures that are only used for a short period of time (such as loading screens). Use only when necessary!"
+msgstr "將所有紋理保留在顯示記憶體中的旗標，可能會大幅增加 VRAM 用量。用於協助標記只會短暫使用的紋理（例如載入畫面）。請只在必要時使用！"
+
+#. option rtx.gui.textureGridThumbnailScale
+#: src/dxvk/rtx_render/rtx_options.h:382
+msgid ""
+"A float to set the scale of thumbnails while selecting textures.\n"
+"This will be scaled by the default value of 120 pixels.\n"
+"This value must always be greater than zero."
+msgstr ""
+"選擇紋理時設定縮圖比例的浮點數。\n"
+"會以預設值 120 像素為基準縮放。\n"
+"此值必須一律大於零。"
+
+#. option rtx.skipDrawCallsPostRTXInjection
+#: src/dxvk/rtx_render/rtx_options.h:387
+msgid "Ignores all draw calls recorded after RTX Injection, the location of which varies but is currently based on when tagged UI textures begin to draw."
+msgstr "忽略 RTX 注入之後記錄的所有繪製呼叫；注入位置會有所不同，但目前取決於已標記的 UI 紋理開始繪製的時間點。"
+
+#. option rtx.dlssPreset
+#: src/dxvk/rtx_render/rtx_options.h:388
+msgid "Combined DLSS Preset for quickly controlling Upscaling, Frame Interpolation and Latency Reduction."
+msgstr "綜合 DLSS 預設，可快速控制升頻、畫格插補與延遲降低。"
+
+#. option rtx.nisPreset
+#: src/dxvk/rtx_render/rtx_options.h:391
+msgid "Adjusts NIS scaling factor, trades quality for performance."
+msgstr "調整 NIS 縮放倍數，以品質換取效能。"
+
+#. option rtx.taauPreset
+#: src/dxvk/rtx_render/rtx_options.h:393
+msgid "Adjusts TAA-U scaling factor, trades quality for performance."
+msgstr "調整 TAA-U 縮放倍數，以品質換取效能。"
+
+#. option rtx.graphicsPreset
+#: src/dxvk/rtx_render/rtx_options.h:396
+msgid "Overall rendering preset, higher presets result in higher image quality, lower presets result in better performance."
+msgstr "整體渲染預設，預設越高影像品質越好，預設越低效能越好。"
+
+#. option rtx.emissiveIntensity
+#: src/dxvk/rtx_render/rtx_options.h:402
+msgid "A general scale factor on all emissive intensity values globally. Generally per-material emissive intensities should be used, but this option may be useful for debugging without needing to author materials."
+msgstr "全域套用於所有自發光強度值的通用縮放係數。一般應使用逐材質的自發光強度，但此選項可在不需製作材質的情況下用於偵錯。"
+
+#. option rtx.fireflyFilteringLuminanceThreshold
+#: src/dxvk/rtx_render/rtx_options.h:404
+msgid "Maximum luminance threshold for the firefly filtering to clamp to."
+msgstr "亮點過濾所限制的最大亮度臨界值。"
+
+#. option rtx.primaryIndirectSpecularFireflyFilteringThreshold
+#: src/dxvk/rtx_render/rtx_options.h:406
+msgid "Maximum per-channel radiance for the primary indirect specular signal to suppress fireflies."
+msgstr "主要間接鏡面訊號的逐通道最大輻射亮度，用於抑制亮點。"
+
+#. option rtx.secondarySpecularFireflyFilteringThreshold
+#: src/dxvk/rtx_render/rtx_options.h:408
+msgid "Firefly luminance clamping threshold for secondary specular signal."
+msgstr "次要鏡面訊號的亮點亮度限制臨界值。"
+
+#. option rtx.vertexColorStrength
+#: src/dxvk/rtx_render/rtx_options.h:409
+msgid ""
+"A scalar to apply to how strong vertex color influence should be on materials.\n"
+"A value of 1 indicates that it should be fully considered (though do note the texture operation and relevant parameters still control how much it should be blended with the actual albedo color), a value of 0 indicates that it should be fully ignored."
+msgstr ""
+"決定頂點色彩對材質影響強度的純量。\n"
+"值為 1 表示完全納入考量（但請注意，紋理運算與相關參數仍會控制它與實際反照率色彩混合的程度），值為 0 表示完全忽略。"
+
+#. option rtx.vertexColorIsBakedLighting
+#: src/dxvk/rtx_render/rtx_options.h:413
+msgid "If true, brightness contribution will be removed from the vertex color by dividing each component by the largest component."
+msgstr "若為 true，會將每個分量除以最大分量，以移除頂點色彩中的亮度貢獻。"
+
+#. option rtx.ignoreAllVertexColorBakedLighting
+#: src/dxvk/rtx_render/rtx_options.h:414
+msgid "If true, all baked lighting bound to all vertex colors will be ignored."
+msgstr "若為 true，會忽略所有頂點色彩上的所有烘焙照明。"
+
+#. option rtx.allowFSE
+#: src/dxvk/rtx_render/rtx_options.h:415
+msgid ""
+"A flag indicating if the application should be able to utilize exclusive full screen mode when set to true, otherwise force it to be disabled when set to false.\n"
+"Exclusive full screen may see performance benefits over other fullscreen modes at the cost of stability in some cases.\n"
+"Do note that on modern Windows full screen optimizations will likely be used regardless which in most cases results in performance similar to exclusive full screen even when it is not in use."
+msgstr ""
+"決定應用程式是否能使用獨佔全螢幕模式的旗標；設為 true 時允許，設為 false 時強制停用。\n"
+"獨佔全螢幕可能比其他全螢幕模式有效能上的優勢，但在某些情況下會犧牲穩定性。\n"
+"請注意，在新版 Windows 上，無論如何都可能會使用全螢幕最佳化，因此大多數情況下，即使未使用獨佔全螢幕，效能也與其相近。"
+
+#. option rtx.shader.useLiveEditMode
+#: src/dxvk/rtx_render/rtx_options.h:444
+msgid ""
+"When set to true shaders will be automatically recompiled when any shader file is updated (saved for instance) in addition to the usual manual recompilation trigger.\n"
+"This option is mainly meant for development use and should not be set for user-facing operation."
+msgstr ""
+"設為 true 時，除了一般的手動重新編譯觸發外，任何著色器檔案更新（例如儲存）時也會自動重新編譯著色器。\n"
+"此選項主要供開發使用，不應在面向使用者的環境中設定。"
+
+#. option rtx.raytracedRenderTarget.enable
+#: src/dxvk/rtx_render/rtx_options.h:471
+msgid "Enables or disables raytracing for render-to-texture effects.  The render target to be raytraced must be specified in the texture selection menu."
+msgstr "啟用或停用渲染至紋理效果的光線追蹤。要進行光線追蹤的渲染目標必須在紋理選擇選單中指定。"
+
+#. option rtx.viewModel.enable
+#: src/dxvk/rtx_render/rtx_options.h:478
+msgid "If true, try to resolve view models (e.g. first-person weapons). World geometry doesn't have shadows / reflections / etc from the view models."
+msgstr "若為 true，會嘗試解析視角模型（例如第一人稱武器）。世界幾何上不會有來自視角模型的陰影 / 反射等。"
+
+#. option rtx.viewModel.scale
+#: src/dxvk/rtx_render/rtx_options.h:481
+msgid "Scale for view models. Minimize to prevent clipping."
+msgstr "視角模型的縮放。請盡量縮小以避免穿模。"
+
+#. option rtx.viewModel.enableVirtualInstances
+#: src/dxvk/rtx_render/rtx_options.h:482
+msgid "If true, virtual instances are created to render the view models behind a portal."
+msgstr "若為 true，會建立虛擬實例以渲染傳送門後方的視角模型。"
+
+#. option rtx.viewModel.perspectiveCorrection
+#: src/dxvk/rtx_render/rtx_options.h:483
+msgid "If true, apply correction to view models (e.g. different FOV is used for view models)."
+msgstr "若為 true，會對視角模型套用校正（例如視角模型使用不同的 FOV）。"
+
+#. option rtx.viewModel.maxZThreshold
+#: src/dxvk/rtx_render/rtx_options.h:484
+msgid "If a draw call's viewport has max depth less than or equal to this threshold, then assume that it's a view model."
+msgstr "若繪製呼叫的檢視區最大深度小於或等於此臨界值，就假設它是視角模型。"
+
+#. option rtx.displacement.mode
+#: src/dxvk/rtx_render/rtx_options.h:502
+msgid ""
+"What algorithm the displacement uses.\n"
+"RaymarchPOM: advances the ray in linear steps until the ray is below the heightfield.\n"
+"QuadtreePOM: Relies on special mipmaps with maximum values instead of average values.  Uses the mipmap as a quadtree."
+msgstr ""
+"位移所使用的演算法。\n"
+"RaymarchPOM：以線性步長推進光線，直到光線位於高度場下方。\n"
+"QuadtreePOM：依賴以最大值而非平均值產生的特殊 mipmap，並將 mipmap 當作四元樹使用。"
+
+#. option rtx.displacement.enableDirectLighting
+#: src/dxvk/rtx_render/rtx_options.h:505
+msgid "Whether direct lighting accounts for displacement mapping"
+msgstr "直接照明是否考慮位移貼圖"
+
+#. option rtx.displacement.enableIndirectLighting
+#: src/dxvk/rtx_render/rtx_options.h:506
+msgid "Whether indirect lighting accounts for displacement mapping"
+msgstr "間接照明是否考慮位移貼圖"
+
+#. option rtx.displacement.enableNEECache
+#: src/dxvk/rtx_render/rtx_options.h:507
+msgid "Whether the NEE cache accounts for displacement mapping"
+msgstr "NEE 快取是否考慮位移貼圖"
+
+#. option rtx.displacement.enableReSTIRGI
+#: src/dxvk/rtx_render/rtx_options.h:508
+msgid "Whether ReSTIR GI accounts for displacement mapping"
+msgstr "ReSTIR GI 是否考慮位移貼圖"
+
+#. option rtx.displacement.enableIndirectHit
+#: src/dxvk/rtx_render/rtx_options.h:509
+msgid "Whether indirect ray hits account for displacement mapping (Enabling this is expensive.  Without it, non-perfect reflections of displaced objects will not show displacement.)"
+msgstr "間接光線命中是否考慮位移貼圖（啟用此選項的成本很高。若不啟用，位移物件的非完美反射將不會顯示位移。）"
+
+#. option rtx.displacement.enablePSR
+#: src/dxvk/rtx_render/rtx_options.h:510
+msgid "Enable PSR (perfect reflections) for materials with displacement.  Rays that have been perfectly reflected off a POM surface will not collide correctly with other parts of that same surface."
+msgstr "為具有位移的材質啟用 PSR（完美反射）。從 POM 表面完美反射出去的光線，無法與同一表面的其他部分正確碰撞。"
+
+#. option rtx.displacement.displacementFactor
+#: src/dxvk/rtx_render/rtx_options.h:511
+msgid "Scaling factor for all displacement maps"
+msgstr "所有位移貼圖的縮放係數"
+
+#. option rtx.displacement.displacementInFactor
+#: src/dxvk/rtx_render/rtx_options.h:512
+msgid "Scale factor for inwards displacement"
+msgstr "向內位移的縮放係數"
+
+#. option rtx.displacement.displacementOutFactor
+#: src/dxvk/rtx_render/rtx_options.h:513
+msgid "Scale factor for outwards displacement"
+msgstr "向外位移的縮放係數"
+
+#. option rtx.displacement.maxIterations
+#: src/dxvk/rtx_render/rtx_options.h:514
+msgid "The max number of times the POM raymarch will iterate."
+msgstr "POM 光線步進的最大迭代次數。"
+
+#. option rtx.minPrimsInDynamicBLAS
+#: src/dxvk/rtx_render/rtx_options.h:519
+msgid "The minimum number of triangles required to promote a mesh to it's own BLAS, otherwise it lands in the merged BLAS with multiple other meshes."
+msgstr "讓網格擁有獨立 BLAS 所需的最少三角形數；否則它會與其他多個網格一起放入合併 BLAS。"
+
+#. option rtx.maxPrimsInMergedBLAS
+#: src/dxvk/rtx_render/rtx_options.h:520
+msgid "The maximum number of triangles for a mesh that can be in the merged BLAS.  "
+msgstr "可放入合併 BLAS 之網格的最大三角形數。  "
+
+#. option rtx.forceMergeAllMeshes
+#: src/dxvk/rtx_render/rtx_options.h:521
+msgid "Force merges all meshes into as few BLAS as possible.  This is generally not desirable for performance, but can be a useful debugging tool."
+msgstr "強制將所有網格合併到盡可能少的 BLAS 中。就效能而言通常並不理想，但可作為實用的偵錯工具。"
+
+#. option rtx.minimizeBlasMerging
+#: src/dxvk/rtx_render/rtx_options.h:522
+msgid "Minimize BLAS merging to the minimum possible, this option tries to give all meshes their own BLAS.  This is generally not desirable forperformance, but can be a useful debugging tool."
+msgstr "將 BLAS 合併減至最少，此選項會嘗試讓所有網格都擁有自己的 BLAS。就效能而言通常並不理想，但可作為實用的偵錯工具。"
+
+#. option rtx.enableAlwaysCalculateAABB
+#: src/dxvk/rtx_render/rtx_options.h:524
+msgid ""
+"Calculate an Axis Aligned Bounding Box for every draw call.\n"
+" This may improve instance tracking across frames for skinned and vertex shaded calls."
+msgstr ""
+"為每個繪製呼叫計算軸對齊邊界框。\n"
+" 這可能會改善蒙皮與頂點著色繪製呼叫的跨畫格實例追蹤。"
+
+#. option rtx.shakeCamera
+#: src/dxvk/rtx_render/rtx_options.h:540
+msgid "Enables animation of the free camera."
+msgstr "啟用自由攝影機的動畫。"
+
+#. option rtx.cameraAnimationMode
+#: src/dxvk/rtx_render/rtx_options.h:541
+msgid "Free camera's animation mode."
+msgstr "自由攝影機的動畫模式。"
+
+#. option rtx.cameraShakePeriod
+#: src/dxvk/rtx_render/rtx_options.h:542
+msgid "Period of the free camera's animation."
+msgstr "自由攝影機動畫的週期。"
+
+#. option rtx.cameraAnimationAmplitude
+#: src/dxvk/rtx_render/rtx_options.h:543
+msgid "Amplitude of the free camera's animation."
+msgstr "自由攝影機動畫的振幅。"
+
+#. option rtx.enableNearPlaneOverride
+#: src/dxvk/rtx_render/rtx_options.h:545
+msgid ""
+"A flag to enable or disable the Camera's near plane override feature.\n"
+"Since the camera is not used directly for ray tracing the near plane the application uses typically does not matter, but for certain matrix-based operations (such as temporal reprojection or voxel grid projection) it is still relevant.\n"
+"The issue arises when geometry is ray traced that is behind where the chosen Camera's near plane is located, typically common on viewmodels especially with how they are ray traced, causing graphical artifacts and other issues.\n"
+"This option helps correct this issue by overriding the near plane value to else (usually smaller) to sit behind the objects in question (such as the view model). As such this option should usually be enabled on games with viewmodels.\n"
+"Do note that when adjusting the near plane the larger the relative magnitude gap between the near and far plane the worse the precision of matrix operations will be, so the near plane should be set as high as possible even when overriding."
+msgstr ""
+"啟用或停用攝影機近平面覆寫功能的旗標。\n"
+"由於攝影機並不直接用於光線追蹤，應用程式使用的近平面通常不重要，但對某些以矩陣為基礎的運算（例如時域重新投影或體素格點投影）而言仍然相關。\n"
+"當進行光線追蹤的幾何位於所選攝影機近平面的後方時就會出現問題，這在視角模型上很常見（尤其是其光線追蹤方式），會造成畫面瑕疵與其他問題。\n"
+"此選項會將近平面值覆寫為其他值（通常更小），使其位於相關物件（例如視角模型）的後方，以協助修正此問題。因此，在有視角模型的遊戲中通常應啟用此選項。\n"
+"請注意，調整近平面時，近平面與遠平面的相對量級差距越大，矩陣運算的精確度就越差，因此即使進行覆寫，也應將近平面設得盡可能高。"
+
+#. option rtx.nearPlaneOverride
+#: src/dxvk/rtx_render/rtx_options.h:551
+msgid ""
+"The near plane value to use for the Camera when the near plane override is enabled.\n"
+"Only takes effect when rtx.enableNearPlaneOverride is enabled, see that option for more information about why this is useful."
+msgstr ""
+"啟用近平面覆寫時，攝影機要使用的近平面值。\n"
+"只在啟用 rtx.enableNearPlaneOverride 時生效，有關此功能用途的詳細資訊，請參閱該選項。"
+
+#. option rtx.useRTXDI
+#: src/dxvk/rtx_render/rtx_options.h:558
+msgid ""
+"A flag indicating if RTXDI should be used, true enables RTXDI, false disables it and falls back on simpler light sampling methods.\n"
+"RTXDI provides improved direct light sampling quality over traditional methods and should generally be enabled for improved direct lighting quality at the cost of some performance."
+msgstr ""
+"決定是否使用 RTXDI 的旗標；true 會啟用 RTXDI，false 會停用並改用較簡單的光源取樣方法。\n"
+"RTXDI 能提供比傳統方法更好的直接光源取樣品質，一般應啟用以提升直接照明品質，代價是一些效能。"
+
+#. option rtx.integrateIndirectMode
+#: src/dxvk/rtx_render/rtx_options.h:561
+msgid ""
+"Indirect integration mode:\n"
+"0: Importance Sampled. Importance sampled mode uses typical GI sampling and it is not recommended for general use as it provides the noisiest output.\n"
+"   It serves as a reference integration mode for validation of other indirect integration modes.\n"
+"1: ReSTIR GI. ReSTIR GI provides improved indirect path sampling over \"Importance Sampled\" mode \n"
+"   with better indirect diffuse and specular GI quality at increased performance cost.\n"
+"2: RTX Neural Radiance Cache (NRC). NRC is an AI based world space radiance cache. It is live trained by the path tracer\n"
+"   and remains available as an alternative cache path.\n"
+"3: Spatially Hashed Radiance Cache (SHaRC). SHaRC is the default world-space radiance cache. It uses a spatial hash\n"
+"   to store radiance and allows paths to terminate early by looking up cached values.\n"
+msgstr ""
+"間接積分模式：\n"
+"0：重要性取樣。重要性取樣模式使用一般的 GI 取樣，由於輸出的雜訊最多，不建議一般使用。\n"
+"   它是用來驗證其他間接積分模式的參考積分模式。\n"
+"1：ReSTIR GI。ReSTIR GI 提供比「重要性取樣」模式更好的間接路徑取樣，\n"
+"   間接漫反射與鏡面 GI 品質更佳，但效能成本較高。\n"
+"2：RTX 神經輻射快取 (NRC)。NRC 是以 AI 為基礎的世界空間輻射快取，由路徑追蹤器即時訓練，\n"
+"   並仍可作為替代的快取路徑使用。\n"
+"3：空間雜湊輻射快取 (SHaRC)。SHaRC 是預設的世界空間輻射快取，使用空間雜湊\n"
+"   儲存輻射亮度，可讓路徑透過查詢快取值提早終止。\n"
+
+#. option rtx.upscalerType
+#: src/dxvk/rtx_render/rtx_options.h:573
+msgid "Upscaling boosts performance with varying degrees of image quality tradeoff depending on the type of upscaler and the quality mode/preset."
+msgstr "升頻可提升效能，但會依升頻器類型與品質模式/預設而在不同程度上犧牲影像品質。"
+
+#. option rtx.frameGenerationType
+#: src/dxvk/rtx_render/rtx_options.h:576
+msgid "Frame Generation technology to use, and the control that enables it. None = disabled, DLSS = NVIDIA DLSS Frame Generation, FSR = AMD FSR 3 Frame Generation. Setting this drives rtx.dlfg.enable / rtx.fsrfg.enable; you do not set those directly."
+msgstr "要使用的畫格生成技術，也是啟用它的控制項。None = 停用，DLSS = NVIDIA DLSS 畫格生成，FSR = AMD FSR 3 畫格生成。設定此選項會驅動 rtx.dlfg.enable / rtx.fsrfg.enable；您不需要直接設定它們。"
+
+#. option rtx.enableRayReconstruction
+#: src/dxvk/rtx_render/rtx_options.h:580
+msgid "Enables DLSS ray reconstruction, an AI-based denoiser designed for real time ray tracing."
+msgstr "啟用 DLSS 光線重建，這是專為即時光線追蹤設計、以 AI 為基礎的降噪器。"
+
+#. option rtx.forceCameraJitter
+#: src/dxvk/rtx_render/rtx_options.h:586
+msgid "Force enables camera jitter frame to frame."
+msgstr "強制啟用逐畫格的攝影機抖動。"
+
+#. option rtx.forceStaticSceneMotionVectors
+#: src/dxvk/rtx_render/rtx_options.h:587
+msgid "Forces primary screen-space motion vectors to assume the scene geometry is static, ignoring per-object/skinned (virtual) motion. Camera motion is still fully accounted for.This reprojects the current pixel directly into the previous frame instead of reprojecting the absolute world-space hit position. This is mainly for testing purposes to detect issues due to world space position reprojection errors vs using translated world space which would be the solution."
+msgstr "強制主要螢幕空間動態向量假設場景幾何是靜態的，忽略逐物件/蒙皮（虛擬）運動。攝影機運動仍會完整考慮。這會將目前像素直接重新投影到上一個畫格，而非重新投影世界空間中的絕對命中位置。主要用於測試，以偵測世界空間位置重新投影誤差所造成的問題，而解決方法是改用平移後的世界空間。"
+
+#. option rtx.cameraJitterSequenceLength
+#: src/dxvk/rtx_render/rtx_options.h:589
+msgid "Sets a camera jitter sequence length [number of frames]. It will loop around once the length is reached."
+msgstr "設定攝影機抖動序列長度 [畫格數]。達到該長度後會循環。"
+
+#. option rtx.enableDirectLighting
+#: src/dxvk/rtx_render/rtx_options.h:590
+msgid "Enables direct lighting (lighting directly from lights on to a surface) on surfaces when set to true, otherwise disables it."
+msgstr "設為 true 時，啟用表面上的直接照明（光源直接照射到表面的照明），否則停用。"
+
+#. option rtx.enableSecondaryBounces
+#: src/dxvk/rtx_render/rtx_options.h:591
+msgid "Enables indirect lighting (lighting from diffuse/specular bounces to one or more other surfaces) on surfaces when set to true, otherwise disables it."
+msgstr "設為 true 時，啟用表面上的間接照明（經由漫反射/鏡面反彈到一或多個其他表面的照明），否則停用。"
+
+#. option rtx.uniqueObjectDistance
+#: src/dxvk/rtx_render/rtx_options.h:594
+msgid ""
+"The distance (in game units) that an object can move in a single frame before it is no longer considered the same object.\n"
+"If this is too low, fast moving objects may flicker and have bad lighting.  If it's too high, repeated objects may flicker.\n"
+"This does not account for sceneScale."
+msgstr ""
+"物件在單一畫格內可移動、但仍被視為同一物件的距離（以遊戲單位計）。\n"
+"若此值太低，快速移動的物件可能會閃爍且照明不佳。若太高，重複的物件可能會閃爍。\n"
+"此值不考慮 sceneScale。"
+
+#. option rtx.defaultToAdvancedUI
+#: src/dxvk/rtx_render/rtx_options.h:611
+msgid "Whether to default to the Advanced UI when opening the developer menu."
+msgstr "開啟開發者選單時，是否預設使用進階 UI。"
+
+#. option rtx.blockInputToGameInUI
+#: src/dxvk/rtx_render/rtx_options.h:619
+msgid ""
+"If true, input will not be passed to the game when the UI is active.\n"
+"Can be toggled with Alt + Backspace"
+msgstr ""
+"若為 true，UI 開啟時輸入不會傳遞給遊戲。\n"
+"可用 Alt + Backspace 切換"
+
+#. option rtx.restoreCursorPosition
+#: src/dxvk/rtx_render/rtx_options.h:623
+msgid ""
+"If true, the game's mouse cursor position will be restored when the Remix UI is closed.\n"
+"This should fix the issue where the game camera suddenly turns when closing the UI.\n"
+msgstr ""
+"若為 true，關閉 Remix UI 時會還原遊戲的滑鼠游標位置。\n"
+"這應能修正關閉 UI 時遊戲攝影機突然轉向的問題。\n"
+
+#. option rtx.qualityDLSS
+#: src/dxvk/rtx_render/rtx_options.h:638
+msgid "Adjusts internal DLSS scaling factor, trades quality for performance."
+msgstr "調整內部 DLSS 縮放倍數，以品質換取效能。"
+
+#. option rtx.renderPassGBufferRaytraceMode
+#: src/dxvk/rtx_render/rtx_options.h:644
+msgid "The ray tracing mode to use for the G-Buffer pass which resolves the initial primary and secondary surfaces to apply lighting to."
+msgstr "G-Buffer 階段使用的光線追蹤模式；此階段會解析要套用照明的初始主要與次要表面。"
+
+#. option rtx.renderPassIntegrateDirectRaytraceMode
+#: src/dxvk/rtx_render/rtx_options.h:649
+msgid "The ray tracing mode to use for the Direct Lighting pass which applies lighting to the primary/secondary surfaces."
+msgstr "直接照明階段使用的光線追蹤模式；此階段會對主要/次要表面套用照明。"
+
+#. option rtx.renderPassIntegrateIndirectRaytraceMode
+#: src/dxvk/rtx_render/rtx_options.h:654
+msgid "The ray tracing mode to use for the Indirect Lighting pass which applies lighting to the primary/secondary surfaces."
+msgstr "間接照明階段使用的光線追蹤模式；此階段會對主要/次要表面套用照明。"
+
+#. option rtx.useDenoiser
+#: src/dxvk/rtx_render/rtx_options.h:662
+msgid ""
+"Enables usage of denoiser(s) when set to true, otherwise disables denoising when set to false.\n"
+"Denoising is important for filtering the raw noisy ray traced signal into a smoother and more stable result at the cost of some potential spatial/temporal artifacts (ghosting, boiling, blurring, etc).\n"
+"Generally should remain enabled except when debugging behavior which requires investigating the output directly, or diagnosing denoising-related issues."
+msgstr ""
+"設為 true 時啟用降噪器，設為 false 時停用降噪。\n"
+"降噪對於將原始、充滿雜訊的光線追蹤訊號過濾成更平滑穩定的結果非常重要，代價是可能產生一些空間/時域瑕疵（殘影、沸騰、模糊等）。\n"
+"一般應保持啟用，除非在偵錯需要直接檢查輸出的行為，或診斷與降噪相關的問題。"
+
+#. option rtx.useDenoiserReferenceMode
+#: src/dxvk/rtx_render/rtx_options.h:666
+msgid ""
+"Enables reference \"denoiser\" (~ accumulation mode) when set to true, otherwise uses a standard denoiser.\n"
+"The reference denoiser accumulates frames over time to generate a reference multi-sample per pixel contribution\n"
+"which should converge slowly to the ideal result the renderer is working towards.\n"
+"It is useful for analyzing quality differences in various denoising methods, post-processing filters,\n"
+"or for more accurately comparing subtle effects of potentially biased rendering techniques\n"
+"which may be hard to see through noise and filtering.\n"
+"It is also useful for higher quality artistic renders of a scene beyond what is possible in real-time."
+msgstr ""
+"設為 true 時啟用參考「降噪器」（~ 累積模式），否則使用標準降噪器。\n"
+"參考降噪器會隨時間累積畫格，產生每像素多重取樣的參考貢獻，\n"
+"並應緩慢收斂到渲染器所追求的理想結果。\n"
+"它適用於分析各種降噪方法、後製處理濾鏡之間的品質差異，\n"
+"或更準確地比較可能有偏差的渲染技術的細微效果，\n"
+"這些效果可能難以在雜訊與過濾中看出。\n"
+"它也可用於產生超越即時渲染所能達到的高品質場景藝術渲染。"
+
+#. option rtx.accumulation.numberOfFramesToAccumulate
+#: src/dxvk/rtx_render/rtx_options.h:676
+msgid ""
+"Number of frames to accumulate render output.\n"
+"This can be used for generating reference images smoothed over time.\n"
+"By default the accumulation stops once the limit is reached.\n"
+"When desired, continous accumulation can be enabled via enableContinuousAccumulation."
+msgstr ""
+"累積渲染輸出的畫格數。\n"
+"可用於產生隨時間平滑化的參考影像。\n"
+"預設情況下，達到上限後就會停止累積。\n"
+"如有需要，可透過 enableContinuousAccumulation 啟用持續累積。"
+
+#. option rtx.denoiseDirectAndIndirectLightingSeparately
+#: src/dxvk/rtx_render/rtx_options.h:692
+msgid "Denoising quality, high uses separate denoising of direct and indirect lighting for higher quality at the cost of performance."
+msgstr "降噪品質；「高」會對直接與間接照明分別降噪，以犧牲效能換取更高品質。"
+
+#. option rtx.antiCulling.object.enable
+#: src/dxvk/rtx_render/rtx_options.h:728
+msgid "Extends lifetime of objects that go outside the camera frustum (anti-culling frustum)."
+msgstr "延長移出攝影機視錐（反剔除視錐）之物件的存續時間。"
+
+#. option rtx.antiCulling.object.enableHighPrecisionAntiCulling
+#: src/dxvk/rtx_render/rtx_options.h:729
+msgid ""
+"Use robust intersection check with Separate Axis Theorem.\n"
+"This method is slightly expensive but it effectively addresses object flickering issues that arise from corner cases in the fast intersection check method.\n"
+"Typically, it's advisable to enable this option unless it results in a notable performance drop; otherwise, the presence of flickering artifacts could significantly diminish the overall image quality."
+msgstr ""
+"使用分離軸定理進行穩健的相交檢查。\n"
+"此方法的成本稍高，但能有效解決快速相交檢查方法在邊界情況下產生的物件閃爍問題。\n"
+"一般建議啟用此選項，除非它造成明顯的效能下降；否則閃爍瑕疵可能會大幅降低整體影像品質。"
+
+#. option rtx.antiCulling.object.enableInfinityFarFrustum
+#: src/dxvk/rtx_render/rtx_options.h:732
+msgid "Enable infinity far plane frustum for anti-culling."
+msgstr "為反剔除啟用無限遠平面視錐。"
+
+#. option rtx.antiCulling.object.hashInstanceWithBoundingBoxHash
+#: src/dxvk/rtx_render/rtx_options.h:733
+msgid ""
+"Hash instances with bounding box hash for object duplication check.\n"
+" Disable this when the game using primitive culling which may cause flickering."
+msgstr ""
+"以邊界框雜湊對實例進行雜湊，用於物件重複檢查。\n"
+" 若遊戲使用可能造成閃爍的圖元剔除，請停用此選項。"
+
+#. option rtx.antiCulling.object.numObjectsToKeep
+#: src/dxvk/rtx_render/rtx_options.h:735
+msgid "The maximum number of RayTracing instances to keep when Anti-Culling is enabled."
+msgstr "啟用反剔除時要保留的最大光線追蹤實例數。"
+
+#. option rtx.antiCulling.object.fovScale
+#: src/dxvk/rtx_render/rtx_options.h:736
+msgid "Scale applied to the FOV of Anti-Culling Frustum for matching the culling frustum in the original game."
+msgstr "套用於反剔除視錐 FOV 的縮放，用於配合原始遊戲中的剔除視錐。"
+
+#. option rtx.antiCulling.object.farPlaneScale
+#: src/dxvk/rtx_render/rtx_options.h:737
+msgid "Scale applied to the far plane for Anti-Culling Frustum for matching the culling frustum in the original game."
+msgstr "套用於反剔除視錐遠平面的縮放，用於配合原始遊戲中的剔除視錐。"
+
+#. option rtx.antiCulling.light.enable
+#: src/dxvk/rtx_render/rtx_options.h:742
+msgid "Enable Anti-Culling for lights."
+msgstr "為光源啟用反剔除。"
+
+#. option rtx.antiCulling.light.numLightsToKeep
+#: src/dxvk/rtx_render/rtx_options.h:743
+msgid "(DEPRECATED)"
+msgstr "（已淘汰）"
+
+#. option rtx.antiCulling.light.numFramesToExtendLightLifetime
+#: src/dxvk/rtx_render/rtx_options.h:744
+msgid "Maximum number of frames to keep  when Anti-Culling is enabled. Make sure not to set this too low (then the anti-culling won't work), nor too high (which will hurt the performance)."
+msgstr "啟用反剔除時保留光源的最大畫格數。請確保不要設得太低（否則反剔除不會生效），也不要太高（會損害效能）。"
+
+#. option rtx.antiCulling.light.fovScale
+#: src/dxvk/rtx_render/rtx_options.h:745
+msgid "Scalar of the FOV of lights Anti-Culling Frustum."
+msgstr "光源反剔除視錐 FOV 的倍數。"
+
+#. option rtx.primaryRayMaxInteractions
+#: src/dxvk/rtx_render/rtx_options.h:759
+msgid ""
+"The maximum number of resolver interactions to use for primary (initial G-Buffer) rays.\n"
+"This affects how many Decals, Ray Portals and potentially particles (if unordered approximations are not enabled) may be interacted with along a ray at the cost of performance for higher amounts of interactions."
+msgstr ""
+"主要（初始 G-Buffer）光線使用的最大解析器交互次數。\n"
+"這會影響一條光線上可交互的貼花、光線傳送門，以及可能的粒子（若未啟用無序近似）數量；交互次數越多，效能成本越高。"
+
+#. option rtx.psrRayMaxInteractions
+#: src/dxvk/rtx_render/rtx_options.h:763
+msgid ""
+"The maximum number of resolver interactions to use for PSR (primary surface replacement G-Buffer) rays.\n"
+"This affects how many Decals, Ray Portals and potentially particles (if unordered approximations are not enabled) may be interacted with along a ray at the cost of performance for higher amounts of interactions."
+msgstr ""
+"PSR（主要表面替換 G-Buffer）光線使用的最大解析器交互次數。\n"
+"這會影響一條光線上可交互的貼花、光線傳送門，以及可能的粒子（若未啟用無序近似）數量；交互次數越多，效能成本越高。"
+
+#. option rtx.secondaryRayMaxInteractions
+#: src/dxvk/rtx_render/rtx_options.h:767
+msgid ""
+"The maximum number of resolver interactions to use for secondary (indirect) rays.\n"
+"This affects how many Decals, Ray Portals and potentially particles (if unordered approximations are not enabled) may be interacted with along a ray at the cost of performance for higher amounts of interactions.\n"
+"This value is recommended to be set lower than the primary/PSR max ray interactions as secondary ray interactions are less visually relevant relative to the performance cost of resolving them."
+msgstr ""
+"次要（間接）光線使用的最大解析器交互次數。\n"
+"這會影響一條光線上可交互的貼花、光線傳送門，以及可能的粒子（若未啟用無序近似）數量；交互次數越多，效能成本越高。\n"
+"建議將此值設得比主要/PSR 的最大光線交互次數低，因為相對於解析成本，次要光線交互對畫面的影響較小。"
+
+#. option rtx.enableSeparateUnorderedApproximations
+#: src/dxvk/rtx_render/rtx_options.h:772
+msgid ""
+"Use a separate loop during resolving for surfaces which can have lighting evaluated in an approximate unordered way on each path segment (such as particles).\n"
+"This improves performance typically in how particles or decals are rendered and should usually always be enabled.\n"
+"Do note however the unordered nature of this resolving method may result in visual artifacts with large numbers of stacked particles due to difficulty in determining the intended order.\n"
+"Additionally, unordered approximations will only be done on the first indirect ray bounce (as particles matter less in higher bounces), and only if enabled by its corresponding setting."
+msgstr ""
+"在解析期間，對可在每個路徑區段上以近似無序方式評估照明的表面（例如粒子）使用獨立的迴圈。\n"
+"這通常能提升粒子或貼花的渲染效能，一般應一律啟用。\n"
+"不過請注意，由於難以判斷預期的順序，此解析方法的無序特性可能會在大量堆疊的粒子上造成畫面瑕疵。\n"
+"此外，無序近似只會在第一次間接光線反彈時進行（因為粒子在更高次反彈中較不重要），且只在對應設定啟用時才會進行。"
+
+#. option rtx.trackParticleObjects
+#: src/dxvk/rtx_render/rtx_options.h:777
+msgid "Track last frame's corresponding particle object."
+msgstr "追蹤上一個畫格對應的粒子物件。"
+
+#. option rtx.enableDirectTranslucentShadows
+#: src/dxvk/rtx_render/rtx_options.h:778
+msgid "Calculate coloured shadows for translucent materials (i.e. glass, water) in direct lighting. In engineering terms: include OBJECT_MASK_TRANSLUCENT into primary visibility rays."
+msgstr "在直接照明中計算半透明材質（例如玻璃、水）的彩色陰影。以工程術語來說：將 OBJECT_MASK_TRANSLUCENT 納入主要可見性光線。"
+
+#. option rtx.enableDirectAlphaBlendShadows
+#: src/dxvk/rtx_render/rtx_options.h:779
+msgid "Calculate shadows for semi-transparent materials (alpha blended) in direct lighting. In engineering terms: include OBJECT_MASK_ALPHA_BLEND into primary visibility rays."
+msgstr "在直接照明中計算半透明材質（alpha 混合）的陰影。以工程術語來說：將 OBJECT_MASK_ALPHA_BLEND 納入主要可見性光線。"
+
+#. option rtx.enableIndirectTranslucentShadows
+#: src/dxvk/rtx_render/rtx_options.h:780
+msgid "Calculate coloured shadows for translucent materials (i.e. glass, water) in indirect lighting (i.e. reflections and GI). In engineering terms: include OBJECT_MASK_TRANSLUCENT into secondary visibility rays."
+msgstr "在間接照明（例如反射與 GI）中計算半透明材質（例如玻璃、水）的彩色陰影。以工程術語來說：將 OBJECT_MASK_TRANSLUCENT 納入次要可見性光線。"
+
+#. option rtx.enableIndirectAlphaBlendShadows
+#: src/dxvk/rtx_render/rtx_options.h:781
+msgid "Calculate shadows for semi-transparent (alpha blended) objects in indirect lighting (i.e. reflections and GI). In engineering terms: include OBJECT_MASK_ALPHA_BLEND into secondary visibility rays."
+msgstr "在間接照明（例如反射與 GI）中計算半透明（alpha 混合）物件的陰影。以工程術語來說：將 OBJECT_MASK_ALPHA_BLEND 納入次要可見性光線。"
+
+#. option rtx.resolveTransparencyThreshold
+#: src/dxvk/rtx_render/rtx_options.h:784
+msgid "A threshold for which any opacity value below is considered totally transparent and may be safely skipped without as significant of a performance cost."
+msgstr "臨界值；不透明度低於此值即視為完全透明，可安全地略過，且不會造成那麼顯著的效能成本。"
+
+#. option rtx.resolveOpaquenessThreshold
+#: src/dxvk/rtx_render/rtx_options.h:786
+msgid "A threshold for which any opacity value above is considered totally opaque."
+msgstr "臨界值；不透明度高於此值即視為完全不透明。"
+
+#. option rtx.enablePSRR
+#: src/dxvk/rtx_render/rtx_options.h:790
+msgid ""
+"A flag to enable or disable reflection PSR (Primary Surface Replacement).\n"
+"When enabled this feature allows higher quality mirror-like reflections in special cases by replacing the G-Buffer's surface with the reflected surface.\n"
+"Should usually be enabled for the sake of quality as almost all applications will utilize it in the form of glass or mirrors."
+msgstr ""
+"啟用或停用反射 PSR（主要表面替換）的旗標。\n"
+"啟用時，此功能會以反射的表面取代 G-Buffer 的表面，在特殊情況下提供更高品質的鏡面般反射。\n"
+"為了品質，通常應啟用，因為幾乎所有應用程式都會以玻璃或鏡子的形式用到它。"
+
+#. option rtx.enablePSTR
+#: src/dxvk/rtx_render/rtx_options.h:794
+msgid ""
+"A flag to enable or disable transmission PSR (Primary Surface Replacement).\n"
+"When enabled this feature allows higher quality glass-like refraction in special cases by replacing the G-Buffer's surface with the refracted surface.\n"
+"Should usually be enabled for the sake of quality as almost all applications will utilize it in the form of glass."
+msgstr ""
+"啟用或停用透射 PSR（主要表面替換）的旗標。\n"
+"啟用時，此功能會以折射的表面取代 G-Buffer 的表面，在特殊情況下提供更高品質的玻璃般折射。\n"
+"為了品質，通常應啟用，因為幾乎所有應用程式都會以玻璃的形式用到它。"
+
+#. option rtx.psrrMaxBounces
+#: src/dxvk/rtx_render/rtx_options.h:798
+msgid ""
+"The maximum number of Reflection PSR bounces to traverse. Must be 15 or less due to payload encoding.\n"
+"Should be set higher when many mirror-like reflection bounces may be needed, though more bounces may come at a higher performance cost."
+msgstr ""
+"要遍歷的最大反射 PSR 反彈次數。由於 payload 編碼的限制，必須為 15 以下。\n"
+"當可能需要多次鏡面般的反射反彈時應設得較高，但反彈越多，效能成本可能越高。"
+
+#. option rtx.pstrMaxBounces
+#: src/dxvk/rtx_render/rtx_options.h:802
+msgid ""
+"The maximum number of Transmission PSR bounces to traverse. Must be 15 or less due to payload encoding.\n"
+"Should be set higher when refraction through many layers of glass may be needed, though more bounces may come at a higher performance cost."
+msgstr ""
+"要遍歷的最大透射 PSR 反彈次數。由於 payload 編碼的限制，必須為 15 以下。\n"
+"當可能需要穿過多層玻璃折射時應設得較高，但反彈越多，效能成本可能越高。"
+
+#. option rtx.enablePSTROutgoingSplitApproximation
+#: src/dxvk/rtx_render/rtx_options.h:806
+msgid ""
+"Enable transmission PSR on outgoing transmission events such as leaving translucent materials (rather than respecting no-split path PSR rule).\n"
+"Typically this results in better looking glass when enabled (at the cost of accuracy due to ignoring non-TIR inter-reflections within the glass itself)."
+msgstr ""
+"在出射透射事件（例如離開半透明材質）上啟用透射 PSR（而不遵守路徑不分岔的 PSR 規則）。\n"
+"啟用時通常能讓玻璃看起來更好（代價是準確度，因為會忽略玻璃內部非全內反射的相互反射）。"
+
+#. option rtx.enablePSTRSecondaryIncidentSplitApproximation
+#: src/dxvk/rtx_render/rtx_options.h:809
+msgid ""
+"Enable transmission PSR on secondary incident transmission events such as entering a translucent material on an already-transmitted path (rather than respecting no-split path PSR rule).\n"
+"Typically this results in better looking glass when enabled (at the cost accuracy due to ignoring reflections off of glass seen through glass for example)."
+msgstr ""
+"在次要入射透射事件（例如在已透射的路徑上進入半透明材質）上啟用透射 PSR（而不遵守路徑不分岔的 PSR 規則）。\n"
+"啟用時通常能讓玻璃看起來更好（代價是準確度，例如會忽略透過玻璃看到的玻璃反射）。"
+
+#. option rtx.psrrNormalDetailThreshold
+#: src/dxvk/rtx_render/rtx_options.h:817
+msgid ""
+"A threshold value to indicate that the denoiser's alternate disocclusion threshold should be used when normal map \"detail\" on a reflection PSR surface exceeds a desired amount.\n"
+"Normal detail is defined as 1-dot(tangent_normal, vec3(0, 0, 1)), or in other words it is 0 when no normal mapping is used, and 1 when the normal mapped normal is perpendicular to the underlying normal.\n"
+"This is typically used to reduce flickering artifacts resulting from reflection on surfaces like glass leveraging normal maps as often the denoiser is too aggressive with disocclusion checks frame to frame when DLSS or other camera jittering is in use."
+msgstr ""
+"臨界值；當反射 PSR 表面上的法線貼圖「細節」超過指定量時，表示應使用降噪器的替代去遮擋臨界值。\n"
+"法線細節定義為 1-dot(tangent_normal, vec3(0, 0, 1))，換句話說，未使用法線貼圖時為 0，當法線貼圖的法線與底層法線垂直時為 1。\n"
+"這通常用於減少玻璃等使用法線貼圖之表面上的反射所造成的閃爍瑕疵，因為在使用 DLSS 或其他攝影機抖動時，降噪器的逐畫格去遮擋檢查往往過於激進。"
+
+#. option rtx.pstrNormalDetailThreshold
+#: src/dxvk/rtx_render/rtx_options.h:821
+msgid ""
+"A threshold value to indicate that the denoiser's alternate disocclusion threshold should be used when normal map \"detail\" on a transmission PSR surface exceeds a desired amount.\n"
+"Normal detail is defined as 1-dot(tangent_normal, vec3(0, 0, 1)), or in other words it is 0 when no normal mapping is used, and 1 when the normal mapped normal is perpendicular to the underlying normal.\n"
+"This is typically used to reduce flickering artifacts resulting from refraction on surfaces like glass leveraging normal maps as often the denoiser is too aggressive with disocclusion checks frame to frame when DLSS or other camera jittering is in use."
+msgstr ""
+"臨界值；當透射 PSR 表面上的法線貼圖「細節」超過指定量時，表示應使用降噪器的替代去遮擋臨界值。\n"
+"法線細節定義為 1-dot(tangent_normal, vec3(0, 0, 1))，換句話說，未使用法線貼圖時為 0，當法線貼圖的法線與底層法線垂直時為 1。\n"
+"這通常用於減少玻璃等使用法線貼圖之表面上的折射所造成的閃爍瑕疵，因為在使用 DLSS 或其他攝影機抖動時，降噪器的逐畫格去遮擋檢查往往過於激進。"
+
+#. option rtx.enableShaderExecutionReorderingInPathtracerIntegrateIndirect
+#: src/dxvk/rtx_render/rtx_options.h:831
+msgid "Enables Shader Execution Reordering (SER) in Integrate Indirect pass if SER is supported."
+msgstr "若支援 SER，在間接積分階段中啟用著色器執行重新排序 (SER)。"
+
+#. option rtx.enableRussianRoulette
+#: src/dxvk/rtx_render/rtx_options.h:834
+msgid ""
+"A flag to enable or disable Russian Roulette, a rendering technique to give paths a chance of terminating randomly with each bounce based on their importance.\n"
+"This is usually useful to have enabled as it will ensure useless paths are terminated earlier while more important paths are allowed to accumulate more bounces.\n"
+"Furthermore this allows for the renderer to remain unbiased whereas a hard clamp on the number of bounces will introduce bias (though this is also done in Remix for the sake of performance).\n"
+"On the other hand, randomly terminating paths too aggressively may leave threads in GPU warps without work which may hurt thread occupancy when not used with a thread-reordering technique like SER.\n"
+"Additionally, Russian Roulette will always for the most part increase variance and will reduce the average path depth from whatever the current maximum path length is set to.\n"
+"This increase in variance will slightly impact image quality especially on scenes relying heavily on many bounces of indirect lighting, but this is usually worth it for efficiency purposes, as Russian Roulette allows each ray to reduces variance more than it would otherwise."
+msgstr ""
+"啟用或停用俄羅斯輪盤的旗標；這是一種渲染技術，會依路徑的重要性，讓路徑在每次反彈時有機會隨機終止。\n"
+"通常啟用會很有用，因為它能確保無用的路徑提早終止，同時讓較重要的路徑累積更多反彈。\n"
+"此外，這能讓渲染器維持無偏差，而對反彈次數設硬性上限則會引入偏差（不過 Remix 為了效能也會這麼做）。\n"
+"另一方面，過於激進地隨機終止路徑，可能會讓 GPU warp 中的執行緒沒有工作，若未搭配 SER 等執行緒重新排序技術，可能會降低執行緒佔用率。\n"
+"此外，俄羅斯輪盤在大多數情況下一定會增加變異數，並會使平均路徑深度低於目前設定的最大路徑長度。\n"
+"這種變異數的增加會稍微影響影像品質，尤其是在大量依賴多次間接照明反彈的場景中，但就效率而言通常是值得的，因為俄羅斯輪盤能讓每條光線降低的變異數比不使用時更多。"
+
+#. option rtx.russianRouletteMode
+#: src/dxvk/rtx_render/rtx_options.h:841
+msgid "Russian Roulette Mode. Throughput Based: paths with higher throughput become longer; Specular Based: specular paths become longer.\n"
+msgstr "俄羅斯輪盤模式。依據通量：通量較高的路徑會變得更長；依據鏡面：鏡面路徑會變得更長。\n"
+
+#. option rtx.russianRouletteDiffuseContinueProbability
+#: src/dxvk/rtx_render/rtx_options.h:844
+msgid "The probability of continuing a diffuse path when Russian Roulette is being used. Only apply to specular based mode.\n"
+msgstr "使用俄羅斯輪盤時，繼續漫反射路徑的機率。僅適用於依據鏡面模式。\n"
+
+#. option rtx.russianRouletteSpecularContinueProbability
+#: src/dxvk/rtx_render/rtx_options.h:845
+msgid "The probability of continuing a specular path when Russian Roulette is being used. Only apply to specular based mode.\n"
+msgstr "使用俄羅斯輪盤時，繼續鏡面路徑的機率。僅適用於依據鏡面模式。\n"
+
+#. option rtx.russianRouletteDistanceFactor
+#: src/dxvk/rtx_render/rtx_options.h:846
+msgid "Path segments whose distance proportion are under this threshold are more likely to continue. Only apply to specular based mode.\n"
+msgstr "距離比例低於此臨界值的路徑區段較可能繼續。僅適用於依據鏡面模式。\n"
+
+#. option rtx.russianRouletteMaxContinueProbability
+#: src/dxvk/rtx_render/rtx_options.h:847
+msgid ""
+"The maximum probability of continuing a path when Russian Roulette is being used.\n"
+"This ensures all rays have a small probability of terminating each bounce, mostly to prevent infinite paths in perfectly reflective mirror rooms (though the maximum path bounce count will also ensure this)."
+msgstr ""
+"使用俄羅斯輪盤時，繼續路徑的最大機率。\n"
+"這可確保所有光線在每次反彈時都有微小的機率終止，主要是為了防止在完全反射的鏡面房間中出現無限路徑（不過最大路徑反彈次數也能確保這一點）。"
+
+#. option rtx.russianRoulette1stBounceMinContinueProbability
+#: src/dxvk/rtx_render/rtx_options.h:852
+msgid ""
+"The minimum probability of continuing a path when Russian Roulette is being used on the first bounce.\n"
+"This ensures that on the first bounce rays are not terminated too aggressively as it may be useful for some denoisers to have a contribution even if it is a relatively unimportant one rather than a missing indirect sample."
+msgstr ""
+"在第一次反彈使用俄羅斯輪盤時，繼續路徑的最小機率。\n"
+"這可確保第一次反彈時光線不會被過於激進地終止，因為對某些降噪器而言，即使是相對不重要的貢獻，也比缺少間接取樣更有用。"
+
+#. option rtx.russianRoulette1stBounceMaxContinueProbability
+#: src/dxvk/rtx_render/rtx_options.h:856
+msgid ""
+"The maximum probability of continuing a path when Russian Roulette is being used on the first bounce.\n"
+"This is similar to the usual max continuation probability for Russian Roulette, but specifically only for the first bounce."
+msgstr ""
+"在第一次反彈使用俄羅斯輪盤時，繼續路徑的最大機率。\n"
+"這與俄羅斯輪盤一般的最大繼續機率類似，但專門只用於第一次反彈。"
+
+#. option rtx.pathMinBounces
+#: src/dxvk/rtx_render/rtx_options.h:860
+msgid ""
+"The minimum number of indirect bounces the path must complete before Russian Roulette can be used. Must be < 16.\n"
+"This value is recommended to stay fairly low (1 for example) as forcing longer paths when they carry little contribution quickly becomes detrimental to performance."
+msgstr ""
+"可使用俄羅斯輪盤之前，路徑必須完成的最少間接反彈次數。必須 < 16。\n"
+"建議將此值保持在相當低的水準（例如 1），因為在路徑貢獻很小時強制延長路徑，很快就會損害效能。"
+
+#. option rtx.pathMaxBounces
+#: src/dxvk/rtx_render/rtx_options.h:868
+msgid ""
+"The maximum number of indirect bounces the path will be allowed to complete. Must be < 16.\n"
+"Higher values result in better indirect lighting quality due to biasing the signal less, lower values result in better performance.\n"
+"Very high values are not recommended however as while long paths may be technically needed for unbiased rendering, in practice the contributions from higher bounces have diminishing returns."
+msgstr ""
+"路徑可完成的最大間接反彈次數。必須 < 16。\n"
+"值越高，訊號偏差越少，間接照明品質越好；值越低，效能越好。\n"
+"不過不建議使用非常高的值，因為雖然技術上無偏差渲染可能需要長路徑，但實際上更高次反彈的貢獻效益遞減。"
+
+#. option rtx.opaqueDiffuseLobeSamplingProbabilityZeroThreshold
+#: src/dxvk/rtx_render/rtx_options.h:880
+msgid "The threshold for which to zero opaque diffuse probability weight values."
+msgstr "將不透明漫反射機率權重值歸零的臨界值。"
+
+#. option rtx.minOpaqueDiffuseLobeSamplingProbability
+#: src/dxvk/rtx_render/rtx_options.h:881
+msgid "The minimum allowed non-zero value for opaque diffuse probability weights."
+msgstr "不透明漫反射機率權重允許的最小非零值。"
+
+#. option rtx.opaqueSpecularLobeSamplingProbabilityZeroThreshold
+#: src/dxvk/rtx_render/rtx_options.h:883
+msgid "The threshold for which to zero opaque specular probability weight values."
+msgstr "將不透明鏡面機率權重值歸零的臨界值。"
+
+#. option rtx.minOpaqueSpecularLobeSamplingProbability
+#: src/dxvk/rtx_render/rtx_options.h:884
+msgid "The minimum allowed non-zero value for opaque specular probability weights."
+msgstr "不透明鏡面機率權重允許的最小非零值。"
+
+#. option rtx.opaqueOpacityTransmissionLobeSamplingProbabilityZeroThreshold
+#: src/dxvk/rtx_render/rtx_options.h:886
+msgid "The threshold for which to zero opaque opacity probability weight values."
+msgstr "將不透明材質不透明度機率權重值歸零的臨界值。"
+
+#. option rtx.minOpaqueOpacityTransmissionLobeSamplingProbability
+#: src/dxvk/rtx_render/rtx_options.h:887
+msgid "The minimum allowed non-zero value for opaque opacity probability weights."
+msgstr "不透明材質不透明度機率權重允許的最小非零值。"
+
+#. option rtx.opaqueDiffuseTransmissionLobeSamplingProbabilityZeroThreshold
+#: src/dxvk/rtx_render/rtx_options.h:888
+msgid "The threshold for which to zero thin opaque diffuse transmission probability weight values."
+msgstr "將薄不透明漫透射機率權重值歸零的臨界值。"
+
+#. option rtx.minOpaqueDiffuseTransmissionLobeSamplingProbability
+#: src/dxvk/rtx_render/rtx_options.h:889
+msgid "The minimum allowed non-zero value for thin opaque diffuse transmission probability weights."
+msgstr "薄不透明漫透射機率權重允許的最小非零值。"
+
+#. option rtx.translucentSpecularLobeSamplingProbabilityZeroThreshold
+#: src/dxvk/rtx_render/rtx_options.h:892
+msgid "The threshold for which to zero translucent specular probability weight values."
+msgstr "將半透明鏡面機率權重值歸零的臨界值。"
+
+#. option rtx.minTranslucentSpecularLobeSamplingProbability
+#: src/dxvk/rtx_render/rtx_options.h:893
+msgid "The minimum allowed non-zero value for translucent specular probability weights."
+msgstr "半透明鏡面機率權重允許的最小非零值。"
+
+#. option rtx.translucentTransmissionLobeSamplingProbabilityZeroThreshold
+#: src/dxvk/rtx_render/rtx_options.h:894
+msgid "The threshold for which to zero translucent transmission probability weight values."
+msgstr "將半透明透射機率權重值歸零的臨界值。"
+
+#. option rtx.minTranslucentTransmissionLobeSamplingProbability
+#: src/dxvk/rtx_render/rtx_options.h:895
+msgid "The minimum allowed non-zero value for translucent transmission probability weights."
+msgstr "半透明透射機率權重允許的最小非零值。"
+
+#. option rtx.indirectRaySpreadAngleFactor
+#: src/dxvk/rtx_render/rtx_options.h:897
+msgid ""
+"A tuning factor applied to the spread angle calculated from the sampled lobe solid angle PDF. Should be 0-1.\n"
+"This scaled spread angle is used to widen a ray's cone angle after indirect lighting BRDF samples to essentially prefilter the effects of the BRDF lobe's spread which potentially may reduce noise from indirect rays (e.g. reflections).\n"
+"Prefiltering will overblur detail however compared to the ground truth of casting multiple samples especially given this calculated spread angle is a basic approximation and ray cones to begin with are a simple approximation for ray pixel footprint.\n"
+"As such rather than using the spread angle fully this spread angle factor allows it to be scaled down to something more narrow so that overblurring can be minimized. Similarly, setting this factor to 0 disables this cone angle widening feature."
+msgstr ""
+"套用於由取樣波瓣立體角 PDF 計算出之擴散角的調整係數。應為 0-1。\n"
+"此縮放後的擴散角用於在間接照明 BRDF 取樣後擴大光線的錐角，本質上是預先過濾 BRDF 波瓣擴散的效果，可能減少間接光線（例如反射）的雜訊。\n"
+"不過，與投射多個取樣的真實結果相比，預先過濾會使細節過度模糊，尤其是這個計算出的擴散角只是基本近似，而光線錐本身也只是光線像素足跡的簡單近似。\n"
+"因此，此擴散角係數不會完整使用擴散角，而是讓它縮小為較窄的角度，以盡量減少過度模糊。同樣地，將此係數設為 0 會停用錐角擴大功能。"
+
+#. option rtx.rngSeedWithFrameIndex
+#: src/dxvk/rtx_render/rtx_options.h:902
+msgid ""
+"Indicates that pseudo-random number generator should be seeded with the frame number of the application every frame, otherwise seed with 0.\n"
+"This should generally always be enabled as without the frame index each frame will typically be identical in the random values that are produced which will result in incorrect rendering. Only meant as a debugging tool."
+msgstr ""
+"表示虛擬亂數產生器應在每個畫格以應用程式的畫格編號作為種子，否則以 0 作為種子。\n"
+"一般應一律啟用，因為若沒有畫格索引，每個畫格產生的隨機值通常會完全相同，導致渲染錯誤。僅作為偵錯工具使用。"
+
+#. option rtx.advanceTime
+#: src/dxvk/rtx_render/rtx_options.h:907
+msgid "A flag to enable or disable advancing time used by Remix subsystems (particle effects, animations, etc.).\n"
+msgstr "啟用或停用推進 Remix 子系統（粒子效果、動畫等）所用時間的旗標。\n"
+
+#. option rtx.enableFirstBounceLobeProbabilityDithering
+#: src/dxvk/rtx_render/rtx_options.h:911
+msgid ""
+"A flag to enable or disable screen-space probability dithering on the first indirect lobe sampled.\n"
+"Generally sampling a diffuse, specular or other lobe relies on a random number generated against the probability of sampling each lobe, effectively focusing more rays/paths on lobes which matter more.\n"
+"This can cause issues however with denoisers which do not handle sparse stochastic signals (like those from path tracing) well as they may be expecting a more \"complete\" signal like those used in simpler branching ray tracing setups.\n"
+"To help solve this issue this option uses a temporal screenspace dithering based on the probability rather than a purely random choice to determine which lobe to sample from on the first indirect bounce.\n"
+"This as a result helps ensure there will always be a diffuse or specular sample within the dithering pattern's area and should help the denoising resolve a more stable result."
+msgstr ""
+"啟用或停用在第一個取樣的間接波瓣上使用螢幕空間機率混色的旗標。\n"
+"一般而言，取樣漫反射、鏡面或其他波瓣時，會依據每個波瓣的取樣機率產生隨機數來決定，實際上會將更多光線/路徑集中在較重要的波瓣上。\n"
+"不過，對於不擅長處理稀疏隨機訊號（例如路徑追蹤產生的訊號）的降噪器而言，這可能會造成問題，因為它們可能預期的是較「完整」的訊號，例如較簡單的分支式光線追蹤設定所用的訊號。\n"
+"為了協助解決此問題，此選項在第一次間接反彈時，會使用基於機率的時域螢幕空間混色，而非純隨機選擇，來決定要從哪個波瓣取樣。\n"
+"如此一來，可確保混色圖樣的區域內一定會有漫反射或鏡面取樣，應有助於降噪解析出更穩定的結果。"
+
+#. option rtx.enableUnorderedResolveInIndirectRays
+#: src/dxvk/rtx_render/rtx_options.h:918
+msgid ""
+"A flag to enable or disable unordered resolve approximations in indirect rays.\n"
+"This allows for the presence of unordered approximations in resolving to be overridden in indirect rays and as such requires separate unordered approximations to be enabled to have any effect.\n"
+"This option should be enabled if objects which can be resolvered in an unordered way in indirect rays are expected for higher quality in reflections, but may come at a performance cost.\n"
+"Note that even with this option enabled, unordered resolve approximations are only done on the first indirect bounce for the sake of performance overall."
+msgstr ""
+"啟用或停用間接光線中無序解析近似的旗標。\n"
+"這可讓間接光線中是否使用無序解析近似被覆寫，因此需要啟用「分離無序近似」才會生效。\n"
+"若預期間接光線中會有可用無序方式解析的物件，為了反射的品質應啟用此選項，但可能會有效能成本。\n"
+"請注意，即使啟用此選項，為了整體效能，無序解析近似也只會在第一次間接反彈時進行。"
+
+#. option rtx.enableProbabilisticUnorderedResolveInIndirectRays
+#: src/dxvk/rtx_render/rtx_options.h:924
+msgid ""
+"A flag to enable or disable probabilistic unordered resolve approximations in indirect rays.\n"
+"This flag speeds up the unordered resolve for indirect rays by probabilistically deciding when to perform unordered resolve or not.  Must have both unordered resolve and unordered resolve in indirect rays enabled for this to take effect.\n"
+"This option should be enabled by default as it can significantly improve performance on some hardware.  In rare cases it may come at the cost of some quality for particles and decals in reflections.\n"
+"Note that even with this option enabled, unordered resolve approximations are only done on the first indirect bounce for the sake of performance overall."
+msgstr ""
+"啟用或停用間接光線中機率式無序解析近似的旗標。\n"
+"此旗標會以機率方式決定何時執行無序解析，以加快間接光線的無序解析。必須同時啟用無序解析與間接光線中的無序解析，此選項才會生效。\n"
+"此選項預設應啟用，因為它能在某些硬體上大幅提升效能。在少數情況下，可能會犧牲反射中粒子與貼花的部分品質。\n"
+"請注意，即使啟用此選項，為了整體效能，無序解析近似也只會在第一次間接反彈時進行。"
+
+#. option rtx.enableUnorderedEmissiveParticlesInIndirectRays
+#: src/dxvk/rtx_render/rtx_options.h:929
+msgid ""
+"A flag to enable or disable unordered resolve emissive particles specifically in indirect rays.\n"
+"Should be enabled in higher quality rendering modes as emissive particles are fairly important in reflections, but may be disabled to skip such interactions which can improve performance on lower end hardware.\n"
+"Note that rtx.enableUnorderedResolveInIndirectRays must first be enabled for this option to take any effect (as it will control if unordered resolve is used to begin with in indirect rays)."
+msgstr ""
+"啟用或停用專門在間接光線中以無序解析處理自發光粒子的旗標。\n"
+"在較高品質的渲染模式中應啟用，因為自發光粒子在反射中相當重要；但也可停用以略過這類交互，在低階硬體上提升效能。\n"
+"請注意，必須先啟用 rtx.enableUnorderedResolveInIndirectRays，此選項才會生效（因為它決定間接光線中是否使用無序解析）。"
+
+#. option rtx.enableTransmissionApproximationInIndirectRays
+#: src/dxvk/rtx_render/rtx_options.h:935
+msgid ""
+"A flag to enable transmission approximations in indirect rays.\n"
+"Translucent objects hit by indirect rays will not alter ray direction, just change the ray throughput."
+msgstr ""
+"在間接光線中啟用透射近似的旗標。\n"
+"被間接光線命中的半透明物件不會改變光線方向，只會改變光線通量。"
+
+#. option rtx.enableDecalMaterialBlending
+#: src/dxvk/rtx_render/rtx_options.h:939
+msgid ""
+"A flag to enable or disable material blending on decals.\n"
+"This should generally always be enabled when decals are in use as this allows decals to be blended down on to the surface they sit slightly above which results in more convincing decals rendering."
+msgstr ""
+"啟用或停用貼花材質混合的旗標。\n"
+"使用貼花時一般應一律啟用，因為這可讓貼花混合到其略為上方的表面上，使貼花渲染更逼真。"
+
+#. option rtx.translucentDecalAlbedoFactor
+#: src/dxvk/rtx_render/rtx_options.h:945
+msgid ""
+"A global scale factor applied to the albedo of decals that are applied to a translucent base material, to make the decals more visible.\n"
+"This is generally needed as albedo values for decals may be fairly low when dealing with opaque surfaces, but the translucent diffuse layer requires a fairly high albedo value to result in an expected look.\n"
+"The need for this option could be avoided by simply authoring decals applied to translucent materials with a higher albedo to begin with, but sometimes applications may share decals between different material types."
+msgstr ""
+"套用於半透明基底材質上之貼花反照率的全域縮放係數，讓貼花更明顯。\n"
+"一般需要此設定，因為處理不透明表面時貼花的反照率值可能相當低，但半透明漫反射層需要相當高的反照率值才能呈現預期的外觀。\n"
+"只要一開始就為套用於半透明材質的貼花製作較高的反照率，就不需要此選項，但有時應用程式會在不同材質類型之間共用貼花。"
+
+#. option rtx.worldSpaceUiBackgroundOffset
+#: src/dxvk/rtx_render/rtx_options.h:950
+msgid "Distance along normal to offset objects rendered as worldspace UI, specifically for the background of screens."
+msgstr "沿法線偏移以世界空間 UI 渲染之物件的距離，專門用於螢幕的背景。"
+
+#. option rtx.shadowTerminator.soften
+#: src/dxvk/rtx_render/rtx_options.h:953
+msgid "Fix the harsh transition on a shadow terminator by gradually smoothing, when the geometry normal is inconsistent with shading normal.Note that it doesn't modify the shadow ray, and only applies a falloff when calculating a direct illumination."
+msgstr "當幾何法線與著色法線不一致時，透過逐漸平滑化來修正明暗交界處生硬的過渡。請注意，這不會修改陰影光線，只會在計算直接照明時套用衰減。"
+
+#. option rtx.shadowTerminator.enableOffset
+#: src/dxvk/rtx_render/rtx_options.h:957
+msgid "Offset the shadow ray origin along the triangle vertex normals to avoid self-intersection. Helps to remove the triangular shadow artifacts on a terminator region. Note that it may introduce a noticeable light leaking if the geometry is low-poly."
+msgstr "沿三角形頂點法線偏移陰影光線的起點，以避免自我相交。有助於移除明暗交界區域的三角形陰影瑕疵。請注意，若幾何是低多邊形，可能會產生明顯的漏光。"
+
+#. option rtx.shadowTerminator.maxArea
+#: src/dxvk/rtx_render/rtx_options.h:961
+msgid "If a polygon area is larger than this value (in square meters), then a shadow terminator offset will not be applied."
+msgstr "若多邊形面積大於此值（平方公尺），就不會套用明暗交界偏移。"
+
+#. option rtx.shadowTerminator.maxLength
+#: src/dxvk/rtx_render/rtx_options.h:962
+msgid "Clamp shadow terminator length by this value (in meters)."
+msgstr "以此值限制明暗交界長度（公尺）。"
+
+#. option rtx.risLightSampleCount
+#: src/dxvk/rtx_render/rtx_options.h:966
+msgid ""
+"The number of lights randomly selected from the global pool to consider when selecting a light with RIS.\n"
+"Higher values generally increases the quality of RIS light sampling, but also has diminishing returns and higher performance cost past a point.\n"
+"Note that RIS is only used when RTXDI is disabled for direct lighting, or for light sampling in indirect rays, so the impact of this effect will vary."
+msgstr ""
+"以 RIS 選擇光源時，從全域集區中隨機選取以供考量的光源數量。\n"
+"值越高通常能提升 RIS 光源取樣的品質，但超過某個程度後效益遞減，效能成本也更高。\n"
+"請注意，RIS 只在直接照明停用 RTXDI 時，或用於間接光線的光源取樣時才會使用，因此此效果的影響會有所不同。"
+
+#. option rtx.subsurface.enableThinOpaque
+#: src/dxvk/rtx_render/rtx_options.h:977
+msgid "Enable thin opaque material. The materials withthin opaque properties will fallback to normal opaque material."
+msgstr "啟用薄不透明材質。具有薄不透明屬性的材質會退回使用一般不透明材質。"
+
+#. option rtx.subsurface.enableTextureMaps
+#: src/dxvk/rtx_render/rtx_options.h:978
+msgid "Enable texture maps such as thickness map or scattering albedo map. The corresponding subsurface properties will fallback to per-material constants if this is disabled."
+msgstr "啟用厚度貼圖或散射反照率貼圖等紋理貼圖。若停用，對應的次表面屬性會改用逐材質常數。"
+
+#. option rtx.subsurface.enableDiffusionProfile
+#: src/dxvk/rtx_render/rtx_options.h:980
+msgid "Enable subsurface material. Solve subsurface rendering equation with (burley/SOTO) diffusion profile."
+msgstr "啟用次表面材質。以 (burley/SOTO) 擴散設定檔求解次表面渲染方程式。"
+
+#. option rtx.subsurface.diffusionProfileScale
+#: src/dxvk/rtx_render/rtx_options.h:981
+msgid "Scalar of the diffusion profile scale."
+msgstr "擴散設定檔比例的倍數。"
+
+#. option rtx.subsurface.enableTransmission
+#: src/dxvk/rtx_render/rtx_options.h:982
+msgid "Enable subsurface transmission. Implement single scattering transmission for thin or curved SSS surface."
+msgstr "啟用次表面透射。為薄或彎曲的 SSS 表面實作單次散射透射。"
+
+#. option rtx.subsurface.enableTransmissionSingleScattering
+#: src/dxvk/rtx_render/rtx_options.h:983
+msgid "Enable single scattering for subsurface transmission. If this option is disabled, then the refracted ray will not be scattered again inside of the volume."
+msgstr "為次表面透射啟用單次散射。若停用此選項，折射光線不會在體積內再次散射。"
+
+#. option rtx.subsurface.enableTransmissionDiffusionProfileCorrection
+#: src/dxvk/rtx_render/rtx_options.h:984
+msgid ""
+"Enable diffusion profile correction when enabling SSS Transmission.\n"
+"Both burley's diffusion profile and SSS Transmission includes the single scattering energy.\n"
+"The correction removes the single scattering part from diffusion profile to avoid double counting the single scattering energy."
+msgstr ""
+"啟用 SSS 透射時，同時啟用擴散設定檔校正。\n"
+"burley 擴散設定檔與 SSS 透射都包含單次散射能量。\n"
+"此校正會從擴散設定檔中移除單次散射部分，以避免重複計算單次散射能量。"
+
+#. option rtx.subsurface.transmissionBsdfSampleCount
+#: src/dxvk/rtx_render/rtx_options.h:994
+msgid "The sample count for transmission BSDF.(1spp as default)"
+msgstr "透射 BSDF 的取樣數。（預設為 1spp）"
+
+#. option rtx.subsurface.transmissionSingleScatteringSampleCount
+#: src/dxvk/rtx_render/rtx_options.h:995
+msgid "The sample count for every single scattering on BSDF transmission (refracted) ray.(1spp as default)"
+msgstr "BSDF 透射（折射）光線上每次單次散射的取樣數。（預設為 1spp）"
+
+#. option rtx.subsurface.diffusionProfileDebugPixelPosition
+#: src/dxvk/rtx_render/rtx_options.h:996
+msgid "Pixel position where we show debugging sampling positions for diffusion profile. Requires set debug view to 'SSS Diffusion Profile Sampling'."
+msgstr "顯示擴散設定檔偵錯取樣位置的像素位置。需要將偵錯檢視設為「SSS 擴散設定檔取樣」。"
+
+#. option rtx.enableAlphaBlend
+#: src/dxvk/rtx_render/rtx_options.h:1000
+msgid "Enable rendering alpha blended geometry, used for partial opacity and other blending effects on various surfaces in many games."
+msgstr "啟用 alpha 混合幾何的渲染，許多遊戲用於各種表面上的部分不透明與其他混合效果。"
+
+#. option rtx.enableAlphaTest
+#: src/dxvk/rtx_render/rtx_options.h:1001
+msgid "Enable rendering alpha tested geometry, used for cutout style opacity in some games."
+msgstr "啟用 alpha 測試幾何的渲染，部分遊戲用於鏤空式的不透明度。"
+
+#. option rtx.enableCulling
+#: src/dxvk/rtx_render/rtx_options.h:1002
+msgid "Enable front/backface culling for opaque objects. Objects with alpha blend or alpha test are not culled."
+msgstr "為不透明物件啟用正面/背面剔除。使用 alpha 混合或 alpha 測試的物件不會被剔除。"
+
+#. option rtx.enableCullingInSecondaryRays
+#: src/dxvk/rtx_render/rtx_options.h:1003
+msgid "Enable front/backface culling for opaque objects. Objects with alpha blend or alpha test are not culled.  Only applies in secondary rays, defaults to off.  Generally helps with light bleeding from objects that aren't watertight."
+msgstr "為不透明物件啟用正面/背面剔除。使用 alpha 混合或 alpha 測試的物件不會被剔除。僅適用於次要光線，預設為關閉。通常有助於改善非密閉物件的漏光問題。"
+
+#. option rtx.enableEmissiveBlendModeTranslation
+#: src/dxvk/rtx_render/rtx_options.h:1004
+msgid "Treat incoming semi/additive D3D blend modes as emissive."
+msgstr "將傳入的半透明/加成 D3D 混合模式視為自發光。"
+
+#. option rtx.enableEmissiveBlendEmissiveOverride
+#: src/dxvk/rtx_render/rtx_options.h:1005
+msgid "Override typical material emissive information on draw calls with any emissive blending modes to emulate their original look more accurately."
+msgstr "對使用任何自發光混合模式的繪製呼叫，覆寫一般的材質自發光資訊，以更準確地模擬其原始外觀。"
+
+#. option rtx.emissiveBlendOverrideEmissiveIntensity
+#: src/dxvk/rtx_render/rtx_options.h:1006
+msgid "The emissive intensity to use when the emissive blend override is enabled. Adjust this if particles for example look overly bright globally."
+msgstr "啟用自發光混合覆寫時使用的自發光強度。例如若粒子整體看起來過亮，請調整此值。"
+
+#. option rtx.particleSoftnessFactor
+#: src/dxvk/rtx_render/rtx_options.h:1008
+msgid "Multiplier for the view distance that is used to calculate the particle blending range."
+msgstr "用於計算粒子混合範圍之檢視距離的倍數。"
+
+#. option rtx.forceCutoutAlpha
+#: src/dxvk/rtx_render/rtx_options.h:1010
+msgid ""
+"When an object is added to the cutout textures list it will have a cutout alpha mode forced on it, using this value for the alpha test.\n"
+"This is meant to improve the look of some legacy mode materials using low-resolution textures and alpha blending instead of alpha cutout as this can cause blurry halos around edges due to the difficulty of handling this sort of blending in Remix.\n"
+"Such objects are generally better handled with actual replacement assets using fully opaque geometry replacements or alpha cutout with higher resolution textures, so this should only be relied on until proper replacements can be authored."
+msgstr ""
+"物件被加入鏤空紋理清單時，會被強制套用鏤空 alpha 模式，並以此值進行 alpha 測試。\n"
+"這是為了改善某些使用低解析度紋理、以 alpha 混合而非 alpha 鏤空的舊版模式材質外觀，因為 Remix 難以處理這類混合，可能會在邊緣周圍產生模糊的光環。\n"
+"這類物件一般最好以實際的替換資產處理，例如使用完全不透明的幾何替換，或搭配較高解析度紋理的 alpha 鏤空，因此在製作出正確的替換之前才應依賴此設定。"
+
+#. option rtx.wboitEnergyLossCompensation
+#: src/dxvk/rtx_render/rtx_options.h:1014
+msgid "Multiplier for the coverage term in the weighted blended OIT imlementation - allows for some configuration to recover energy loss from the technique.  This is non physical, be careful overtuning "
+msgstr "加權混合 OIT 實作中覆蓋項的倍數，可透過設定來彌補此技術造成的能量損失。這並非物理正確的做法，請小心不要過度調整 "
+
+#. option rtx.wboitDepthWeightTuning
+#: src/dxvk/rtx_render/rtx_options.h:1015
+msgid "Allows for tuning the weighted blended OIT depth weight - which can be used to fine tune blending for various circumstances.  This control has a side effect, larger numbers here can adversely affect brightness of emissive blended materials."
+msgstr "可調整加權混合 OIT 的深度權重，用於在各種情況下微調混合效果。此控制有副作用：較大的值可能會對自發光混合材質的亮度造成不良影響。"
+
+#. option rtx.wboitEnabled
+#: src/dxvk/rtx_render/rtx_options.h:1016
+msgid "Enables the new rendering mode for handling alpha blended objects.  Changing this will trigger a shader recompile.  The new mode improves rendering accuracy, especially in cases where there are many layers of transparent things being rendered."
+msgstr "啟用處理 alpha 混合物件的新渲染模式。變更此設定會觸發著色器重新編譯。新模式能提升渲染準確度，尤其是在渲染多層透明物體的情況下。"
+
+#. option rtx.rayPortalModelTextureHashes
+#: src/dxvk/rtx_render/rtx_options.h:1022
+msgid ""
+"Texture hashes identifying ray portals.\n"
+"Entries are interpreted as pairs of hashes; the list length must be even and will be clamped to the internal max portal count."
+msgstr ""
+"用於識別光線傳送門的紋理雜湊。\n"
+"項目會被解讀為成對的雜湊；清單長度必須為偶數，並會被限制在內部的最大傳送門數量。"
+
+#. option rtx.rayPortalSamplingWeightMinDistance
+#: src/dxvk/rtx_render/rtx_options.h:1033
+msgid ""
+"The minimum distance from a portal which the interpolation of the probability of light sampling through portals will begin (and is at its maximum value).\n"
+"Currently unimplemented, kept here for future use."
+msgstr ""
+"距離傳送門的最小距離；穿過傳送門之光源取樣機率的內插從此處開始（且在此處為最大值）。\n"
+"目前尚未實作，保留供日後使用。"
+
+#. option rtx.rayPortalSamplingWeightMaxDistance
+#: src/dxvk/rtx_render/rtx_options.h:1038
+msgid ""
+"The maximum distance from a portal which the interpolation of the probability of light sampling through portals will end (and is at its minimum value such that no portal light sampling will happen beyond this point).\n"
+"Currently unimplemented, kept here for future use."
+msgstr ""
+"距離傳送門的最大距離；穿過傳送門之光源取樣機率的內插在此處結束（且在此處為最小值，因此超過此點後不會再透過傳送門進行光源取樣）。\n"
+"目前尚未實作，保留供日後使用。"
+
+#. option rtx.rayPortalCameraHistoryCorrection
+#: src/dxvk/rtx_render/rtx_options.h:1042
+msgid ""
+"A flag to control if history correction on ray portal camera teleportation events is enabled or disabled.\n"
+"This allows for the previous camera matrix to be set to a virtual matrix to correct the large discontunity in position and view direction which happens when a camera teleports from moving through a ray portal (in games like Portal).\n"
+"As such this option should always be enabled in games utilizing ray portals the camera can pass through as it should fix artifacts from incorrectly calculated motion vectors or other deltas that rely on the current and previous camera matrix."
+msgstr ""
+"控制是否在光線傳送門攝影機傳送事件中啟用歷史校正的旗標。\n"
+"這可將上一個攝影機矩陣設為虛擬矩陣，以校正攝影機穿過光線傳送門而傳送時（例如在 Portal 等遊戲中），位置與視線方向發生的大幅不連續。\n"
+"因此，在攝影機可穿過光線傳送門的遊戲中，應一律啟用此選項，因為它能修正因動態向量計算錯誤，或其他依賴目前與上一個攝影機矩陣之差值所造成的瑕疵。"
+
+#. option rtx.rayPortalCameraInBetweenPortalsCorrection
+#: src/dxvk/rtx_render/rtx_options.h:1046
+msgid ""
+"A flag to contol correction when the camera is \"in-between\" a pair of ray portals.\n"
+"This is mostly relevant in applications which allow the camera to move through a ray portal (games like Portal) as often the ray portals are placed slightly off of a surface, allowing the camera to sometimes end up in this tiny gap for a frame.\n"
+"To correct this artifact (as it can mess up denoising and other temporal surface consistency checks due to the sudden frame of geometry in front of the camera) this option pushes the camera slightly backwards if this occurs when entering a ray portal.\n"
+"Similar to ray portal camera history correction this option should always be enabled in games utilizing ray portals the camera can pass through."
+msgstr ""
+"控制攝影機位於一對光線傳送門「之間」時之校正的旗標。\n"
+"這主要與允許攝影機穿過光線傳送門的應用程式（例如 Portal 等遊戲）有關，因為光線傳送門通常會稍微偏離表面放置，使攝影機有時會在某個畫格停在這個微小的間隙中。\n"
+"為了修正此瑕疵（因為攝影機前方突然出現一個畫格的幾何，可能會打亂降噪與其他時域表面一致性檢查），當進入光線傳送門時發生這種情況，此選項會將攝影機稍微向後推。\n"
+"與光線傳送門攝影機歷史校正類似，在攝影機可穿過光線傳送門的遊戲中，應一律啟用此選項。"
+
+#. option rtx.rayPortalCameraInBetweenPortalsCorrectionThreshold
+#: src/dxvk/rtx_render/rtx_options.h:1051
+msgid ""
+"The threshold to use for camera \"in-between\" ray portal detection in meters.\n"
+"When the camera is less than this distance behind the surface of a ray portal it will be pushed backwards to stay behind the ray portal.\n"
+"This value should stay small but be large enough to cover the gap between ray portals and the geometry behind them (if such a gap exists in the underlying application).\n"
+"Additionally, this setting must be set at startup and changing it will not take effect at runtime."
+msgstr ""
+"偵測攝影機位於光線傳送門「之間」時使用的臨界值，單位為公尺。\n"
+"當攝影機位於光線傳送門表面後方、距離小於此值時，會被向後推，以保持在光線傳送門後方。\n"
+"此值應保持很小，但要大到足以涵蓋光線傳送門與其後方幾何之間的間隙（若底層應用程式中存在這種間隙）。\n"
+"此外，此設定必須在啟動時設定，於執行期間變更不會生效。"
+
+#. option rtx.useWhiteMaterialMode
+#: src/dxvk/rtx_render/rtx_options.h:1057
+msgid "Override all objects' materials by white material"
+msgstr "以白色材質覆寫所有物件的材質"
+
+#. option rtx.linearizeSrgbTextures
+#: src/dxvk/rtx_render/rtx_options.h:1060
+msgid ""
+"When true, opaque albedo/emissive textures that use an sRGB VkFormat are detected and the path tracer's software gamma\n"
+"correction (gammaToLinear/pow(2.2)) is skipped for them, since the sampler hardware already linearized the value on read.\n"
+"This avoids a double linearization (sampler sRGB curve + shader pow(2.2)) that darkens such textures. Constants and\n"
+"non-sRGB (UNORM) textures are unaffected and still receive the software gamma correction. Set to false to restore the\n"
+"legacy behavior where the software conversion is always applied regardless of texture format."
+msgstr ""
+"為 true 時，會偵測使用 sRGB VkFormat 的不透明反照率/自發光紋理，並略過路徑追蹤器對它們的軟體伽瑪\n"
+"校正 (gammaToLinear/pow(2.2))，因為取樣器硬體在讀取時已將值線性化。\n"
+"這可避免雙重線性化（取樣器 sRGB 曲線 + 著色器 pow(2.2)）使這類紋理變暗。常數與\n"
+"非 sRGB (UNORM) 紋理不受影響，仍會套用軟體伽瑪校正。設為 false 可還原\n"
+"舊版行為，即不論紋理格式為何，一律套用軟體轉換。"
+
+#. option rtx.nativeMipBias
+#: src/dxvk/rtx_render/rtx_options.h:1066
+msgid ""
+"Specifies a mipmapping level bias to add to all material texture filtering. Stacks with the upscaling mip bias.\n"
+"Mipmaps are determined based on how far away a texture is, using this can bias the desired level in a lower quality direction (positive bias), or a higher quality direction with potentially more aliasing (negative bias).\n"
+"Note that mipmaps are also important for good spatial caching of textures, so too far negative of a mip bias may start to significantly affect performance, therefore changing this value is not recommended"
+msgstr ""
+"指定要加到所有材質紋理過濾上的 mipmap 層級偏差。會與升頻 mip 偏差疊加。\n"
+"mipmap 是依紋理的距離決定的，使用此值可將所需層級偏向較低品質（正偏差），或偏向較高品質但可能有更多鋸齒（負偏差）。\n"
+"請注意，mipmap 對紋理的良好空間快取也很重要，因此 mip 偏差過度為負可能會開始顯著影響效能，故不建議變更此值"
+
+#. option rtx.upscalingMipBias
+#: src/dxvk/rtx_render/rtx_options.h:1070
+msgid ""
+"Specifies a mipmapping level bias to add to all material texture filtering when upscaling (such as DLSS) is used.\n"
+"Mipmaps are determined based on how far away a texture is, using this can bias the desired level in a lower quality direction (positive bias), or a higher quality direction with potentially more aliasing (negative bias).\n"
+"Note that mipmaps are also important for good spatial caching of textures, so too far negative of a mip bias may start to significantly affect performance, therefore changing this value is not recommended"
+msgstr ""
+"使用升頻（例如 DLSS）時，指定要加到所有材質紋理過濾上的 mipmap 層級偏差。\n"
+"mipmap 是依紋理的距離決定的，使用此值可將所需層級偏向較低品質（正偏差），或偏向較高品質但可能有更多鋸齒（負偏差）。\n"
+"請注意，mipmap 對紋理的良好空間快取也很重要，因此 mip 偏差過度為負可能會開始顯著影響效能，故不建議變更此值"
+
+#. option rtx.useAnisotropicFiltering
+#: src/dxvk/rtx_render/rtx_options.h:1074
+msgid ""
+"A flag to indicate if anisotropic filtering should be used on material textures, otherwise typical trilinear filtering will be used.\n"
+"This should generally be enabled as anisotropic filtering allows for less blurring on textures at grazing angles than typical trilinear filtering with only usually minor performance impact (depending on the max anisotropy samples)."
+msgstr ""
+"決定是否對材質紋理使用非等向性過濾的旗標，否則使用一般的三線性過濾。\n"
+"一般應啟用，因為非等向性過濾在斜角處造成的紋理模糊比一般三線性過濾少，通常只有輕微的效能影響（取決於最大非等向性取樣數）。"
+
+#. option rtx.maxAnisotropySamples
+#: src/dxvk/rtx_render/rtx_options.h:1077
+msgid ""
+"The maximum number of samples to use when anisotropic filtering is enabled.\n"
+"The actual max anisotropy used will be the minimum between this value and the hardware's maximum. Higher values increase quality but will likely reduce performance."
+msgstr ""
+"啟用非等向性過濾時使用的最大取樣數。\n"
+"實際使用的最大非等向性為此值與硬體最大值中較小者。值越高品質越好，但可能會降低效能。"
+
+#. option rtx.enableMultiStageTextureFactorBlending
+#: src/dxvk/rtx_render/rtx_options.h:1080
+msgid "Support texture factor blending in stage 1~7. Currently only support 1 additional blending stage, more than 1 additional blending stages will be ignored."
+msgstr "支援在階段 1~7 中進行紋理因子混合。目前只支援 1 個額外的混合階段，超過 1 個的額外混合階段會被忽略。"
+
+#. option rtx.enableBreakIntoDebuggerOnPressingB
+#: src/dxvk/rtx_render/rtx_options.h:1083
+msgid ""
+"Enables a break into a debugger at the start of InjectRTX() on a press of key 'B'.\n"
+"If debugger is not attached at the time, it will wait until a debugger is attached and break into it then."
+msgstr ""
+"按下 'B' 鍵時，在 InjectRTX() 開頭中斷進入偵錯工具。\n"
+"若當時沒有附加偵錯工具，會等到偵錯工具附加後再中斷進入。"
+
+#. option rtx.enableCrashHotkey
+#: src/dxvk/rtx_render/rtx_options.h:1092
+msgid ""
+"Arms the crash hotkey feature. When enabled, pressing the crash hotkey combination (Ctrl+Shift+Alt+K by default) will trigger a deliberate crash.\n"
+"This option is only available in development builds and is intended for testing crash handling and crash dump generation.\n"
+"The armed state is indicated by a red warning overlay on screen. This setting is not saved to config files but can be set manually in rtx.conf."
+msgstr ""
+"啟用當機快速鍵功能。啟用後，按下當機快速鍵組合（預設為 Ctrl+Shift+Alt+K）會刻意觸發當機。\n"
+"此選項只在開發組建中提供，用於測試當機處理與當機傾印的產生。\n"
+"啟用狀態會以畫面上的紅色警告覆疊表示。此設定不會儲存到設定檔，但可在 rtx.conf 中手動設定。"
+
+#. option rtx.enablePreservePath
+#: src/dxvk/rtx_render/rtx_options.h:1107
+msgid ""
+"When true, Remix attempts to identify draw calls whose state has not changed since last frame and re-use the previous\n"
+"frame's translation, rather than retranslating the draw call into raytrace-ready scene data.\n"
+"When false, every submit uses full dynamic geometry and instance processing (drawReplacements / processDrawCallState).\n"
+"Disable for debugging or compatibility when suspecting preserve-path regressions."
+msgstr ""
+"為 true 時，Remix 會嘗試找出狀態自上一個畫格以來未變更的繪製呼叫，並重複使用上一個\n"
+"畫格的轉譯結果，而不是將繪製呼叫重新轉譯為可供光線追蹤的場景資料。\n"
+"為 false 時，每次提交都會使用完整的動態幾何與實例處理 (drawReplacements / processDrawCallState)。\n"
+"懷疑保留路徑造成回歸問題時，可為了偵錯或相容性而停用。"
+
+#. option rtx.enableInstanceDebuggingTools
+#: src/dxvk/rtx_render/rtx_options.h:1112
+msgid "NOTE: This will disable temporal correllation for instances, but allow the use of instance developer debug tools"
+msgstr "注意：這會停用實例的時域關聯，但可使用實例開發者偵錯工具"
+
+#. option rtx.enablePresentThrottle
+#: src/dxvk/rtx_render/rtx_options.h:1119
+msgid ""
+"A flag to enable or disable present throttling, when set to true a sleep for a time specified by the throttle delay will be inserted into the DXVK presentation thread.\n"
+"Useful to manually reduce the framerate if the application is running too fast or to reduce GPU power usage during development to keep temperatures down.\n"
+"Should not be enabled in anything other than development situations."
+msgstr ""
+"啟用或停用呈現節流的旗標；設為 true 時，會在 DXVK 呈現執行緒中插入一段由節流延遲指定時間的休眠。\n"
+"適用於在應用程式執行過快時手動降低畫格率，或在開發期間降低 GPU 耗電以控制溫度。\n"
+"除開發情況外不應啟用。"
+
+#. option rtx.presentThrottleDelay
+#: src/dxvk/rtx_render/rtx_options.h:1123
+msgid ""
+"A time in milliseconds that the DXVK presentation thread should sleep for. Requires present throttling to be enabled to take effect.\n"
+"Note that the application may sleep for longer than the specified time as is expected with sleep functions in general."
+msgstr ""
+"DXVK 呈現執行緒應休眠的時間，單位為毫秒。需要啟用呈現節流才會生效。\n"
+"請注意，如同一般的休眠函式，應用程式的休眠時間可能會比指定的時間長。"
+
+#. option rtx.recomputeTextureHashOnWrite
+#: src/dxvk/rtx_render/rtx_options.h:1127
+msgid ""
+"When true, Remix computes the hash of a texture when the game writes to the resource. Some games manage their own pool of\n"
+"textures and shuffle data around those resources resulting in incorrect textures being displayed. Recomputing the hash\n"
+"when the game writes to the resource can resolve this issue, however this can have unintended side effects when replacing\n"
+"animated game textures."
+msgstr ""
+"為 true 時，Remix 會在遊戲寫入資源時計算紋理的雜湊。有些遊戲會自行管理紋理\n"
+"集區，並在這些資源之間搬移資料，導致顯示錯誤的紋理。在遊戲寫入資源時重新計算雜湊\n"
+"可解決此問題，但在替換動畫遊戲紋理時\n"
+"可能會產生非預期的副作用。"
+
+#. option rtx.aliasing.beginPass
+#: src/dxvk/rtx_render/rtx_options.h:1151
+msgid "The first render pass where the aliasing resource is bound in a frame."
+msgstr "一個畫格中繫結別名資源的第一個渲染階段。"
+
+#. option rtx.aliasing.endPass
+#: src/dxvk/rtx_render/rtx_options.h:1152
+msgid "The last render pass where the aliasing resource is bound in a frame."
+msgstr "一個畫格中繫結別名資源的最後一個渲染階段。"
+
+#. option rtx.aliasing.formatCategory
+#: src/dxvk/rtx_render/rtx_options.h:1153
+msgid "Specifies the texture format compatibility category for the aliasing resource."
+msgstr "指定別名資源的紋理格式相容類別。"
+
+#. option rtx.aliasing.extentType
+#: src/dxvk/rtx_render/rtx_options.h:1154
+msgid "Specifies the resolution type for the aliasing resource. If a 3D texture is used, depth must also be set."
+msgstr "指定別名資源的解析度類型。若使用 3D 紋理，也必須設定深度。"
+
+#. option rtx.aliasing.width
+#: src/dxvk/rtx_render/rtx_options.h:1155
+msgid "The width of the aliasing resource in pixels."
+msgstr "別名資源的寬度，單位為像素。"
+
+#. option rtx.aliasing.height
+#: src/dxvk/rtx_render/rtx_options.h:1156
+msgid "The height of the aliasing resource in pixels."
+msgstr "別名資源的高度，單位為像素。"
+
+#. option rtx.aliasing.depth
+#: src/dxvk/rtx_render/rtx_options.h:1157
+msgid "The depth of the aliasing resource. Required for 3D textures."
+msgstr "別名資源的深度。3D 紋理必須設定。"
+
+#. option rtx.aliasing.layer
+#: src/dxvk/rtx_render/rtx_options.h:1158
+msgid "The number of layers in the aliasing resource."
+msgstr "別名資源中的層數。"
+
+#. option rtx.aliasing.imageType
+#: src/dxvk/rtx_render/rtx_options.h:1159
+msgid "The image type of the aliasing resource (e.g., 1D, 2D, or 3D)."
+msgstr "別名資源的影像類型（例如 1D、2D 或 3D）。"
+
+#. option rtx.aliasing.imageViewType
+#: src/dxvk/rtx_render/rtx_options.h:1160
+msgid "The image view type of the aliasing resource (e.g., 1D, 2D, 3D, or cube)."
+msgstr "別名資源的影像檢視類型（例如 1D、2D、3D 或 cube）。"
+
+#. option rtx.opacityMicromap.enable
+#: src/dxvk/rtx_render/rtx_options.h:1167
+msgid ""
+"Enables Opacity Micromaps for geometries with textures that have alpha cutouts.\n"
+"This is generally the case for geometries such as fences, foliage, particles, etc. .\n"
+"Opacity Micromaps greatly speed up raytracing of partially opaque triangles.\n"
+"Examples of scenes that benefit a lot: multiple trees with a lot of foliage,\n"
+"a ground densely covered with grass blades or steam consisting of many particles."
+msgstr ""
+"為紋理具有 alpha 鏤空的幾何啟用不透明度微貼圖。\n"
+"這通常適用於柵欄、枝葉、粒子等幾何。\n"
+"不透明度微貼圖能大幅加快部分不透明三角形的光線追蹤。\n"
+"獲益良多的場景範例：有大量枝葉的多棵樹木、\n"
+"密布草葉的地面，或由許多粒子組成的蒸氣。"
+
+#. option rtx.reflexMode
+#: src/dxvk/rtx_render/rtx_options.h:1175
+msgid ""
+"Reflex mode selection, enabling it helps minimize input latency, boost mode may further reduce latency by boosting GPU clocks in CPU-bound cases.\n"
+"Supported enum values are 0 = None (Disabled), 1 = LowLatency (Enabled), 2 = LowLatencyBoost (Enabled + Boost).\n"
+"Note that even when using the \"None\" Reflex mode Reflex will attempt to be initialized. Use rtx.isReflexEnabled to fully disable to skip this initialization if needed."
+msgstr ""
+"Reflex 模式選擇；啟用可協助將輸入延遲降至最低，加速模式則可在受 CPU 限制的情況下提高 GPU 時脈，進一步降低延遲。\n"
+"支援的列舉值：0 = None（停用），1 = LowLatency（啟用），2 = LowLatencyBoost（啟用 + 加速）。\n"
+"請注意，即使使用 \"None\" Reflex 模式，Reflex 仍會嘗試初始化。如有需要，可使用 rtx.isReflexEnabled 完全停用以略過此初始化。"
+
+#. option rtx.enableVsync
+#: src/dxvk/rtx_render/rtx_options.h:1194
+msgid "Controls the game's V-Sync setting. Native game's V-Sync settings are ignored."
+msgstr "控制遊戲的垂直同步設定。遊戲原生的垂直同步設定會被忽略。"
+
+#. option rtx.enableReplacementAssets
+#: src/dxvk/rtx_render/rtx_options.h:1199
+msgid "Globally enables or disables all enhanced asset replacement (materials, meshes, lights) functionality."
+msgstr "全域啟用或停用所有強化資產替換（材質、網格、光源）功能。"
+
+#. option rtx.enableReplacementLights
+#: src/dxvk/rtx_render/rtx_options.h:1201
+msgid ""
+"Enables or disables enhanced light replacements.\n"
+"Requires replacement assets in general to be enabled to have any effect."
+msgstr ""
+"啟用或停用強化光源替換。\n"
+"需要先整體啟用替換資產才會生效。"
+
+#. option rtx.enableReplacementMeshes
+#: src/dxvk/rtx_render/rtx_options.h:1205
+msgid ""
+"Enables or disables enhanced mesh replacements.\n"
+"Requires replacement assets in general to be enabled to have any effect."
+msgstr ""
+"啟用或停用強化網格替換。\n"
+"需要先整體啟用替換資產才會生效。"
+
+#. option rtx.enableReplacementMaterials
+#: src/dxvk/rtx_render/rtx_options.h:1209
+msgid ""
+"Enables or disables enhanced material replacements.\n"
+"Requires replacement assets in general to be enabled to have any effect."
+msgstr ""
+"啟用或停用強化材質替換。\n"
+"需要先整體啟用替換資產才會生效。"
+
+#. option rtx.texturemanager.budgetPercentageOfAvailableVram
+#: src/dxvk/rtx_render/rtx_options.h:1224
+msgid "The percentage of available VRAM we should use for material textures.  If material textures are required beyond this budget, then those textures will be loaded at lower quality.  Important note, it's impossible to perfectly match the budget while maintaining reasonable quality levels, so use this as more of a guideline.  If the replacements assets are simply too large for the target GPUs available vid mem, we may end up going overbudget regularly.  Defaults to 50% of the available VRAM."
+msgstr "用於材質紋理的可用 VRAM 百分比。若材質紋理需求超出此預算，這些紋理會以較低品質載入。重要提示：在維持合理品質的同時，不可能完全符合預算，因此請將此值視為參考準則。若替換資產對目標 GPU 的可用顯示記憶體而言實在太大，可能會經常超出預算。預設為可用 VRAM 的 50%。"
+
+#. option rtx.texturemanager.fixedBudgetEnable
+#: src/dxvk/rtx_render/rtx_options.h:1230
+msgid "If true, rtx.texturemanager.fixedBudgetMiB is used instead of rtx.texturemanager.budgetPercentageOfAvailableVram."
+msgstr "若為 true，會使用 rtx.texturemanager.fixedBudgetMiB，而非 rtx.texturemanager.budgetPercentageOfAvailableVram。"
+
+#. option rtx.texturemanager.fixedBudgetMiB
+#: src/dxvk/rtx_render/rtx_options.h:1231
+msgid "Fixed-size VRAM budget for replacement textures. In mebibytes. To use, set rtx.texturemanager.fixedBudgetEnable to True."
+msgstr "替換紋理的固定大小 VRAM 預算，單位為 MiB。若要使用，請將 rtx.texturemanager.fixedBudgetEnable 設為 True。"
+
+#. option rtx.texturemanager.samplerFeedbackEnable
+#: src/dxvk/rtx_render/rtx_options.h:1234
+msgid "Enable texture sampler feedback. If true, a texture prioritization logic considers the amount of mip-levels that was sampled by a GPU while rendering a scene.(For example, if a texture is in the distance, it will have a lower priority compared to a texture rendered just in front of the camera)."
+msgstr "啟用紋理取樣器回饋。若為 true，紋理優先順序邏輯會考量 GPU 渲染場景時所取樣的 mip 層級數量。（例如，位於遠處的紋理，其優先順序會低於渲染在攝影機正前方的紋理。）"
+
+#. option rtx.reloadTextureWhenResolutionChanged
+#: src/dxvk/rtx_render/rtx_options.h:1251
+msgid "Reload texture when resolution changed."
+msgstr "解析度變更時重新載入紋理。"
+
+#. option rtx.captureShowMenuOnHotkey
+#: src/dxvk/rtx_render/rtx_options.h:1262
+msgid ""
+"If true, then the capture menu will appear whenever one of the capture hotkeys are pressed. A capture MUST be started by using a button in the menu, in that case.\n"
+"If false, the hotkeys behave as expected. The user must manually open the menu in order to change any values."
+msgstr ""
+"若為 true，每當按下任一擷取快速鍵時都會顯示擷取選單。在這種情況下，「必須」使用選單中的按鈕開始擷取。\n"
+"若為 false，快速鍵會照常運作。使用者必須手動開啟選單才能變更任何值。"
+
+#. option rtx.captureInstanceStageName
+#: src/dxvk/rtx_render/rtx_options.h:1278
+msgid "Name of the 'instance' stage (see: 'rtx.captureInstances')."
+msgstr "「instance」stage 的名稱（請參閱：'rtx.captureInstances'）。"
+
+#. option rtx.captureOverwriteExistingCapture
+#: src/dxvk/rtx_render/rtx_options.h:1280
+msgid "If true, a capture with the same filename will overwrite any existing capture file instead of appending a numeric suffix to avoid collisions."
+msgstr "若為 true，相同檔名的擷取會覆寫現有的擷取檔案，而不是附加數字字尾以避免衝突。"
+
+#. option rtx.captureMaxFrames
+#: src/dxvk/rtx_render/rtx_options.h:1283
+msgid "Max frames capturable when running a multi-frame capture. The capture can be toggled to completion manually."
+msgstr "執行多畫格擷取時可擷取的最大畫格數。可手動切換以完成擷取。"
+
+#. option rtx.captureFramesPerSecond
+#: src/dxvk/rtx_render/rtx_options.h:1284
+msgid ""
+"Playback rate marked in the USD stage.\n"
+"Will eventually determine frequency with which game state is captured and written. Currently every frame -- even those at higher frame rates -- are recorded."
+msgstr ""
+"在 USD stage 中標記的播放速率。\n"
+"最終將決定擷取並寫入遊戲狀態的頻率。目前每個畫格（即使是較高畫格率下的畫格）都會被記錄。"
+
+#. option rtx.captureMeshPositionDelta
+#: src/dxvk/rtx_render/rtx_options.h:1288
+msgid "Inter-frame position min delta warrants new time sample."
+msgstr "畫格間位置差異達此最小值時，才會建立新的時間取樣。"
+
+#. option rtx.captureMeshNormalDelta
+#: src/dxvk/rtx_render/rtx_options.h:1289
+msgid "Inter-frame normal min delta warrants new time sample."
+msgstr "畫格間法線差異達此最小值時，才會建立新的時間取樣。"
+
+#. option rtx.captureMeshTexcoordDelta
+#: src/dxvk/rtx_render/rtx_options.h:1290
+msgid "Inter-frame texcoord min delta warrants new time sample."
+msgstr "畫格間紋理座標差異達此最小值時，才會建立新的時間取樣。"
+
+#. option rtx.captureMeshColorDelta
+#: src/dxvk/rtx_render/rtx_options.h:1291
+msgid "Inter-frame color min delta warrants new time sample."
+msgstr "畫格間色彩差異達此最小值時，才會建立新的時間取樣。"
+
+#. option rtx.captureMeshBlendWeightDelta
+#: src/dxvk/rtx_render/rtx_options.h:1292
+msgid "Inter-frame blend weight min delta warrants new time sample."
+msgstr "畫格間混合權重差異達此最小值時，才會建立新的時間取樣。"
+
+#. option rtx.useVirtualShadingNormalsForDenoising
+#: src/dxvk/rtx_render/rtx_options.h:1294
+msgid ""
+"A flag to enable or disable the usage of virtual shading normals for denoising passes.\n"
+"This is primairly important for anything that modifies the direction of a primary ray, so mainly PSR and ray portals as both of these will view a surface from an angle different from the \"virtual\" viewing direction perceived by the camera.\n"
+"This can cause some issues with denoising due to the normals not matching the expected perception of what the normals should be, for example normals facing away from the camera direction due to being viewed from a different angle via refraction or portal teleportation.\n"
+"To correct this, virtual normals are calculcated such that they always are oriented relative to the primary camera ray as if its direction was never altered, matching the virtual perception of the surface from the camera's point of view.\n"
+"As an aside, virtual normals themselves can cause issues with denoising due to the normals suddenly changing from virtual to \"real\" normals upon traveling through a portal, causing surface consistency failures in the denoiser, but this is accounted for via a special transform given to the denoiser on camera ray portal teleportation events.\n"
+"As such, this option should generally always be enabled when rendering with ray portals in the scene to have good denoising quality."
+msgstr ""
+"啟用或停用在降噪階段使用虛擬著色法線的旗標。\n"
+"這主要對任何會修改主要光線方向的功能很重要，主要是 PSR 與光線傳送門，因為兩者都會以不同於攝影機所感知之「虛擬」視線方向的角度觀看表面。\n"
+"由於法線與預期感知的法線不符，可能會造成一些降噪問題，例如透過折射或傳送門傳送從不同角度觀看時，法線背向攝影機方向。\n"
+"為了修正此問題，會計算虛擬法線，使其一律相對於主要攝影機光線定向，彷彿光線方向從未改變，以符合從攝影機視角對表面的虛擬感知。\n"
+"附帶一提，虛擬法線本身也可能造成降噪問題，因為穿過傳送門時，法線會突然從虛擬法線變為「真實」法線，導致降噪器的表面一致性檢查失敗；不過這已透過在攝影機光線傳送門傳送事件時提供給降噪器的特殊轉換來處理。\n"
+"因此，當場景中有光線傳送門時，一般應一律啟用此選項，以獲得良好的降噪品質。"
+
+#. option rtx.fogIgnoreSky
+#: src/dxvk/rtx_render/rtx_options.h:1303
+msgid "If true, sky draw calls will be skipped when searching for the D3D9 fog values."
+msgstr "若為 true，搜尋 D3D9 霧值時會略過天空繪製呼叫。"
+
+#. option rtx.skyForceHDR
+#: src/dxvk/rtx_render/rtx_options.h:1306
+msgid "By default sky will be rasterized in the color format used by the game. Set the checkbox to force sky to be rasterized in HDR intermediate format. This may be important when sky textures replaced with HDR textures."
+msgstr "預設情況下，天空會以遊戲使用的色彩格式點陣化。勾選此核取方塊可強制以 HDR 中介格式點陣化天空。當天空紋理被替換為 HDR 紋理時，這可能很重要。"
+
+#. option rtx.skyProbeSide
+#: src/dxvk/rtx_render/rtx_options.h:1307
+msgid "Resolution of the skybox for indirect illumination (rough reflections, global illumination etc)."
+msgstr "用於間接照明（粗糙反射、全域照明等）的天空盒解析度。"
+
+#. option rtx.skyDrawcallIdThreshold
+#: src/dxvk/rtx_render/rtx_options.h:1309
+msgid "It's common in games to render the skybox first, and so, this value provides a simple mechanism to identify those early draw calls that are untextured (textured draw calls can still use the Sky Textures functionality."
+msgstr "遊戲通常會先渲染天空盒，因此此值提供一種簡單的機制，用來識別這些早期的無紋理繪製呼叫（有紋理的繪製呼叫仍可使用天空紋理功能）。"
+
+#. option rtx.skyMinZThreshold
+#: src/dxvk/rtx_render/rtx_options.h:1310
+msgid "If a draw call's viewport has min depth greater than or equal to this threshold, then assume that it's a sky."
+msgstr "若繪製呼叫的檢視區最小深度大於或等於此臨界值，就假設它是天空。"
+
+#. option rtx.skyAutoDetect
+#: src/dxvk/rtx_render/rtx_options.h:1311
+msgid ""
+"Automatically tag sky draw calls using various heuristics.\n"
+"0 = None\n"
+"1 = CameraPosition - assume the first seen camera position is a sky camera.\n"
+"2 = CameraPositionAndDepthFlags - assume the first seen camera position is a sky camera, if its draw call's depth test is disabled. If it's enabled, assume no sky camera.\n"
+"Note: if all draw calls are marked as sky, then assume that there's no sky camera at all."
+msgstr ""
+"使用各種啟發式方法自動標記天空繪製呼叫。\n"
+"0 = None\n"
+"1 = CameraPosition - 假設第一個看到的攝影機位置是天空攝影機。\n"
+"2 = CameraPositionAndDepthFlags - 若繪製呼叫的深度測試已停用，假設第一個看到的攝影機位置是天空攝影機。若已啟用，則假設沒有天空攝影機。\n"
+"注意：若所有繪製呼叫都被標記為天空，則假設完全沒有天空攝影機。"
+
+#. option rtx.skyAutoDetectUniqueCameraDistance
+#: src/dxvk/rtx_render/rtx_options.h:1317
+msgid "If multiple cameras are found, this threshold distance (in game units) is used to distinguish a sky camera from a main camera. Active if sky auto-detect is set to CameraPosition / CameraPositionAndDepthFlags."
+msgstr "若找到多台攝影機，會使用此臨界距離（以遊戲單位計）區分天空攝影機與主攝影機。在天空自動偵測設為 CameraPosition / CameraPositionAndDepthFlags 時生效。"
+
+#. option rtx.skyReprojectToMainCameraSpace
+#: src/dxvk/rtx_render/rtx_options.h:1320
+msgid ""
+"Move sky geometry to the main camera space.\n"
+"Useful, if a game has a skybox that contains geometry that can be a part of the main scene (e.g. buildings, mountains). So with this option enabled, that geometry would be promoted from sky rasterization to ray tracing."
+msgstr ""
+"將天空幾何移到主攝影機空間。\n"
+"若遊戲的天空盒包含可作為主場景一部分的幾何（例如建築、山脈），此選項就很有用。啟用此選項後，這些幾何會從天空點陣化提升為光線追蹤。"
+
+#. option rtx.skyReprojectScale
+#: src/dxvk/rtx_render/rtx_options.h:1324
+msgid "Scaling of the sky geometry on reprojection to main camera space."
+msgstr "重新投影至主攝影機空間時，天空幾何的縮放。"
+
+#. option rtx.skyForceAutoDetectedToReproject
+#: src/dxvk/rtx_render/rtx_options.h:1325
+msgid "When enabled, draw calls classified as sky by auto-detect are always reprojected to main camera space instead of being rasterized to the sky cubemap. This fixes a class of bugs where auto-detect misclassifies world geometry as sky (due to shared camera positions), causing that geometry to become invisible. Only effective when Sky Auto-Detect and Reproject Sky to Main Camera are both enabled."
+msgstr "啟用時，被自動偵測歸類為天空的繪製呼叫，一律會重新投影至主攝影機空間，而不會點陣化到天空立方體貼圖。這可修正一類錯誤：自動偵測（因共用攝影機位置）將世界幾何誤判為天空，導致該幾何變得不可見。只在「天空自動偵測」與「將天空重新投影至主攝影機」都啟用時有效。"
+
+#. option rtx.skyMode
+#: src/dxvk/rtx_render/rtx_options.h:1331
+msgid "Sky rendering mode. SkyboxRasterization uses traditional skybox rasterization, Numos uses Hillaire atmospheric scattering."
+msgstr "天空渲染模式。SkyboxRasterization 使用傳統的天空盒點陣化，Numos 使用 Hillaire 大氣散射。"
+
+#. option rtx.gmod.enableInstrumentation
+#: src/dxvk/rtx_render/rtx_options.h:1337
+msgid "Enable GMod-specific mesh-hash, skinning, and animated-geometry diagnostic capture and logging."
+msgstr "啟用 GMod 專屬的網格雜湊、蒙皮與動畫幾何診斷擷取與記錄。"
+
+#. option rtx.fusedWorldViewMode
+#: src/dxvk/rtx_render/rtx_options.h:1340
+msgid "Set if game uses a fused World-View transform matrix."
+msgstr "若遊戲使用融合的世界-檢視轉換矩陣，請設定此選項。"
+
+#. option rtx.ignoreLastTextureStage
+#: src/dxvk/rtx_render/rtx_options.h:1345
+msgid ""
+"Removes the last texture bound to a draw call, when using fixed-function pipeline. Primary textures are untouched.\n"
+"Might be set to true, if a game applies a lightmap as last shading step, to omit the original lightmap data."
+msgstr ""
+"使用固定功能管線時，移除繫結至繪製呼叫的最後一張紋理。主要紋理不受影響。\n"
+"若遊戲在最後一個著色步驟套用光照貼圖，可設為 true 以省略原始光照貼圖資料。"
+
+#. option rtx.terrain.terrainAsDecalsEnabledIfNoBaker
+#: src/dxvk/rtx_render/rtx_options.h:1349
+msgid "If terrain baker is disabled, attempt to blend with the decals."
+msgstr "若停用地形烘焙器，會嘗試以貼花方式混合。"
+
+#. option rtx.terrain.terrainAsDecalsAllowOverModulate
+#: src/dxvk/rtx_render/rtx_options.h:1350
+msgid "Set to true, if it's known that terrain layers with ModulateX2 / ModulateX4 flags do not contain a lighting info, but ModulateX2 / ModulateX4 are used only to blend layers."
+msgstr "若已知具有 ModulateX2 / ModulateX4 旗標的地形層不包含照明資訊，而 ModulateX2 / ModulateX4 僅用於混合圖層，請設為 true。"
+
+#. option rtx.eye.enable
+#: src/dxvk/rtx_render/rtx_options.h:1355
+msgid "Enable shader code for eye drawing (eyeball normals, iris blending)."
+msgstr "啟用繪製眼睛的著色器程式碼（眼球法線、虹膜混合）。"
+
+#. option rtx.eye.assumeViewTexgenModeAsEye
+#: src/dxvk/rtx_render/rtx_options.h:1357
+msgid "Used to detect eyes and its vectors, by assuming that a draw call with D3DTSS_TCI_CAMERASPACEPOSITION and specific texture transform is an eye draw call."
+msgstr "用於偵測眼睛及其向量；做法是假設使用 D3DTSS_TCI_CAMERASPACEPOSITION 與特定紋理轉換的繪製呼叫是眼睛繪製呼叫。"
+
+#. option rtx.eye.eyeballSphereOffset
+#: src/dxvk/rtx_render/rtx_options.h:1359
+msgid "Radius of the sphere used to calculate eye normals on the whites, in world units. The larger the value, the more pronounced the ambient shadowing is on an eyeball, to better ground the eyes on a face."
+msgstr "用於計算眼白部分眼睛法線的球體半徑，以世界單位計。值越大，眼球上的環境陰影越明顯，讓眼睛更自然地嵌在臉上。"
+
+#. option rtx.eye.corneaSphereOffset
+#: src/dxvk/rtx_render/rtx_options.h:1362
+msgid "Radius of the sphere used to calculate eye normals on the cornea, in world units. Larger values make the eye cornea appear more spherical."
+msgstr "用於計算角膜部分眼睛法線的球體半徑，以世界單位計。值越大，眼睛角膜看起來越接近球形。"
+
+#. option rtx.eye.eyeWhitesAlbedoScale
+#: src/dxvk/rtx_render/rtx_options.h:1365
+msgid "Brightness multiplier for the eye whites."
+msgstr "眼白的亮度倍數。"
+
+#. option rtx.eye.irisRadius
+#: src/dxvk/rtx_render/rtx_options.h:1366
+msgid "Size of an iris in the iris texture. If the iris texture is sampled outside of this radius, it's assumed that that area is a transition to the eye whites, so iris depth gradually goes to 0."
+msgstr "虹膜紋理中虹膜的大小。若在此半徑外取樣虹膜紋理，會假設該區域是過渡到眼白的部分，因此虹膜深度會逐漸變為 0。"
+
+#. option rtx.eye.irisDepth
+#: src/dxvk/rtx_render/rtx_options.h:1370
+msgid "How deep should the iris (colored part of an eye) be placed behind the cornea (eye lens). The larger the value the more distortion there is, because of the lens."
+msgstr "虹膜（眼睛有顏色的部分）應放在角膜（眼睛透鏡）後方多深的位置。值越大，由於透鏡的關係，扭曲越明顯。"
+
+#. option rtx.eye.sourceIrisSizeAdjustment
+#: src/dxvk/rtx_render/rtx_options.h:1373
+msgid "Source Engine r_eyesize equivalent for tagged Source eye draws. Positive values enlarge the projected iris without changing eyeball geometry."
+msgstr "已標記之 Source 眼睛繪製的 Source Engine r_eyesize 對應值。正值會放大投影的虹膜，而不改變眼球幾何。"
+
+#. option rtx.effectLightColor
+#: src/dxvk/rtx_render/rtx_options.h:1428
+msgid "Colour of the effect light, if not using plasma ball mode.  Effect lights can be attached to materials from the remix runtime menu, using the `Add Light to Texture` texture tag in game setup."
+msgstr "未使用電漿球模式時，效果光源的色彩。可在 Remix 執行階段選單的遊戲設定中，使用 `Add Light to Texture`（為紋理加入光源）紋理標記將效果光源附加到材質上。"
+
+#. option rtx.effectLightIntensity
+#: src/dxvk/rtx_render/rtx_options.h:1429
+msgid "The intensity of the effect light.  Effect lights can be attached to materials from the remix runtime menu, using the `Add Light to Texture` texture tag in game setup."
+msgstr "效果光源的強度。可在 Remix 執行階段選單的遊戲設定中，使用 `Add Light to Texture`（為紋理加入光源）紋理標記將效果光源附加到材質上。"
+
+#. option rtx.effectLightRadius
+#: src/dxvk/rtx_render/rtx_options.h:1430
+msgid "The sphere radius of the effect light.  Effect lights can be attached to materials from the remix runtime menu, using the `Add Light to Texture` texture tag in game setup."
+msgstr "效果光源的球體半徑。可在 Remix 執行階段選單的遊戲設定中，使用 `Add Light to Texture`（為紋理加入光源）紋理標記將效果光源附加到材質上。"
+
+#. option rtx.effectLightPlasmaBall
+#: src/dxvk/rtx_render/rtx_options.h:1431
+msgid "Use plasma ball mode, in this mode the effect light color is ignored.  Effect lights can be attached to materials from the remix runtime menu, using the `Add Light to Texture` texture tag in game setup."
+msgstr "使用電漿球模式；在此模式下會忽略效果光源的色彩。可在 Remix 執行階段選單的遊戲設定中，使用 `Add Light to Texture`（為紋理加入光源）紋理標記將效果光源附加到材質上。"
+
