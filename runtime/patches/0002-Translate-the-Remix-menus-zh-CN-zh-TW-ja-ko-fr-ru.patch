+#: src/dxvk/rtx_render/rtx_weather.cpp:1095
+msgid "Disable variation"
+msgstr "Отключить вариацию"
+
+#: src/dxvk/rtx_render/rtx_weather.cpp:1115
+msgid "Weather Preset Editor"
+msgstr "Редактор погодных пресетов"
+
+#: src/dxvk/rtx_render/rtx_weather.cpp:1126
+msgid "Editing Preset"
+msgstr "Редактируемый пресет"
+
+#: src/dxvk/rtx_render/rtx_weather.cpp:1128
+msgid "Use Active"
+msgstr "Взять активный"
+
+#: src/dxvk/rtx_render/rtx_weather.cpp:1133
+msgid "Point the editor at whatever preset the blender is currently targeting."
+msgstr "Переключить редактор на пресет, к которому сейчас стремится смешивание."
