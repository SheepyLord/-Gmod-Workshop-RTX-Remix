+#. option rtx.skyUseProbeForPrimaryRays
+#: src/dxvk/rtx_render/rtx_composite.h:93
+msgid ""
+"Samples the sky probe cubemap by ray direction for primary misses instead of the screen-space sky matte.\n"
+"This orients the sky to the current camera, such as the free camera in captures.\n"
+"Directions the game's sky draws do not cover show the clear color."
+msgstr ""
+"1차 광선이 빗나간 경우 화면 공간 하늘 매트 대신 광선 방향으로 하늘 프로브 큐브맵을 샘플링합니다.\n"
+"이렇게 하면 캡처의 자유 카메라처럼 현재 카메라에 맞게 하늘의 방향이 정해집니다.\n"
+"게임의 하늘 그리기가 다루지 않는 방향에는 클리어 색상이 표시됩니다."
+
+#. option rtx.compositePrimaryDirectDiffuse
+#: src/dxvk/rtx_render/rtx_composite.h:98
+msgid "Enables direct lightning's diffuse signal for primary surfaces in the final composite."
+msgstr "최종 합성에서 1차 표면에 대한 직접 조명의 디퓨즈 신호를 활성화합니다."
+
+#. option rtx.compositePrimaryDirectSpecular
+#: src/dxvk/rtx_render/rtx_composite.h:99
+msgid "Enables direct lightning's specular signal for primary surfaces in the final composite."
+msgstr "최종 합성에서 1차 표면에 대한 직접 조명의 스페큘러 신호를 활성화합니다."
+
+#. option rtx.compositePrimaryIndirectDiffuse
+#: src/dxvk/rtx_render/rtx_composite.h:100
+msgid "Enables indirect lightning's diffuse signal for primary surfaces in the final composite."
+msgstr "최종 합성에서 1차 표면에 대한 간접 조명의 디퓨즈 신호를 활성화합니다."
+
+#. option rtx.compositePrimaryIndirectSpecular
+#: src/dxvk/rtx_render/rtx_composite.h:101
+msgid "Enables indirect lightning's specular signal for primary surfaces in the final composite."
+msgstr "최종 합성에서 1차 표면에 대한 간접 조명의 스페큘러 신호를 활성화합니다."
+
+#. option rtx.compositeSecondaryCombinedDiffuse
+#: src/dxvk/rtx_render/rtx_composite.h:102
+msgid "Enables combined direct and indirect lightning's diffuse signal for secondary surfaces in the final composite."
+msgstr "최종 합성에서 2차 표면에 대한 직접 및 간접 조명을 결합한 디퓨즈 신호를 활성화합니다."
+
+#. option rtx.compositeSecondaryCombinedSpecular
+#: src/dxvk/rtx_render/rtx_composite.h:103
+msgid "Enables combined direct and indirect lightning's specular signal for secondary surfaces in the final composite."
+msgstr "최종 합성에서 2차 표면에 대한 직접 및 간접 조명을 결합한 스페큘러 신호를 활성화합니다."
+
+#. option rtx.enableStochasticAlphaBlend
+#: src/dxvk/rtx_render/rtx_composite.h:105
+msgid "Use stochastic alpha blend."
+msgstr "확률적 알파 블렌드를 사용합니다."
+
+#. option rtx.stochasticAlphaBlendOpacityThreshold
+#: src/dxvk/rtx_render/rtx_composite.h:107
+msgid "Max opacity to use stochastic alpha blend."
+msgstr "확률적 알파 블렌드를 사용할 최대 불투명도입니다."
+
+#. option rtx.stochasticAlphaBlendUseNeighborSearch
+#: src/dxvk/rtx_render/rtx_composite.h:108
+msgid "Get radiance from neighbor opaque pixels."
+msgstr "이웃한 불투명 픽셀에서 래디언스를 가져옵니다."
+
+#. option rtx.stochasticAlphaBlendSearchTheSameObject
+#: src/dxvk/rtx_render/rtx_composite.h:109
+msgid "Only use radiance samples from the same object."
+msgstr "같은 오브젝트의 래디언스 샘플만 사용합니다."
+
+#. option rtx.stochasticAlphaBlendSearchIteration
+#: src/dxvk/rtx_render/rtx_composite.h:110
+msgid "Search iterations."
+msgstr "검색 반복 횟수입니다."
+
+#. option rtx.stochasticAlphaBlendInitialSearchRadius
+#: src/dxvk/rtx_render/rtx_composite.h:111
+msgid "Initial search radius."
+msgstr "초기 검색 반경입니다."
+
+#. option rtx.stochasticAlphaBlendRadiusExpandFactor
+#: src/dxvk/rtx_render/rtx_composite.h:112
+msgid "Multiply radius by this factor if cannot find a good neighbor."
+msgstr "적합한 이웃을 찾지 못하면 반경에 이 계수를 곱합니다."
+
+#. option rtx.stochasticAlphaBlendShareNeighbors
+#: src/dxvk/rtx_render/rtx_composite.h:113
+msgid "Share result with other pixels to accelerate search."
+msgstr "검색을 가속하기 위해 결과를 다른 픽셀과 공유합니다."
+
+#. option rtx.stochasticAlphaBlendAverageSearchMatches
+#: src/dxvk/rtx_render/rtx_composite.h:114
+msgid "Averages the radiance of up to 4 matching neighbors instead of using the first match, which reduces flicker from per-frame noise."
+msgstr "첫 번째 일치 항목을 사용하는 대신 일치하는 이웃을 최대 4개까지 래디언스를 평균하여, 프레임별 노이즈로 인한 깜빡임을 줄입니다."
+
+#. option rtx.stochasticAlphaBlendNormalSimilarity
+#: src/dxvk/rtx_render/rtx_composite.h:116
+msgid "Min normal similarity for a valid neighbor."
+msgstr "유효한 이웃으로 인정할 최소 노멀 유사도입니다."
+
+#. option rtx.stochasticAlphaBlendDepthDifference
+#: src/dxvk/rtx_render/rtx_composite.h:117
+msgid "Max depth difference for a valid neighbor."
+msgstr "유효한 이웃으로 인정할 최대 깊이 차이입니다."
+
+#. option rtx.stochasticAlphaBlendPlanarDifference
+#: src/dxvk/rtx_render/rtx_composite.h:118
+msgid "Max planar difference for a valid neighbor."
+msgstr "유효한 이웃으로 인정할 최대 평면 차이입니다."
+
+#. option rtx.stochasticAlphaBlendUseRadianceVolume
+#: src/dxvk/rtx_render/rtx_composite.h:119
+msgid "Get radiance from radiance volume."
+msgstr "래디언스 볼륨에서 래디언스를 가져옵니다."
+
+#. option rtx.stochasticAlphaBlendRadianceVolumeMultiplier
+#: src/dxvk/rtx_render/rtx_composite.h:120
+msgid "Radiance volume multiplier."
+msgstr "래디언스 볼륨 배수입니다."
+
+#. option rtx.stochasticAlphaBlendEnableFilter
+#: src/dxvk/rtx_render/rtx_composite.h:121
+msgid "Filter samples to suppress noise."
+msgstr "노이즈를 억제하기 위해 샘플을 필터링합니다."
+
+#. option rtx.stochasticAlphaBlendDiscardBlackPixel
+#: src/dxvk/rtx_render/rtx_composite.h:122
+msgid "Discard black pixels."
+msgstr "검은색 픽셀을 버립니다."
+
+#. option rtx.usePostFilter
+#: src/dxvk/rtx_render/rtx_composite.h:124
+msgid "Uses post filter to remove fireflies in the denoised result."
+msgstr "후처리 필터를 사용하여 디노이징된 결과의 파이어플라이를 제거합니다."
+
+#. option rtx.postFilterThreshold
+#: src/dxvk/rtx_render/rtx_composite.h:126
+msgid "Clamps a pixel when its luminance exceeds x times of the average."
+msgstr "픽셀의 휘도가 평균의 x배를 초과하면 해당 픽셀을 클램프합니다."
+
+#. option rtx.enableDLSSEnhancement
+#: src/dxvk/rtx_render/rtx_composite.h:129
+msgid "Enhances lighting details when DLSS is on."
+msgstr "DLSS가 켜져 있을 때 조명 디테일을 향상합니다."
+
+#. option rtx.dlssEnhancementDirectLightPower
+#: src/dxvk/rtx_render/rtx_composite.h:130
+msgid "The overall strength of direct lighting enhancement."
+msgstr "직접 조명 향상의 전체 강도입니다."
+
+#. option rtx.dlssEnhancementIndirectLightPower
+#: src/dxvk/rtx_render/rtx_composite.h:131
+msgid "The overall strength of indirect lighting enhancement."
+msgstr "간접 조명 향상의 전체 강도입니다."
+
+#. option rtx.dlssEnhancementDirectLightMaxValue
+#: src/dxvk/rtx_render/rtx_composite.h:132
+msgid "The maximum strength of direct lighting enhancement."
+msgstr "직접 조명 향상의 최대 강도입니다."
+
+#. option rtx.dlssEnhancementIndirectLightMaxValue
+#: src/dxvk/rtx_render/rtx_composite.h:133
+msgid "The maximum strength of indirect lighting enhancement."
+msgstr "간접 조명 향상의 최대 강도입니다."
+
+#. option rtx.dlssEnhancementIndirectLightMinRoughness
+#: src/dxvk/rtx_render/rtx_composite.h:134
+msgid "The reference roughness in indirect lighting enhancement."
+msgstr "간접 조명 향상의 기준 거칠기입니다."
+
+#. option rtx.dlssEnhancementMode
+#: src/dxvk/rtx_render/rtx_composite.h:135
+msgid "The enhancement filter type. Valid values: <Normal Difference=1, Laplacian=0>. Normal difference mode provides more normal detail at the cost of some noise. Laplacian mode is less aggressive."
+msgstr "향상 필터 유형입니다. 유효한 값: <Normal Difference=1, Laplacian=0>. 노멀 차이 모드는 노이즈가 다소 늘어나는 대신 노멀 디테일을 더 많이 제공합니다. 라플라시안 모드는 덜 공격적입니다."
+
+#. option rtx.pixelHighlightReuseStrength
+#: src/dxvk/rtx_render/rtx_composite.h:137
+msgid "The specular portion when we reuse last frame's pixel value."
+msgstr "이전 프레임의 픽셀 값을 재사용할 때의 스페큘러 비율입니다."
+
+#: src/dxvk/rtx_render/rtx_context.cpp:3104
+msgid "Begin Pass must be before the End Pass"
+msgstr "시작 패스는 종료 패스보다 앞에 있어야 합니다"
