+#. option rtx.tonemap.tonemapOperator
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:40
+msgid ""
+"Tonemapping operator applied to the post-exposure color buffer.\n"
+"Supported values: 0 = None (saturate-only identity), 1 = Hill ACES, 2 = Narkowicz ACES, 3 = Hable Filmic, 4 = AgX, 5 = Lottes 2016, 6 = PsychoV17_Beta, 7 = Gran Turismo 7 (SDR), 8 = Neutwo (per-channel)."
+msgstr ""
+"套用於曝光後色彩緩衝區的色調對應運算子。\n"
+"支援的值：0 = 無（僅做 saturate 限制的恆等對應），1 = Hill ACES，2 = Narkowicz ACES，3 = Hable Filmic，4 = AgX，5 = Lottes 2016，6 = PsychoV17_Beta，7 = Gran Turismo 7 (SDR)，8 = Neutwo（逐通道）。"
+
+#. option rtx.tonemap.hable.exposureBias
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:56
+msgid "Hable Filmic: pre-operator exposure multiplier."
+msgstr "Hable Filmic：運算子之前的曝光倍數。"
+
+#. option rtx.tonemap.hable.shoulderStrength
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:57
+msgid "Hable Filmic: A — shoulder strength."
+msgstr "Hable Filmic：A — 肩部強度。"
+
+#. option rtx.tonemap.hable.linearStrength
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:58
+msgid "Hable Filmic: B — linear strength."
+msgstr "Hable Filmic：B — 線性強度。"
+
+#. option rtx.tonemap.hable.linearAngle
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:59
+msgid "Hable Filmic: C — linear angle."
+msgstr "Hable Filmic：C — 線性角度。"
+
+#. option rtx.tonemap.hable.toeStrength
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:60
+msgid "Hable Filmic: D — toe strength."
+msgstr "Hable Filmic：D — 趾部強度。"
+
+#. option rtx.tonemap.hable.toeNumerator
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:61
+msgid "Hable Filmic: E — toe numerator."
+msgstr "Hable Filmic：E — 趾部分子。"
+
+#. option rtx.tonemap.hable.toeDenominator
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:62
+msgid "Hable Filmic: F — toe denominator."
+msgstr "Hable Filmic：F — 趾部分母。"
+
+#. option rtx.tonemap.hable.whitePoint
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:63
+msgid "Hable Filmic: W — linear-scene white point. Defaults to 4.0 (Half-Life: Alyx); Uncharted 2 reference is 11.2."
+msgstr "Hable Filmic：W — 線性場景白點。預設為 4.0 (Half-Life: Alyx)；Uncharted 2 的參考值為 11.2。"
+
+#. option rtx.tonemap.agx.saturation
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:69
+msgid "AgX saturation multiplier. Range [0.0, 2.0]."
+msgstr "AgX 飽和度倍數。範圍 [0.0, 2.0]。"
+
+#. option rtx.tonemap.agx.look
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:70
+msgid "AgX look preset: 0 = None, 1 = Golden, 2 = Punchy."
+msgstr "AgX 風格預設：0 = 無，1 = 金黃，2 = 鮮明。"
+
+#. option rtx.tonemap.lottes.hdrMax
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:78
+msgid "Lottes: peak HDR white value. Higher values preserve more highlight detail. Range [1.0, 64.0]."
+msgstr "Lottes：HDR 峰值白色值。值越高，保留越多高光細節。範圍 [1.0, 64.0]。"
+
+#. option rtx.tonemap.lottes.contrast
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:79
+msgid "Lottes: contrast control (also drives saturation / crosstalk). Range [1.0, 3.0]."
+msgstr "Lottes：對比控制（也會影響飽和度 / 串擾）。範圍 [1.0, 3.0]。"
+
+#. option rtx.tonemap.lottes.shoulder
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:80
+msgid "Lottes: shoulder strength (highlight compression). Range [0.5, 2.0]."
+msgstr "Lottes：肩部強度（高光壓縮）。範圍 [0.5, 2.0]。"
+
+#. option rtx.tonemap.lottes.midIn
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:81
+msgid "Lottes: mid-grey input (scene linear). Range [0.01, 1.0]."
+msgstr "Lottes：中灰輸入（場景線性）。範圍 [0.01, 1.0]。"
+
+#. option rtx.tonemap.lottes.midOut
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:82
+msgid "Lottes: mid-grey output. Range [0.01, 1.0]."
+msgstr "Lottes：中灰輸出。範圍 [0.01, 1.0]。"
+
+#. option rtx.tonemap.psycho17.exposure
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:95
+msgid "Psycho17: pre-operator exposure multiplier."
+msgstr "Psycho17：運算子之前的曝光倍數。"
+
+#. option rtx.tonemap.psycho17.highlights
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:96
+msgid "Psycho17: highlight compression strength. Values > 1 compress highlights more aggressively."
+msgstr "Psycho17：高光壓縮強度。值 > 1 會更積極地壓縮高光。"
+
+#. option rtx.tonemap.psycho17.shadows
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:97
+msgid "Psycho17: shadow lifting strength. Values > 1 lift shadows."
+msgstr "Psycho17：暗部提亮強度。值 > 1 會提亮暗部。"
+
+#. option rtx.tonemap.psycho17.contrast
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:98
+msgid "Psycho17: contrast adjustment applied before tone mapping."
+msgstr "Psycho17：在色調對應之前套用的對比調整。"
+
+#. option rtx.tonemap.psycho17.purityScale
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:99
+msgid "Psycho17: chromatic purity (saturation) scale factor."
+msgstr "Psycho17：色彩純度（飽和度）縮放係數。"
+
+#. option rtx.tonemap.psycho17.bleachingIntensity
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:100
+msgid "Psycho17: Hunt-effect bleaching intensity. 0 = disabled, 1 = full bleach."
+msgstr "Psycho17：Hunt 效應漂白強度。0 = 停用，1 = 完全漂白。"
+
+#. option rtx.tonemap.psycho17.hueRestore
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:102
+msgid "Psycho17: source-hue restoration after adaptation (0 = none, 1 = full)."
+msgstr "Psycho17：適應後的原始色相還原（0 = 無，1 = 完全）。"
+
+#. option rtx.tonemap.psycho17.coneResponseExponent
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:105
+msgid "Psycho17: cone response exponent for the Naka-Rushton stage."
+msgstr "Psycho17：Naka-Rushton 階段的錐細胞反應指數。"
+
+#. option rtx.tonemap.psycho17.gamutCompression
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:106
+msgid "Psycho17: output gamut compression strength. 0 = off, 1 = full."
+msgstr "Psycho17：輸出色域壓縮強度。0 = 關閉，1 = 完全。"
+
+#. option rtx.tonemap.psycho17.gamutCompressionMode
+#: src/dxvk/rtx_render/rtx_fork_tonemap.h:107
+msgid "Psycho17: target gamut for output compression. 0 = BT.709, 1 = BT.2020."
+msgstr "Psycho17：輸出壓縮的目標色域。0 = BT.709，1 = BT.2020。"
+
