+#. option rtx.dlssNeuralRendering.enable
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:60
+msgid "Enable DLSS 3D-Guided Neural Rendering.\n"
+msgstr "Включает DLSS 3D-Guided Neural Rendering.\n"
+
+#. option rtx.dlssNeuralRendering.intensity
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:62
+msgid "Controls the overall DLSS 3D-Guided Neural Rendering effect. Lower values reduce the effect; higher values increase it."
+msgstr "Управляет общим эффектом DLSS 3D-Guided Neural Rendering. Меньшие значения ослабляют эффект, большие — усиливают."
+
+#. option rtx.dlssNeuralRendering.structuralStrength
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:65
+msgid "Controls DLSS 3D-Guided Neural Rendering adjustments to details, shadows, and materials. Lower values preserve the original structure; higher values apply stronger adjustments."
+msgstr "Управляет корректировками деталей, теней и материалов в DLSS 3D-Guided Neural Rendering. Меньшие значения сохраняют исходную структуру; большие применяют более сильные корректировки."
+
+#. option rtx.dlssNeuralRendering.toneStrength
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:68
+msgid "Controls DLSS 3D-Guided Neural Rendering adjustments to lightness, darkness, and color. Lower values preserve the original tone and color; higher values apply stronger adjustments."
+msgstr "Управляет корректировками светлоты, темноты и цвета в DLSS 3D-Guided Neural Rendering. Меньшие значения сохраняют исходный тон и цвет; большие применяют более сильные корректировки."
+
+#. option rtx.dlssNeuralRendering.model
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:71
+msgid "Selects among three DLSS 3D-Guided Neural Rendering model variants. Their appearance is content-dependent; compare them in the target scene and choose the preferred result. 0: Model A, 1: Model B, 2: Model C."
+msgstr "Выбор одного из трёх вариантов модели DLSS 3D-Guided Neural Rendering. Их вид зависит от содержимого; сравните их в нужной сцене и выберите лучший результат. 0: модель A, 1: модель B, 2: модель C."
+
+#. option rtx.dlssNeuralRendering.useAutoMask
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:73
+msgid "Combine the automatic character mask with the material control mask."
+msgstr "Объединять автоматическую маску персонажей с маской управления материалами."
+
+#. option rtx.dlssNeuralRendering.skinStructureStrength
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:74
+msgid "Controls DLSS 3D-Guided Neural Rendering adjustments to characters when Auto Mask is enabled. Lower values preserve the original structure; higher values apply stronger structural adjustments."
+msgstr "Управляет корректировками персонажей в DLSS 3D-Guided Neural Rendering при включённой автомаске. Меньшие значения сохраняют исходную структуру; большие применяют более сильные структурные корректировки."
+
+#. option rtx.dlssNeuralRendering.enableHighlightRecovery
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:82
+msgid "Recover highlights compressed by DLSS 3D-Guided Neural Rendering's LDR-domain processing."
+msgstr "Восстанавливать света, сжатые обработкой DLSS 3D-Guided Neural Rendering в области LDR."
+
+#. option rtx.dlssNeuralRendering.highlightRecoveryThresholds
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:83
+msgid "Smoothstep edges for highlight recovery: (exposed HDR max-channel min, exposed HDR max-channel max, LDR max-channel min, LDR max-channel max)."
+msgstr "Границы smoothstep для восстановления светов: (мин. максимального канала HDR после экспозиции, макс. максимального канала HDR после экспозиции, мин. максимального канала LDR, макс. максимального канала LDR)."
+
+#. option rtx.dlssNeuralRendering.enableVolumetricControlMask
+#: src/dxvk/rtx_render/rtx_dlss_neural_rendering.h:85
+msgid "Modulate the DLSS 3D-Guided Neural Rendering control mask with fog, volumetric, and alpha-blended transmittance."
+msgstr "Модулировать маску управления DLSS 3D-Guided Neural Rendering пропусканием тумана, объёмных эффектов и альфа-смешивания."
+
