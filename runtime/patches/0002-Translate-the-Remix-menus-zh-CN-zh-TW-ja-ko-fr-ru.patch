+msgstr "粗糙度限制"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:221
+msgid "Validate Lighting Change"
+msgstr "驗證照明變化"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:222
+msgid "Lighting Change Threshold"
+msgstr "照明變化臨界值"
+
+#: src/dxvk/rtx_render/rtx_restir_gi_rayquery.cpp:223
