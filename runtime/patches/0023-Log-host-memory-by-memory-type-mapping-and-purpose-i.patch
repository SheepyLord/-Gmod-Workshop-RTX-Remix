+  // NV-DXVK start: host memory census
+  void DxvkMemoryAllocator::logHostCensus(uint32_t frame) {
+    struct Mapping { uint64_t begin; uint64_t bytes; uint64_t used; uint32_t type; bool dedicated; };
+    std::vector<Mapping> mappings;
+
+    for (uint32_t i = 0; i < m_memProps.memoryTypeCount; i++) {
+      DxvkMemoryType& type = m_memTypes[i];
+      uint64_t chunkBytes = 0, chunkUsed = 0, dedicatedBytes = 0;
+      size_t chunkCount = 0, dedicatedCount = 0;
+      const bool hostVisible = (type.memType.propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) != 0;
+      {
+        std::lock_guard<dxvk::mutex> lock(type.mutex);
+        chunkCount = type.chunks.size();
+        for (const auto& chunk : type.chunks) {
+          const DxvkDeviceMemory& memory = chunk->deviceMemory();
+          const uint64_t used = chunk->usedBytes();
+          chunkBytes += memory.memSize;
+          chunkUsed += used;
+          if (hostVisible && memory.memPointer)
+            mappings.push_back({ uint64_t(reinterpret_cast<uintptr_t>(memory.memPointer)), memory.memSize, used, i, false });
+        }
+        dedicatedCount = type.dedicated.size();
+        for (const auto& memory : type.dedicated) {
+          dedicatedBytes += memory.memSize;
+          if (hostVisible && memory.memPointer)
+            mappings.push_back({ uint64_t(reinterpret_cast<uintptr_t>(memory.memPointer)), memory.memSize, memory.memSize, i, true });
+        }
+      }
+      Logger::info(str::format("[RTX Host Memory] {\"event\":\"memory_type\",\"frame\":", frame,
+        ",\"type\":", i, ",\"heap\":", type.heapId, ",\"flags\":", type.memType.propertyFlags,
+        ",\"chunks\":", chunkCount, ",\"chunk_bytes\":", chunkBytes, ",\"chunk_used\":", chunkUsed,
+        ",\"dedicated\":", dedicatedCount, ",\"dedicated_bytes\":", dedicatedBytes, "}"));
+    }
+
+    for (const auto& mapping : mappings) {
+      Logger::info(str::format("[RTX Host Memory] {\"event\":\"host_mapping\",\"frame\":", frame,
+        ",\"type\":", mapping.type, ",\"address\":", mapping.begin, ",\"bytes\":", mapping.bytes,
+        ",\"used\":", mapping.used, ",\"dedicated\":", mapping.dedicated ? "true" : "false", "}"));
+    }
+
+    PROCESS_MEMORY_COUNTERS_EX counters = { };
+    counters.cb = sizeof(counters);
+    if (K32GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&counters), sizeof(counters))) {
+      Logger::info(str::format("[RTX Host Memory] {\"event\":\"process\",\"frame\":", frame,
+        ",\"private_bytes\":", uint64_t(counters.PrivateUsage), ",\"working_set\":", uint64_t(counters.WorkingSetSize),
+        ",\"peak_working_set\":", uint64_t(counters.PeakWorkingSetSize), "}"));
+    }
+
+    // Committed address space by type and protection, and the part DXVK's host-visible
+    // memory objects cover. Mappings are disjoint, so a sorted sweep attributes each byte once.
+    std::sort(mappings.begin(), mappings.end(), [] (const Mapping& a, const Mapping& b) { return a.begin < b.begin; });
+    struct Usage { uint64_t committed = 0; uint64_t regions = 0; std::map<uint32_t, uint64_t> byType; };
+    std::map<std::pair<uint32_t, uint32_t>, Usage> usage; // (MEM_* type, protection)
+    MEMORY_BASIC_INFORMATION info = { };
+    uintptr_t address = 0;
+    while (VirtualQuery(reinterpret_cast<LPCVOID>(address), &info, sizeof(info)) == sizeof(info)) {
+      const uint64_t begin = uint64_t(reinterpret_cast<uintptr_t>(info.BaseAddress));
+      const uint64_t end = begin + info.RegionSize;
+      if (info.State == MEM_COMMIT) {
+        auto& entry = usage[{ uint32_t(info.Type), uint32_t(info.Protect) }];
+        entry.committed += info.RegionSize;
+        entry.regions += 1;
+        auto it = std::upper_bound(mappings.begin(), mappings.end(), begin,
+          [] (uint64_t value, const Mapping& mapping) { return value < mapping.begin; });
+        if (it != mappings.begin())
+          --it;
+        for (; it != mappings.end() && it->begin < end; ++it) {
+          const uint64_t overlapBegin = std::max(begin, it->begin);
+          const uint64_t overlapEnd = std::min(end, it->begin + it->bytes);
+          if (overlapEnd > overlapBegin)
+            entry.byType[it->type] += overlapEnd - overlapBegin;
+        }
+      }
+      if (end <= address)
+        break;
+      address = uintptr_t(end);
+    }
+
+    for (const auto& [key, entry] : usage) {
+      if (entry.committed < (16ull << 20))
+        continue;
+      std::string byType;
+      for (const auto& [type, bytes] : entry.byType)
+        byType += str::format(byType.empty() ? "" : ",", "\"", type, "\":", bytes);
+      const char* kind = key.first == MEM_PRIVATE ? "private" : key.first == MEM_MAPPED ? "mapped" : key.first == MEM_IMAGE ? "image" : "other";
+      Logger::info(str::format("[RTX Host Memory] {\"event\":\"address_space\",\"frame\":", frame,
+        ",\"kind\":\"", kind, "\",\"protect\":", key.second, ",\"committed\":", entry.committed,
+        ",\"regions\":", entry.regions, ",\"dxvk_by_type\":{", byType, "}}"));
+    }
+    Logger::info(str::format("[RTX Host Memory] {\"event\":\"end\",\"frame\":", frame, ",\"mappings\":", mappings.size(), "}"));
+  }
+  // NV-DXVK end
+
 }
