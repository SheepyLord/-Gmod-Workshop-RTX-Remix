diff --git a/src/dxvk/rtx_render/rtx_texture_budget.h b/src/dxvk/rtx_render/rtx_texture_budget.h
index d36f2694..2b51baa2 100644
--- a/src/dxvk/rtx_render/rtx_texture_budget.h
+++ b/src/dxvk/rtx_render/rtx_texture_budget.h
@@ -93,4 +93,14 @@ namespace dxvk {
     return drawn ? PreloadPinChange::Restore : PreloadPinChange::Keep;
   }
 
+  // R13-F: a material's preload waits for the material's first draw instead of loading every mip
+  // when its mod loads (rtx.texturemanager.preloadOnFirstDraw). Until then it holds its smallest
+  // mips, as a streamed texture does; the frame that first draws it pins it and loads every mip
+  // synchronously, before that frame renders. Other preloads (dome lights, the Remix API's),
+  // textures too large for the streaming staging buffer, and every texture while
+  // rtx.texturemanager.neverDowngradeTextures is on load whole with the mod, as before.
+  inline bool preloadWaitsForFirstDraw(bool enabled, bool materialPreload, bool mustLoadWhole, bool neverDowngrade) {
+    return enabled && materialPreload && !mustLoadWhole && !neverDowngrade;
+  }
+
 }
