   }
 
+  // NV-DXVK start: R13-F as the CI path of queueAdd: the waiting upload's staging is given back and
+  // the texture staged again with what it requests now (the render thread uploads it this frame)
+  bool AsyncRunner::replaceReadyWithSync(const Rc<ManagedTexture>& tex, uint64_t generation) {
+    auto assetLock = std::unique_lock{ m_assetInfoMutex };
+    auto l = std::unique_lock{ m_readyTextures_mutex };
+    bool replaced = false;
+    erase_ifv(m_readyTextures, [&](const ReadyToCopy& r) {
+      const bool same = r.dstTexture == tex;
+      if (same) {
+        releaseStagingReservation(r);
+        replaced = true;
+      }
+      return same;
+    });
+    if (replaced) {
+      m_readyTextures.push_back(makeStagingForTextureAsset(m_synchronousAlloc, tex, generation));
+    }
+    return replaced;
+  }
