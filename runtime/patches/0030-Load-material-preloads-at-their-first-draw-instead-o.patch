@@ -88,6 +88,13 @@ int main() {
   check(!textureInUse(0, 97, 100), "Tracked three frames ago is not in use any more");
   check(textureInUse(0, UINT32_MAX - 1, 0), "The frame counter may wrap");
 
+  // R13-F: only a material's preload waits for its first draw, and only while the option is on.
+  check(preloadWaitsForFirstDraw(true, true, false, false), "A material's preload waits for its first draw");
+  check(!preloadWaitsForFirstDraw(false, true, false, false), "With the option off it loads with the mod");
