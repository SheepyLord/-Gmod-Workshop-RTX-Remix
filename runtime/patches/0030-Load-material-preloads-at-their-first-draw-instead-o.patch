+  // NV-DXVK start: R13-F
+  void RtxTextureManager::loadPreloadOnFirstDraw(const Rc<ManagedTexture>& tex) {
+    // As a preload at mod load: pinned, every mip requested, staged synchronously. The upload goes
+    // with this frame's others (submitTexturesToDeviceLocal, before the scene is built and traced),
+    // so the frame that first draws the material already samples the whole chain.
+    tex->m_preloadOnFirstDraw = false;
+    tex->m_needsReloadAfterPurge.store(false);
+    tex->m_canDemote = false;
+    tex->requestMips(MAX_MIPS);
+    // A load in flight makes scheduleTextureLoad leave the texture alone. The mod's own load of the
+    // smallest mips still waits for the render thread when the material is drawn in the frame its
+    // mod loaded: it is replaced by a load of every mip, uploaded with this frame's. Any other (a
+    // load on the worker thread) is listed, and the next frames finish it (garbageCollection).
+    const bool loadInFlight = tex->m_state.load() == ManagedTexture::State::kQueuedForUpload;
+    const auto start = std::chrono::steady_clock::now();
+    bool queued = true;
+    if (!loadInFlight) {
+      scheduleTextureLoad(tex, false);
+    } else {
+      queued = m_asyncThread && m_asyncThread->replaceReadyWithSync(tex, m_uploadGeneration.current());
+    }
+    const double stagingMs = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    if (!queued) {
+      g_firstDrawPending.push_back(tex);
+    }
+
+    const size_t bytes = calcSizeForAsset(*tex->m_assetData, 0, tex->m_assetData->info().mipLevels);
+    g_firstDrawWaiting.fetch_sub(1);
+    g_firstDrawWaitingBytes.fetch_sub(int64_t(bytes));
+    ++g_firstDrawLoaded;
+    g_firstDrawLoadedBytes += bytes;
+    ++g_firstDrawFrame.textures;
+    g_firstDrawFrame.bytes += bytes;
+    g_firstDrawFrame.stagingMs += stagingMs;
+  }
+  // NV-DXVK end
+
   void RtxTextureManager::updateSamplerFeedback(const Rc<ManagedTexture>& tex, uint16_t associatedFeedbackStamp) {
     m_sf.associate(
       RtxOptions::TextureManager::samplerFeedbackEnable() ? associatedFeedbackStamp : SAMPLER_FEEDBACK_INVALID,
@@ -1672,6 +1761,32 @@ namespace dxvk {
     }
     // NV-DXVK end
 
+    // NV-DXVK start: R13-F first-draw preloads whose load was not queued at their first draw load
+    // whole synchronously, for the next frame (pinned textures leave the lists below)
+    for (size_t i = 0; i < g_firstDrawPending.size();) {
+      const Rc<ManagedTexture>& tex = g_firstDrawPending[i];
+      const ManagedTexture::State state = tex->m_state.load();
+      const bool done = tex->m_canDemote                       // released under pressure since
+                     || state == ManagedTexture::State::kFailed
+                     || (state == ManagedTexture::State::kVidMem && tex->hasUploadedMips(MAX_MIPS, false));
+      if (done) {
+        g_firstDrawPending[i] = g_firstDrawPending.back();
+        g_firstDrawPending.pop_back();
+        continue;
+      }
+      scheduleTextureLoad(tex, false);
+      ++i;
+    }
+    if (g_firstDrawFrame.textures > 0) {
+      Logger::info(str::format("[RTX Preload] {\"frame\":", curframe,
+        ",\"first_draw_textures\":", g_firstDrawFrame.textures, ",\"first_draw_bytes\":", g_firstDrawFrame.bytes,
+        ",\"staging_ms\":", int64_t(g_firstDrawFrame.stagingMs * 10 + 0.5) / 10.0, ",\"pending\":", g_firstDrawPending.size(),
+        ",\"loaded_textures\":", g_firstDrawLoaded, ",\"loaded_bytes\":", g_firstDrawLoadedBytes,
+        ",\"waiting_textures\":", g_firstDrawWaiting.load(), ",\"waiting_bytes\":", g_firstDrawWaitingBytes.load(), "}"));
+      g_firstDrawFrame = {};
+    }
+    // NV-DXVK end
+
 
     // Non-SF textures (sky, terrain, etc.): keep at full mips while active in the scene,
     // evict once the scene clears (m_refCount > 0 reset in clear()).
@@ -1885,7 +2000,11 @@ namespace dxvk {
     // NV-DXVK end
 
     Rc<ManagedTexture> texture = TextureUtils::createTexture(assetData, colorSpace);
-    if (forceLoad) {
+    // NV-DXVK start: R13-F a material's preload waits for the material's first draw (addTexture)
+    const bool waitsForFirstDraw = preloadWaitsForFirstDraw(preloadOnFirstDraw(), forceLoad && preloadYields, mustLoadWhole,
+                                                            RtxOptions::TextureManager::neverDowngradeTextures());
+    if (forceLoad && !waitsForFirstDraw) {
+    // NV-DXVK end
       texture->m_canDemote = false;
       // NV-DXVK start: R13 a material's preload may give way under real memory pressure
       texture->m_preloadYields = preloadYields && !mustLoadWhole;
@@ -1894,6 +2013,14 @@ namespace dxvk {
       scheduleTextureLoad(texture, false);
     } else {
       texture->m_canDemote = true;
+      // NV-DXVK start: R13-F until then it holds its smallest mips, as a streamed texture does
+      if (waitsForFirstDraw) {
+        texture->m_preloadYields = true;
+        texture->m_preloadOnFirstDraw = true;
+        g_firstDrawWaiting.fetch_add(1);
+        g_firstDrawWaitingBytes.fetch_add(int64_t(calcSizeForAsset(*assetData, 0, assetData->info().mipLevels)));
+      }
+      // NV-DXVK end
       texture->requestMips(1);
       scheduleTextureLoad(texture, false);
     }
