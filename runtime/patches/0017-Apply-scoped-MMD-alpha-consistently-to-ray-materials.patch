diff --git a/tests/rtx/unit/test_mmd_alpha.cpp b/tests/rtx/unit/test_mmd_alpha.cpp
new file mode 100644
index 00000000..c8954020
--- /dev/null
+++ b/tests/rtx/unit/test_mmd_alpha.cpp
@@ -0,0 +1,108 @@
+/*
+ * Copyright (c) 2026 native-loader contributors.
+ * SPDX-License-Identifier: MIT
+ */
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include "../../../src/dxvk/rtx_render/rtx_mmd_alpha.h"
+#include "../../../src/dxvk/rtx_render/rtx_model_layers.h"
+#include "../../../src/dxvk/rtx_render/rtx_opacity_micromap_manager.h"
+
+namespace dxvk { Logger Logger::s_instance("test_mmd_alpha.log"); }
+
+int main() {
+  using namespace dxvk;
+  const auto require = [](bool ok, const char* message) {
+    if (!ok) { std::cerr << message << '\n'; std::exit(1); }
+  };
+  RtxOptionLayer::initializeSystemLayers();
+  const auto* user = RtxOptionLayer::getUserLayer();
+  const auto* derived = RtxOptionLayer::getDerivedLayer();
+  require(RtxModelLayers::mmdAlphaTexturesObject().getTargetLayer(user) == user &&
+    RtxModelLayers::mmdAlphaTexturesForSessionObject().getTargetLayer(user) == derived,
+    "Saved and transient category lifetimes must differ");
+  for (auto* option : {&RtxModelLayers::mmdAlphaTexturesObject(),
+                      &RtxModelLayers::mmdAlphaTexturesForSessionObject()}) {
+    require(bool(option->getFlags() & RtxOptionFlags::InvalidatesDrawcallTranslation),
+      "Category writes must invalidate preserved draw translation");
+  }
+  require(RtxModelLayers::mmdAlphaCutoff() == 0.5f &&
+    bool(RtxModelLayers::mmdAlphaCutoffObject().getFlags() & RtxOptionFlags::InvalidatesDrawcallTranslation),
+    "Cutoff must default to 0.5 and invalidate preserved draws");
+
+  // Exercise the category snapshot type used by D3D9 without creating a device.
+  RtxOptionHashSetCopy savedCopy(RtxModelLayers::mmdAlphaTexturesObject());
+  RtxOptionHashSetCopy sessionCopy(RtxModelLayers::mmdAlphaTexturesForSessionObject());
+  const auto refresh = [&]() {
+    std::lock_guard<std::mutex> lock(RtxOptionImpl::getUpdateMutex());
+    savedCopy.refreshLocked();
+    sessionCopy.refreshLocked();
+  };
+  fast_unordered_set hashes;
+  hashes.insert(0x1234);
+  for (const bool session : {false, true}) {
+    RtxModelLayers::mmdAlphaTexturesObject().setImmediately(session ? fast_unordered_set{} : hashes);
+    RtxModelLayers::mmdAlphaTexturesForSessionObject().setImmediately(session ? hashes : fast_unordered_set{});
+    refresh();
+    require(savedCopy.contains(0x1234) == !session && sessionCopy.contains(0x1234) == session,
+      "Category snapshots must track additions and removals without overwriting the other set");
+  }
+
+  RtSurface::AlphaState original;
+  original.alphaTestType = AlphaTestType::kGreater;
+  original.alphaTestReferenceValue = 178; // Source DX7's reference, not the VMT's 0.5.
+  auto tested = original;
+  applyMmdAlphaState(tested, true, true, false, 0.5f);
+  require(tested.isMmdAlpha && tested.mmdAlphaCutoff == 1024 &&
+    tested.alphaTestType == AlphaTestType::kGreater && tested.isBlendingDisabled && !tested.isFullyOpaque,
+    "MMD cutouts need exact 0.5 and must retain traversal's nonopaque geometry classification");
+  for (const auto flags : {std::array{false, true, false}, std::array{true, false, false}, std::array{true, true, true}}) {
+    auto state = original;
+    applyMmdAlphaState(state, flags[0], flags[1], flags[2], 0.5f);
+    require(std::memcmp(&state, &original, sizeof(state)) == 0,
+      "Unrelated draws, authored replacement alpha and forced cutouts must remain byte-identical");
+  }
+  RtSurface::AlphaState opaque;
+  opaque.isFullyOpaque = true;
+  applyMmdAlphaState(opaque, true, true, false, 0.5f);
+  require(opaque.isFullyOpaque && !opaque.isMmdAlpha, "Opaque draws must keep their opaque BLAS classification");
+
+  for (const float cutoff : {-1.f, 0.f, 0.2f, 0.5f, 1.f, 2.f, std::numeric_limits<float>::quiet_NaN()}) {
+    auto state = original;
+    applyMmdAlphaState(state, true, true, false, cutoff);
+    const float resolved = float(state.mmdAlphaCutoff) / 2048.f;
+    require(resolved >= 0.f && resolved <= 1.f && glm::unpackHalf1x16(glm::packHalf1x16(resolved)) == resolved,
+      "Cutoff must clamp and survive the CPU/GPU half-float round trip exactly");
+    require(!std::isnan(cutoff) || resolved == 0.5f, "Nonfinite cutoff must use the default");
+  }
+  for (const float alpha : {0.f, 66.f/255.f, std::nextafter(0.5f, 0.f), 0.5f, 166.f/255.f, 1.f}) {
+    require(mmdAlphaPromoteOpacity(alpha, false, 0.5f) == alpha, "Untagged blend changed");
+    require(mmdAlphaPromoteOpacity(alpha, true, 0.5f) == (alpha >= 0.5f ? 1.f : alpha),
+      "MMD promotion must include equality and preserve the soft-alpha path below the cutoff");
+  }
+  // Final opacity is used for shadows, BSDF transmission, ray resolve and OMM classification.
+  require(mmdAlphaPromoteOpacity((166.f/255.f) * 0.5f, true, 0.5f) < 0.5f,
+    "Vertex/material alpha must be applied before promotion");
+
+  RtSurface surface;
+  surface.alphaState = tested;
+  std::array<unsigned char, kSurfaceGPUSize> bytes{};
+  size_t offset = 0;
+  surface.writeGPUData(bytes.data(), offset);
+  uint32_t packed;
+  std::memcpy(&packed, bytes.data() + 54 * sizeof(uint32_t), sizeof(packed));
+  require(offset == kSurfaceGPUSize && ((packed >> 16) & 1) && ((packed >> 19) & 0xfff) == 1024,
+    "Surface record size or MMD cutoff packing changed");
+  OpacityMicromapHashSourceData a{}, b{};
+  a.alphaState = original;
+  b.alphaState = tested;
+  const auto ommHash = [](const auto& data) { return XXH3_64bits(&data, sizeof(data)); };
+  require(ommHash(a) != ommHash(b), "OMM cache identity omitted MMD classification");
+  a = b;
+  ++b.alphaState.mmdAlphaCutoff;
+  require(ommHash(a) != ommHash(b), "OMM cache identity omitted cutoff changes");
+  std::cout << "MMD alpha: option lifetime, categories, precedence, boundaries, packing and OMM identity passed\n";
+}
