diff --git a/src/dxvk/rtx_render/rtx_mmd_alpha.h b/src/dxvk/rtx_render/rtx_mmd_alpha.h
new file mode 100644
index 00000000..0a2487b9
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_mmd_alpha.h
@@ -0,0 +1,31 @@
+/*
+ * Copyright (c) 2026 native-loader contributors.
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include "rtx_materials.h"
+
+namespace dxvk {
+  // Called after ordinary alpha translation. Explicit replacement alpha and forced
+  // cutout/hair categories remain authoritative; ordinary opaque draws stay opaque.
+  inline void applyMmdAlphaState(RtSurface::AlphaState& state, bool tagged,
+                                bool useLegacyAlphaState, bool forceAlphaTest, float cutoff) {
+    if (!tagged || !useLegacyAlphaState || forceAlphaTest || state.isFullyOpaque) {
+      return;
+    }
+    if (!std::isfinite(cutoff)) {
+      cutoff = 0.5f;
+    }
+    cutoff = std::clamp(cutoff, 0.f, 1.f);
+    state.isMmdAlpha = true;
+    // Every value 0..2048 is exactly representable in the shader's float16_t.
+    state.mmdAlphaCutoff = uint16_t(std::round(cutoff * 2048.f));
+    if (state.alphaTestType != AlphaTestType::kAlways) {
+      // Capture metadata retains its byte reference; the live surface uses the exact cutoff.
+      state.alphaTestReferenceValue = uint8_t(cutoff * 255.f);
+    }
+  }
+}
