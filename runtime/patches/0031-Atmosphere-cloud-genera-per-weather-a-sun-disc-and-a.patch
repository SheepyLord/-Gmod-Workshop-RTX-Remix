+#: src/dxvk/rtx_render/rtx_atmosphere_ui.cpp:164
 msgid "Phase"
 msgstr "Phase"
 
-#: src/dxvk/rtx_render/rtx_atmosphere_ui.cpp:152
+#: src/dxvk/rtx_render/rtx_atmosphere_ui.cpp:165
 msgid "Moon phase: 0 = new, 0.25 = first quarter, 0.5 = full, 0.75 = third quarter. Same persistence rules as Elevation."
 msgstr "Phase de la lune : 0 = nouvelle lune, 0.25 = premier quartier, 0.5 = pleine lune, 0.75 = dernier quartier. Mêmes règles de conservation que pour l'élévation."
 
-#: src/dxvk/rtx_render/rtx_atmosphere_ui.cpp:154
+#: src/dxvk/rtx_render/rtx_atmosphere_ui.cpp:167
 msgid "Appearance"
