+// grain's centre, 0 between grains. p is in cells.
+float cirrusGrains(vec2 p, uint seed) {
+  vec2 i = floor(p);
+  vec2 f = p - i;
+  int2 c = int2(i);
+  float nearest = 8.0f;
+  for (int y = -1; y <= 1; ++y) {
+    for (int x = -1; x <= 1; ++x) {
+      uint2 h = cirrusPcg2d(uint2(c + int2(x, y)) + uint2(seed, seed * 7u));
+      vec2 jitter = vec2(h) * (1.0f / 4294967295.0f);
