+// about 3 degrees at 9 km, so the layer stays sunlit, red, for a while after
+// sunset, as real cirrus does.
+vec3 cirrusSunTransmittance(vec3 sunDir, float hKm, AtmosphereArgs args) {
+  float planetR = max(args.planetRadius, 1.0f);
+  float dip = acos(clamp(planetR / (planetR + hKm), 0.0f, 1.0f));
+  float elevation = asin(clamp(sunDir.y, -1.0f, 1.0f)) + dip;
