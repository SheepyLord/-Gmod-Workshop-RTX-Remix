+// octave too fine for the pixel blends to its mean (about 0.25) instead of
+// dropping out, so far streaks blur into a veil rather than vanish. [0, 1].
+float cirrusRidged(vec2 p, int octaves, float footprint, uint seed) {
+  float sum = 0.0f;
+  float norm = 0.0f;
+  float amplitude = 0.55f;
+  float frequency = 1.0f;
+  for (int i = 0; i < octaves; ++i) {
+    float fade = saturate(1.0f / max(frequency * footprint, 1e-6f) - 1.0f);
+    float r = saturate(1.0f - 1.8f * abs(cirrusNoise(p * frequency, seed + uint(i) * 131u)));
+    sum += amplitude * mix(0.25f, r * r * r, fade);
+    norm += amplitude;
+    frequency *= 2.0f;
+    amplitude *= 0.5f;
+  }
+  return sum / max(norm, 1e-6f);
