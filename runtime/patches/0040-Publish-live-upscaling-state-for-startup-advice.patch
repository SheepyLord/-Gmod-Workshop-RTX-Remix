diff --git a/tests/rtx/unit/test_upscaling_state.cpp b/tests/rtx/unit/test_upscaling_state.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5f8c0255bbeaa6093f320b16c8516c7633326c22
--- /dev/null
+++ b/tests/rtx/unit/test_upscaling_state.cpp
@@ -0,0 +1,81 @@
+// Runtime-owned upscaling snapshots: no GPU, SDK or config files required.
+#include "../../../src/dxvk/rtx_render/rtx_fork_game_state.h"
+
+#include <atomic>
+#include <cstdlib>
+#include <iostream>
+#include <thread>
+
+using namespace dxvk::fork_game_state;
+
+static void check(bool value) {
+  if (!value) {
+    std::cerr << "FAIL upscaling state publisher\n";
+    std::abort();
+  }
+}
+
+int main() {
+  auto& store = GameStateStore::get();
+  std::string value;
+  int deviceA = 0;
+  int deviceB = 0;
+  check(!store.tryGet(kUpscalingStateKey, value));
+  check(!store.set(kUpscalingStateKey, "forged"));
+  check(!store.set("rtx.runtime.future", "forged"));
+  check(store.set("isRaining", "true"));
+  check(store.tryGet("isRaining", value) && value == "true");
+
+  store.beginUpscalingState(&deviceA);
+  check(store.tryGet(kUpscalingStateKey, value) && value == "1 0 0 0 0 0 0");
+  store.publishUpscalingState(&deviceA, {true, 1, 1, true, true, false});
+  check(store.tryGet(kUpscalingStateKey, value) && value == "1 0 1 1 1 1 0");
+  store.finishUpscalingOptions(true);
+  store.publishUpscalingState(&deviceA, {true, 1, 1, true, true, false});
+  check(store.tryGet(kUpscalingStateKey, value) && value == "1 1 1 1 1 1 0");
+  check(!store.set(kUpscalingStateKey, "1 1 0 0 1 1 1"));
+  check(store.tryGet(kUpscalingStateKey, value) && value == "1 1 1 1 1 1 0");
+
+  store.invalidateUpscalingState();
+  check(store.tryGet(kUpscalingStateKey, value) && value == "1 0 1 1 1 1 0");
+  store.publishUpscalingState(&deviceA, {true, 0, 0, true, true, true});
+  check(store.tryGet(kUpscalingStateKey, value) && value == "1 0 0 0 1 1 1");
+  store.finishUpscalingOptions(false);
+  store.finishUpscalingOptions(true);
+  store.publishUpscalingState(&deviceA, {true, 0, 0, true, true, true});
+  check(store.tryGet(kUpscalingStateKey, value) && value == "1 0 0 0 1 1 1");
+
+  store.beginUpscalingState(&deviceB);
+  store.endUpscalingState(&deviceA);
+  store.publishUpscalingState(&deviceA, {true, 5, 2, false, false, false});
+  check(store.tryGet(kUpscalingStateKey, value) && value == "1 0 0 0 0 0 0");
+  store.finishUpscalingOptions(true);
+  for (uint32_t up = 0; up <= 5; up++) {
+    for (uint32_t fg = 0; fg <= 2; fg++) {
+      store.publishUpscalingState(&deviceB, {true, up, fg, true, true, true});
+      check(store.tryGet(kUpscalingStateKey, value)
+        && value == "1 1 " + std::to_string(up) + " " + std::to_string(fg) + " 1 1 1");
+    }
+  }
+  store.publishUpscalingState(&deviceB, {true, 6, 3, true, true, true});
+  check(store.tryGet(kUpscalingStateKey, value) && value == "1 0 6 3 1 1 1");
+
+  std::atomic<bool> done = false;
+  store.publishUpscalingState(&deviceB, {true, 1, 1, true, false, true});
+  std::thread writer([&] {
+    for (int i = 0; i < 50000; i++) {
+      store.publishUpscalingState(&deviceB, {true, 1, 1, true, false, true});
+      store.publishUpscalingState(&deviceB, {true, 5, 2, false, true, false});
+    }
+    done = true;
+  });
+  do {
+    check(store.tryGet(kUpscalingStateKey, value));
+    check(value == "1 1 1 1 1 0 1" || value == "1 1 5 2 0 1 0");
+  } while (!done);
+  writer.join();
+  store.endUpscalingState(&deviceB);
+  check(!store.tryGet(kUpscalingStateKey, value));
+  check(store.tryGet("isRaining", value) && value == "true");
+  std::cout << "PASS upscaling state publisher: lifecycle, readiness, namespace, enums, atomic readers\n";
+}
