diff --git a/src/dxvk/rtx_render/rtx_fork_game_state.h b/src/dxvk/rtx_render/rtx_fork_game_state.h
index e2a6240b35981e60eef19ca0ff6c2c7c3e29b5ad..979b377fea974c1b4a0bd961fa242283a73a395a 100644
--- a/src/dxvk/rtx_render/rtx_fork_game_state.h
+++ b/src/dxvk/rtx_render/rtx_fork_game_state.h
@@ -1,59 +1,146 @@
 #pragma once
 
 // rtx_fork_game_state.h — fork-owned generic key/value store for plugin-
 // injected runtime state that graph components read by name. The store is a
 // header-only singleton guarded by an internal mutex. Writes happen on the
 // plugin thread via remixapi_SetGameValue; reads happen on the render thread
 // from GameValueRead* graph components.
 //
 // Lifetime is deliberately API-lifetime (function-local static): the store
 // survives Remix Shutdown / re-init so plugins do not have to re-populate
 // their state across device resets.
 //
 // See docs/fork-touchpoints.md for the upstream file touches
 // associated with the remixapi_SetGameValue entrypoint.
 
+#include <algorithm>
+#include <cstdint>
 #include <mutex>
 #include <string>
 #include <unordered_map>
 #include <utility>
+#include <vector>
 
 namespace dxvk {
   namespace fork_game_state {
 
+    // A single versioned value keeps the plugin read atomic across all six fields.
+    inline constexpr const char* kUpscalingStateKey = "rtx.runtime.upscalingState";
+
+    struct UpscalingState {
+      bool ready = false;
+      uint32_t upscaler = 0;
+      uint32_t frameGeneration = 0;
+      bool dlssSupported = false;
+      bool dlssFrameGenerationSupported = false;
+      bool fsrFrameGenerationSupported = false;
+    };
+
     class GameStateStore {
     public:
       static GameStateStore& get() {
         static GameStateStore s_instance;
         return s_instance;
       }
 
-      // Overwrites the value under key. Thread-safe.
-      void set(const std::string& key, std::string value) {
+      // Plugins cannot impersonate the runtime, including future keys in this namespace.
+      bool set(const std::string& key, std::string value) {
+        if (key.compare(0, 12, "rtx.runtime.") == 0) {
+          return false;
+        }
         std::lock_guard<std::mutex> lock{ m_lock };
         m_values[key] = std::move(value);
+        return true;
+      }
+
+      void beginUpscalingState(const void* owner, std::vector<const void*> dependencies) {
+        std::lock_guard<std::mutex> lock{ m_lock };
+        m_upscalingOwner = owner;
+        m_upscalingDependencies = std::move(dependencies);
+        m_upscalingOptionsResolved = false;
+        m_upscalingResolutionFailed = false;
+        m_upscalingState = {};
+        writeUpscalingState();
+      }
+
+      void endUpscalingState(const void* owner) {
+        std::lock_guard<std::mutex> lock{ m_lock };
+        if (owner == m_upscalingOwner) {
+          m_values.erase(kUpscalingStateKey);
+          m_upscalingOwner = nullptr;
+          m_upscalingDependencies.clear();
+        }
+      }
+
+      // Called while holding the option update mutex; readers take only m_lock.
+      void invalidateUpscalingState(const void* option) {
+        std::lock_guard<std::mutex> lock{ m_lock };
+        if (std::find(m_upscalingDependencies.begin(), m_upscalingDependencies.end(), option)
+            == m_upscalingDependencies.end()) {
+          return;
+        }
+        m_upscalingOptionsResolved = false;
+        if (m_upscalingOwner && m_upscalingState.ready) {
+          m_upscalingState.ready = false;
+          writeUpscalingState();
+        }
+      }
+
+      void finishUpscalingOptions(bool converged) {
+        std::lock_guard<std::mutex> lock{ m_lock };
+        m_upscalingOptionsResolved = converged;
+        // A resolver that abandons cyclic callbacks cannot certify this device's state.
+        m_upscalingResolutionFailed |= !converged;
+        if (!converged && m_upscalingOwner && m_upscalingState.ready) {
+          m_upscalingState.ready = false;
+          writeUpscalingState();
+        }
+      }
+
+      void publishUpscalingState(const void* owner, UpscalingState state) {
+        std::lock_guard<std::mutex> lock{ m_lock };
+        if (owner != m_upscalingOwner || !owner) {
+          return;
+        }
+        state.ready &= m_upscalingOptionsResolved && !m_upscalingResolutionFailed;
+        state.ready &= state.upscaler <= 5 && state.frameGeneration <= 2;
+        m_upscalingState = state;
+        writeUpscalingState();
       }
 
       // Copies the current value under key into out. Returns false if the
       // key is not present. Thread-safe.
       bool tryGet(const std::string& key, std::string& out) const {
         std::lock_guard<std::mutex> lock{ m_lock };
         auto it = m_values.find(key);
         if (it == m_values.end()) {
           return false;
         }
         out = it->second;
         return true;
       }
 
     private:
       GameStateStore() = default;
       GameStateStore(const GameStateStore&) = delete;
       GameStateStore& operator=(const GameStateStore&) = delete;
 
+      void writeUpscalingState() {
+        const auto& s = m_upscalingState;
+        m_values[kUpscalingStateKey] = "1 " + std::to_string(s.ready) + " "
+          + std::to_string(s.upscaler) + " " + std::to_string(s.frameGeneration) + " "
+          + std::to_string(s.dlssSupported) + " " + std::to_string(s.dlssFrameGenerationSupported) + " "
+          + std::to_string(s.fsrFrameGenerationSupported);
+      }
+
+      const void* m_upscalingOwner = nullptr;
+      std::vector<const void*> m_upscalingDependencies;
+      bool m_upscalingOptionsResolved = false;
+      bool m_upscalingResolutionFailed = false;
+      UpscalingState m_upscalingState;
       mutable std::mutex m_lock;
       std::unordered_map<std::string, std::string> m_values;
     };
 
   }  // namespace fork_game_state
 }  // namespace dxvk
