@@ -69,9 +73,27 @@ namespace dxvk {
 
   RtxInitializer::RtxInitializer(DxvkDevice* device)
   : CommonDeviceObject(device) {
+    // The upscaling closure of updateGraphicsPresets, update*Upscaler/Preset and
+    // applyFrameGenerationType. Lighting, sky and category writes cannot change the snapshot.
+    const RtxOptionImpl* dependencies[] = {
+      &RtxOptions::upscalerTypeObject(), &RtxOptions::frameGenerationTypeObject(),
+      &RtxOptions::graphicsPresetObject(), &RtxOptions::dlssPresetObject(),
+      &RtxOptions::nisPresetObject(), &RtxOptions::taauPresetObject(),
+      &RtxOptions::qualityDLSSObject(), &RtxOptions::resolutionScaleObject(),
+      &RtxOptions::reflexModeObject(), &RtxOptions::enableRayReconstructionObject(),
+      &RtxOptions::Automation::disableUpdateUpscaleFromDlssPresetObject(),
+      &DxvkDLSS::presetObject(), &DxvkXeSS::XessOptions::presetObject(), &DxvkFSR::FSROptions::presetObject(),
+      &DxvkDLFG::enableObject(), &DxvkDLFG::litePresetObject(), &DxvkDLFG::maxInterpolatedFramesObject(),
+      &DxvkDLFG::enablePresentMeteringObject(), &DxvkFSRFrameGen::enableObject(),
+    };
+    fork_game_state::GameStateStore::get().beginUpscalingState(this,
+      std::vector<const void*>(std::begin(dependencies), std::end(dependencies)));
+    Logger::info("[RTX Upscaling State] startup pending: 1 0 0 0 0 0 0");
   }
 
   void RtxInitializer::onDestroy() {
+    m_upscalingPresetsInitialized = false;
+    fork_game_state::GameStateStore::get().endUpscalingState(this);
     // Raised before the joins below so the asset loaders abandon their prim walks rather
     // than running the stage to completion - otherwise quitting while enhancements load
     // blocks for the whole remaining load and looks like a hang.
@@ -168,6 +190,29 @@ namespace dxvk {
       // Wait for all prewarming to complete before calling "RTX initialized"
       waitForShaderPrewarm();
     }
+    m_upscalingPresetsInitialized = true;
+    publishUpscalingState();
+    std::string upscalingState;
+    fork_game_state::GameStateStore::get().tryGet(fork_game_state::kUpscalingStateKey, upscalingState);
+    Logger::info(str::format("[RTX Upscaling State] startup resolved: ", upscalingState));
+  }
+
+  void RtxInitializer::publishUpscalingState() {
+    if (!m_upscalingPresetsInitialized) {
+      return;
+    }
+    auto* common = m_device->getCommon();
+    const bool dlss = m_device->extensions().nvxBinaryImport
+      && m_device->extensions().nvxImageViewHandle && m_device->extensions().khrPushDescriptor
+      && common->metaDLSS().supportsDLSS();
+    const bool dlfg = common->metaDLFG().supportsDLFG() && !common->metaDLFG().hasDLFGFailed();
+    const bool fsrfg = common->metaFSRFrameGen().supportsFSRFrameGen();
+
+    // Match markDirty's lock order and copy both effective enums from the same resolution.
+    std::lock_guard<std::mutex> lock(RtxOptionImpl::getUpdateMutex());
+    fork_game_state::GameStateStore::get().publishUpscalingState(this, {
+      true, static_cast<uint32_t>(RtxOptions::upscalerType.getValueNoLock()),
+      static_cast<uint32_t>(RtxOptions::frameGenerationType.getValueNoLock()), dlss, dlfg, fsrfg });
   }
 
   void RtxInitializer::release() {
