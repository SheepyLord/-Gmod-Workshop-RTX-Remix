diff --git a/tests/rtx/unit/test_upscaling_options.cpp b/tests/rtx/unit/test_upscaling_options.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fedc23237b8b269a735ef0e8d9d851dcb9bf185b
--- /dev/null
+++ b/tests/rtx/unit/test_upscaling_options.cpp
@@ -0,0 +1,145 @@
+// Actual option writes/resolution with controlled sky-like writers and preset callbacks; no GPU.
+#include "../../../src/dxvk/rtx_render/rtx_option.h"
+#include "../../../src/dxvk/rtx_render/rtx_option_manager.h"
+#include "../../../src/dxvk/rtx_render/rtx_fork_game_state.h"
+#include "../../../src/util/config/config.h"
+#include "../../test_utils.h"
+
+#include <cstdlib>
+#include <iostream>
+
+namespace dxvk {
+  Logger Logger::s_instance("test_upscaling_options.log");
+
+namespace upscaling_options_test {
+  using namespace fork_game_state;
+
+  static void check(bool value, const char* message) {
+    if (!value) {
+      std::cerr << "FAIL upscaling options: " << message << '\n';
+      std::abort();
+    }
+  }
+
+  class Options {
+  public:
+    static inline bool cycleEnabled = false;
+    static void onPreset(DxvkDevice*) {
+      upscaler.setDeferred(preset(), RtxOptionLayer::getUserLayer());
+      backend.setDeferred(frameGeneration() != 0);
+    }
+    static void onFrameGeneration(DxvkDevice*) {
+      backend.setDeferred(frameGeneration() != 0);
+    }
+    static void onCycle(DxvkDevice*) {
+      if (cycleEnabled) {
+        cycle.setDeferred(cycle() + 1);
+      }
+    }
+    RTX_OPTION("rtx.readbackTest", int, upscaler, 1, "Test upscaler selector.");
+    RTX_OPTION_ARGS("rtx.readbackTest", int, frameGeneration, 0, "Test FG selector.", args.onChangeCallback = &onFrameGeneration);
+    RTX_OPTION_ARGS("rtx.readbackTest", int, preset, 1, "Test preset.", args.onChangeCallback = &onPreset);
+    RTX_OPTION("rtx.readbackTest", bool, backend, false, "Preset's derived backend control.");
+    RTX_OPTION("rtx.readbackTest", float, sunElevation, 15.0f, "Continuous unrelated sky writer.");
+    RTX_OPTION("rtx.readbackTest", float, cloudCoverage, 0.5f, "Continuous unrelated cloud writer.");
+    RTX_OPTION("rtx.readbackTest", bool, effect, false, "Unrelated effect control.");
+    RTX_OPTION("rtx.readbackTest", std::string, category, "", "Unrelated category list.");
+    RTX_OPTION_ARGS("rtx.readbackTest", int, cycle, 0, "Unrelated failing resolver.", args.onChangeCallback = &onCycle);
+  };
+
+  // Same readOption path as remixapi_SetConfigVariable; no config is saved.
+  static void write(RtxOptionImpl& option, const std::string& value) {
+    Config setting;
+    setting.setOption(option.getFullName(), value);
+    option.readOption(setting, RtxOptionLayer::getUserLayer());
+  }
+
+  static void expect(bool ready, int upscaler, int fg) {
+    static int reads = 0;
+    reads++;
+    std::string value;
+    check(GameStateStore::get().tryGet(kUpscalingStateKey, value), "snapshot missing");
+    const auto expected = "1 " + std::to_string(ready) + " " + std::to_string(upscaler)
+      + " " + std::to_string(fg) + " 1 1 1";
+    if (value != expected) {
+      std::cerr << "read " << reads << ": expected '" << expected << "', got '" << value << "'\n";
+      check(false, "wrong readiness or effective state");
+    }
+  }
+
+  static void publish(const void* device) {
+    std::lock_guard<std::mutex> lock(RtxOptionImpl::getUpdateMutex());
+    GameStateStore::get().publishUpscalingState(device, {true,
+      static_cast<uint32_t>(Options::upscaler.getValueNoLock()),
+      static_cast<uint32_t>(Options::frameGeneration.getValueNoLock()), true, true, true});
+  }
+
+  void run() {
+    RtxOptionLayer::initializeSystemLayers();
+    RtxOptionImpl::setInitialized(true);
+    RtxOptionManager::markOptionsWithCallbacksDirty();
+    RtxOptionManager::applyPendingValues(nullptr, true);
+
+    int device = 0;
+    auto& store = GameStateStore::get();
+    const RtxOptionImpl* dependencies[] = {&Options::upscalerObject(), &Options::frameGenerationObject(),
+      &Options::presetObject(), &Options::backendObject()};
+    store.beginUpscalingState(&device, std::vector<const void*>(std::begin(dependencies), std::end(dependencies)));
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    publish(&device);
+    expect(true, 1, 0);
+
+    for (int frame = 0; frame < 100; frame++) {
+      for (int i = 0; i < 50; i++) {
+        write(Options::sunElevationObject(), std::to_string((frame + i) % 80));
+        write(Options::cloudCoverageObject(), std::to_string(float(i) / 50));
+        write(Options::effectObject(), (i % 2) ? "True" : "False");
+        write(Options::categoryObject(), std::to_string(i));
+        expect(true, 1, 0);
+      }
+      RtxOptionManager::applyPendingValues(nullptr, false);
+      // A sky write after resolution but before present must not cancel publication either.
+      write(Options::sunElevationObject(), "15");
+      publish(&device);
+      expect(true, 1, 0);
+    }
+
+    write(Options::upscalerObject(), "0");
+    expect(false, 1, 0);
+    publish(&device);
+    expect(false, 1, 0);
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    publish(&device);
+    expect(true, 0, 0);
+
+    write(Options::frameGenerationObject(), "1");
+    expect(false, 0, 0);
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    publish(&device);
+    expect(true, 0, 1);
+    check(Options::backend(), "FG callback not resolved");
+
+    write(Options::presetObject(), "3");
+    expect(false, 0, 1);
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    publish(&device);
+    expect(true, 3, 1);
+
+    Options::cycleEnabled = true;
+    Options::cycle.setDeferred(1);
+    expect(true, 3, 1);
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    expect(false, 3, 1);
+    Options::cycleEnabled = false;
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    publish(&device);
+    expect(false, 3, 1);
+    store.endUpscalingState(&device);
+    std::cout << "PASS upscaling option writes: 20100 unrelated writes, pending selectors/presets, failed convergence\n";
+  }
+}
+}
+
+int main() {
+  dxvk::upscaling_options_test::run();
+}
