-#: src/dxvk/rtx_render/rtx_atmosphere.h:537
+#: src/dxvk/rtx_render/rtx_atmosphere.h:598
 msgid "Vertical depth of the cloud slab in km."
 msgstr "Épaisseur verticale de la couche de nuages, en km."
 
 #. option rtx.atmosphere.cloudMsScale
-#: src/dxvk/rtx_render/rtx_atmosphere.h:562
+#: src/dxvk/rtx_render/rtx_atmosphere.h:623
 msgid "Multi-scatter strength multiplier on the Nubis Cubed sigma_ms term [0..2]. 1.0 = paper baseline. sigma_ms is an EXTINCTION on the body lobe (exp(-sigma_ms * D_sun)), so higher = darker shadowed bulk / more shading contrast, lower = brighter, flatter body fill. (Doc fixed 2026-07-14; the old text had the direction inverted.)"
 msgstr "Multiplicateur de l'intensité de diffusion multiple appliqué au terme sigma_ms de Nubis Cubed [0..2]. 1.0 = référence de l'article. sigma_ms est une EXTINCTION sur le lobe du corps (exp(-sigma_ms * D_sun)) : plus élevé = masse ombrée plus sombre / plus de contraste d'ombrage, plus faible = remplissage du corps plus lumineux et plus plat. (Documentation corrigée le 2026-07-14 ; l'ancien texte inversait le sens.)"
 
 #. option rtx.atmosphere.cloudTypeMean
-#: src/dxvk/rtx_render/rtx_atmosphere.h:569
+#: src/dxvk/rtx_render/rtx_atmosphere.h:630
 msgid "Mean cloud type across the sky [0,1]: 0=stratus, 0.5=stratocumulus, 1=cumulus."
 msgstr "Type de nuage moyen sur l'ensemble du ciel [0,1] : 0=stratus, 0.5=stratocumulus, 1=cumulus."
 
 #. option rtx.atmosphere.cloudTypeSpread
-#: src/dxvk/rtx_render/rtx_atmosphere.h:571
+#: src/dxvk/rtx_render/rtx_atmosphere.h:632
 msgid "Spatial variation amplitude for cloud type [0,1]. 0=uniform, 1=full range across the sky."
 msgstr "Amplitude de la variation spatiale du type de nuage [0,1]. 0=uniforme, 1=plage complète sur l'ensemble du ciel."
 
 #. option rtx.atmosphere.cloudTypeNoiseScale
-#: src/dxvk/rtx_render/rtx_atmosphere.h:573
+#: src/dxvk/rtx_render/rtx_atmosphere.h:634
 msgid "Region size frequency for type noise. Numerically smaller = larger spatial features. Capped at 0.0034 in the UI because faster variation puts visible 2D-noise cell structure at sub-cumulus scales (regular grid of cumulus blobs)."
 msgstr "Fréquence de taille des régions pour le bruit de type. Numériquement plus petit = motifs spatiaux plus grands. Plafonnée à 0.0034 dans l'interface, car une variation plus rapide fait apparaître la structure en cellules du bruit 2D à des échelles inférieures à celle des cumulus (grille régulière de masses de cumulus)."
 
 #. option rtx.atmosphere.cloudCoverageMean
-#: src/dxvk/rtx_render/rtx_atmosphere.h:577
+#: src/dxvk/rtx_render/rtx_atmosphere.h:638
 msgid "Mean cloud coverage across the sky [0,1]: 0=clear, 1=overcast."
 msgstr "Couverture nuageuse moyenne sur l'ensemble du ciel [0,1] : 0=dégagé, 1=couvert."
 
 #. option rtx.atmosphere.cloudCoverageSpread
-#: src/dxvk/rtx_render/rtx_atmosphere.h:579
+#: src/dxvk/rtx_render/rtx_atmosphere.h:640
 msgid "Spatial variation amplitude for coverage [0,1]. 0=uniform, 1=full range."
 msgstr "Amplitude de la variation spatiale de la couverture [0,1]. 0=uniforme, 1=plage complète."
 
 #. option rtx.atmosphere.cloudCoverageNoiseScale
-#: src/dxvk/rtx_render/rtx_atmosphere.h:581
+#: src/dxvk/rtx_render/rtx_atmosphere.h:642
 msgid "Region size frequency for coverage noise. Independent from type noise scale."
 msgstr "Fréquence de taille des régions pour le bruit de couverture. Indépendante de l'échelle du bruit de type."
 
 #. option rtx.atmosphere.cloudCellSizeKm
-#: src/dxvk/rtx_render/rtx_atmosphere.h:597
+#: src/dxvk/rtx_render/rtx_atmosphere.h:658
 msgid "Average cloud-cluster footprint in km [0.5..6] for the placement map bake. Smaller = many small clouds; larger = fewer, broader banks. Re-bakes the placement map live on change (the effective value snaps so an integer number of clusters fits the noise tile)."
 msgstr "Emprise moyenne d'un amas de nuages, en km [0.5..6], pour le précalcul de la carte de placement. Plus petit = nombreux petits nuages ; plus grand = bancs moins nombreux et plus étendus. Toute modification relance en direct le précalcul de la carte de placement (la valeur effective est arrondie pour qu'un nombre entier d'amas tienne dans la tuile de bruit)."
 
 #. option rtx.atmosphere.nvdfProfileDepthKm
-#: src/dxvk/rtx_render/rtx_atmosphere.h:627
+#: src/dxvk/rtx_render/rtx_atmosphere.h:688
 msgid "Nubis3: depth into the cloud body (km) over which the dimensional profile ramps 0 -> 1 [0.1..3]. Small = dense hard-shelled clouds; large = soft translucent-edged bodies. Applies live."
 msgstr "Nubis3 : profondeur dans le corps du nuage (km) sur laquelle le profil dimensionnel passe progressivement de 0 -> 1 [0.1..3]. Petite = nuages denses à coque dure ; grande = corps doux aux bords translucides. S'applique immédiatement."
 
 #. option rtx.atmosphere.nubis3ErosionStrength
-#: src/dxvk/rtx_render/rtx_atmosphere.h:638
+#: src/dxvk/rtx_render/rtx_atmosphere.h:699
 msgid "Nubis3: scale on the wispy/billowy noise composite that erodes the dimensional profile [0..2]. 0 = smooth un-eroded bodies (pure SDF blobs); 1 = paper-faithful erosion; higher = ragged heavily-carved clouds. Applies live."
 msgstr "Nubis3 : échelle du composite de bruit filandreux/bouillonnant qui érode le profil dimensionnel [0..2]. 0 = corps lisses non érodés (masses SDF pures) ; 1 = érosion fidèle à l'article ; plus élevé = nuages déchiquetés, fortement creusés. S'applique immédiatement."
 
 #. option rtx.atmosphere.nvdfBodyErosionStrength
-#: src/dxvk/rtx_render/rtx_atmosphere.h:648
+#: src/dxvk/rtx_render/rtx_atmosphere.h:709
 msgid "Nubis3: strength of the 3D noise carve applied to the cloud BODIES in the NVDF occupancy bake [0..1.5]. The carve shifts the placement waterline per voxel, baking concavity (overhangs, notches, lumps) into the otherwise-convex column bodies — the anti-blobby body lever. 0 = smooth convex bodies. Changing it re-bakes the SDF (amortized, ~6 frames)."
 msgstr "Nubis3 : intensité du creusement par bruit 3D appliqué aux CORPS des nuages lors du précalcul d'occupation NVDF [0..1.5]. Le creusement décale la ligne de flottaison du placement voxel par voxel, intégrant des concavités (surplombs, encoches, bosses) dans des corps en colonne autrement convexes — le levier contre l'aspect de masses informes. 0 = corps convexes lisses. Le modifier relance le précalcul du SDF (étalé sur ~6 images)."
 
 #. option rtx.atmosphere.nubis3ShapeVarietyKm
-#: src/dxvk/rtx_render/rtx_atmosphere.h:661
+#: src/dxvk/rtx_render/rtx_atmosphere.h:722
 msgid "Nubis3: mid-frequency SHAPE displacement amplitude in km [0..1.5] (the GT7 mid-band role). Pushes/pulls the body iso-surface by up to half this at ~2.4 km wavelengths — lobes, notches and full splits that turn round singular blobs into varied cloud clusters. Whole-body reshaping, not edge detail; coverage-neutral on average. 0 = off. Applies live, no rebake."
 msgstr "Nubis3 : amplitude du déplacement de FORME à moyenne fréquence, en km [0..1.5] (le rôle de la bande moyenne dans GT7). Pousse ou tire l'isosurface du corps jusqu'à la moitié de cette valeur, à des longueurs d'onde de ~2.4 km — lobes, encoches et séparations complètes qui transforment des masses rondes isolées en amas de nuages variés. Remodèle le corps entier, pas les détails des bords ; neutre en moyenne pour la couverture. 0 = désactivé. S'applique immédiatement, sans nouveau précalcul."
 
 #. option rtx.atmosphere.cloudLightingLodThreshold
-#: src/dxvk/rtx_render/rtx_atmosphere.h:669
+#: src/dxvk/rtx_render/rtx_atmosphere.h:730
 msgid "Nubis3: contribution-weighted lighting LOD [0..0.25]. A march sample's contribution weight is view transmittance x aerial haze x its own opacity — exactly the factor its color is multiplied by in the composite. Samples below this threshold skip the expensive near-field live sun refinement (two full density-sampler calls, ~9 of ~16 texture taps per dense sample) and the moon shadow march, falling back to the D_sun grid and unshadowed moonlight — the same fallbacks the existing thin-sample density gates already use, so this only coarsens lighting that was designed to degrade that way and never removes cloud material. Targets deep-in-cloud and distance-dimmed samples, which pay full price while contributing almost nothing to the pixel. Raise until edges or crevice contrast visibly soften, then back off. 0 = disabled (every sample fully refined). Applies live."
 msgstr "Nubis3 : LOD d'éclairage pondéré par la contribution [0..0.25]. Le poids de contribution d'un échantillon de marche est transmittance de vue x brume aérienne x sa propre opacité — exactement le facteur par lequel sa couleur est multipliée lors de la composition. Les échantillons sous ce seuil sautent le coûteux affinage en direct du soleil en champ proche (deux appels complets à l'échantillonneur de densité, ~9 des ~16 lectures de texture par échantillon dense) ainsi que la marche d'ombre de la lune, et se replient sur la grille D_sun et un clair de lune sans ombre — les mêmes solutions de repli que celles déjà utilisées par les seuils de densité existants pour les échantillons fins ; cela ne fait donc que dégrader un éclairage conçu pour se dégrader ainsi, sans jamais supprimer de matière nuageuse. Cible les échantillons situés au cœur des nuages ou atténués par la distance, qui coûtent le prix fort tout en ne contribuant presque pas au pixel. Augmentez jusqu'à ce que les bords ou le contraste des crevasses s'adoucissent visiblement, puis revenez un peu en arrière. 0 = désactivé (chaque échantillon est entièrement affiné). S'applique immédiatement."
 
 #. option rtx.atmosphere.nubis3EdgeErosion
-#: src/dxvk/rtx_render/rtx_atmosphere.h:693
+#: src/dxvk/rtx_render/rtx_atmosphere.h:754
 msgid "Nubis3: edge wisp cut [0..3]. Extra erosion shaped by the wispy noise channel, concentrated at the silhouette and fading by mid-shell — cuts trailing wisp shapes out of cloud edges while billowy cores keep rounded cauliflower edges. 0 = uniform erosion only. Applies live."
 msgstr "Nubis3 : découpe filandreuse des bords [0..3]. Érosion supplémentaire façonnée par le canal de bruit filandreux, concentrée sur la silhouette et s'estompant à mi-coque — découpe des filaments traînants dans les bords des nuages, tandis que les cœurs bouillonnants gardent des bords arrondis en chou-fleur. 0 = érosion uniforme uniquement. S'applique immédiatement."
 
 #. option rtx.atmosphere.cloudViewStepKm
-#: src/dxvk/rtx_render/rtx_atmosphere.h:724
+#: src/dxvk/rtx_render/rtx_atmosphere.h:785
 msgid "Distance between cloud samples along each view ray, in km [0.1..1]. Fixes the horizontal banding near the horizon (sightlines there cross 50+ km of cloud layer, which the legacy fixed 32-sample march could not resolve). PERFORMANCE: cost scales with samples per ray — overhead views are unchanged, horizon-heavy views can cost up to cloudViewSamplesMax/32 times more cloud time (2x at defaults). Raise the spacing or lower the cap to trade quality for speed; 0 = legacy fixed count (banding returns). Applies live."
 msgstr "Distance entre les échantillons de nuages le long de chaque rayon de vue, en km [0.1..1]. Corrige les bandes horizontales près de l'horizon (les lignes de visée y traversent plus de 50 km de couche nuageuse, ce que l'ancienne marche fixe à 32 échantillons ne pouvait pas résoudre). PERFORMANCES : le coût augmente avec le nombre d'échantillons par rayon — les vues vers le zénith ne changent pas, les vues dominées par l'horizon peuvent coûter jusqu'à cloudViewSamplesMax/32 fois plus de temps de calcul des nuages (2x avec les valeurs par défaut). Augmentez l'espacement ou abaissez le plafond pour privilégier la vitesse au détriment de la qualité ; 0 = ancien nombre fixe (les bandes réapparaissent). S'applique immédiatement."
 
 #. option rtx.atmosphere.cloudViewSamplesMax
-#: src/dxvk/rtx_render/rtx_atmosphere.h:735
+#: src/dxvk/rtx_render/rtx_atmosphere.h:796
 msgid "Hard cap on cloud samples per ray [32..256] — the performance governor for cloudViewStepKm. 64 resolves the default spacing out to ~6 km of cloud span; lower costs less but lets some banding back in at the far horizon. 32 = legacy cost ceiling. Applies live."
 msgstr "Plafond strict du nombre d'échantillons de nuages par rayon [32..256] — le régulateur de performances de cloudViewStepKm. 64 permet de résoudre l'espacement par défaut jusqu'à ~6 km d'étendue nuageuse ; une valeur plus faible coûte moins, mais laisse réapparaître quelques bandes à l'horizon lointain. 32 = plafond de coût de l'ancien comportement. S'applique immédiatement."
 
 #. option rtx.atmosphere.cloudUndersideLightSigma
-#: src/dxvk/rtx_render/rtx_atmosphere.h:741
+#: src/dxvk/rtx_render/rtx_atmosphere.h:802
 msgid "Extinction of the light filtering down through each cloud, per km of overlying water [0..0.5]. Drives the analytic per-column underside light field: brightness varies continuously with the water above every point (dark cores, bright thin spots, smooth gradients) instead of one flat-lit sheet. Higher = darker, more dramatic undersides; 0 = underside darkening off (flat-lit base). Overall strength and the sun-elevation fade are set by Bottom Darkening. Applies live."
 msgstr "Extinction de la lumière qui filtre vers le bas à travers chaque nuage, par km d'eau située au-dessus [0..0.5]. Pilote le champ lumineux analytique par colonne de la face inférieure : la luminosité varie continûment selon la quantité d'eau au-dessus de chaque point (cœurs sombres, zones fines lumineuses, dégradés doux) au lieu d'une nappe éclairée uniformément. Plus élevé = dessous plus sombres et plus spectaculaires ; 0 = assombrissement du dessous désactivé (base éclairée uniformément). L'intensité globale et l'atténuation selon l'élévation du soleil sont définies par « Assombrissement du dessous ». S'applique immédiatement."
 
 #. option rtx.atmosphere.cloudMicroAoStrength
-#: src/dxvk/rtx_render/rtx_atmosphere.h:765
+#: src/dxvk/rtx_render/rtx_atmosphere.h:826
 msgid "Billow-scale shading from the edge-detail field [0..1]: grown cauliflower knuckles brighten, carved crevices darken, so the edge detail reads inside the cloud body instead of only at the silhouette. Applies to ambient + multi-scatter body light; silver linings are exempt. 0 = off (legacy smooth shading)."
 msgstr "Ombrage à l'échelle des volutes, issu du champ de détails des bords [0..1] : les bosses en chou-fleur s'éclaircissent, les crevasses creusées s'assombrissent, de sorte que les détails des bords se lisent dans le corps du nuage et pas seulement sur la silhouette. S'applique à la lumière ambiante et de diffusion multiple du corps ; les liserés argentés ne sont pas concernés. 0 = désactivé (ancien ombrage lisse)."
 
 #. option rtx.atmosphere.lightningEnable
-#: src/dxvk/rtx_render/rtx_atmosphere.h:784
+#: src/dxvk/rtx_render/rtx_atmosphere.h:845
 msgid "Lightning master switch. With this on, lightning is driven entirely by lightningStrikesPerMinute (default 0 = no strikes) - the weather presets raise the rate for storm archetypes. Turn this off to mute lightning everywhere, including storm presets and the Test Strike button."
 msgstr "Interrupteur principal des éclairs. Lorsqu'il est activé, les éclairs sont entièrement pilotés par lightningStrikesPerMinute (par défaut 0 = aucun éclair) - les préréglages météo augmentent cette fréquence pour les types d'orage. Désactivez-le pour supprimer les éclairs partout, y compris dans les préréglages d'orage et avec le bouton « Éclair de test »."
 
 #. option rtx.atmosphere.lightningStrikesPerMinute
-#: src/dxvk/rtx_render/rtx_atmosphere.h:790
+#: src/dxvk/rtx_render/rtx_atmosphere.h:851
 msgid "Mean lightning strike rate per minute [0..60]. Inter-strike gaps are randomized (Poisson-like) so strikes cluster and lull naturally. 0 = no automatic strikes (Test Strike still works). Driven by the weather-preset system when a preset is active (thunderstorm 12/min, rainstorm 4/min)."
 msgstr "Fréquence moyenne des éclairs par minute [0..60]. Les intervalles entre éclairs sont aléatoires (de type Poisson), si bien que les éclairs se regroupent et s'espacent naturellement. 0 = aucun éclair automatique (« Éclair de test » fonctionne toujours). Pilotée par le système de préréglages météo lorsqu'un préréglage est actif (orage 12/min, tempête de pluie 4/min)."
 
 #. option rtx.atmosphere.lightningFlashIntensity
-#: src/dxvk/rtx_render/rtx_atmosphere.h:796
+#: src/dxvk/rtx_render/rtx_atmosphere.h:857
 msgid "Radiance scale of the in-cloud flash glow. Higher = the deck lights up brighter and the glow reaches further through the cloud. Tune against your sky brightness; the flash competes with direct sunlight, so night storms need far less."
 msgstr "Échelle de radiance de la lueur de l'éclair dans les nuages. Plus élevé = la couche nuageuse s'illumine davantage et la lueur porte plus loin à travers le nuage. Réglez-la en fonction de la luminosité de votre ciel ; l'éclair est en concurrence avec la lumière directe du soleil, donc les orages nocturnes nécessitent beaucoup moins."
 
 #. option rtx.atmosphere.lightningSceneLightIntensity
-#: src/dxvk/rtx_render/rtx_atmosphere.h:801
+#: src/dxvk/rtx_render/rtx_atmosphere.h:862
 msgid "Radiance of the transient sphere light that flashes the SCENE at the strike position (independent of the in-cloud glow's intensity). 0 = cloud-only lightning (no ground flash)."
 msgstr "Radiance de la lumière sphérique temporaire qui illumine la SCÈNE à l'emplacement de l'éclair (indépendamment de l'intensité de la lueur dans les nuages). 0 = éclairs uniquement dans les nuages (aucun flash au sol)."
 
 #. option rtx.atmosphere.lightningRangeKm
-#: src/dxvk/rtx_render/rtx_atmosphere.h:806
+#: src/dxvk/rtx_render/rtx_atmosphere.h:867
 msgid "Maximum strike distance from the camera in km [1.5..30]. Strikes distribute uniformly by area between 1 km and this range."
 msgstr "Distance maximale des éclairs par rapport à la caméra, en km [1.5..30]. Les éclairs se répartissent uniformément en surface entre 1 km et cette distance."
 
 #. option rtx.atmosphere.lightningColor
-#: src/dxvk/rtx_render/rtx_atmosphere.h:810
+#: src/dxvk/rtx_render/rtx_atmosphere.h:871
 msgid "Lightning flash color (linear RGB), shared by the in-cloud glow and the scene flash. Default is a cool blue-white."
 msgstr "Couleur de l'éclair (RGB linéaire), commune à la lueur dans les nuages et au flash sur la scène. Par défaut, un blanc bleuté froid."
 
 #. option rtx.atmosphere.cloudBottomDarkening
-#: src/dxvk/rtx_render/rtx_atmosphere.h:824
+#: src/dxvk/rtx_render/rtx_atmosphere.h:885
 msgid "Strength of the cloud-underside darkening [0..1]. Scales the analytic per-column light field (shaped by Underside Shading) applied to the multi-scatter and ambient terms; the direct sun beam (silver lining) is unaffected. The darkening is strongest with the sun overhead and fades out toward the horizon, where the low sun rakes under the deck and lights the bases (sunset glow). 0 = off (uniformly lit undersides)."
 msgstr "Intensité de l'assombrissement de la face inférieure des nuages [0..1]. Met à l'échelle le champ lumineux analytique par colonne (façonné par « Ombrage du dessous ») appliqué aux termes de diffusion multiple et ambiant ; le faisceau direct du soleil (liseré argenté) n'est pas affecté. L'assombrissement est maximal avec le soleil au zénith et s'estompe vers l'horizon, où le soleil bas rase le dessous de la couche et éclaire les bases (lueur du couchant). 0 = désactivé (dessous éclairés uniformément)."
 
 #. option rtx.atmosphere.cloudSkyAmbientFill
-#: src/dxvk/rtx_render/rtx_atmosphere.h:832
+#: src/dxvk/rtx_render/rtx_atmosphere.h:893
 msgid "How strongly cloud undersides pick up the open sky around them [0..1]. Adds a sky-dome fill - the overhead sky color, bypassing the bottom-darkening since that skylight reaches the base from below/around rather than through the cloud. Lifts gloomy undersides under a bright daytime sky and tints them with the actual sky color; naturally fades at sunset (the overhead sky is dim then). Higher = brighter, more sky-colored bases; 0 = off (legacy, undersides ignore the open sky). Applies live."
 msgstr "Intensité avec laquelle le dessous des nuages capte le ciel dégagé environnant [0..1]. Ajoute un éclairage d'appoint de la voûte céleste - la couleur du ciel au zénith, sans passer par l'assombrissement du dessous, car cette lumière du ciel atteint la base par en dessous et par les côtés plutôt qu'à travers le nuage. Éclaircit les dessous trop sombres sous un ciel diurne lumineux et les teinte de la couleur réelle du ciel ; s'estompe naturellement au coucher du soleil (le ciel au zénith est alors sombre). Plus élevé = bases plus lumineuses et plus colorées par le ciel ; 0 = désactivé (ancien comportement, le dessous ignore le ciel dégagé). S'applique immédiatement."
 
 #. option rtx.atmosphere.cloudAmbientShadowStrength
-#: src/dxvk/rtx_render/rtx_atmosphere.h:841
+#: src/dxvk/rtx_render/rtx_atmosphere.h:902
 msgid "Dramatic shading [0..1]: how much the sky-ambient fill is attenuated by sun-shadow depth inside the cloud. The ambient term otherwise refloods sun-shadowed bulk with bright daytime sky light, flattening the cloud; with this, shaded cores fall toward dark grey while sunlit faces and silver linings keep their full ambient - the high-contrast puffy-cumulus read. The sky-dome underside fill (Sky Ambient Fill) is exempt so midday bases keep their open-sky floor. 0 = off (legacy flat ambient). Applies live."
 msgstr "Ombrage dramatique [0..1] : dans quelle mesure l'appoint ambiant du ciel est atténué par la profondeur d'ombre solaire à l'intérieur du nuage. Sans cela, le terme ambiant inonde à nouveau la masse à l'ombre du soleil avec la lumière vive du ciel diurne, ce qui aplatit le nuage ; avec cela, les cœurs ombragés tendent vers le gris foncé, tandis que les faces ensoleillées et les liserés argentés conservent tout leur éclairage ambiant - l'aspect de cumulus gonflés très contrastés. L'appoint de la voûte céleste sous les nuages (« Appoint ambiant du ciel ») n'est pas concerné, afin que les bases à midi conservent le plancher lumineux du ciel dégagé. 0 = désactivé (ancien éclairage ambiant uniforme). S'applique immédiatement."
 
 #. option rtx.atmosphere.cloudAerialHazePerKm
-#: src/dxvk/rtx_render/rtx_atmosphere.h:862
+#: src/dxvk/rtx_render/rtx_atmosphere.h:923
 msgid "Per-km haze extinction applied to cloud RADIANCE (effect A of the aerial-perspective path). Dims distant cloud samples toward atmospheric color so they read as 'softer / duller with distance.' Visual softness control - does NOT prevent the horizon white wall by itself. 0 = no haze. Default 0.05."
 msgstr "Extinction par brume, par km, appliquée à la RADIANCE des nuages (effet A du chemin de perspective aérienne). Atténue les échantillons de nuages lointains vers la couleur de l'atmosphère afin qu'ils paraissent « plus doux / plus ternes avec la distance ». Réglage de douceur visuelle - n'empêche PAS à lui seul le mur blanc à l'horizon. 0 = aucune brume. Par défaut : 0.05."
 
 #. option rtx.atmosphere.cloudAerialFadePerKm
-#: src/dxvk/rtx_render/rtx_atmosphere.h:868
+#: src/dxvk/rtx_render/rtx_atmosphere.h:929
 msgid "Per-km fade extinction applied to cloud ALPHA accumulation (effect B of the aerial-perspective path). Distant samples stop piling up extinction so horizon-grazing rays don't form a solid white wall. Does NOT affect cloud appearance close to camera. 0 = no fade (legacy white-wall behavior). Default 0.05."
 msgstr "Extinction par fondu, par km, appliquée à l'accumulation ALPHA des nuages (effet B du chemin de perspective aérienne). Les échantillons lointains cessent d'accumuler de l'extinction, afin que les rayons rasant l'horizon ne forment pas un mur blanc opaque. N'affecte PAS l'aspect des nuages proches de la caméra. 0 = aucun fondu (ancien comportement avec mur blanc). Par défaut : 0.05."
 
 #. option rtx.atmosphere.cloudPhaseG1
-#: src/dxvk/rtx_render/rtx_atmosphere.h:875
+#: src/dxvk/rtx_render/rtx_atmosphere.h:936
 msgid "Primary HG asymmetry; strong forward-scatter, drives silver lining at backlit edges."
 msgstr "Asymétrie HG principale ; forte diffusion vers l'avant, produit le liseré argenté sur les bords en contre-jour."
 
 #. option rtx.atmosphere.cloudRenderResolutionScale
-#: src/dxvk/rtx_render/rtx_atmosphere.h:908
+#: src/dxvk/rtx_render/rtx_atmosphere.h:969
 msgid "Resolution scale of the cloud render target relative to the internal (DLSS-input) resolution [0.25..1]. 0.5 = quarter the pixels (~4x cheaper cloud march); 1.0 = native (legacy, bit-exact). Applies on the next frame; live-tunable."
 msgstr "Échelle de résolution de la cible de rendu des nuages par rapport à la résolution interne (entrée de DLSS) [0.25..1]. 0.5 = un quart des pixels (marche des nuages ~4x moins coûteuse) ; 1.0 = native (ancien comportement, identique au bit près). S'applique à l'image suivante ; réglable en direct."
 
 #. option rtx.atmosphere.cloudHistoryWeight
-#: src/dxvk/rtx_render/rtx_atmosphere.h:913
+#: src/dxvk/rtx_render/rtx_atmosphere.h:974
 msgid "EMA history weight of the cloud temporal smoother [0..0.98]. Higher = smoother/softer clouds that respond slowly; lower = crisper, faster-responding clouds with more visible per-frame jitter. 0 disables the temporal blend entirely (raw jittered march). 0.92 = the previous hardcoded value. Applies live."
 msgstr "Poids d'historique (EMA) du lissage temporel des nuages [0..0.98]. Plus élevé = nuages plus lisses et plus doux, qui réagissent lentement ; plus faible = nuages plus nets et plus réactifs, avec un jitter par image plus visible. 0 désactive entièrement le mélange temporel (marche brute avec jitter). 0.92 = l'ancienne valeur codée en dur. S'applique immédiatement."
 
 #. option rtx.atmosphere.cloudSecondaryLutEnable
-#: src/dxvk/rtx_render/rtx_atmosphere.h:920
+#: src/dxvk/rtx_render/rtx_atmosphere.h:981
 msgid "Supply clouds to secondary rays (indirect bounces, PSR, reflections) from a small per-frame baked dome LUT instead of a per-ray cloud march. Large performance win on cloudy skies, and reflected/indirect clouds match the primary Nubis look. Disable to make secondary sky-miss rays cloudless."
 msgstr "Fournit les nuages aux rayons secondaires (rebonds indirects, PSR, réflexions) à partir d'une petite LUT de dôme précalculée à chaque image, au lieu d'une marche des nuages par rayon. Gain de performances important par ciel nuageux, et les nuages réfléchis/indirects correspondent à l'aspect Nubis primaire. Désactivez cette option pour que les rayons secondaires qui atteignent le ciel n'aient pas de nuages."
 
 #. option rtx.atmosphere.cloudLayer2Enable
-#: src/dxvk/rtx_render/rtx_atmosphere.h:1020
+#: src/dxvk/rtx_render/rtx_atmosphere.h:1081
 msgid "When true, cloud_render.comp.slang marches a second 'echo' cloud deck above the primary slab — the same cloud-slab density model at a higher, gapped altitude, marched cheaply (low step budget, analytic sun shadow, no moon path). Layer 2 has its own altitude / thickness / type / coverage / density-scale / noise-seed knobs (the cloudLayer2* options below); the seed decorrelates the deck's coverage/type field from layer 1 so it reads as a related-but-different cloudscape. Voxel-grid terrain shadows + ground-shadow NEE remain layer-1-only."
 msgstr "Si cette option est activée, cloud_render.comp.slang calcule par marche une seconde couche nuageuse « écho » au-dessus de la couche principale — le même modèle de densité de couche nuageuse, à une altitude plus élevée et séparée, calculé à moindre coût (budget de pas réduit, ombre solaire analytique, pas de chemin lunaire). La couche 2 a ses propres réglages d'altitude / épaisseur / type / couverture / échelle de densité / graine de bruit (les options cloudLayer2* ci-dessous) ; la graine décorrèle le champ couverture/type de cette couche de celui de la couche 1, afin qu'elle forme un paysage nuageux apparenté mais différent. Les ombres de terrain de la grille de voxels + le NEE d'ombre au sol restent réservés à la couche 1."
 
 #. option rtx.atmosphere.cloudLayer2Altitude
-#: src/dxvk/rtx_render/rtx_atmosphere.h:1030
+#: src/dxvk/rtx_render/rtx_atmosphere.h:1091
 msgid "Altitude (km) of the layer-2 deck base. The gap between the layer-1 top (cloudAltitude + cloudThickness) and this value is the clear-sky band separating the two decks."
 msgstr "Altitude (km) de la base de la couche 2. L'écart entre le sommet de la couche 1 (cloudAltitude + cloudThickness) et cette valeur forme la bande de ciel dégagé qui sépare les deux couches."
 
 #. option rtx.atmosphere.cloudLayer2Thickness
-#: src/dxvk/rtx_render/rtx_atmosphere.h:1034
+#: src/dxvk/rtx_render/rtx_atmosphere.h:1095
 msgid "Vertical depth (km) of the layer-2 deck."
 msgstr "Épaisseur verticale (km) de la couche 2."
 
 #. option rtx.atmosphere.cloudLayer2TypeMean
-#: src/dxvk/rtx_render/rtx_atmosphere.h:1036
+#: src/dxvk/rtx_render/rtx_atmosphere.h:1097
 msgid "[0,1] mean cloud type for layer 2. Low values (~0.05) sample the LUT's stratus-shaped column — appropriate for cirrus."
 msgstr "[0,1] type de nuage moyen de la couche 2. Les valeurs faibles (~0.05) échantillonnent la colonne en forme de stratus de la LUT — adaptée aux cirrus."
 
 #. option rtx.atmosphere.cloudLayer2CoverageMean
-#: src/dxvk/rtx_render/rtx_atmosphere.h:1039
+#: src/dxvk/rtx_render/rtx_atmosphere.h:1100
 msgid "[0,1] mean coverage for layer 2. Defaults sparser than layer 1 so cirrus reads as wispy patches rather than overcast."
 msgstr "[0,1] couverture moyenne de la couche 2. Par défaut plus clairsemée que la couche 1, afin que les cirrus apparaissent comme des plaques filandreuses plutôt que comme un ciel couvert."
 
 #. option rtx.atmosphere.cloudLayer2DensityScale
-#: src/dxvk/rtx_render/rtx_atmosphere.h:1050
+#: src/dxvk/rtx_render/rtx_atmosphere.h:1111
 msgid "Per-step density multiplier applied to layer 2 only. Lower values keep the echo deck from competing visually with the cumulus deck below."
 msgstr "Multiplicateur de densité par pas appliqué uniquement à la couche 2. Des valeurs plus faibles évitent que la couche écho ne concurrence visuellement la couche de cumulus en dessous."
 
 #. option rtx.atmosphere.cloudLayer2Color
-#: src/dxvk/rtx_render/rtx_atmosphere.h:1065
+#: src/dxvk/rtx_render/rtx_atmosphere.h:1126
 msgid "Base color (albedo) of the layer-2 echo deck, independent of the main cloudColor. Defaults to the same near-white so the deck matches layer 1 until changed; tint it to differentiate the upper deck (e.g. cooler high cirrus). The deck shares all other look knobs with layer 1 (phase, multi-scatter, detail, etc.)."
 msgstr "Couleur de base (albédo) de la couche écho 2, indépendante de la couleur principale cloudColor. Par défaut, le même blanc presque pur, pour que la couche corresponde à la couche 1 tant qu'elle n'est pas modifiée ; teintez-la pour différencier la couche supérieure (par ex. des cirrus d'altitude plus froids). La couche partage tous les autres réglages d'aspect avec la couche 1 (phase, diffusion multiple, détail, etc.)."
 
@@ -15975,199 +15975,203 @@ msgstr ""
 "Valeurs d'énumération prises en charge : 0 = None (désactivé), 1 = Spatial (activé, tramage spatial uniquement), 2 = SpatialTemporal (activé, tramage spatial et temporel).\n"
 "Il est généralement recommandé d'activer le tramage, mais le désactiver peut être utile dans quelques cas particuliers pour améliorer le taux de compression d'images ou de vidéos au détriment de la qualité (le bruit, même peu visible, peut être plus difficile à compresser), ou pour capturer les données « brutes » du moteur de rendu après tone mapping."
 
