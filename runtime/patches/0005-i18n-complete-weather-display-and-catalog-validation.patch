 msgstr "하늘 전체의 평균 구름 유형 [0,1]: 0=층운, 0.5=층적운, 1=적운."
 
 #. option rtx.atmosphere.cloudTypeSpread
-#: src/dxvk/rtx_render/rtx_atmosphere.h:571
+#: src/dxvk/rtx_render/rtx_atmosphere.h:632
 msgid "Spatial variation amplitude for cloud type [0,1]. 0=uniform, 1=full range across the sky."
 msgstr "구름 유형의 공간적 변화 폭 [0,1]. 0=균일, 1=하늘 전체에서 전 범위."
 
 #. option rtx.atmosphere.cloudTypeNoiseScale
-#: src/dxvk/rtx_render/rtx_atmosphere.h:573
+#: src/dxvk/rtx_render/rtx_atmosphere.h:634
 msgid "Region size frequency for type noise. Numerically smaller = larger spatial features. Capped at 0.0034 in the UI because faster variation puts visible 2D-noise cell structure at sub-cumulus scales (regular grid of cumulus blobs)."
 msgstr "유형 노이즈의 영역 크기 주파수입니다. 수치가 작을수록 공간적 특징이 커집니다. 변화가 더 빠르면 적운보다 작은 규모에서 2D 노이즈 셀 구조가 눈에 띄므로(적운 덩어리가 규칙적인 격자로 배열됨) UI에서는 0.0034로 제한됩니다."
 
 #. option rtx.atmosphere.cloudCoverageMean
-#: src/dxvk/rtx_render/rtx_atmosphere.h:577
+#: src/dxvk/rtx_render/rtx_atmosphere.h:638
 msgid "Mean cloud coverage across the sky [0,1]: 0=clear, 1=overcast."
 msgstr "하늘 전체의 평균 구름양 [0,1]: 0=맑음, 1=흐림."
 
 #. option rtx.atmosphere.cloudCoverageSpread
