diff --git a/i18n/tools/test_embed.py b/i18n/tools/test_embed.py
new file mode 100644
index 00000000..6aebcbc7
--- /dev/null
+++ b/i18n/tools/test_embed.py
@@ -0,0 +1,66 @@
+"""Catalog build regressions; no GPU or compiler required."""
+import contextlib
+import io
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import embed
+import po
+
+
+class CatalogBuildTests(unittest.TestCase):
+    def setUp(self):
+        scratch = Path(__file__).resolve().parents[2] / 'out' / 'tmp'
+        scratch.mkdir(parents=True, exist_ok=True)
+        self.temp = tempfile.TemporaryDirectory(dir=scratch)
+        self.root = Path(self.temp.name)
+        self.pot = self.root / 'messages.pot'
+        self.catalog = self.root / 'fr.po'
+        self.output = self.root / 'embedded.cpp'
+        po.write(self.pot, None, [po.Entry('Hello'), po.Entry('Count: %d', flags=['c-format'])])
+        self.header = po.make_header({'Language': 'fr', 'X-Remix-Language-Name': 'Français'})
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    def run_build(self, entries, *options):
+        po.write(self.catalog, self.header, entries)
+        args = ['embed.py', '--pot', str(self.pot), '--latin-font', 'unused.ttf',
+                '--fonts-dir', str(self.root), '--out', str(self.output), *options, str(self.catalog)]
+        output = io.StringIO()
+        with patch.object(sys, 'argv', args), patch.object(embed.fontcmap, 'characters', return_value=set(range(256))), \
+                patch.object(embed.fontcmap, 'height_per_em', return_value=1.0), \
+                contextlib.redirect_stdout(output), contextlib.redirect_stderr(output):
+            result = embed.main()
+        return result, output.getvalue()
+
+    def test_complete_catalog_builds(self):
+        result, log = self.run_build([po.Entry('Hello', 'Bonjour'), po.Entry('Count: %d', 'Nombre : %d')])
+        self.assertEqual(result, 0, log)
+        self.assertTrue(self.output.is_file())
+
+    def test_missing_blank_and_fuzzy_entries_fail(self):
+        for entries in ([po.Entry('Hello', 'Bonjour')],
+                        [po.Entry('Hello', ''), po.Entry('Count: %d', 'Nombre : %d')],
+                        [po.Entry('Hello', 'Bonjour', flags=['fuzzy']), po.Entry('Count: %d', 'Nombre : %d')]):
+            result, log = self.run_build(entries)
+            self.assertEqual(result, 1, log)
+            self.assertFalse(self.output.exists())
+
+    def test_duplicate_and_bad_format_entries_fail(self):
+        for entries in ([po.Entry('Hello', 'Bonjour'), po.Entry('Hello', 'Salut'), po.Entry('Count: %d', 'Nombre : %d')],
+                        [po.Entry('Hello', 'Bonjour'), po.Entry('Count: %d', 'Nombre : %s')]):
+            result, log = self.run_build(entries)
+            self.assertEqual(result, 1, log)
+            self.assertFalse(self.output.exists())
+
+    def test_fallback_is_explicitly_available_for_drafts(self):
+        result, log = self.run_build([po.Entry('Hello', 'Bonjour')], '--allow-incomplete')
+        self.assertEqual(result, 0, log)
+
+
+if __name__ == '__main__':
+    unittest.main()
