--- a/RtxOptions.md
+++ b/RtxOptions.md
@@ -2064,6 +2064,7 @@ This file is auto-generated by RTX Remix. To regenerate it, run Remix with `DXVK
 |rtx.geometryAssetHashRuleString|string|positions,indices,geometrydescriptor|||Defines which hashes we need to include when sampling from replacements and doing USD capture\.|
 |rtx.geometryGenerationHashRuleString|string|positions,indices,texcoords,geometrydescriptor,vertexlayout,vertexshader|||Defines which asset hashes we need to generate via the geometry processing engine\.|
 |rtx.gmod.eyeWhiteAliases|string||||Session\-only eye\-white proxy=original texture hash pairs\. Original mod materials take precedence over automatic albedo emission\.|
+|rtx.gmod.fallbackMods|string|~gmod\_topbr|||Comma\-separated mod folder names holding generated fallback replacements\. Every other mod wins over them\. Names match without case\.|
 |rtx.gmod.ignoredOutlineTextures|hash set||||Outline textures hidden by the GMod companion for this session\. Other texture categories are unchanged\.|
 |rtx.gmod.importedModelSmoothNormalTextures|hash set||||Imported model textures whose normals are recalculated for this session\. Saved smooth\-normal tags are preserved\.|
 |rtx.gmod.meshReplacementHashAliases|hash vector||||Pairs of source and target mesh hashes used only for replacement lookup\. This allows equivalent GMod geometry to consume replacements authored for another Source build\.|
diff --git a/src/dxvk/rtx_render/rtx_fallback_mods.h b/src/dxvk/rtx_render/rtx_fallback_mods.h
new file mode 100644
index 00000000..75254923
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fallback_mods.h
@@ -0,0 +1,48 @@
+/* Copyright (c) 2026 native-loader contributors. SPDX-License-Identifier: MIT */
+#pragma once
+#include <string>
+#include <string_view>
+#include "rtx_option.h"
+
+namespace dxvk {
+  // Mods that hold generated fallbacks (the RTX fixes' ToPBR writes ~gmod_topbr) must never win over an
+  // authored mod: whatever their folder names sort as, a listed mod ranks after every other mod for
+  // material, mesh and light lookups (the first mod that has a replacement wins) and before them for asset
+  // search paths (the last path wins). Mods load and reload independently, so this holds for a pack added
+  // or hot-reloaded after the fallback wrote its material too.
+  class RtxFallbackMods {
+  public:
+    RTX_OPTION("rtx.gmod", std::string, fallbackMods, "~gmod_topbr",
+      "Comma-separated mod folder names holding generated fallback replacements. Every other mod wins over them. Names match without case.");
+
+    // Whether folderName (UTF-8) is one of the comma-separated names in list, ignoring ASCII case and
+    // the spaces around each name. Pure, for the unit test.
+    static bool listed(std::string_view folderName, std::string_view list) {
+      auto lower = [](char c) { return c >= 'A' && c <= 'Z' ? char(c - 'A' + 'a') : c; };
+      auto trim = [](std::string_view s) {
+        while (!s.empty() && s.front() == ' ') s.remove_prefix(1);
+        while (!s.empty() && s.back() == ' ') s.remove_suffix(1);
+        return s;
+      };
+      folderName = trim(folderName);
+      if (folderName.empty()) return false;
+      while (!list.empty()) {
+        const size_t comma = list.find(',');
+        const std::string_view name = trim(list.substr(0, comma));
+        if (name.size() == folderName.size()) {
+          bool same = true;
+          for (size_t i = 0; same && i < name.size(); ++i) same = lower(name[i]) == lower(folderName[i]);
+          if (same) return true;
+        }
+        if (comma == std::string_view::npos) break;
+        list.remove_prefix(comma + 1);
+      }
+      return false;
+    }
+
+    static bool isFallback(std::string_view folderName) {
+      const std::string list = fallbackMods();
+      return listed(folderName, list);
+    }
+  };
+}
diff --git a/src/dxvk/rtx_render/rtx_mod_manager.cpp b/src/dxvk/rtx_render/rtx_mod_manager.cpp
index 668b9d5f..46c11c3e 100644
--- a/src/dxvk/rtx_render/rtx_mod_manager.cpp
+++ b/src/dxvk/rtx_render/rtx_mod_manager.cpp
@@ -24,6 +24,7 @@
 
 #include "rtx_asset_replacer.h"
 #include "rtx_mod_usd.h"
+#include "rtx_fallback_mods.h"
 
 #include "rtx_options.h"
 
@@ -83,9 +84,15 @@ void ModManager::publishSearchPaths() const {
   // Keep any lock taken from within this call, or setSearchPaths, consistent with that order.
   std::vector<Mod::Path> flattened;
   std::lock_guard<std::mutex> lock(m_searchPathMutex);
-  for (const auto& mod : m_mods) {
-    const auto& paths = mod->searchPaths();
-    flattened.insert(flattened.end(), paths.begin(), paths.end());
+  // Generated fallback mods rank last for replacements but come first here, where the last path wins.
+  for (const bool fallbackPass : { true, false }) {
+    for (const auto& mod : m_mods) {
+      if ((mod->m_priority != 0) != fallbackPass) {
+        continue;
+      }
+      const auto& paths = mod->searchPaths();
+      flattened.insert(flattened.end(), paths.begin(), paths.end());
+    }
   }
   AssetDataManager::get().setSearchPaths(flattened);
 }
@@ -175,7 +182,12 @@ ModManager::Mods ModManager::enumerateModsInDir(const Path& modsDirPath) {
       const auto modDirPath = modsDirEntry.path();
       const auto [bModExists, modDesc] = modExists(modDirPath);
       if (bModExists) {
-        mods.emplace(modDesc.typeInfo->construct(modDesc.filePath));
+        auto mod = modDesc.typeInfo->construct(modDesc.filePath);
+        // A generated fallback mod (ToPBR's ~gmod_topbr) ranks after every authored mod, whatever its
+        // folder name sorts as. UTF-8: a name outside the ANSI code page must not throw here.
+        const auto name = modDirPath.filename().u8string();
+        mod->m_priority = RtxFallbackMods::isFallback(std::string(name.begin(), name.end())) ? 1 : 0;
+        mods.emplace(std::move(mod));
       }
     }
   }
