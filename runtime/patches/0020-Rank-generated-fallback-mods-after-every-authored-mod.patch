diff --git a/tests/rtx/unit/test_fallback_mods.cpp b/tests/rtx/unit/test_fallback_mods.cpp
new file mode 100644
index 00000000..9344370e
--- /dev/null
+++ b/tests/rtx/unit/test_fallback_mods.cpp
@@ -0,0 +1,21 @@
+/* Copyright (c) 2026 native-loader contributors. SPDX-License-Identifier: MIT */
+#include <cstdlib>
+#include <iostream>
+#include "../../../src/dxvk/rtx_render/rtx_fallback_mods.h"
+namespace dxvk { Logger Logger::s_instance("test_fallback_mods.log"); }
+int main() {
+  using namespace dxvk;
+  const auto require = [](bool ok, const char* message) {
+    if (!ok) { std::cerr << message << '\n'; std::exit(1); }
+  };
+  require(RtxFallbackMods::listed("~gmod_topbr", "~gmod_topbr"), "The default name must match");
+  require(RtxFallbackMods::listed("~GMOD_TopBR", "~gmod_topbr"), "Names match without ASCII case");
+  require(RtxFallbackMods::listed("generated", " a , generated , b "), "Spaces around listed names are ignored");
+  require(!RtxFallbackMods::listed("gmod_topbr", "~gmod_topbr"), "Only the exact name matches");
+  require(!RtxFallbackMods::listed("~gmod_topbr_old", "~gmod_topbr"), "A longer name is another mod");
+  require(!RtxFallbackMods::listed("pbr_robin", "~gmod_topbr"), "An authored pack is never a fallback");
+  require(!RtxFallbackMods::listed("\xE4\xB8\xAD\xE6\x96\x87", "~gmod_topbr"), "A non-ASCII authored name is never a fallback");
+  require(!RtxFallbackMods::listed("", "~gmod_topbr") && !RtxFallbackMods::listed("a", ""), "Empty names never match");
+  require(!RtxFallbackMods::listed("a", ",,"), "Empty list entries never match");
+  return 0;
+}
