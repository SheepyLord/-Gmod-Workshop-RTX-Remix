diff --git a/tests/rtx/unit/test_option_layer_export.cpp b/tests/rtx/unit/test_option_layer_export.cpp
index f8aa67d5..2df57f78 100644
--- a/tests/rtx/unit/test_option_layer_export.cpp
+++ b/tests/rtx/unit/test_option_layer_export.cpp
@@ -607,6 +607,52 @@ namespace option_layer_export_test {
   }
 
   // ============================================================================
+  // Failed disk operations must not replace either the saved baseline or live values.
+  void testSaveFailureAndReload() {
+    const std::string path = "test_persistent_settings.conf";
+    cleanupTestFile(path);
+    Config original;
+    original.setOption("rtx.test.export.testFloatOption", 1.25f);
+    original.setOption("rtx.unregistered.keep", std::string("authored"));
+    TEST_ASSERT(Config::serializeCustomConfig(original, path), "Initial save failed");
+    auto* layer = const_cast<RtxOptionLayer*>(RtxOptionManager::acquireLayer(path, kTestLayerKey));
+    TEST_ASSERT(layer, "Layer missing");
+    TestExportOptions::testFloatOption.setImmediately(0.f, layer);
+    TEST_ASSERT(layer->hasUnsavedChanges(), "An intentional zero should be unsaved");
+
+    const HANDLE locked = CreateFileA(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, 0, nullptr);
+    TEST_ASSERT(locked != INVALID_HANDLE_VALUE, "Could not lock original");
+    const bool savedWhileLocked = layer->save();
+    const bool stillUnsaved = layer->hasUnsavedChanges();
+    CloseHandle(locked);
+    TEST_ASSERT(!savedWhileLocked && stillUnsaved, "Failed save was reported as saved");
+    TEST_ASSERT(readOptionFromFile(path, "rtx.test.export.testFloatOption") == "1.25", "Failed save damaged original");
+    TEST_ASSERT(layer->save() && !layer->hasUnsavedChanges(), "Retry did not save");
+    TEST_ASSERT(readOptionFromFile(path, "rtx.test.export.testFloatOption") == "0", "Saved zero lost");
+    TEST_ASSERT(readOptionFromFile(path, "rtx.unregistered.keep") == "authored", "Unknown setting lost");
+
+    TestExportOptions::testFloatOption.setImmediately(2.5f, layer);
+    const HANDLE unreadable = CreateFileA(path.c_str(), GENERIC_READ, 0, nullptr, OPEN_EXISTING, 0, nullptr);
+    TEST_ASSERT(unreadable != INVALID_HANDLE_VALUE, "Could not lock reads");
+    const bool loadedWhileLocked = layer->reload();
+    CloseHandle(unreadable);
+    TEST_ASSERT(!loadedWhileLocked, "Unreadable file was reported as loaded");
+    TEST_ASSERT(layer->hasUnsavedChanges(), "Failed reload lost live changes");
+    TEST_ASSERT(layer->save(), "Save after failed reload failed");
+    TEST_ASSERT(readOptionFromFile(path, "rtx.test.export.testFloatOption") == "2.5", "Failed reload changed live value");
+    TestExportOptions::testFloatOption.setImmediately(0.f, layer);
+    TEST_ASSERT(layer->reload() && !layer->hasUnsavedChanges(), "Successful reload failed");
+
+    Config absentDirectory;
+    absentDirectory.setOption("rtx.test", 1);
+    TEST_ASSERT(!Config::serializeCustomConfig(absentDirectory, "absent-settings-dir/test.conf"), "Missing directory save succeeded");
+    RtxOptionManager::releaseLayer(layer);
+    cleanupTestFile(path);
+    for (const auto& entry : std::filesystem::directory_iterator(".")) {
+      TEST_ASSERT(entry.path().filename().string().find(path + ".tmp-") != 0, "Staged file leaked");
+    }
+  }
+
