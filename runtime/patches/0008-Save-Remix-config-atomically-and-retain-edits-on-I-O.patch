-  void Config::serializeCustomConfig(const Config& config, std::string filePath, std::string filterStr) {
-    // Open the file if it exists
-    std::ofstream stream(str::tows(filePath.c_str()).c_str());
-
-    if (!stream)
-      return;
+  // NV-DXVK start: Preserve the last complete file until a flushed replacement is ready
+  bool Config::serializeCustomConfig(const Config& config, std::string filePath, std::string filterStr) {
+    std::ostringstream stream;
+    for (const auto& line : config.m_options) {
+      if (filterStr.empty() || line.first.find(filterStr) != std::string::npos) {
+        stream << line.first << " = " << line.second << '\n';
+      }
+    }
 
-    Logger::info(str::format("Serializing config file: ", filePath));
+    const auto path = str::tows(filePath.c_str());
+    std::wstring temporaryPath;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    for (uint32_t attempt = 0; attempt < 16; ++attempt) {
+      temporaryPath = path + L".tmp-" + std::to_wstring(GetCurrentProcessId()) + L"-"
+        + std::to_wstring(GetTickCount64()) + L"-" + std::to_wstring(attempt);
+      file = CreateFileW(temporaryPath.c_str(), GENERIC_WRITE, FILE_SHARE_READ, nullptr,
+                         CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+      if (file != INVALID_HANDLE_VALUE || GetLastError() != ERROR_FILE_EXISTS) {
+        break;
+      }
+    }
+    if (file == INVALID_HANDLE_VALUE) {
+      Logger::err(str::format("Failed to stage config '", filePath, "' (Windows error ", GetLastError(), ")."));
+      return false;
+    }
 
-    for (const auto& line : config.m_options) {
-      // Write if no filter specified, or if key matches the filter
-      if (filterStr.empty() || line.first.find(filterStr) != std::string::npos)
-        stream << line.first << " = " << line.second << std::endl;
+    const auto fail = [&](DWORD error) {
+      if (file != INVALID_HANDLE_VALUE) {
+        CloseHandle(file);
+      }
+      DeleteFileW(temporaryPath.c_str());
+      Logger::err(str::format("Failed to save config '", filePath, "' (Windows error ", error, "). Previous file kept."));
+      return false;
+    };
+
+    const std::string contents = stream.str();
+    size_t offset = 0;
+    while (offset < contents.size()) {
+      const DWORD count = static_cast<DWORD>(std::min<size_t>(contents.size() - offset, MAXDWORD));
+      DWORD written = 0;
+      if (!WriteFile(file, contents.data() + offset, count, &written, nullptr) || !written) {
+        return fail(GetLastError());
+      }
+      offset += written;
     }
+    if (!FlushFileBuffers(file)) {
+      return fail(GetLastError());
+    }
+    if (!CloseHandle(file)) {
+      return fail(GetLastError());
+    }
+    file = INVALID_HANDLE_VALUE;
+    if (!MoveFileExW(temporaryPath.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+      return fail(GetLastError());
+    }
+    Logger::info(str::format("Saved config file: ", filePath));
+    return true;
   }
+  // NV-DXVK end
 
   // NV-DXVK start: Extend logOptions function
   void Config::logOptions(const char* configName) const {
