+  bool D3D9Rtx::isRasterRenderTarget() const {
+    const auto& target = d3d9State().renderTargets[kRenderTargetIndex];
+    if (target == nullptr || !m_activePresentParams || s_isDxvkResolutionEnvVarSet) {
+      return false;
+    }
+    auto* texture = target->GetCommonTexture();
+    if (texture->GetImage() == nullptr) {
+      return false;
+    }
+    if (RtxOptions::RaytracedRenderTarget::enable() &&
+        m_textureCategories.raytracedRenderTargetTextures.contains(texture->GetImage()->getDescriptorHash())) {
+      return false;
+    }
+    return !isRenderTargetPrimary(*m_activePresentParams, texture->Desc());
+  }
+
   PrepareDrawFlags D3D9Rtx::internalPrepareDraw(const IndexContext& indexContext, const VertexContext vertexContext[caps::MaxStreams], const DrawContext& drawContext) {
     ScopedCpuProfileZone();
 
     m_textureCategories.refresh();
 
+    // Offscreen color/alpha canvases must keep native blend and write-mask operations, before
+    // ray-tracing-only rejection and independently of the main framebuffer's injection point.
+    if (isRasterRenderTarget()) {
+      return PrepareDrawFlag::PreserveDrawCallAndItsState;
+    }
+
     // RTX was injected => treat everything else as rasterized,
     // unless this draw targets a raytraced render target (e.g. render-to-texture
     // in games that draw UI before 3D content).
