+/* Copyright (c) 2026 native-loader contributors. SPDX-License-Identifier: MIT */
+#include <cstdlib>
+#include <iostream>
+#include "../../../src/dxvk/rtx_render/rtx_gmod_effects.h"
+
+namespace dxvk { Logger Logger::s_instance("test_gmod_effects.log"); }
+
+int main() {
+  using namespace dxvk;
+  const auto require = [](bool value, const char* message) {
+    if (!value) { std::cerr << message << '\n'; std::exit(1); }
+  };
+  RtxOptionLayer::initializeSystemLayers();
+  const auto* user = RtxOptionLayer::getUserLayer();
+  const auto* derived = RtxOptionLayer::getDerivedLayer();
+  for (auto* option : {&RtxGmodEffects::particleTexturesForSessionObject(),
+                      &RtxGmodEffects::decalTexturesForSessionObject(),
+                      &RtxGmodEffects::legacyEffectTexturesForSessionObject()}) {
+    require(option->getTargetLayer(user) == derived, "Session effects must never enter user.conf");
+    require(bool(option->getFlags() & RtxOptionFlags::NoSave), "Session effects must not serialize");
+    require(bool(option->getFlags() & RtxOptionFlags::InvalidatesDrawcallTranslation), "Effect changes must invalidate preserved draws");
+  }
+  for (auto* option : {&RtxGmodEffects::particleTexturesForSessionObject(),
+                      &RtxGmodEffects::decalTexturesForSessionObject(),
+                      &RtxGmodEffects::legacyEffectTexturesForSessionObject()}) {
+    RtxOptionHashSetCopy copy(*option);
+    const auto refresh = [&]() {
+      std::lock_guard<std::mutex> lock(RtxOptionImpl::getUpdateMutex());
+      copy.refreshLocked();
+    };
+    refresh();
+    require(!copy.contains(0x1234), "Session categories must start empty");
+    fast_unordered_set hashes;
+    hashes.insert(0x1234);
+    option->setImmediately(hashes);
+    refresh();
+    require(copy.contains(0x1234), "D3D9 snapshots must receive new session hashes");
+    option->setImmediately(fast_unordered_set{});
+    refresh();
+    require(!copy.contains(0x1234), "D3D9 snapshots must release removed session hashes");
+  }
+  std::cout << "GMod effect category lifetime and snapshots passed\n";
+}
