#. R6 T3: agent-written by Codex; not yet human-reviewed.
msgid "Performance tier: %s (%s; %s, %s MiB VRAM). To change it, set remix.performance_tier in native-loader\\config.json to auto, high, medium or low, then restart Garry's Mod."
msgstr "성능 등급: %s(%s; %s, VRAM %s MiB). 변경하려면 native-loader\\config.json의 remix.performance_tier를 auto, high, medium, low 중 하나로 설정한 뒤 Garry's Mod를 다시 시작하세요."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:209
#. R6 T3: agent-written by Codex; not yet human-reviewed.
msgid "Unknown source"
msgstr "알 수 없는 선택 출처"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:213
msgid "RTX Remix runs in this session through the native loader. Everything RTX lives in this tab."
msgstr "이번 세션에서는 RTX Remix가 네이티브 로더를 통해 실행되고 있습니다. RTX에 관한 모든 것은 이 탭에 있습니다."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:216
msgid "Open the RTX Remix guide"
msgstr "RTX Remix 가이드 열기"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:217
#. R6 T3: agent-written by Codex; not yet human-reviewed.
msgid "Memory and stability guide"
msgstr "메모리와 안정성 가이드"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:218
msgid "Print the loader's status to the console"
msgstr "로더 상태를 콘솔에 출력"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:219
msgid "Classic settings: the values of the original RTX install. They were applied once, only where a setting was still at its default. This button applies all of them again."
msgstr "클래식 설정: 기존 RTX 환경의 값입니다. 아직 기본값이던 설정에만 한 번 적용되었습니다. 이 버튼은 이 값들을 모두 다시 적용합니다."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:220
msgid "Use the classic RTX settings"
msgstr "클래식 RTX 설정 사용"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:221
msgid "Keep add-ons from undoing RTX settings or drawing post-processing over the image"
msgstr "애드온이 RTX 설정을 되돌리거나 화면에 후처리를 덧그리지 못하게 막기"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:222
msgid "RTX session guard"
msgstr "RTX 세션 보호"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:223
msgid "Turn this off only to test an add-on that misbehaves."
msgstr "오작동하는 애드온을 테스트할 때만 끄세요."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:224
msgid "Remix's own menu: press Alt+X. Choose Custom as the graphics preset before changing single settings, then use Save, or they come back at the next start."
msgstr "Remix 자체 메뉴: Alt+X를 누르세요. 개별 설정을 바꾸기 전에 그래픽 프리셋으로 '사용자 지정'(Custom)을 고르고, 그다음 '저장'(Save)을 누르세요. 그렇지 않으면 다음 실행 시 원래대로 돌아갑니다."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:225
msgid "Language"
msgstr "언어"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:226
msgid "Same as Garry's Mod"
msgstr "Garry's Mod와 동일"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:228
msgid "Language of this tab and the guide"
msgstr "언어(이 탭과 가이드)"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:235
msgid "Changes here apply to this session. Use Save Settings in Alt+X to keep them. Values shown here are this panel's overrides, not a live readout of Remix."
msgstr "여기서 변경한 값은 이번 게임에 적용됩니다. 유지하려면 Alt+X 메뉴에서 설정을 저장하세요. 여기에 표시되는 값은 이 패널의 덮어쓰기 값이며, Remix의 현재 값을 실시간으로 표시하는 것은 아닙니다."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:236
msgid "Reapply these overrides at every launch"
msgstr "시작할 때마다 이 덮어쓰기 값 다시 적용"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:237
msgid "Leave this off to load Remix's saved settings. Turn it on only if you want this panel to override them."
msgstr "끄면 Remix에 저장된 설정을 불러옵니다. 이 패널의 값으로 덮어쓰려는 경우에만 켜세요."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:247
msgid "On"
msgstr "켜기"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:251
#, c-format
msgid "Set %s here"
msgstr "여기서 %s 설정"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:277
msgid "Enable a numeric override before editing it. Zero is a valid value for sky brightness and colour purity."
msgstr "숫자를 편집하기 전에 해당 항목의 덮어쓰기를 켜세요. 하늘 밝기와 색 순도는 0으로 설정할 수도 있습니다."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:278
msgid "Clear this panel's overrides"
msgstr "이 패널의 덮어쓰기 값 지우기"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:282
msgid "Local player shadow"
msgstr "내 플레이어 그림자"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:283
msgid "Create your first-person body shadow and reflection. Other players and ragdolls are unaffected."
msgstr "1인칭 시점에서 내 몸의 그림자와 반사를 표시합니다. 다른 플레이어와 래그돌에는 영향을 주지 않습니다."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:284
msgid "Body height offset (units)"
msgstr "몸 높이 오프셋(유닛)"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:285
msgid "Positive values raise only the rendered body. Your camera and collision stay in place."
msgstr "양수 값은 화면에 그려지는 몸만 위로 올립니다. 카메라와 충돌 판정 위치는 바뀌지 않습니다."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:289
msgid "Keep toolgun text sharp"
msgstr "툴건 글자를 선명하게 표시"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:290
msgid "Draw the live toolgun screen at full resolution after upscaling. Animated and custom screens keep updating normally."
msgstr "업스케일링 후 툴건 화면을 전체 해상도로 그립니다. 애니메이션과 사용자 지정 화면도 정상적으로 갱신됩니다."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:294
msgid "Hide outline meshes"
msgstr "외곽선 메시 숨기기"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:295
msgid "Hides incompatible outline shells that can cover or darken the model. Other model materials keep their normal rendering."
msgstr "모델을 덮거나 어둡게 만드는 호환되지 않는 외곽선 셸을 숨깁니다. 다른 모델 재질은 정상적으로 렌더링됩니다."

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:310
msgid "Player models"
msgstr "플레이어 모델"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:311
msgid "Toolgun screen"
msgstr "툴건 화면"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:312
msgid "Model outlines"
msgstr "모델 외곽선"

