#: nativeloader/lua/autorun/client/nativeloader_menu.lua:89
msgid "Remix default"
msgstr "Remix 기본값"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:89
msgid "Heavy fog"
msgstr "짙은 안개"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:89
msgid "Light fog"
msgstr "옅은 안개"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:90
msgid "Mist"
