#: nativeloader/lua/autorun/client/nativeloader_menu.lua:49
msgid "Post effects"
msgstr "Постэффекты"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:49
msgid "Bloom, motion blur and film grain."
