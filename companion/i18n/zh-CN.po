#: nativeloader/lua/autorun/nativeloader_sky.lua:695
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:260
msgid "The Remix API is not available in this session, so these settings cannot be applied. Run nativeloader_status for details."
msgstr "本次游戏中 Remix API 不可用，因此无法应用这些设置。运行 nativeloader_status 可查看详情。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:699
#, c-format
msgid "On this map %s also sets the sky. It keeps its sky while Follow the map's sun is ticked and nothing here is changed; otherwise your settings here replace it."
msgstr "在此地图上，天空也由 %s 设置。勾选“跟随地图的太阳”且未在这里更改任何设置时，会保留其天空；否则会用这里的设置替换它。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:701
msgid "Sky"
msgstr "天空"

#: nativeloader/lua/autorun/nativeloader_sky.lua:702
msgid "Physical sky"
msgstr "物理天空"

#: nativeloader/lua/autorun/nativeloader_sky.lua:703
msgid "The map's skybox"
msgstr "地图自带的天空盒"

#: nativeloader/lua/autorun/nativeloader_sky.lua:704
msgid "The physical sky has a sun, clouds, stars and a moon, and lights the map from them."
msgstr "物理天空有太阳、云、星星和月亮，并由它们照亮地图。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:705
msgid "Follow the map's sun"
msgstr "跟随地图的太阳"

#: nativeloader/lua/autorun/nativeloader_sky.lua:706
msgid "Puts the sun where the map's own sun is; on a map whose add-on sets its own sky, such as Modern House RTX, keeps that sky. Moving Time of day or Sun direction turns this off."
msgstr "将太阳放在地图自身太阳的位置；如果地图的插件（如 Modern House RTX）设置了自己的天空，则保留该天空。调整“时间”或“太阳方向”会关闭此项。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:707
msgid "Time of day"
msgstr "时间"

#: nativeloader/lua/autorun/nativeloader_sky.lua:711
#, c-format
msgid "Now %s"
msgstr "现在 %s"

#: nativeloader/lua/autorun/nativeloader_sky.lua:729
msgid "Sun direction"
msgstr "太阳方向"

#: nativeloader/lua/autorun/nativeloader_sky.lua:730
msgid "Turns the sun's path around the sky."
msgstr "让太阳的运行轨迹绕着天空转动。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:731
msgid "Time passes"
msgstr "时间流逝"

#: nativeloader/lua/autorun/nativeloader_sky.lua:732
msgid "Day length (min)"
msgstr "一天时长(分钟)"

#: nativeloader/lua/autorun/nativeloader_sky.lua:733
msgid "Time passes is on by default. A whole day takes 20 real minutes; untick Time passes to stop the clock."
msgstr "默认开启时间流逝。一天持续现实中的 20 分钟；取消勾选“时间流逝”即可停止时钟。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:734
msgid "Sky update interval (s)"
msgstr "天空更新间隔(秒)"

#: nativeloader/lua/autorun/nativeloader_sky.lua:735
msgid "How often the sun, moon, stars and weather move, in seconds: 0.02 is 50 times a second, 0 is every frame. A longer interval costs a little less frame time, but the sky moves in steps."
msgstr "太阳、月亮、星空和天气的更新间隔，以秒为单位：0.02 表示每秒更新 50 次，0 表示每帧更新。较长的间隔能稍微减少帧时间开销，但天空的变化会显得不连贯。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:736
msgid "Season"
msgstr "季节"

#: nativeloader/lua/autorun/nativeloader_sky.lua:737
msgid "Moon"
msgstr "月亮"

#: nativeloader/lua/autorun/nativeloader_sky.lua:738
msgid "Eclipse"
msgstr "日月食"

#: nativeloader/lua/autorun/nativeloader_sky.lua:739
msgid "Eclipse progress"
msgstr "日月食进度"

#: nativeloader/lua/autorun/nativeloader_sky.lua:740
msgid "From first contact (0) to the middle (100): a lunar eclipse is total from 70, a solar one from 90. An eclipse sets the moon's phase, and the time if the sun is on the wrong side of the horizon for it."
msgstr "从初亏（0）到食甚（100）：月食从 70 起为全食，日食从 90 起为全食。选择食会设定月相；若太阳在地平线的另一侧，也会调整时间。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:741
msgid "Night sky"
msgstr "夜空"

#: nativeloader/lua/autorun/nativeloader_sky.lua:742
msgid "Night sky image: sharp stars, a galaxy and nebulae, turning with the time and the season."
msgstr "夜空图像：清晰的星星、银河和星云，随时间和季节转动。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:743
msgid "Weather"
msgstr "天气"

#: nativeloader/lua/autorun/nativeloader_sky.lua:744
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:269
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:273
msgid "(leave to Remix)"
msgstr "（由 Remix 决定）"

#: nativeloader/lua/autorun/nativeloader_sky.lua:746
msgid "Clouds, haze, fog, rain and snow, from Remix's own weather presets."
msgstr "云、薄雾、雾、雨和雪，来自 Remix 自带的天气预设。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:747
msgid "Weather change (s)"
msgstr "天气变换(秒)"

#: nativeloader/lua/autorun/nativeloader_sky.lua:748
msgid "How long a change of weather takes."
msgstr "天气变化所需的时间。"

#: nativeloader/lua/autorun/nativeloader_sky.lua:749
msgid "Reset the sky and weather"
msgstr "重置天空和天气"

#: nativeloader/lua/autorun/nativeloader_sky.lua:755
#: nativeloader/lua/autorun/nativeloader_sky.lua:755
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:22
#: nativeloader/lua/nativeloader/guide_pages.lua:108
msgid "Sky and weather"
msgstr "天空与天气"

