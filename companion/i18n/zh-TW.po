#: nativeloader/lua/autorun/client/nativeloader_menu.lua:50
msgid "Tone map colour purity"
msgstr "色調對應色彩純度"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:97
msgid "RTX Remix runs in this session through the native loader. Everything RTX lives in this tab."
msgstr "本次遊戲透過原生載入器執行 RTX Remix。與 RTX 相關的一切都在此分頁中。"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:98
msgid "Open the RTX Remix guide"
msgstr "開啟 RTX Remix 指南"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:99
msgid "Print the loader's status to the console"
msgstr "將載入器狀態輸出至主控台"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:100
msgid "Classic settings: the values of the original RTX install. They were applied once, only where a setting was still at its default. This button applies all of them again."
msgstr "經典設定：原始 RTX 安裝中的值。這些值已套用過一次，且只套用於當時仍為預設值的設定。此按鈕會再次套用所有這些值。"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:101
msgid "Use the classic RTX settings"
msgstr "使用經典 RTX 設定"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:102
msgid "Keep add-ons from undoing RTX settings or drawing post-processing over the image"
msgstr "防止附加元件還原 RTX 設定，或在畫面上疊加後製效果"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:103
msgid "RTX session guard"
msgstr "RTX 工作階段保護"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:104
msgid "Turn this off only to test an add-on that misbehaves."
msgstr "僅在測試行為異常的附加元件時才關閉此項。"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:105
msgid "Remix's own menu: press Alt+X. Choose Custom as the graphics preset before changing single settings, then use Save, or they come back at the next start."
msgstr "Remix 內建選單：按 Alt+X。變更個別設定前，請先將圖形預設設為「自訂」(Custom)，改完後使用「儲存」(Save)，否則下次啟動時這些設定會恢復原狀。"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:106
msgid "Language"
msgstr "語言"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:107
msgid "Same as Garry's Mod"
msgstr "與 Garry's Mod 相同"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:109
msgid "Language of this tab and the guide"
msgstr "此分頁與指南的語言"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:114
msgid "The Remix API is not available in this session, so these settings cannot be applied. Run nativeloader_status for details."
msgstr "本次遊戲中無法使用 Remix API，因此無法套用這些設定。請執行 nativeloader_status 以查看詳細資訊。"

#: nativeloader/lua/autorun/client/nativeloader_menu.lua:116
msgid "A setting chosen here is kept and applied at every start. Clear it (the empty choice, or the reset button) to leave it to Remix's own files."
