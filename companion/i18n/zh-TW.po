msgstr "天空更新間隔(秒)"

#: nativeloader/lua/autorun/nativeloader_sky.lua:724
msgid "How often the sun, moon, stars and weather move: 0.02 is 50 times a second, 0 is every frame. A longer interval saves a little time, but the sky moves in steps."
msgstr ""

#: nativeloader/lua/autorun/nativeloader_sky.lua:725
msgid "Season"
msgstr "季節"

#: nativeloader/lua/autorun/nativeloader_sky.lua:726
